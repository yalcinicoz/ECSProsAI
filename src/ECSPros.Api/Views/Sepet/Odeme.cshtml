@{
    ViewData["Title"] = "Ödeme";
}

<main class="ms-siparis-sayfa">
    @await Html.PartialAsync("~/Views/ProjeElementleri/Sepet/_SepetOdemeSayfasi.cshtml")
</main>

<script>
    document.querySelectorAll("[data-ms-siparis-asama-panel]").forEach((panel) => {
        panel.hidden = false;
        panel.classList.add("ms-siparis-asama-paneli-aktif");
    });

    window.msSiparisAsamasiGoster = function (hedef) {
        if (hedef === "onay") {
            window.location.href = "/siparis-tamamlandi";
        }
    };

</script>
