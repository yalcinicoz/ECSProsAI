@{
    ViewData["Title"] = "Teslimat";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["CanonicalPath"] = "/teslimat";
}

<div class="ms-siparis-sayfa">
    <h1 class="sr-only">Teslimat Bilgileri</h1>
    @await Html.PartialAsync("~/Views/ProjeElementleri/Sepet/_SepetTeslimatSayfasi.cshtml")
</div>

<script>
    document.querySelectorAll("[data-ms-siparis-asama-panel]").forEach((panel) => {
        panel.hidden = false;
        panel.classList.add("ms-siparis-asama-paneli-aktif");
    });

    document.querySelectorAll("[data-ms-siparis-asama-git='odeme']").forEach((buton) => {
        buton.addEventListener("click", () => {
            // Hızlı satın alma bağlamı (?hizli=1) ödeme adımına taşınır — ödeme sayfası
            // sepeti ana sepetten değil tek ürünlük hızlı sepetten okur (A seçeneği).
            const hizli = new URLSearchParams(window.location.search).get("hizli") === "1";
            window.location.href = hizli ? "/odeme?hizli=1" : "/odeme";
        });
    });

    // 2026-08-03: teslimat kapısı — sayfaya HANGİ yoldan gelinirse gelinsin (mini sepetteki
    // "Siparişi Tamamla" düz /teslimat linkidir, doğrudan URL, geri tuşu) üye değilse ve
    // misafir tercihi yoksa giriş modalı açılır. Önceden kapı yalnız /sepet'in düğmesindeydi;
    // buraya kapısız gelen kullanıcı "Misafir Olarak Devam Et"e bassa da bayrak yazılmıyor
    // ve giriş modalı döngüye giriyordu.
    document.addEventListener("DOMContentLoaded", () => {
        const girisli = () => !!localStorage.getItem("ecspros_member_token");
        const misafir = () => sessionStorage.getItem("msMisafirSiparis") === "1";

        if (!girisli() && !misafir()) {
            try { sessionStorage.setItem("msBekleyenTeslimat", "1"); } catch { }
            document.querySelector("[data-ms-giris-modal-ac]")?.click();
        }

        // Girişle devam: merge sonrası tetiklenen ms:uye-giris — adres listesi üye
        // verisiyle gelsin diye sayfa yeniden yüklenir (?hizli=1 URL'de korunur).
        document.addEventListener("ms:uye-giris", () => {
            try { sessionStorage.removeItem("msBekleyenTeslimat"); } catch { }
            window.location.reload();
        });

        // Misafirle devam: bu sayfada modal nereden açılmış olursa olsun (kapı, "giriş
        // yapın" linki, "Yeni Adres Ekle") misafir seçimi misafir akışı demektir —
        // bayrak yazılır, sayfa misafir görünümüyle (adres formu açık) yeniden yüklenir.
        document.querySelectorAll(".ms-giris-buton-misafir").forEach((buton) => {
            buton.addEventListener("click", () => {
                try {
                    sessionStorage.removeItem("msBekleyenTeslimat");
                    sessionStorage.setItem("msMisafirSiparis", "1");
                } catch { }
                window.location.reload();
            });
        });

        // Seçimsiz kapanış (X / kaplama / ESC): kapı bekliyorken vazgeçildi → sepete dön;
        // teslimatta giriş/misafir seçimi olmadan kalınmaz. ESC site.js'te kapat düğmesi
        // tıklanmadan doğrudan modalKapat() çağırır — bu yüzden tıklama değil, modalın
        // "açık" sınıfının düşmesi gözlenir (tüm kapanış yolları tek yerden yakalanır).
        // Başarılı giriş/misafir seçimi vazgeçme sayılmaz: girişte token kapanıştan önce
        // yazılır, misafirde bayrak kapanıştan önce temizlenir. "Kayıt Ol" geçişinde giriş
        // modalı kapanıp kayıt modalı açılır — biri açıkken yönlendirme yapılmaz; kayıt
        // modalı da seçimsiz kapanırsa sepete dönülür.
        const girisModali = document.querySelector("[data-ms-giris-modal]");
        const kayitModali = document.querySelector("[data-ms-kayit-modal]");
        if (girisModali) {
            const gozlemci = new MutationObserver(() => {
                if (girisli()) { return; }
                if (sessionStorage.getItem("msBekleyenTeslimat") !== "1") { return; }
                if (girisModali.classList.contains("ms-giris-modal-acik")
                    || kayitModali?.classList.contains("ms-giris-modal-acik")) { return; }
                try { sessionStorage.removeItem("msBekleyenTeslimat"); } catch { }
                window.location.href = "/sepet";
            });
            gozlemci.observe(girisModali, { attributes: true, attributeFilter: ["class"] });
            if (kayitModali) {
                gozlemci.observe(kayitModali, { attributes: true, attributeFilter: ["class"] });
            }
        }
    });
</script>
