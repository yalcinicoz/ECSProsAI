@{
    ViewData["Title"] = "Sipariş Tamamlandı";
    ViewData["Robots"] = "noindex, nofollow";
    ViewData["CanonicalPath"] = "/siparis-tamamlandi";
}

<div class="ms-siparis-sayfa">
    <h1 class="sr-only">Sipariş Tamamlandı</h1>
    @await Html.PartialAsync("~/Views/ProjeElementleri/Sepet/_SepetSiparisTamamlandiSayfasi.cshtml")
</div>

<script>
    document.querySelectorAll("[data-ms-siparis-asama-panel]").forEach((panel) => {
        panel.hidden = false;
        panel.classList.add("ms-siparis-asama-paneli-aktif");
    });
</script>
