@model ECSPros.Api.Models.Store.UrunKartVm
@inject ECSPros.Api.Services.IStoreContext MsStoreContext
@{
    // Canlı ürün kartı — misharix _UrunKartiOrnegi component'inin veriye bağlı karşılığı.
    // B7'de _UrunListesiUrunAlani içinde local function'dı; B6'da ana sayfa carousel'leri de
    // aynı kartı kullandığı için paylaşılan partial'a alındı (tek kaynak). Model null ise
    // infinite-scroll <template> iskelet kartı üretilir (boş data-ms-* alanları JS doldurur).
    // Veri karşılığı olmayan demo blokları @if(false) ile gizli — B8/B11/Faz G'de bağlanacak.
    // Ürün Kartı F1 (2026-08-09): elementler kanal ayarına bağlı (Settings."productCard",
    // panel Storefront → Ürün Kartı). Önizleme ucu kaydedilmemiş ayarı ViewData ile geçer.
    var kartAyar = ViewData["MsKartAyarlari"] as ECSPros.Api.Services.StoreKartAyarlari
        ?? (await MsStoreContext.GetPlatformAsync())?.KartAyarlari
        ?? ECSPros.Api.Services.StoreKartAyarlari.Varsayilan;
    var u = Model;
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var adParcalari = (u?.Ad ?? "").Split(' ', 2);
    var adIlk = adParcalari.Length > 0 ? adParcalari[0] : "";
    var adKalan = adParcalari.Length > 1 ? adParcalari[1] : "";
    // 2026-07-30: ürün görseli srcset — CDN anında ölçekler, cihaz gereken genişliği indirir
    // (kart ekranda ~180-240px; 640 sabit yerine 240-640 merdiveni). Kalıp dışı URL'de null.
    var kartSrcset = ECSPros.Api.Services.Store.UrunGorselSrcset.Kart(u?.GorselUrl);
    const string kartSizes = "(max-width: 768px) 45vw, 240px";

    // F2: üç değişken alan (1 = görsel altı bant, 2 = ad altı satır, 3 = puan altı satır).
    // Her alanın içeriği = elle kart mesajları + (alana yönlendirilmişse) kampanya rozetleri;
    // sıra kanal ayarındaki önceliğe göre. Şablon kartında (u null) placeholder basılır,
    // kartDoldur JS'i doldurur; rotasyonu _Layout'taki script'ler döndürür.
    List<(string Ad, string? Renk)> Alan1Ogeleri()
    {
        var a = kartAyar.Alan(1);
        var liste = new List<(string Ad, string? Renk)>();
        if (!a.Acik || u is null) { return liste; }
        var mesajlar = a.Mesajlar
            ? u.AlanMesajlari(1).Select(m => (m.Text, ECSPros.Api.Services.StoreKartAyarlari.PaletHex(m.Color))).ToList()
            : new List<(string, string?)>();
        var kampanyalar = a.Kampanyalar
            ? u.KampanyaBantListesi.Select(b => (b.Name, b.Color)).ToList()
            : new List<(string, string?)>();
        liste.AddRange(a.MesajlarOnce ? mesajlar.Concat(kampanyalar) : kampanyalar.Concat(mesajlar));
        return liste;
    }

    List<(string Metin, string Ikon, string? Sinif, string? Renk)> AlanSatirOgeleri(int slot)
    {
        var a = kartAyar.Alan(slot);
        var liste = new List<(string Metin, string Ikon, string? Sinif, string? Renk)>();
        if (!a.Acik || u is null) { return liste; }
        var mesajlar = a.Mesajlar
            ? u.AlanMesajlari(slot).Select(m => (m.Text, m.Icon is { Length: > 0 } ? m.Icon : "fa-circle-info",
                m.Color is { Length: > 0 } ? $"ms-metin-{m.Color}" : null, (string?)null)).ToList()
            : new List<(string, string, string?, string?)>();
        var kampanyalar = a.Kampanyalar
            ? u.KampanyaBantListesi.Select(b => (b.Name, "fa-tags", (string?)null, b.Color)).ToList()
            : new List<(string, string, string?, string?)>();
        liste.AddRange(a.MesajlarOnce ? mesajlar.Concat(kampanyalar) : kampanyalar.Concat(mesajlar));
        // Sosyal kanıt (2026-08-10, yalnız Alan 3): canlı sepet/favori sayaçları rotasyona
        // sondan eklenir; sayacı 0 olan satır hiç basılmaz (tasarımdaki turuncu vurgu kalıbı).
        if (slot == 3)
        {
            if (a.SepetSayisi && u.SepetteSayisi > 0)
                liste.Add(($"{u.SepetteSayisi.ToString("N0", tr)} kişinin sepetinde", "fa-cart-shopping", "ms-metin-turuncu", null));
            if (a.FavoriSayisi && u.FavoriSayisi > 0)
                liste.Add(($"{u.FavoriSayisi.ToString("N0", tr)} kişinin favorisi", "fa-heart", "ms-metin-turuncu", null));
            if (a.BakanSayisi && u.BakanSayisi > 0)
                liste.Add(($"{u.BakanSayisi.ToString("N0", tr)} kişi baktı", "fa-eye", "ms-metin-turuncu", null));
        }
        return liste;
    }

    // Alan 2/3 satırı — tasarım markup'ı (ms-urun-teslimat / ms-urun-kargo); tek satır SSR,
    // kalan öğeler data-ms-mesaj-rotasyon JSON'unda (JS her adette döndürür — CSS'in sabit
    // 3'lü/5'li keyframe'lerine bağlı değil).
    void AlanSatirBas(int slot, string pSinif, string gecisSinif)
    {
        if (u is null)
        {
            if (kartAyar.Alan(slot).Acik)
            {
                <p class="@pSinif" data-ms-kart-alan="@slot" hidden><span class="ms-urun-mesaj-gecis @gecisSinif" data-ms-mesaj-rotasyon=""></span></p>
            }
            return;
        }
        var ogeler = AlanSatirOgeleri(slot);
        if (ogeler.Count == 0) { return; }
        var ilk = ogeler[0];
        <p class="@pSinif" data-ms-kart-alan="@slot">
            <span class="ms-urun-mesaj-gecis @gecisSinif"
                  data-ms-mesaj-rotasyon="@System.Text.Json.JsonSerializer.Serialize(ogeler.Select(o => new { metin = o.Metin, ikon = o.Ikon, sinif = o.Sinif, renk = o.Renk }))"
                  aria-label="@string.Join(", ", ogeler.Select(o => o.Metin))">
                <span class="ms-urun-mesaj-satiri">
                    <i class="fa-solid @ilk.Ikon ms-fa-ikon ms-urun-mini-ikon" aria-hidden="true"></i>
                    <span class="@ilk.Sinif" style="@(ilk.Renk is { Length: > 0 } ? $"color:{ilk.Renk}" : "")">@ilk.Metin</span>
                </span>
            </span>
        </p>
    }
}
<div class="ms-urun-karti" data-ms-kart-link-alani
     data-ms-urun-id="@(u?.Kod ?? "")"
     data-ms-urun-kod="@(u?.Kod ?? "")"
     data-ms-secili-renk="@(u?.SeciliRenkId?.ToString() ?? "")"
     data-ms-fiyat="@(u?.Fiyat.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
     data-ms-eski-fiyat="@(u?.EskiFiyat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
     data-ms-kampanya-ad="@(u?.KampanyaAdi ?? "")"
     data-ms-kampanya-fiyat="@(u is not null && u.KampanyaFiyatVar ? u.KampanyaFiyat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
     data-ms-degerler="@(u is null ? "" : string.Join(",", u.DegerIdler))"
     data-ms-bedenler="@(u?.BedenlerJson ?? "")"
     data-ms-dolu="@(u is null ? "" : "true")">
    <a class="ms-urun-kart-baglanti" href="@(u?.Url ?? "#")" data-ms-kart-link aria-label="@(u?.Ad ?? "Ürün") ürün detayına git"></a>
    <div class="ms-urun-gorsel-alani" data-ms-urun-galeri data-ms-urun-galeri-resimler="@(u?.GaleriResimleri ?? "")">
        @if (u?.GorselUrl is not null)
        {
            <img class="ms-urun-gorsel" data-ms-urun-galeri-gorsel data-ms-lazy-src="@u.GorselUrl" data-ms-lazy-srcset="@kartSrcset" data-ms-lazy-sizes="@(kartSrcset is null ? null : kartSizes)" data-ms-lazy-skeleton="true" alt="@u.Ad" loading="lazy" decoding="async" width="240" height="320">
        }
        else if (u is not null)
        {
            @* Görselsiz ürün: no-image placeholder (site geneli kuralı, 2026-07-17) *@
            <img class="ms-urun-gorsel" data-ms-urun-galeri-gorsel data-ms-no-image="true" src="/images/no-image.svg" alt="@u.Ad" loading="lazy" decoding="async" width="240" height="320">
        }
        else
        {
            <img class="ms-urun-gorsel" data-ms-urun-galeri-gorsel data-ms-lazy-skeleton="true" alt="" loading="lazy" decoding="async" width="240" height="320">
        }
        @if (kartAyar.VideoRozeti && u?.VideoUrl is not null)
        {
            @* H5: Videolu Ürün rozeti — markup tasarımın kart örneğinden (hover tooltip
               videosu site.js data-ms-urun-video davranışıyla). Kampanya etiketi veri
               kaynağı gelene dek yok (Faz G). *@
            <span class="ms-urun-gorsel-etiketleri">
                <span class="ms-urun-video-alani" data-ms-urun-video>
                    <button class="ms-urun-video-rozeti" type="button" aria-expanded="false" aria-label="Videolu ürünü göster">
                        <i class="fa-solid fa-play ms-fa-ikon ms-urun-video-ikon" aria-hidden="true"></i>
                        Videolu Ürün
                    </button>
                    <span class="ms-urun-video-tooltip">
                        <video class="ms-urun-video" src="@u.VideoUrl" muted loop playsinline preload="none"></video>
                    </span>
                </span>
            </span>
        }
        @if (kartAyar.SponsorRozeti && u?.Sponsorlu == true)
        {
            @* B11: öne çıkar penceresi içindeki ürün (ChannelProduct.FeaturedFrom/Until) *@
            <span class="ms-urun-sponsor">Sponsorlu</span>
        }
        @if (kartAyar.FavoriButonu)
        {
        <button class="ms-urun-favori" type="button" aria-label="Favorilere ekle" aria-pressed="false">
            <img class="ms-urun-favori-ikon" src="/ikons/favorite.svg" alt="" aria-hidden="true" width="20" height="20" loading="lazy">
        </button>
        }
        @if (kartAyar.KoleksiyonButonu)
        {
        <button class="ms-urun-koleksiyon" type="button" aria-label="Koleksiyona ekle" aria-pressed="false" data-ms-urun-koleksiyon>
            <i class="fa-solid fa-bookmark ms-fa-ikon" aria-hidden="true"></i>
        </button>
        }
        @if (kartAyar.BenzerButonu)
        {
        @* Benzer ürünler (2026-08-14): ürünün ilk görseliyle görsel arama — aynı cinsiyet +
           ürün grubu filtresiyle sonuç listesi açılır. Şablon kartında href'i kartDoldur yazar. *@
        <a class="ms-urun-benzer" data-ms-urun-benzer aria-label="Benzer ürünleri göster" rel="nofollow"
           href="@(u is null ? "#" : "/benzer/" + u.Kod + (u.SeciliRenkId is { } benzerRenk ? "?renk=" + benzerRenk : ""))">
            <i class="fa-solid fa-layer-group ms-fa-ikon" aria-hidden="true"></i>
        </a>
        }
        @if (kartAyar.SepetButonu)
        {
        @* Kartta sepete ekle (2026-08-14): tıklanınca desktop'ta beden paneli, mobilde alt
           sayfa (bottom sheet) açılır. Davranış: _KartSepetDavranis.cshtml. *@
        <button class="ms-urun-sepet" type="button" aria-label="Sepete ekle" data-ms-urun-sepet>
            <i class="fa-solid fa-cart-shopping ms-fa-ikon" aria-hidden="true"></i>
        </button>
        }
        @* "Diğer renkler" rozeti — tasarım kaynağı (_UrunKartiOrnegi.cshtml) markup'ı BİREBİR:
           iki sabit dekoratif nokta + renk sayısı. Çok renkli her üründe gösterilir
           (tooltip ile aynı koşul: RenkSecenekleri >= 2). Yoruma/inline style'a girilmez. *@
        @if (kartAyar.RenkRozeti && u is not null && u.RenkSecenekleri.Count >= 2)
        {
            <button class="ms-urun-renk-rozet" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label="@u.RenkSayisi diğer renk seçeneğini göster">
                <span class="ms-urun-renkler" aria-hidden="true">
                    <span class="ms-urun-renk ms-urun-renk-mavi"></span>
                    <span class="ms-urun-renk ms-urun-renk-pembe"></span>
                </span>
                @u.RenkSayisi
            </button>
        }
        @if (kartAyar.GaleriNoktalari && u is not null && u.GaleriUrller.Count > 1)
        {
            @* B8: hover galeri nokta göstergeleri (site.js data-ms-urun-galeri modülü) *@
            <span class="ms-urun-slider-noktalari" aria-hidden="true">
                @for (var n = 0; n < u.GaleriUrller.Count; n++)
                {
                    <span class="@(n == 0 ? "ms-urun-slider-nokta-aktif" : "")"></span>
                }
            </span>
        }
    </div>
    @* F2 Alan 1: görsel altı bant — elle mesajlar + kampanya rozetleri (kanal ayarındaki
       öncelikle). Rozetler (ad+renk) data-ms-kampanya-rotasyon'da JSON taşınır; birden
       çoksa _Layout'taki script animasyonlu döndürür (renk = bant arka planı). *@
    @if (u is null)
    {
        if (kartAyar.Alan(1).Acik)
        {
            <div class="ms-urun-kampanya-bandi" data-ms-kart-kampanya-bandi hidden></div>
        }
    }
    else
    {
        var bantOgeleri = Alan1Ogeleri();
        if (bantOgeleri.Count > 0)
        {
            var ilkOge = bantOgeleri[0];
            <div class="ms-urun-kampanya-bandi"
                 data-ms-kampanya-rotasyon="@System.Text.Json.JsonSerializer.Serialize(bantOgeleri.Select(b => new { ad = b.Ad, renk = b.Renk }))"
                 style="@(ilkOge.Renk is { Length: > 0 } ? $"background-color:{ilkOge.Renk}" : "")">@ilkOge.Ad</div>
        }
    }
    @if (kartAyar.RenkRozeti && u is not null && u.RenkSecenekleri.Count >= 2)
    {
        @* B8: farklı renk seçenekleri tooltip'i — eksen renkleri kendi görselleri ve
           ?color= linkleriyle (ilk 4 desktop; tam liste mobil panel sınıfıyla) *@
        <div class="ms-urun-renk-tooltip-alani" role="dialog" aria-label="Ürünün diğer renkleri">
            <span class="ms-urun-renk-tooltip">
                <span class="ms-urun-renk-tooltip-baslik">
                    <span>Farklı Renk Seçenekleri <span class="ms-urun-renk-tooltip-sayac">(@u.RenkSecenekleri.Count)</span></span>
                    @if (u.RenkSecenekleri.Count > 4)
                    {
                        <span>+@(u.RenkSecenekleri.Count - 4) Renk <i class="fa-solid fa-chevron-right ms-fa-ikon" aria-hidden="true"></i></span>
                    }
                    <button class="ms-urun-renk-tooltip-kapat" type="button" data-ms-renk-tooltip-kapat aria-label="Renk seçeneklerini kapat"><i class="fa-solid fa-xmark ms-fa-ikon" aria-hidden="true"></i></button>
                </span>
                <span class="ms-urun-renk-tooltip-liste">
                    @foreach (var renk in u.RenkSecenekleri.Take(4))
                    {
                        <a class="ms-urun-renk-tooltip-gorsel @(renk.Stokta ? "" : "ms-urun-renk-tooltip-tukendi")" href="@u.UrlRenkli(renk.ValueId)"><img data-ms-lazy-src="@(renk.GorselUrl ?? u.GorselUrl)" alt="@renk.Ad renk seçeneği" width="90" height="134" loading="lazy" decoding="async"><span>@renk.Ad</span></a>
                    }
                    @foreach (var renk in u.RenkSecenekleri)
                    {
                        <a class="ms-urun-renk-tooltip-gorsel ms-urun-renk-tooltip-gorsel-mobil @(renk.Stokta ? "" : "ms-urun-renk-tooltip-tukendi")" href="@u.UrlRenkli(renk.ValueId)"><img data-ms-lazy-src="@(renk.GorselUrl ?? u.GorselUrl)" alt="@renk.Ad renk seçeneği" width="90" height="134" loading="lazy" decoding="async"><span>@renk.Ad</span></a>
                    }
                </span>
            </span>
        </div>
    }
    <div class="ms-urun-icerik">
        <h3 class="ms-urun-basligi"><strong>@adIlk</strong> @adKalan</h3>
        @* F2 Alan 2: ürün adı altı satır (tasarım ms-urun-teslimat markup'ı) *@
        @{ AlanSatirBas(2, "ms-urun-teslimat", "ms-urun-teslimat-gecis"); }
        @* E7: puan onaylı yorum ortalamasından (yorumsuz üründe bölüm yok — sıfır durumu);
           şablon kartında (u null) alan JS ile dolar. Kamera ikonu fotolu yorumla gelecek.
           F1: kapalıysa placeholder da basılmaz — kartDoldur elementi bulamayınca atlar. *@
        @if (kartAyar.Puan && u is null)
        {
            <div class="ms-urun-puan" data-ms-kart-puan hidden></div>
        }
        else if (kartAyar.Puan && u is not null && u.PuanSayisi > 0)
        {
            <div class="ms-urun-puan">
                <span>@u.Puan.ToString("0.0", tr)</span>
                <span class="ms-urun-yildizlar" aria-hidden="true">
                    @for (var y = 1; y <= 5; y++)
                    {
                        <i class="fa-@(y <= Math.Round(u.Puan, MidpointRounding.AwayFromZero) ? "solid" : "regular") fa-star ms-fa-ikon " aria-hidden="true"></i>
                    }
                </span>
                <span>(@u.PuanSayisi)</span>
            </div>
        }
        @* F2 Alan 3: puan altı satır (tasarım ms-urun-kargo markup'ı) *@
        @{ AlanSatirBas(3, "ms-urun-kargo", "ms-urun-kargo-gecis"); }
        @* Fiyat senaryoları (tasarım _UrunKartiOrnegi): güncel fiyat + varsa indirim rozeti ve
           üstü çizili eski fiyat (CompareAtPrice > Fiyat). Diğer senaryolar (Sepette/Plus/kampanya)
           veri kaynağı geldiğinde eklenir — "varsa yazdırılır" kuralı. *@
        <div class="ms-urun-fiyat-senaryolari">
            <p class="ms-urun-fiyat" data-ms-kart-fiyat>@(u is null ? "" : u.Fiyat.ToString("N2", tr) + " TL")</p>
            @if (kartAyar.IndirimSatiri && u is null)
            {
                <p class="ms-urun-fiyat-satiri" data-ms-kart-indirim-satiri hidden>
                    <span class="ms-urun-indirim-rozeti" data-ms-kart-indirim-rozet></span>
                    <span class="ms-urun-fiyat-eski" data-ms-kart-eski-fiyat></span>
                </p>
            }
            else if (kartAyar.IndirimSatiri && u?.IndirimYuzdesi is { } yuzde)
            {
                <p class="ms-urun-fiyat-satiri">
                    <span class="ms-urun-indirim-rozeti">-%@yuzde</span>
                    <span class="ms-urun-fiyat-eski">@u.EskiFiyat!.Value.ToString("N2", tr) TL</span>
                </p>
            }
            @* F3: kampanyalı fiyat (ürün-bazlı) — satış fiyatının altındaysa "İndirimli/Kampanyalı" satırı. *@
            @if (kartAyar.KampanyaFiyatSatiri && u is null)
            {
                <p class="ms-urun-fiyat-satiri ms-urun-fiyat-indirimli" data-ms-kart-kampanya-fiyat-satiri hidden>
                    <span data-ms-kart-kampanya-fiyat></span>
                </p>
            }
            else if (kartAyar.KampanyaFiyatSatiri && u?.KampanyaFiyatVar == true)
            {
                <p class="ms-urun-fiyat-satiri ms-urun-fiyat-indirimli">
                    <span>@u.KampanyaFiyat!.Value.ToString("N2", tr) TL</span>
                </p>
            }
        </div>
    </div>
</div>
