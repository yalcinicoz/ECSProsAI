@model ECSPros.Api.Models.Store.UrunKartVm
@{
    // Canlı ürün kartı — misharix _UrunKartiOrnegi component'inin veriye bağlı karşılığı.
    // B7'de _UrunListesiUrunAlani içinde local function'dı; B6'da ana sayfa carousel'leri de
    // aynı kartı kullandığı için paylaşılan partial'a alındı (tek kaynak). Model null ise
    // infinite-scroll <template> iskelet kartı üretilir (boş data-ms-* alanları JS doldurur).
    // Veri karşılığı olmayan demo blokları @if(false) ile gizli — B8/B11/Faz G'de bağlanacak.
    var u = Model;
    var tr = new System.Globalization.CultureInfo("tr-TR");
    var adParcalari = (u?.Ad ?? "").Split(' ', 2);
    var adIlk = adParcalari.Length > 0 ? adParcalari[0] : "";
    var adKalan = adParcalari.Length > 1 ? adParcalari[1] : "";
}
<div class="ms-urun-karti" data-ms-kart-link-alani
     data-ms-urun-id="@(u?.Kod ?? "")"
     data-ms-urun-kod="@(u?.Kod ?? "")"
     data-ms-secili-renk="@(u?.SeciliRenkId?.ToString() ?? "")"
     data-ms-fiyat="@(u?.Fiyat.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
     data-ms-degerler="@(u is null ? "" : string.Join(",", u.DegerIdler))"
     data-ms-dolu="@(u is null ? "" : "true")">
    <a class="ms-urun-kart-baglanti" href="@(u?.Url ?? "#")" data-ms-kart-link aria-label="@(u?.Ad ?? "Ürün") ürün detayına git"></a>
    <div class="ms-urun-gorsel-alani" data-ms-urun-galeri data-ms-urun-galeri-resimler="@(u?.GaleriResimleri ?? "")">
        @if (u?.GorselUrl is not null)
        {
            <img class="ms-urun-gorsel" data-ms-urun-galeri-gorsel data-ms-lazy-src="@u.GorselUrl" data-ms-lazy-skeleton="true" alt="@u.Ad" loading="lazy" decoding="async" width="240" height="320">
        }
        else if (u is not null)
        {
            @* Görselsiz ürün: no-image placeholder (site geneli kuralı, 2026-07-17) *@
            <img class="ms-urun-gorsel" data-ms-urun-galeri-gorsel data-ms-no-image="true" src="/images/no-image.svg" alt="@u.Ad" loading="lazy" decoding="async" width="240" height="320">
        }
        else
        {
            <img class="ms-urun-gorsel" data-ms-urun-galeri-gorsel data-ms-lazy-skeleton="true" alt="" loading="lazy" decoding="async" width="240" height="320">
        }
        @if (u?.VideoUrl is not null)
        {
            @* H5: Videolu Ürün rozeti — markup tasarımın kart örneğinden (hover tooltip
               videosu site.js data-ms-urun-video davranışıyla). Kampanya etiketi veri
               kaynağı gelene dek yok (Faz G). *@
            <span class="ms-urun-gorsel-etiketleri">
                <span class="ms-urun-video-alani" data-ms-urun-video>
                    <button class="ms-urun-video-rozeti" type="button" aria-expanded="false" aria-label="Videolu ürünü göster">
                        <i class="fa-solid fa-play ms-fa-ikon ms-urun-video-ikon" aria-hidden="true"></i>
                        Videolu Ürün
                    </button>
                    <span class="ms-urun-video-tooltip">
                        <video class="ms-urun-video" src="@u.VideoUrl" muted loop playsinline preload="none"></video>
                    </span>
                </span>
            </span>
        }
        @if (u?.Sponsorlu == true)
        {
            @* B11: öne çıkar penceresi içindeki ürün (ChannelProduct.FeaturedFrom/Until) *@
            <span class="ms-urun-sponsor">Sponsorlu</span>
        }
        <button class="ms-urun-favori" type="button" aria-label="Favorilere ekle" aria-pressed="false">
            <img class="ms-urun-favori-ikon" src="/ikons/favorite.svg" alt="" aria-hidden="true" width="20" height="20" loading="lazy">
        </button>
        <button class="ms-urun-koleksiyon" type="button" aria-label="Koleksiyona ekle" aria-pressed="false" data-ms-urun-koleksiyon>
            <i class="fa-solid fa-bookmark ms-fa-ikon" aria-hidden="true"></i>
        </button>
        @* "Diğer renkler" rozeti — tasarım kaynağı (_UrunKartiOrnegi.cshtml) markup'ı BİREBİR:
           iki sabit dekoratif nokta + renk sayısı. Çok renkli her üründe gösterilir
           (tooltip ile aynı koşul: RenkSecenekleri >= 2). Yoruma/inline style'a girilmez. *@
        @if (u is not null && u.RenkSecenekleri.Count >= 2)
        {
            <button class="ms-urun-renk-rozet" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label="@u.RenkSayisi diğer renk seçeneğini göster">
                <span class="ms-urun-renkler" aria-hidden="true">
                    <span class="ms-urun-renk ms-urun-renk-mavi"></span>
                    <span class="ms-urun-renk ms-urun-renk-pembe"></span>
                </span>
                @u.RenkSayisi
            </button>
        }
        @if (u is not null && u.GaleriUrller.Count > 1)
        {
            @* B8: hover galeri nokta göstergeleri (site.js data-ms-urun-galeri modülü) *@
            <span class="ms-urun-slider-noktalari" aria-hidden="true">
                @for (var n = 0; n < u.GaleriUrller.Count; n++)
                {
                    <span class="@(n == 0 ? "ms-urun-slider-nokta-aktif" : "")"></span>
                }
            </span>
        }
    </div>
    @if (false)
    {
        @* Faz G: kampanya bandı *@
        <div class="ms-urun-kampanya-bandi"></div>
    }
    @if (u is not null && u.RenkSecenekleri.Count >= 2)
    {
        @* B8: farklı renk seçenekleri tooltip'i — eksen renkleri kendi görselleri ve
           ?color= linkleriyle (ilk 4 desktop; tam liste mobil panel sınıfıyla) *@
        <div class="ms-urun-renk-tooltip-alani" role="dialog" aria-label="Ürünün diğer renkleri">
            <span class="ms-urun-renk-tooltip">
                <span class="ms-urun-renk-tooltip-baslik">
                    <span>Farklı Renk Seçenekleri <span class="ms-urun-renk-tooltip-sayac">(@u.RenkSecenekleri.Count)</span></span>
                    @if (u.RenkSecenekleri.Count > 4)
                    {
                        <span>+@(u.RenkSecenekleri.Count - 4) Renk <i class="fa-solid fa-chevron-right ms-fa-ikon" aria-hidden="true"></i></span>
                    }
                    <button class="ms-urun-renk-tooltip-kapat" type="button" data-ms-renk-tooltip-kapat aria-label="Renk seçeneklerini kapat"><i class="fa-solid fa-xmark ms-fa-ikon" aria-hidden="true"></i></button>
                </span>
                <span class="ms-urun-renk-tooltip-liste">
                    @foreach (var renk in u.RenkSecenekleri.Take(4))
                    {
                        <a class="ms-urun-renk-tooltip-gorsel" href="@u.UrlRenkli(renk.ValueId)"><img data-ms-lazy-src="@(renk.GorselUrl ?? u.GorselUrl)" alt="@renk.Ad renk seçeneği" width="90" height="134" loading="lazy" decoding="async"><span>@renk.Ad</span></a>
                    }
                    @foreach (var renk in u.RenkSecenekleri)
                    {
                        <a class="ms-urun-renk-tooltip-gorsel ms-urun-renk-tooltip-gorsel-mobil" href="@u.UrlRenkli(renk.ValueId)"><img data-ms-lazy-src="@(renk.GorselUrl ?? u.GorselUrl)" alt="@renk.Ad renk seçeneği" width="90" height="134" loading="lazy" decoding="async"><span>@renk.Ad</span></a>
                    }
                </span>
            </span>
        </div>
    }
    <div class="ms-urun-icerik">
        <h3 class="ms-urun-basligi"><strong>@adIlk</strong> @adKalan</h3>
        @if (false)
        {
            @* B8: teslimat/favori mesajları ve kargo mesajları — model alanları gelince *@
            <p class="ms-urun-teslimat"></p>
            <p class="ms-urun-kargo"></p>
        }
        @* E7: puan onaylı yorum ortalamasından (yorumsuz üründe bölüm yok — sıfır durumu);
           şablon kartında (u null) alan JS ile dolar. Kamera ikonu fotolu yorumla gelecek. *@
        @if (u is null)
        {
            <div class="ms-urun-puan" data-ms-kart-puan hidden></div>
        }
        else if (u.PuanSayisi > 0)
        {
            <div class="ms-urun-puan">
                <span>@u.Puan.ToString("0.0", tr)</span>
                <span class="ms-urun-yildizlar" aria-hidden="true">
                    @for (var y = 1; y <= 5; y++)
                    {
                        <i class="fa-@(y <= Math.Round(u.Puan, MidpointRounding.AwayFromZero) ? "solid" : "regular") fa-star ms-fa-ikon " aria-hidden="true"></i>
                    }
                </span>
                <span>(@u.PuanSayisi)</span>
            </div>
        }
        <p class="ms-urun-fiyat">@(u is null ? "" : u.Fiyat.ToString("N2", tr) + " TL")</p>
    </div>
</div>
