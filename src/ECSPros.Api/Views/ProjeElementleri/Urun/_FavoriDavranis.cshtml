@* E5: favori kalplerinin API bağlaması (İZİNLİ YENİ — kaynakta karşılığı yok; görsel
   toggle/animasyon misharix site.js'te). Capture-phase dinleyici: misafirde site.js
   toggle'ı ENGELLENİR ve giriş modalı açılır; üyede site.js görseli yönetir, burada
   POST/DELETE atılır. Kart kodu data-ms-urun-kod'dan (JS dolan kartlarda link href'inden),
   detayda URL'den, sepette satırın data'sından. Sayfa yüklenince GET favorites ile
   işaretlenir; sonradan eklenen kartlar (infinite) MutationObserver ile işaretlenir. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const platformId = document.querySelector("[data-ms-arama]")?.dataset.msAramaPlatform || "";
    if (!platformId) { return; }
    const token = () => localStorage.getItem("ecspros_member_token");
    // 2026-07-16: favori anahtarı ürün+renk — "kod|renkId" (renksiz: "kod|").
    // Bir rengin kalbi diğer renk kartlarını işaretlemez.
    const favoriKodlar = new Set();
    window.msFavoriKodlar = favoriKodlar;
    const favoriAnahtar = (kod, renk) => kod + "|" + (renk || "");
    window.msFavoriAnahtar = favoriAnahtar;
    // E6: kart/detay bookmark'ı "Kaydedilenler" hızlı koleksiyonuyla çalışır
    const kayitliKodlar = new Set();

    const kodBul = (buton) => {
        const kart = buton.closest("[data-ms-urun-kod]");
        if (kart?.dataset.msUrunKod) { return kart.dataset.msUrunKod; }
        const link = buton.closest("[data-ms-kart-link-alani]")?.querySelector("[data-ms-kart-link]");
        const eslesme = link?.getAttribute("href")?.match(/\/urun\/([^/?#]+)/);
        if (eslesme) { return decodeURIComponent(eslesme[1]); }
        return detayKod();
    };

    // B-014 (kabul testi 2026-07-22): detay sayfaları slug URL'inde render edilir (2b) —
    // /urun/{kod} regex'i orada TUTMAZ; detay ürün kodu config'teki urunKod'dan çözülür.
    const detayKod = () => {
        const detay = location.pathname.match(/^\/urun\/([^/?#]+)/);
        if (detay) { return decodeURIComponent(detay[1]); }
        return detayConfig()?.urunKod || null;
    };

    const detayConfig = () => {
        try { return JSON.parse(document.getElementById("ms-urun-detay-config")?.textContent || "null"); }
        catch { return null; }
    };

    const renkBul = (buton) => {
        const kart = buton.closest("[data-ms-secili-renk]");
        if (kart) { return kart.dataset.msSeciliRenk || null; }
        if (buton.matches(".ms-urun-detay-favori, .ms-urun-detay-koleksiyon")) {
            return detayConfig()?.seciliRenk || null;
        }
        return null;
    };

    const kartIsaretle = (kok) => {
        kok.querySelectorAll(".ms-urun-karti .ms-urun-favori").forEach((buton) => {
            const kod = kodBul(buton);
            const aktif = !!kod && favoriKodlar.has(favoriAnahtar(kod, renkBul(buton)));
            if (aktif === buton.classList.contains("ms-urun-favori-aktif")) { return; }
            buton.classList.toggle("ms-urun-favori-aktif", aktif);
            buton.setAttribute("aria-pressed", aktif.toString());
            buton.setAttribute("aria-label", aktif ? "Favorilerden çıkar" : "Favorilere ekle");
            const ikon = buton.querySelector(".ms-urun-favori-ikon");
            if (ikon) { ikon.src = aktif ? "/ikons/kalp.svg" : "/ikons/favorite.svg"; }
        });
        // E6: bookmark işaretleme (Kaydedilenler içeriğinden)
        kok.querySelectorAll(".ms-urun-karti [data-ms-urun-koleksiyon]").forEach((buton) => {
            const kod = kodBul(buton);
            const aktif = !!kod && kayitliKodlar.has(kod);
            if (aktif === buton.classList.contains("ms-urun-koleksiyon-aktif")) { return; }
            buton.classList.toggle("ms-urun-koleksiyon-aktif", aktif);
            buton.setAttribute("aria-pressed", aktif.toString());
            buton.setAttribute("aria-label", aktif ? "Koleksiyondan çıkar" : "Koleksiyona ekle");
        });
    };

    const detayIsaretle = () => {
        const kod = detayKod();
        if (!kod) { return; }
        // Kabul testi 2026-07-22: detay koleksiyon butonu açılışta işaretlenmiyordu —
        // ekleme başarılı olsa da yenileyince ikon pasif görünüyordu.
        if (kayitliKodlar.has(kod)) {
            document.querySelectorAll(".ms-urun-detay-koleksiyon, [data-ms-urun-detay-koleksiyon]").forEach((buton) => {
                buton.classList.add("ms-urun-detay-koleksiyon-aktif");
                buton.setAttribute("aria-pressed", "true");
                buton.setAttribute("aria-label", "Koleksiyondan çıkar");
            });
        }
        const detayRenk = detayConfig()?.seciliRenk || null;
        if (!favoriKodlar.has(favoriAnahtar(kod, detayRenk))) { return; }
        document.querySelectorAll(".ms-urun-detay-favori").forEach((buton) => {
            buton.setAttribute("aria-pressed", "true");
            buton.setAttribute("aria-label", "Favorilerden çıkar");
            const ikon = buton.querySelector(".ms-urun-detay-favori-ikon");
            if (ikon) { ikon.src = "/ikons/kalp.svg"; }
        });
    };

    const sepetIsaretle = (buton, aktif) => {
        buton.classList.toggle("ms-sepet-ikon-buton-aktif", aktif);
        buton.setAttribute("aria-pressed", aktif.toString());
        buton.setAttribute("aria-label", aktif ? "Favorilerden çıkar" : "Favorilere ekle");
        const ikon = buton.querySelector("img");
        if (ikon) { ikon.src = aktif ? "/ikons/kalp.svg" : "/ikons/favorite.svg"; }
    };
    window.msSepetFavoriIsaretle = sepetIsaretle;

    const yukle = async () => {
        if (!token()) { return; }
        try {
            const cevap = await fetch("/api/store/favorites?firmPlatformId=" + platformId, {
                headers: { Authorization: "Bearer " + token() }
            });
            const veri = await cevap.json().catch(() => null);
            if (!veri?.success) { return; }
            veri.data.forEach((f) => favoriKodlar.add(
                typeof f === "string" ? favoriAnahtar(f, null) : favoriAnahtar(f.productCode, f.colorValueId)));

            // E6: Kaydedilenler koleksiyonu — bookmark işaretleme seti
            try {
                const kcevap = await fetch("/api/store/collections?firmPlatformId=" + platformId, {
                    headers: { Authorization: "Bearer " + token() }
                });
                const kveri = await kcevap.json().catch(() => null);
                // 2026-07-16: bookmark işaretlemesi üyenin TÜM koleksiyonlarındaki ürünlere göre
                (kveri?.data || [])
                    .forEach((k) => (k.itemCodes || []).forEach((kod) => kayitliKodlar.add(kod)));
            } catch { /* bookmark işaretlemesi yapılamadı */ }

            kartIsaretle(document);
            detayIsaretle();
            document.querySelectorAll("[data-ms-sepet-favori]").forEach((buton) => {
                const kod = buton.closest("[data-ms-urun-kod]")?.dataset.msUrunKod;
                if (kod && favoriKodlar.has(favoriAnahtar(kod, null))) { sepetIsaretle(buton, true); }
            });
            document.dispatchEvent(new CustomEvent("ms:favoriler-yuklendi"));
        } catch { /* işaretleme yapılamadı — kalpler pasif başlar */ }
    };

    const kaydet = async (kod, renk, ekle) => {
        try {
            if (ekle) {
                favoriKodlar.add(favoriAnahtar(kod, renk));
                await fetch("/api/store/favorites", {
                    method: "POST",
                    headers: { "Content-Type": "application/json", Authorization: "Bearer " + token() },
                    body: JSON.stringify({ firmPlatformId: platformId, productCode: kod, colorValueId: renk || null })
                });
            } else {
                favoriKodlar.delete(favoriAnahtar(kod, renk));
                await fetch(`/api/store/favorites/${encodeURIComponent(kod)}?firmPlatformId=${platformId}`
                    + (renk ? `&colorValueId=${encodeURIComponent(renk)}` : ""), {
                    method: "DELETE",
                    headers: { Authorization: "Bearer " + token() }
                });
            }
        } catch { /* ağ hatası — bir sonraki yüklemede gerçek durum işaretlenir */ }
    };

    // Capture: misafirde site.js toggle'ından ÖNCE yakalanıp giriş modalına yönlendirilir;
    // üyede yeni durum = mevcutun tersi (site.js bubble'da toggle'lar).
    // E6: bookmark toggle — Kaydedilenler hızlı koleksiyonuna ekle/çıkar
    const kayitliKaydet = async (kod, ekle) => {
        try {
            if (ekle) { kayitliKodlar.add(kod); } else { kayitliKodlar.delete(kod); }
            await fetch("/api/store/collections/saved/toggle", {
                method: "POST",
                headers: { "Content-Type": "application/json", Authorization: "Bearer " + token() },
                body: JSON.stringify({ firmPlatformId: platformId, productCode: kod, add: ekle })
            });
        } catch { /* ağ hatası — bir sonraki yüklemede gerçek durum işaretlenir */ }
    };

    document.addEventListener("click", (olay) => {
        const buton = olay.target.closest(
            ".ms-urun-karti .ms-urun-favori, .ms-urun-detay-favori, [data-ms-sepet-favori],"
            + " .ms-urun-karti [data-ms-urun-koleksiyon], .ms-urun-detay-koleksiyon");
        if (!buton) { return; }

        if (!token()) {
            olay.preventDefault();
            olay.stopPropagation();
            // Kabul testi 2026-07-22: misafirin favori niyeti saklanır — girişten sonra
            // otomatik uygulanır (kullanıcı tekrar tıklamak zorunda kalmıyordu ama kalp
            // boş kalınca "eklenmedi" sanıyordu). Koleksiyon akışı modal gerektirdiğinden
            // niyet yalnız favori için taşınır.
            const bekleyenKod = kodBul(buton);
            if (bekleyenKod && !buton.matches("[data-ms-urun-koleksiyon], .ms-urun-detay-koleksiyon")) {
                try { sessionStorage.setItem("ms-bekleyen-favori",
                    JSON.stringify({ kod: bekleyenKod, renk: renkBul(buton) })); } catch { }
            }
            document.querySelector("[data-ms-giris-modal-ac]")?.click();
            return;
        }

        const kod = kodBul(buton);
        if (!kod) { return; }
        const koleksiyonMu = buton.matches("[data-ms-urun-koleksiyon], .ms-urun-detay-koleksiyon");
        const aktifti = buton.classList.contains("ms-urun-favori-aktif")
            || buton.classList.contains("ms-urun-koleksiyon-aktif")
            || buton.classList.contains("ms-sepet-ikon-buton-aktif")
            || buton.getAttribute("aria-pressed") === "true";
        if (buton.matches("[data-ms-sepet-favori]")) {
            sepetIsaretle(buton, !aktifti); // sepet satırları dinamik — görsel toggle burada
        }
        // 2026-07-16: koleksiyon butonu artık sessiz quick-save YAPMAZ — site.js'in ortak
        // "Koleksiyona Ekle" modal akışı açılır, kayıt köprü script'inden (gerçek API) yapılır.
        if (!koleksiyonMu) { kaydet(kod, renkBul(buton), !aktifti); }
    }, true);

    // Sonradan eklenen kartlar (infinite scroll şablon kartları)
    new MutationObserver(() => kartIsaretle(document)).observe(document.body, { childList: true, subtree: true });

    // Kabul testi 2026-07-22: girişten sonra işaretler tazelenir + misafirken saklanan
    // favori niyeti otomatik uygulanır (kalp dolu gelir, ürün Favorilerim'e düşer).
    document.addEventListener("ms:uye-giris", async () => {
        if (!token()) { return; }
        let bekleyen = null;
        try { bekleyen = JSON.parse(sessionStorage.getItem("ms-bekleyen-favori") || "null"); } catch { }
        sessionStorage.removeItem("ms-bekleyen-favori");
        if (bekleyen?.kod) { await kaydet(bekleyen.kod, bekleyen.renk || null, true); }
        await yukle();
    });

    yukle();
});
</script>
