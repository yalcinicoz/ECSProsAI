<div class="ms-ornek-modal ms-siparis-kupon-modal" data-ms-kupon-modal aria-hidden="true">
    <div class="ms-ornek-modal-kaplama" data-ms-kupon-modal-kapat></div>
    <section class="ms-ornek-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-sepet-kupon-modal-baslik">
        <button class="ms-ornek-modal-kapat" type="button" data-ms-kupon-modal-kapat aria-label="Kuponlarım modalını kapat">×</button>
        <h3 id="ms-sepet-kupon-modal-baslik" class="ms-ornek-modal-baslik">Kuponlarım</h3>
        <p class="ms-ornek-modal-aciklama">Sepette kullanabileceğiniz kuponları bu alanda görüntüleyebilirsiniz.</p>

        @* E9: kartlar üyenin kupon listesinden (GET /api/store/account/coupons) JS ile
           dolar; demo kart şablona çevrildi. Misafirde/kupon yokken boş durum görünür. *@
        <div class="ms-siparis-kupon-modal-icerik" data-ms-kupon-modal-icerik>
            <template data-ms-kupon-kart-sablon>
            <section class="ms-siparis-kupon-karti">
                <div>
                    <strong data-ms-kupon-kart-baslik></strong>
                    <span data-ms-kupon-kart-aciklama></span>
                </div>
                <button class="ms-buton ms-buton-s ms-buton-satin-al" type="button" data-ms-kupon-kart-kullan>Kullan</button>
            </section>
            </template>

            <section class="ms-siparis-kupon-bos-durum" data-ms-kupon-bos-durum>
                <h4>Kupon Bulunmuyor</h4>
                <p>Henüz kullanılabilir kuponunuz bulunmuyor. Kampanyalarımızı takip ederek avantajlı fırsatları kaçırmayın!</p>
            </section>
        </div>
    </section>
</div>

<div class="ms-ornek-modal ms-siparis-sozlesme-modal" data-ms-sozlesme-modal aria-hidden="true">
    <div class="ms-ornek-modal-kaplama" data-ms-sozlesme-modal-kapat></div>
    <section class="ms-ornek-modal-kutu ms-siparis-sozlesme-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-sepet-sozlesme-modal-baslik">
        <button class="ms-ornek-modal-kapat" type="button" data-ms-sozlesme-modal-kapat aria-label="Sözleşme bilgilendirme modalını kapat">×</button>
        <h3 id="ms-sepet-sozlesme-modal-baslik" class="ms-ornek-modal-baslik">Mesafeli Satış Sözleşmesi ve Ön Bilgilendirme</h3>
        <p class="ms-ornek-modal-aciklama">Siparişi tamamlamadan önce satış, teslimat, ödeme, cayma hakkı ve kişisel veri bilgilendirme koşullarını okuyup onaylamanız gerekir.</p>

        @{
            // C8: belge içerikleri CMS legal sayfalarından (SepetController → ViewData;
            // demo ELDİ TEKSTİL metinleri CMS seed'ine taşındı). Panel markup'ı birebir korunur.
            var msSozlesmeler = ViewData["MsSozlesmeler"] as List<ECSPros.Cms.Application.Queries.GetStoreLegalPages.StoreLegalPageDto> ?? new();
            var msModalBelgeKodlari = new[] { "mesafeli-satis-sozlesmesi", "on-bilgilendirme-formu" };
            var msModalBelgeleri = msModalBelgeKodlari
                .Select(kod => msSozlesmeler.FirstOrDefault(s => s.Code == kod))
                .Where(s => s != null).Select(s => s!).ToList();
        }
        <div class="ms-siparis-sozlesme-belgeler" data-ms-sozlesme-kodlar="@string.Join(",", msModalBelgeleri.Select(b => b.Code))">
            @foreach (var belge in msModalBelgeleri)
            {
            <section class="ms-siparis-sozlesme-belge-paneli">
                <h4>@belge.Title</h4>
                <div class="ms-siparis-sozlesme-belge">
                    @Html.Raw(belge.BodyHtml)
                </div>
            </section>
            }
            @if (msModalBelgeleri.Count == 0)
            {
            <section class="ms-siparis-sozlesme-belge-paneli">
                <h4>Sözleşme Metinleri</h4>
                <div class="ms-siparis-sozlesme-belge">
                    <p>Sözleşme metinleri şu anda görüntülenemiyor. Lütfen daha sonra tekrar deneyin veya müşteri hizmetleriyle iletişime geçin.</p>
                </div>
            </section>
            }
        </div>

        <div class="ms-ornek-modal-aksiyonlar">
            <button class="ms-buton ms-buton-m ms-buton-sade" type="button" data-ms-sozlesme-modal-kapat>Vazgeç</button>
            <button class="ms-buton ms-buton-m ms-buton-satin-al" type="button" data-ms-sozlesme-onayla>Okudum ve Onaylıyorum</button>
        </div>
    </section>
</div>

<div class="ms-ornek-modal ms-tckn-dogrulama-modal" data-ms-tckn-modal aria-hidden="true">
    <div class="ms-ornek-modal-kaplama" data-ms-tckn-modal-kapat></div>
    <section class="ms-ornek-modal-kutu ms-ornek-modal-kutu-uyari ms-ornek-modal-boyut-xl" role="dialog" aria-modal="true" aria-labelledby="ms-sepet-tckn-modal-baslik">
        <button class="ms-ornek-modal-kapat" type="button" data-ms-tckn-modal-kapat aria-label="TCKN doğrulama modalını kapat">×</button>
        <h3 id="ms-sepet-tckn-modal-baslik" class="ms-ornek-modal-baslik">TCKN Doğrulama</h3>
        <p class="ms-ornek-modal-aciklama">Sipariş tutarınız 13.000 TL üzeri olduğu için kimlik doğrulama bilgisini kontrol etmeniz gerekiyor.</p>

        <div class="ms-tckn-dogrulama-formu">
            <div class="ms-tckn-form-grid">
                <label class="ms-form-alani">
                    <span class="ms-form-etiket">T.C. Kimlik Numarası</span>
                    <input class="ms-form-girdi" type="text" inputmode="numeric" maxlength="11" placeholder="11 haneli TCKN" data-ms-tckn-girdi data-ms-tckn-zorunlu data-ms-tckn-etiket="TCKN">
                    <span class="ms-form-hata" data-ms-tckn-hata hidden>TCKN zorunludur.</span>
                </label>
                <label class="ms-form-alani">
                    <span class="ms-form-etiket">Ad</span>
                    <input class="ms-form-girdi" type="text" placeholder="Adınızı yazın" autocomplete="given-name" data-ms-tckn-zorunlu data-ms-tckn-etiket="Ad">
                    <span class="ms-form-hata" data-ms-tckn-hata hidden>Ad zorunludur.</span>
                </label>
                <label class="ms-form-alani">
                    <span class="ms-form-etiket">Soyad</span>
                    <input class="ms-form-girdi" type="text" placeholder="Soyadınızı yazın" autocomplete="family-name" data-ms-tckn-zorunlu data-ms-tckn-etiket="Soyad">
                    <span class="ms-form-hata" data-ms-tckn-hata hidden>Soyad zorunludur.</span>
                </label>
                <label class="ms-form-alani">
                    <span class="ms-form-etiket">Doğum Tarihi</span>
                    <input class="ms-form-girdi" type="date" autocomplete="bday" data-ms-tckn-zorunlu data-ms-tckn-etiket="Doğum tarihi">
                    <span class="ms-form-hata" data-ms-tckn-hata hidden>Doğum tarihi zorunludur.</span>
                </label>
            </div>
            <div class="ms-tckn-durum-listesi" aria-live="polite">
                <span class="ms-tckn-durum ms-tckn-durum-bekliyor" data-ms-tckn-durum-bekliyor>Doğrulama bekleniyor</span>
                <span class="ms-tckn-durum ms-tckn-durum-basarili ms-gizli" data-ms-tckn-durum-basarili>Doğrulandı</span>
                <span class="ms-tckn-durum ms-tckn-durum-hata ms-gizli" data-ms-tckn-durum-hata>Doğrulanmadı</span>
            </div>
            <p class="ms-tckn-yardim-metni">TCKN yalnızca sipariş doğrulama süreci için kullanılacaktır.</p>
        </div>

        <div class="ms-ornek-modal-aksiyonlar">
            <button class="ms-buton ms-buton-m ms-buton-sade" type="button" data-ms-tckn-modal-kapat>Vazgeç</button>
            <button class="ms-buton ms-buton-m ms-buton-uyari" type="button" data-ms-tckn-dogrula>Doğrula</button>
        </div>
    </section>
</div>

<div class="ms-ornek-modal" data-ms-sepet-sil-modal aria-hidden="true">
    <div class="ms-ornek-modal-kaplama" data-ms-sepet-sil-modal-kapat></div>
    <section class="ms-ornek-modal-kutu ms-ornek-modal-kutu-hata" role="dialog" aria-modal="true" aria-labelledby="ms-sepet-sil-modal-baslik">
        <button class="ms-ornek-modal-kapat" type="button" data-ms-sepet-sil-modal-kapat aria-label="Sepetten çıkarma modalını kapat">×</button>
        <h3 id="ms-sepet-sil-modal-baslik" class="ms-ornek-modal-baslik">Ürünü Sepetten Çıkar</h3>
        <p class="ms-ornek-modal-aciklama" data-ms-sepet-sil-modal-aciklama>Bu ürün sepetinizden çıkarılacak. Emin misiniz?</p>
        <div class="ms-ornek-modal-aksiyonlar">
            <button class="ms-buton ms-buton-m ms-buton-sade" type="button" data-ms-sepet-sil-modal-kapat>Vazgeç</button>
            <button class="ms-buton ms-buton-m ms-buton-tehlikeli" type="button" data-ms-sepet-sil-onayla>Sepetten Çıkar</button>
        </div>
    </section>
</div>

<script>
    (() => {
        const modalAc = (modal, odakSecici) => {
            if (!modal) {
                return;
            }

            modal.classList.add("ms-ornek-modal-acik");
            modal.setAttribute("aria-hidden", "false");
            window.setTimeout(() => modal.querySelector(odakSecici || "button")?.focus(), 30);
        };

        const modalKapat = (modal) => {
            modal?.classList.remove("ms-ornek-modal-acik");
            modal?.setAttribute("aria-hidden", "true");
        };

        const kuponModal = document.querySelector("[data-ms-kupon-modal]");
        const sozlesmeModal = document.querySelector("[data-ms-sozlesme-modal]");
        const sepetSilModal = document.querySelector("[data-ms-sepet-sil-modal]");
        const sepetSilModalAciklama = sepetSilModal?.querySelector("[data-ms-sepet-sil-modal-aciklama]");
        let sozlesmeHedefCheckbox = null;
        let sepetSilHedef = null;

        window.msKuponModalAc = () => modalAc(kuponModal, "[data-ms-kupon-modal-kapat]");

        // E9: sepetteki "Kuponlarım" butonu — üyenin kuponları çekilip modal doldurulur.
        // "Kullan" kupon kodunu sepetteki alana yazıp mevcut Uygula akışını tetikler
        // (doğrulama/uygulama C3 script'inde tek yerden). Misafirde/kupon yokken boş durum.
        const kuponKartlariniDoldur = (kuponlar) => {
            const icerik = kuponModal?.querySelector("[data-ms-kupon-modal-icerik]");
            const sablon = icerik?.querySelector("[data-ms-kupon-kart-sablon]");
            const bosDurum = icerik?.querySelector("[data-ms-kupon-bos-durum]");

            if (!icerik || !sablon || !bosDurum) {
                return;
            }

            icerik.querySelectorAll(".ms-siparis-kupon-karti").forEach((kart) => kart.remove());
            bosDurum.hidden = kuponlar.length > 0;

            kuponlar.forEach((kupon) => {
                const kart = sablon.content.firstElementChild.cloneNode(true);
                const kosullar = [];

                if (kupon.minimumCartTotal) {
                    kosullar.push(`${kupon.minimumCartTotal.toLocaleString("tr-TR", { minimumFractionDigits: 2 })} TL ve üzeri sepette geçerli.`);
                }

                if (kupon.validForFirstOrderOnly) {
                    kosullar.push("Yalnızca ilk siparişte geçerli.");
                }

                if (kupon.endsAt) {
                    kosullar.push(`Son kullanım: ${new Date(kupon.endsAt).toLocaleDateString("tr-TR")}`);
                }

                kart.querySelector("[data-ms-kupon-kart-baslik]").textContent = `${kupon.code} · ${kupon.discountText}`;
                kart.querySelector("[data-ms-kupon-kart-aciklama]").textContent = kosullar.join(" ") || "Sepette kullanılabilir.";
                kart.querySelector("[data-ms-kupon-kart-kullan]").addEventListener("click", () => {
                    const kodInput = document.querySelector("[data-ms-kupon-kodu]");

                    if (kodInput) {
                        kodInput.value = kupon.code;
                    }

                    document.querySelector("[data-ms-kupon-uygula]")?.click();
                    modalKapat(kuponModal);
                });

                icerik.insertBefore(kart, bosDurum);
            });
        };

        // delegation: bu partial sayfa başında include edilir — buton henüz parse edilmedi
        document.addEventListener("click", async (olay) => {
            if (!olay.target.closest("[data-ms-kupon-modal-ac]")) {
                return;
            }

            let kuponlar = [];
            const token = localStorage.getItem("ecspros_member_token");

            if (token) {
                try {
                    const cevap = await fetch("/api/store/account/coupons",
                        { headers: { Authorization: "Bearer " + token } });
                    const veri = await cevap.json().catch(() => null);
                    kuponlar = veri?.success ? (veri.data || []) : [];
                } catch { /* liste alınamazsa boş durum gösterilir */ }
            }

            kuponKartlariniDoldur(kuponlar);
            window.msKuponModalAc();
        });

        window.msSozlesmeModalAc = (checkbox) => {
            sozlesmeHedefCheckbox = checkbox || null;
            modalAc(sozlesmeModal, "[data-ms-sozlesme-onayla]");
        };

        document.querySelectorAll("[data-ms-kupon-modal-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => modalKapat(kapatici.closest("[data-ms-kupon-modal]")));
        });

        document.querySelectorAll("[data-ms-sozlesme-modal-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => {
                if (sozlesmeHedefCheckbox) {
                    sozlesmeHedefCheckbox.checked = false;
                }

                modalKapat(kapatici.closest("[data-ms-sozlesme-modal]"));
            });
        });

        document.querySelector("[data-ms-sozlesme-onayla]")?.addEventListener("click", () => {
            if (sozlesmeHedefCheckbox) {
                sozlesmeHedefCheckbox.checked = true;
            }

            modalKapat(sozlesmeModal);
        });

        window.msSepetSilModalAc = (hedef, aciklama) => {
            sepetSilHedef = hedef || null;

            if (sepetSilModalAciklama && aciklama) {
                sepetSilModalAciklama.textContent = aciklama;
            }

            modalAc(sepetSilModal, "[data-ms-sepet-sil-modal-kapat]");
        };

        document.querySelectorAll("[data-ms-sepet-sil-modal-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => {
                sepetSilHedef = null;
                modalKapat(kapatici.closest("[data-ms-sepet-sil-modal]"));
            });
        });

        document.querySelector("[data-ms-sepet-sil-onayla]")?.addEventListener("click", () => {
            sepetSilHedef?.remove?.();
            sepetSilHedef = null;
            modalKapat(sepetSilModal);
        });
    })();
</script>

@* C7 (K9): Canlı TCKN doğrulama — modal davranışı + kontrol basamağı algoritması client'ta,
   kayıt POST /api/store/account/identity ile sunucuda (aynı algoritma orada da doğrular;
   NVİ/KPS ileride). Başarıda window.msTcknDogrulandi=true + "ms:tckn-dogrulandi" event'i
   (sepet banner'ı ve ödeme guard'ı dinler). Sayfa açılışında üyenin me kaydından yüklenir. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const modal = document.querySelector("[data-ms-tckn-modal]");
    if (!modal) { return; }
    const girdi = modal.querySelector("[data-ms-tckn-girdi]");
    const zorunlular = [...modal.querySelectorAll("[data-ms-tckn-zorunlu]")];
    const durumlar = {
        bekliyor: modal.querySelector("[data-ms-tckn-durum-bekliyor]"),
        basarili: modal.querySelector("[data-ms-tckn-durum-basarili]"),
        hata: modal.querySelector("[data-ms-tckn-durum-hata]"),
    };
    const token = () => localStorage.getItem("ecspros_member_token");

    const durumGoster = (ad) => {
        Object.entries(durumlar).forEach(([k, alan]) => alan?.classList.toggle("ms-gizli", k !== ad));
    };

    const alanHata = (alan, hataVar) => {
        alan.classList.toggle("ms-form-girdi-hata", hataVar);
        const mesaj = alan.closest(".ms-form-alani")?.querySelector("[data-ms-tckn-hata]");
        if (mesaj) { mesaj.hidden = !hataVar; }
    };

    // TCKN kontrol basamağı algoritması (K9): sunucudaki TcknValidator ile birebir
    const tcknGecerli = (t) => {
        if (!/^[1-9][0-9]{10}$/.test(t)) { return false; }
        const d = [...t].map(Number);
        const tekler = d[0] + d[2] + d[4] + d[6] + d[8];
        const ciftler = d[1] + d[3] + d[5] + d[7];
        let h10 = ((tekler * 7) - ciftler) % 10;
        if (h10 < 0) { h10 += 10; }
        const h11 = d.slice(0, 10).reduce((a, b) => a + b, 0) % 10;
        return d[9] === h10 && d[10] === h11;
    };

    const dogrulandiIsaretle = () => {
        window.msTcknDogrulandi = true;
        window.dispatchEvent(new CustomEvent("ms:tckn-dogrulandi"));
    };

    const ac = () => {
        if (!token()) { document.querySelector("[data-ms-giris-modal-ac]")?.click(); return; }
        modal.classList.add("ms-ornek-modal-acik");
        modal.setAttribute("aria-hidden", "false");
        durumGoster("bekliyor");
        zorunlular.forEach((alan) => alanHata(alan, false));
        window.setTimeout(() => girdi?.focus(), 50);
    };
    const kapat = () => {
        modal.classList.remove("ms-ornek-modal-acik");
        modal.setAttribute("aria-hidden", "true");
    };
    window.msTcknModalAc = ac;

    document.querySelectorAll("[data-ms-tckn-modal-ac]").forEach((buton) => buton.addEventListener("click", ac));
    modal.querySelectorAll("[data-ms-tckn-modal-kapat]").forEach((buton) => buton.addEventListener("click", kapat));

    girdi?.addEventListener("input", () => {
        girdi.value = girdi.value.replace(/\D/g, "").slice(0, 11);
        durumGoster("bekliyor");
    });
    zorunlular.forEach((alan) => alan.addEventListener("input", () => {
        if (alan.value.trim()) { alanHata(alan, false); }
        durumGoster("bekliyor");
    }));

    modal.querySelector("[data-ms-tckn-dogrula]")?.addEventListener("click", async (olay) => {
        let eksikVar = false;
        zorunlular.forEach((alan) => {
            const bos = !alan.value.trim();
            alanHata(alan, bos);
            eksikVar = eksikVar || bos;
        });
        if (eksikVar) { durumGoster("hata"); return; }

        const tckn = (girdi?.value || "").trim();
        if (!tcknGecerli(tckn)) {
            alanHata(girdi, true);
            durumGoster("hata");
            return;
        }

        const buton = olay.currentTarget;
        buton.disabled = true;
        try {
            const dogum = modal.querySelector("input[type='date']")?.value || null;
            const cevap = await fetch("/api/store/account/identity", {
                method: "POST",
                headers: { "Content-Type": "application/json", Authorization: "Bearer " + token() },
                body: JSON.stringify({ identityNumber: tckn, birthDate: dogum })
            });
            const veri = await cevap.json().catch(() => null);
            if (!veri?.success) { durumGoster("hata"); return; }
            durumGoster("basarili");
            dogrulandiIsaretle();
            window.setTimeout(kapat, 900);
        } catch {
            durumGoster("hata");
        } finally {
            buton.disabled = false;
        }
    });

    // Sayfa açılışında üyenin mevcut doğrulaması yüklenir
    (async () => {
        if (!token()) { return; }
        try {
            const cevap = await fetch("/api/store/auth/me", { headers: { Authorization: "Bearer " + token() } });
            const veri = await cevap.json().catch(() => null);
            if (veri?.success && veri.data?.identityVerified) { dogrulandiIsaretle(); }
        } catch { /* misafir görünümüyle devam */ }
    })();
});
</script>
