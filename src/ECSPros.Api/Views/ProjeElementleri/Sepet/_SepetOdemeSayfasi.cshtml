    @* Bu script: Ödeme yöntemi kartları, panel geçişleri ve ödeme doğrulama akışını yönetir. *@
    <script>
    (() => {
        const odemeSayfasiKok = document.currentScript?.closest("[data-ms-sayfa-panel], .ms-panel") || document;

        odemeSayfasiKok.querySelectorAll("[data-ms-odeme-yontemleri]").forEach((odemeAlani) => {
            const yontemler = Array.from(odemeAlani.querySelectorAll("[data-ms-odeme-yontemi]"));
            const paneller = Array.from(odemeAlani.querySelectorAll("[data-ms-odeme-panel]"));
            const asamaSayfasi = odemeAlani.closest(".ms-siparis-asama-sayfasi");
            const asamaPaneli = odemeAlani.closest("[data-ms-siparis-asama-panel]");
            const eksikListesi = asamaSayfasi?.querySelector("[data-ms-odeme-eksikler]");
            const onayaGecButonlari = Array.from(asamaPaneli?.querySelectorAll("[data-ms-odeme-onaya-gec]") || []);
            const sozlesmeOnayInput = asamaSayfasi?.querySelector("[data-ms-sozlesme-onay-input]");
            const kartAlanlari = Array.from(odemeAlani.querySelectorAll("[data-ms-kart-alan]"));
            const kartNumarasi = odemeAlani.querySelector('[data-ms-kart-alan="numara"]');
            const kartSahibiIsmi = odemeAlani.querySelector('[data-ms-kart-alan="isim"]');
            const sonKullanma = odemeAlani.querySelector('[data-ms-kart-alan="son-kullanma"]');
            const cvv = odemeAlani.querySelector('[data-ms-kart-alan="cvv"]');
            const taksitBos = odemeAlani.querySelector("[data-ms-taksit-bos]");
            const taksitListesi = odemeAlani.querySelector("[data-ms-taksit-listesi]");
            let taksitSonBin = "";

            // Ödenecek tutarı özet DOM'undan oku ("24,99 TL" → 24.99) — taksit gösterimi için.
            const odenecekTutarOku = () => {
                const el = document.querySelector("[data-ms-odeme-odenecek]");
                if (!el) return 0;
                const s = (el.textContent || "").replace(/[^0-9,.]/g, "").replace(/\./g, "").replace(",", ".");
                const n = parseFloat(s);
                return isFinite(n) ? n : 0;
            };

            // Kart BIN'ine (ilk 6 hane) göre PayTR taksit seçeneklerini yükle. Sunucu ham PayTR
            // yanıtını loglar (Adım 1: format yakalama); şimdilik tek çekim döner. Yalnız BIN gönderilir.
            const taksitleriYukle = async (bin) => {
                if (!taksitListesi) return;
                try {
                    const r = await fetch("/api/store/payment/paytr/taksit", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ bin: bin, tutar: odenecekTutarOku() })
                    });
                    const v = await r.json();
                    const opts = (v && v.taksitler) || [];
                    const nf = new Intl.NumberFormat("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    taksitListesi.innerHTML = opts.map((o, i) => {
                        const etiket = (o.adet || 1) <= 1 ? "Tek Çekim" : (o.adet + " Taksit");
                        return `<label class="ms-odeme-taksit-secenegi">
                            <input class="ms-onay-input" type="radio" name="siparis-taksit" value="${o.adet || 1}" ${i === 0 ? "checked" : ""}>
                            <span class="ms-onay-kutu ms-onay-kutu-yuvarlak" aria-hidden="true"></span>
                            <span>${etiket}</span>
                            <strong class="ms-fiyat-standart">${nf.format(o.birim || 0)} ₺ <small class="ms-fiyat-standart">Toplam: ${nf.format(o.toplam || 0)} ₺</small></strong>
                        </label>`;
                    }).join("");
                } catch { /* sessiz — taksit gösterimi kritik değil */ }
            };
            const kartOnizleme = odemeAlani.querySelector("[data-ms-kart-onizleme]");
            const kartTurYazilari = Array.from(odemeAlani.querySelectorAll("[data-ms-kart-tur-yazi], [data-ms-kart-tur-yazi-arka]"));
            const kartOnizlemeNumara = odemeAlani.querySelector("[data-ms-kart-onizleme-numara]");
            const kartOnizlemeIsim = odemeAlani.querySelector("[data-ms-kart-onizleme-isim]");
            const kartOnizlemeSonKullanma = odemeAlani.querySelector("[data-ms-kart-onizleme-son-kullanma]");
            const kartOnizlemeCvv = odemeAlani.querySelector("[data-ms-kart-onizleme-cvv]");
            const kuponDurumKarti = odemeAlani.querySelector("[data-ms-odeme-kupon-durumu]");
            const kuponKoduYazi = odemeAlani.querySelector("[data-ms-odeme-kupon-kod]");
            const kuponAciklamaYazi = odemeAlani.querySelector("[data-ms-odeme-kupon-aciklama]");
            const kuponIndirimYazi = odemeAlani.querySelector("[data-ms-odeme-kupon-indirim]");
            const kuponUyari = odemeAlani.querySelector("[data-ms-odeme-kupon-uyari]");
            const kuponUyariMetni = odemeAlani.querySelector("[data-ms-odeme-kupon-uyari-metin]");
            const kuponOzetSatiri = asamaSayfasi?.querySelector("[data-ms-odeme-kupon-satiri]");
            const kuponOzetKodu = asamaSayfasi?.querySelector("[data-ms-odeme-kupon-ozet-kod]");
            const kuponOzetIndirimi = asamaSayfasi?.querySelector("[data-ms-odeme-kupon-ozet-indirim]");
            // 2026-07-17: demo KART25 kaldırıldı — kupon yalnız sepette gerçekten
            // uygulanmışsa gösterilir (gerçek durum sessionStorage sözleşmesinden gelir).
            const varsayilanKuponDurumu = null;

            const kayitliKuponDurumuAl = () => {
                try {
                    const kayitliDurum = window.sessionStorage?.getItem("msSepetKuponDurumu");
                    return kayitliDurum === null ? undefined : JSON.parse(kayitliDurum);
                } catch {
                    return undefined;
                }
            };

            const kayitliKuponDurumu = kayitliKuponDurumuAl();
            let aktifKupon = typeof window.msSepetKuponDurumu !== "undefined"
                ? window.msSepetKuponDurumu
                : typeof kayitliKuponDurumu !== "undefined"
                    ? kayitliKuponDurumu
                    : varsayilanKuponDurumu;

            // 2026-07-17: gerçek kupon durumu {kod, tutar, kosul} şeklinde gelir — tasarım
            // kartının beklediği görüntü alanları (indirim metni / açıklama) türetilir.
            if (aktifKupon?.kod && !aktifKupon.indirim && typeof aktifKupon.tutar === "number") {
                aktifKupon = {
                    ...aktifKupon,
                    indirim: "-" + new Intl.NumberFormat("tr-TR",
                        { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(aktifKupon.tutar) + " TL",
                    aciklama: aktifKupon.aciklama || aktifKupon.kosul || "Sepette uygulanan kupon"
                };
            }

            const odemeTipiEtiketleri = {
                kart: "Kart ile Öde",
                kapida: "Kapıda ödeme",
                "kapida-nakit": "Kapıda Nakit Ödeme",
                "kapida-kart": "Kapıda Kart ile Ödeme",
                tum: "tüm ödeme yöntemleri"
            };

            const kuponYontemeUygunMu = (kupon, seciliYontem) => {
                if (!kupon?.kod || !kupon.odemeTipi || kupon.odemeTipi === "tum") {
                    return true;
                }

                if (kupon.odemeTipi === "kapida") {
                    return seciliYontem === "kapida-nakit" || seciliYontem === "kapida-kart";
                }

                return kupon.odemeTipi === seciliYontem;
            };

            const kuponDurumunuGuncelle = (seciliYontem = yontemler.find((yontem) => yontem.checked)?.value) => {
                const kuponVar = Boolean(aktifKupon?.kod);
                const uyumlu = !kuponVar || kuponYontemeUygunMu(aktifKupon, seciliYontem);

                if (kuponDurumKarti) {
                    kuponDurumKarti.hidden = !kuponVar;
                    kuponDurumKarti.classList.toggle("ms-odeme-kupon-durumu-uyumsuz", kuponVar && !uyumlu);
                }

                if (kuponKoduYazi) {
                    kuponKoduYazi.textContent = aktifKupon?.kod || "";
                }

                if (kuponAciklamaYazi) {
                    kuponAciklamaYazi.textContent = aktifKupon?.aciklama || "";
                }

                if (kuponIndirimYazi) {
                    kuponIndirimYazi.textContent = aktifKupon?.indirim || "";
                }

                if (kuponUyari) {
                    kuponUyari.hidden = !kuponVar || uyumlu;
                }

                if (kuponUyariMetni && aktifKupon?.odemeTipi) {
                    kuponUyariMetni.textContent = `${aktifKupon.kod} kuponu yalnızca ${odemeTipiEtiketleri[aktifKupon.odemeTipi] || "ilgili ödeme yöntemi"} ile kullanılabilir. Kuponu korumak için uygun ödeme yöntemini seçin veya sepetten kuponu kaldırın.`;
                }

                yontemler.forEach((yontem) => {
                    const etiket = yontem.closest(".ms-odeme-yontemi")?.querySelector("[data-ms-odeme-yontemi-kupon-etiketi]");
                    if (etiket) {
                        etiket.hidden = !kuponVar || !kuponYontemeUygunMu(aktifKupon, yontem.value);
                    }
                });

                if (kuponOzetSatiri) {
                    kuponOzetSatiri.hidden = !kuponVar;
                }

                if (kuponOzetKodu) {
                    kuponOzetKodu.textContent = aktifKupon?.kod || "";
                }

                if (kuponOzetIndirimi) {
                    kuponOzetIndirimi.textContent = aktifKupon?.indirim || "";
                }

                return uyumlu;
            };

            const odemeYontemiGoster = (hedef) => {
                yontemler.forEach((yontem) => {
                    const aktif = yontem.value === hedef;
                    yontem.closest(".ms-odeme-yontemi")?.classList.toggle("ms-odeme-yontemi-aktif", aktif);
                });

                paneller.forEach((panel) => {
                    const aktif = panel.dataset.msOdemePanel === hedef;
                    panel.classList.toggle("ms-odeme-yontemi-panel-aktif", aktif);
                    panel.hidden = !aktif;
                });

                kuponDurumunuGuncelle(hedef);
            };

            const sadeceRakam = (deger) => (deger || "").replace(/\D/g, "");
            const rakamsizMetin = (deger) => (deger || "").replace(/[0-9]/g, "");

            const kartTurunuBul = (numara) => {
                if (/^4/.test(numara)) {
                    return { kod: "visa", ad: "Visa" };
                }

                if (/^(5[1-5]|2(2[2-9]|[3-6]|7[01]|720))/.test(numara)) {
                    return { kod: "mastercard", ad: "Mastercard" };
                }

                if (/^3[47]/.test(numara)) {
                    return { kod: "amex", ad: "American Express" };
                }

                if (/^(9792|65)/.test(numara)) {
                    return { kod: "troy", ad: "Troy" };
                }

                return { kod: "bilinmiyor", ad: "Kart" };
            };

            const kartOnizlemeGuncelle = () => {
                if (!kartOnizleme) {
                    return;
                }

                const numara = sadeceRakam(kartNumarasi?.value || "");
                const tur = kartTurunuBul(numara);
                const formatliNumara = (kartNumarasi?.value || "").trim();
                const isim = kartAlanlari.find((alan) => alan.dataset.msKartAlan === "isim")?.value?.trim();
                const sonKullanmaDegeri = sonKullanma?.value?.trim();
                const cvvDegeri = cvv?.value?.trim();

                kartOnizleme.dataset.msKartTur = tur.kod;
                kartTurYazilari.forEach((alan) => {
                    alan.textContent = tur.ad;
                });

                if (kartOnizlemeNumara) {
                    kartOnizlemeNumara.textContent = formatliNumara || "•••• •••• •••• ••••";
                }

                if (kartOnizlemeIsim) {
                    kartOnizlemeIsim.textContent = isim || "AD SOYAD";
                }

                if (kartOnizlemeSonKullanma) {
                    kartOnizlemeSonKullanma.textContent = sonKullanmaDegeri || "MM/YY";
                }

                if (kartOnizlemeCvv) {
                    kartOnizlemeCvv.textContent = cvvDegeri || "•••";
                }
            };

            const kartNumarasiFormatla = () => {
                if (!kartNumarasi) {
                    return;
                }

                const rakamlar = sadeceRakam(kartNumarasi.value).slice(0, 16);
                kartNumarasi.value = rakamlar.replace(/(.{4})/g, "$1 ").trim();

                // Taksit listesi kart BIN'i (ilk 6 hane) tamamlanınca PayTR'den yüklenir.
                const taksitGoster = rakamlar.length >= 6;

                if (taksitBos) {
                    taksitBos.hidden = taksitGoster;
                }
                if (taksitListesi) {
                    taksitListesi.hidden = !taksitGoster;
                }

                if (rakamlar.length >= 6) {
                    const bin = rakamlar.slice(0, 6);
                    if (bin !== taksitSonBin) {
                        taksitSonBin = bin;
                        taksitleriYukle(bin);
                    }
                } else {
                    taksitSonBin = "";
                    if (taksitListesi) { taksitListesi.innerHTML = ""; }
                }

                kartOnizlemeGuncelle();
            };

            const sonKullanmaFormatla = () => {
                if (!sonKullanma) {
                    return;
                }

                const rakamlar = sadeceRakam(sonKullanma.value).slice(0, 4);
                sonKullanma.value = rakamlar.length > 2 ? `${rakamlar.slice(0, 2)}/${rakamlar.slice(2)}` : rakamlar;
                kartOnizlemeGuncelle();
            };

            const cvvFormatla = () => {
                if (cvv) {
                    cvv.value = sadeceRakam(cvv.value).slice(0, 3);
                }

                kartOnizlemeGuncelle();
            };

            const kartSahibiIsmiFormatla = () => {
                if (kartSahibiIsmi) {
                    kartSahibiIsmi.value = rakamsizMetin(kartSahibiIsmi.value);
                }

                kartOnizlemeGuncelle();
            };

            const kartAlanHatasiniGoster = (alan, hataVar) => {
                const hata = odemeAlani.querySelector(`[data-ms-kart-hata="${alan.dataset.msKartAlan}"]`);
                alan.classList.toggle("ms-form-girdi-hata", hataVar);

                if (hata) {
                    hata.hidden = !hataVar;
                }
            };

            const kartEksikleriniAl = () => {
                const eksikler = [];

                kartAlanlari.forEach((alan) => {
                    let hataVar = !alan.value.trim();

                    if (alan.dataset.msKartAlan === "numara") {
                        hataVar = sadeceRakam(alan.value).length !== 16;
                    }

                    kartAlanHatasiniGoster(alan, hataVar);

                    if (hataVar) {
                        eksikler.push(alan.dataset.msKartEtiket || "Kart bilgisi");
                    }
                });

                return eksikler;
            };

            const eksikleriGoster = (eksikler) => {
                if (!eksikListesi) {
                    return;
                }

                eksikListesi.innerHTML = "";
                eksikListesi.hidden = eksikler.length === 0;

                eksikler.forEach((eksik) => {
                    const satir = document.createElement("div");
                    satir.className = "ms-odeme-eksik";
                    satir.innerHTML = `
                        <i class="fa-solid fa-circle-info ms-fa-ikon" aria-hidden="true"></i>
                        <span>${eksik}</span>
                    `;
                    eksikListesi.appendChild(satir);
                });
            };

            yontemler.forEach((yontem) => {
                yontem.addEventListener("change", () => odemeYontemiGoster(yontem.value));
            });

            kartNumarasi?.addEventListener("input", () => {
                kartNumarasiFormatla();
                kartAlanHatasiniGoster(kartNumarasi, false);
            });
            sonKullanma?.addEventListener("input", () => {
                sonKullanmaFormatla();
                kartAlanHatasiniGoster(sonKullanma, false);
            });
            cvv?.addEventListener("input", () => {
                cvvFormatla();
                kartAlanHatasiniGoster(cvv, false);
            });
            kartSahibiIsmi?.addEventListener("input", () => {
                kartSahibiIsmiFormatla();
                kartAlanHatasiniGoster(kartSahibiIsmi, false);
            });
            kartAlanlari.forEach((alan) => {
                if (alan === kartNumarasi || alan === sonKullanma || alan === cvv || alan === kartSahibiIsmi) {
                    return;
                }

                alan.addEventListener("input", () => {
                    kartAlanHatasiniGoster(alan, false);
                    kartOnizlemeGuncelle();
                });
            });

            cvv?.addEventListener("focus", () => {
                kartOnizleme?.classList.add("ms-kredi-kart-arka-gorunur");
            });

            cvv?.addEventListener("blur", () => {
                kartOnizleme?.classList.remove("ms-kredi-kart-arka-gorunur");
            });

            (asamaSayfasi || odemeAlani).querySelectorAll("[data-ms-sozlesme-modal-ac]").forEach((buton) => {
                buton.addEventListener("click", () => {
                    const ozet = buton.closest(".ms-siparis-ozeti");
                    window.msSozlesmeModalAc?.(ozet?.querySelector("[data-ms-sozlesme-onay-input]") || null);
                });
            });

            sozlesmeOnayInput?.addEventListener("click", (event) => {
                if (!sozlesmeOnayInput.checked) {
                    return;
                }

                event.preventDefault();
                sozlesmeOnayInput.checked = false;
                window.msSozlesmeModalAc?.(sozlesmeOnayInput);
            });

            const odemeOnayiniDogrula = () => {
                const seciliYontem = yontemler.find((yontem) => yontem.checked)?.value;
                const sozlesmeEksik = sozlesmeOnayInput && !sozlesmeOnayInput.checked;
                const kuponUyumsuz = !kuponDurumunuGuncelle(seciliYontem);

                if (seciliYontem !== "kart") {
                    const eksikler = [];

                    if (kuponUyumsuz) {
                        eksikler.push("Kupon ödeme yöntemi ile uyumsuz");
                    }

                    if (sozlesmeEksik) {
                        eksikler.push("Sözleşme onayı");
                    }

                    eksikleriGoster(eksikler);

                    if (eksikler.length > 0) {
                        if (kuponUyumsuz) {
                            kuponUyari?.focus();
                        } else {
                            sozlesmeOnayInput?.focus();
                        }
                        return;
                    }

                    window.msSiparisAsamasiGoster?.("onay");
                    return;
                }

                const eksikler = kartEksikleriniAl();
                if (kuponUyumsuz) {
                    eksikler.push("Kupon ödeme yöntemi ile uyumsuz");
                }

                if (sozlesmeEksik) {
                    eksikler.push("Sözleşme onayı");
                }

                eksikleriGoster(eksikler);

                if (eksikler.length > 0) {
                    const hataliKartAlani = kartAlanlari.find((alan) => alan.classList.contains("ms-form-girdi-hata"));
                    (kuponUyumsuz ? kuponUyari : hataliKartAlani || sozlesmeOnayInput)?.focus();
                    return;
                }

                window.msSiparisAsamasiGoster?.("onay");
            };

            onayaGecButonlari.forEach((onayaGecButonu) => {
                onayaGecButonu.addEventListener("click", odemeOnayiniDogrula);
            });

            window.addEventListener("ms:sepet-kupon-degisti", (event) => {
                aktifKupon = event.detail || null;
                kuponDurumunuGuncelle(yontemler.find((yontem) => yontem.checked)?.value);
            });

            kartNumarasiFormatla();
            sonKullanmaFormatla();
            cvvFormatla();
            kartOnizlemeGuncelle();
            odemeYontemiGoster(yontemler.find((yontem) => yontem.checked)?.value || yontemler[0]?.value);
        });
    })();
</script>


@* C5+C10: Canlı ödeme script'i — özet cart + msSepetKuponDurumu'ndan; teslimat adresi
   msTeslimatDurumu'ndan (yoksa /teslimat'a döner). Misharix demo script'i eksik kontrolü,
   kart önizleme/taksit ve kupon-yöntem uyumunu yönetir; başarıyla geçerse
   msSiparisAsamasiGoster('onay') çağırır — burada Odeme.cshtml'in yönlendirme fonksiyonu
   SARILIR: önce POST /api/store/checkout (K2 test modu: sipariş pending oluşur, tahsilat
   mock), kupon kullanım kaydı checkout gövdesinde; başarıda sepet+kupon temizlenir,
   msSiparisSonucu yazılır ve /siparis-tamamlandi'ya gidilir. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const platformId = document.querySelector("[data-ms-arama]")?.dataset.msAramaPlatform || "";
    const urunToplami = document.querySelector("[data-ms-odeme-urun-toplami]");
    const odenecekler = [...document.querySelectorAll("[data-ms-odeme-odenecek]")];
    const eksikAlani = document.querySelector("[data-ms-odeme-eksikler]");
    if (!platformId || !urunToplami) { return; }

    const paraYaz = (deger) => new Intl.NumberFormat("tr-TR",
        { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(deger || 0) + " TL";
    const trAd = (i18n) => (i18n && (i18n.tr || Object.values(i18n)[0])) || "";
    const token = () => localStorage.getItem("ecspros_member_token");

    // Hızlı satın alma bağlamı (A seçeneği, 2026-07-30): sepet ana sid yerine
    // sessionStorage'daki tek ürünlük hızlı sepetten okunur; kupon bu sayfada girilir.
    const hizliMod = new URLSearchParams(window.location.search).get("hizli") === "1";

    // Sepet sayfasında seçilmeyen kalemlerin variantId kümesi (checkout dışı) — 2026-07-31.
    const secimDisiKume = () => {
        try { return new Set(JSON.parse(sessionStorage.getItem("msSepetSecimDisi") || "[]")); }
        catch { return new Set(); }
    };

    let sepet = null;
    let teslimat = null;
    try { teslimat = JSON.parse(sessionStorage.getItem("msTeslimatDurumu") || "null"); } catch { }
    let kupon = null;
    if (!hizliMod) {
        try { kupon = JSON.parse(sessionStorage.getItem("msSepetKuponDurumu") || "null"); } catch { }
    }

    if (!teslimat) { window.location.href = hizliMod ? "/teslimat?hizli=1" : "/teslimat"; return; }

    // 2026-07-30: kapıda ödeme hizmet bedeli — sunucu ayarının görüntüsü (checkout aynı
    // bedeli TotalExpense/GrandTotal'a yazar; buradaki değer yalnız gösterimdir).
    // 2026-08-04: bedel/limit/varsayılan yöntem panel ayarından (IPaymentOptionsProvider).
    const KAPIDA_BEDELI = @msOdemeSecenekleri.CodServiceFee.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const KAPIDA_UST_SINIR = @msOdemeSecenekleri.CodMaxOrderTotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const VARSAYILAN_ODEME_YONTEMI = "@msIlkOdemeYontemi";
    const seciliOdemeYontemi = () => document.querySelector("[data-ms-odeme-yontemi]:checked")?.value || VARSAYILAN_ODEME_YONTEMI;
    const kapidaBedeli = () => {
        const yontem = seciliOdemeYontemi();
        return yontem === "kapida-nakit" || yontem === "kapida-kart" ? KAPIDA_BEDELI : 0;
    };

    const toplamlar = () => {
        const toplam = (sepet?.items || []).reduce((t, k) => t + (k.lineTotal || 0), 0);
        const indirim = kupon?.tutar || 0;
        // 2026-08-03: sepet-seviyesi kampanya indirimi — sunucu hesaplar (GET cart);
        // checkout aynı serviyle (F4) aynı indirimi sipariş toplamına yazar.
        const kampanyaIndirim = sepet?.campaignDiscount || 0;
        const masraf = kapidaBedeli();
        urunToplami.textContent = paraYaz(toplam);
        const kampanyaSatiri = document.querySelector("[data-ms-odeme-kampanya-satiri]");
        if (kampanyaSatiri) {
            kampanyaSatiri.hidden = !(kampanyaIndirim > 0);
            const adAlani = kampanyaSatiri.querySelector("[data-ms-odeme-kampanya-ad]");
            const tutarAlani = kampanyaSatiri.querySelector("[data-ms-odeme-kampanya-tutar]");
            if (adAlani) { adAlani.textContent = (sepet?.campaigns || []).map((k) => k.name).filter(Boolean).join(", "); }
            if (tutarAlani) { tutarAlani.textContent = "-" + paraYaz(kampanyaIndirim); }
        }
        const kapidaSatiri = document.querySelector("[data-ms-odeme-kapida-satiri]");
        if (kapidaSatiri) { kapidaSatiri.hidden = masraf === 0; }
        const kapidaTutar = document.querySelector("[data-ms-odeme-kapida-tutar]");
        if (kapidaTutar) { kapidaTutar.textContent = "+" + paraYaz(masraf); }
        odenecekler.forEach((alan) => { alan.textContent = paraYaz(Math.max(0, toplam - indirim - kampanyaIndirim) + masraf); });
        return { toplam, indirim, masraf };
    };

    // ── 2026-07-17: ödeme yöntemine özel bilgi mesajı + kupon geçerlilik kuralı ──
    // Kural: kupon indirimleri yalnız KART ile ödemede geçerlidir. Kapıda ödeme
    // seçilince uygulanmış kupon sepetten kaldırılır (toplamlar + sipariş gövdesi
    // kuponsuz), bilgi mesajı "Ödeme Bilgileri" başlığının üstündeki alanda gösterilir.
    const yontemBilgi = document.querySelector("[data-ms-odeme-yontem-bilgi]");
    const bilgiKacir = (metin) => String(metin ?? "").replace(/[&<>"']/g, (k) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[k]);

    const kuponGorselleriniGizle = () => {
        document.querySelectorAll("[data-ms-odeme-kupon-durumu], [data-ms-odeme-kupon-satiri], [data-ms-odeme-kupon-uyari]")
            .forEach((oge) => { oge.hidden = true; });
        document.querySelectorAll("[data-ms-odeme-yontemi-kupon-etiketi]")
            .forEach((oge) => { oge.hidden = true; });
    };

    const yontemBilgisiniGuncelle = () => {
        if (!yontemBilgi) { return; }
        const secili = document.querySelector("[data-ms-odeme-yontemi]:checked")?.value || "kart";
        const kapida = secili === "kapida-nakit" || secili === "kapida-kart";
        const mesajlar = [];

        if (kapida) {
            const paraYazKisa = (d) => new Intl.NumberFormat("tr-TR").format(d) + " TL";
            const parcalar = [];
            if (KAPIDA_BEDELI > 0) { parcalar.push(`Kapıda ödemede +${paraYazKisa(KAPIDA_BEDELI)} hizmet bedeli uygulanır`); }
            if (KAPIDA_UST_SINIR > 0) { parcalar.push(`${parcalar.length ? "" : "Kapıda ödemede "}${paraYazKisa(KAPIDA_UST_SINIR)} ve üzeri siparişlerde kapıda ödeme kabul edilmez`); }
            if (parcalar.length) { mesajlar.push(parcalar.join("; ") + "."); }
            if (kupon?.kod) {
                mesajlar.push(`${bilgiKacir(kupon.kod)} kuponu yalnızca kart ile ödemede geçerli olduğundan sepetinizden kaldırıldı. Kart ile ödemeye dönerseniz kuponu sepette yeniden uygulayabilirsiniz.`);
                kupon = null;
                window.msSepetKuponDurumu = null;
                try { sessionStorage.removeItem("msSepetKuponDurumu"); } catch { /* depolama kapalı */ }
                kuponGorselleriniGizle();
                toplamlar();
            }
        } else if (kupon?.kod) {
            mesajlar.push(`${bilgiKacir(kupon.kod)} kuponu bu ödeme yönteminde geçerli — ${paraYaz(kupon.tutar)} indirim uygulanıyor.`);
        }

        yontemBilgi.innerHTML = mesajlar.map((m) => `<p>${m}</p>`).join("");
        yontemBilgi.hidden = mesajlar.length === 0;
        toplamlar(); // 2026-07-30: yöntem değişince kapıda bedeli satırı + ödenecek tazelenir
    };

    document.querySelectorAll("[data-ms-odeme-yontemi]").forEach((yontem) => {
        yontem.addEventListener("change", yontemBilgisiniGuncelle);
    });
    yontemBilgisiniGuncelle();

    const sepetiYukle = async () => {
        // Hızlı modda YALNIZ hızlı sepet kimlikleri kullanılır; üye token'ı BİLEREK
        // gönderilmez (token gitse sunucu üye ana sepetini çözer, yanlış kalemler
        // siparişe girerdi). Normal modda davranış aynen eski.
        const sid = hizliMod ? sessionStorage.getItem("ecspros_hizli_sid") : localStorage.getItem("ecspros_sid");
        const cartId = hizliMod ? sessionStorage.getItem("ecspros_hizli_cart") : localStorage.getItem("ecspros_cart");
        // 2026-07-22: üyeyken token da gönderilir — cartId/sid yokken de üye sepeti bulunur
        const uyeToken = hizliMod ? null : localStorage.getItem("ecspros_member_token");
        const parametreler = new URLSearchParams({ firmPlatformId: platformId });
        if (cartId) { parametreler.set("cartId", cartId); }
        if (sid) { parametreler.set("sessionId", sid); }
        // 2026-08-03: seçim dışı kalemler kampanya hesabına da girmesin (sunucu tarafı)
        if (!hizliMod) {
            const disiListe = [...secimDisiKume()];
            if (disiListe.length) { parametreler.set("excludedVariantIds", disiListe.join(",")); }
        }
        try {
            const cevap = await fetch("/api/store/cart?" + parametreler.toString(),
                uyeToken ? { headers: { Authorization: "Bearer " + uyeToken } } : undefined);
            const veri = await cevap.json().catch(() => null);
            sepet = veri?.success ? veri.data : null;
        } catch { sepet = null; }
        // Sepet sayfasında seçilmeyen kalemleri sipariş+özet dışı bırak (2026-07-31). Hızlı akış
        // (Şimdi Al) ayrı tek-ürün sepeti kullandığından seçime tabi değildir.
        if (!hizliMod && sepet?.items && secimDisiKume().size) {
            sepet.items = sepet.items.filter((k) => !secimDisiKume().has(k.variantId));
        }
        // Hızlı sepet yok/boşsa (ör. süresi doldu) ana sayfaya; ana akışta sepete dönülür.
        // Ana akışta tüm kalemler seçim dışıysa da sepete geri döndür.
        if (!sepet?.items?.length) { window.location.href = hizliMod ? "/" : "/sepet"; return; }
        toplamlar();
    };

    const hataGoster = (mesajlar) => {
        if (!eksikAlani) { return; }
        eksikAlani.innerHTML = mesajlar.map((m) => `<p>${m}</p>`).join("");
        eksikAlani.hidden = mesajlar.length === 0;
        if (mesajlar.length) { eksikAlani.scrollIntoView({ block: "center", behavior: "smooth" }); }
    };

    const odemeTipiEtiketi = () => {
        const secili = document.querySelector("[data-ms-odeme-yontemi]:checked");
        return secili?.closest(".ms-odeme-yontemi")?.querySelector("strong")?.textContent.trim()
            || "Kart ile Öde";
    };

    let gonderiliyor = false;
    const siparisOlustur = async () => {
        if (gonderiliyor) { return; }
        // 2026-07-22: misafir sipariş — sepetteki kapıda misafir seçildiyse token'sız
        // devam edilir (checkout API misafiri kabul eder); değilse giriş istenir.
        if (!token() && sessionStorage.getItem("msMisafirSiparis") !== "1") {
            document.querySelector("[data-ms-giris-modal-ac]")?.click();
            return;
        }
        if (!teslimat.countryId || !teslimat.cityId || !teslimat.districtId) {
            hataGoster(["Adres kaydınızda il/ilçe bilgisi eksik — lütfen teslimat adımından yeni bir adres oluşturun."]);
            return;
        }
        const { toplam, indirim, masraf } = toplamlar();

        // C7: eşik üzeri + TCKN doğrulanmamış → modal (sunucu guard'ı da 400 döner)
        const tcknEsik = Number(document.querySelector("[data-ms-odeme-urun-toplami]")?.dataset.msTcknEsik || 13000);
        if (Math.max(0, toplam - indirim) >= tcknEsik && window.msTcknDogrulandi !== true) {
            hataGoster([`${tcknEsik.toLocaleString("tr-TR")} TL ve üzeri siparişlerde TCKN doğrulaması zorunludur.`]);
            window.msTcknModalAc?.();
            return;
        }
        gonderiliyor = true;
        try {
            const cevap = await fetch("/api/store/checkout", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    ...(token() ? { Authorization: "Bearer " + token() } : {})
                },
                body: JSON.stringify({
                    firmPlatformId: platformId,
                    currencyCode: sepet.currencyCode || "TRY",
                    shippingRecipientName: teslimat.recipientName,
                    shippingRecipientPhone: teslimat.recipientPhone,
                    shippingCountryId: teslimat.countryId,
                    shippingCityId: teslimat.cityId,
                    shippingDistrictId: teslimat.districtId,
                    shippingAddressLine: [teslimat.neighborhoodName, teslimat.addressLine].filter(Boolean).join(" "),
                    shippingPostalCode: teslimat.postalCode || null,
                    shippingDeliveryNotes: teslimat.deliveryNotes || null,
                    billingSameAsShipping: true,
                    items: sepet.items.map((k) => ({
                        variantId: k.variantId,
                        sku: k.productCode || "",
                        productName: trAd(k.productNameI18n) || k.productCode || "Ürün",
                        variantInfo: k.optionsText || null,
                        quantity: k.quantity,
                        unitPrice: k.addedPrice
                    })),
                    customerNotes: document.querySelector(".ms-siparis-asama-kart textarea, .ms-form-metin-alani")?.value?.trim() || null,
                    cartId: sepet.id,
                    // 2026-07-22: teslimat adımındaki kargo tercihi (mahalle bazlı seçim)
                    requestedCargoIntegrationId: teslimat.kargo?.id || null,
                    requestedCargoName: teslimat.kargo?.ad || null,
                    couponId: kupon?.couponId || null,
                    couponDiscount: kupon?.tutar || null,
                    // 2026-08-27: sunucu kuponu KODLA yeniden doğrular; tutar sunucuda hesaplanır
                    couponCode: kupon?.kod || null,
                    // 2026-07-30: kapıda ödeme bedeli sunucuda bu yönteme göre hesaplanıp
                    // sipariş toplamına yazılır (tutar istemciden gönderilmez)
                    paymentMethod: seciliOdemeYontemi(),
                    // C8: onaylanan sözleşme kodları — SSR modalın belgeler kabından okunur,
                    // kabul kaydını (başlık + metin sürümü) sunucu CMS'ten çözerek siparişe yazar.
                    // (Onay input'u misharix script'inin scope'unda — buradan DOM'dan okunur.)
                    acceptedContracts: (document.querySelector("[data-ms-sozlesme-onay-input]")?.checked
                        ? (document.querySelector("[data-ms-sozlesme-kodlar]")?.dataset.msSozlesmeKodlar || "")
                            .split(",").filter(Boolean)
                        : null)
                })
            });
            const veri = await cevap.json().catch(() => null);
            if (!veri?.success) {
                hataGoster([veri?.error || "Sipariş oluşturulamadı. Lütfen tekrar deneyin."]);
                if (veri?.tcknRequired) { window.msTcknModalAc?.(); }
                return;
            }

            // Onay sayfası için sonucu yaz; sepet + kupon + teslimat durumları temizlenir
            try {
                sessionStorage.setItem("msSiparisSonucu", JSON.stringify({
                    orderId: veri.data.orderId,
                    orderNumber: veri.data.orderNumber || null,
                    odemeTipi: odemeTipiEtiketi(),
                    tutar: toplam,
                    indirim,
                    odenecek: Math.max(0, toplam - indirim) + masraf, // kapıda bedeli dahil (2026-07-30)
                    adresBaslik: teslimat.title,
                    adresYer: [teslimat.districtName, teslimat.cityName].filter(Boolean).join(", "),
                    aliciAd: teslimat.recipientName,
                    kuponKod: kupon?.kod || null,
                    kalemler: sepet.items.map((k) => ({
                        ad: trAd(k.productNameI18n) || k.productCode,
                        kod: k.productCode || "",
                        gorsel: k.imageUrl || "",
                        secenek: (k.optionsText || "").replaceAll(", ", " • "),
                        adet: k.quantity,
                        tutar: k.lineTotal,
                        // İE-3 takip (2026-08-22): purchase kalemi — item_id varyant SKU (feed id), birim fiyat, indirim
                        sku: k.sku || null,
                        varyantId: k.variantId,
                        birimFiyat: k.addedPrice,
                        indirim: k.campaignLineDiscount || 0
                    })),
                    // İE-3: purchase event'i için sipariş toplamları (kargo/masraf ayrı)
                    masraf

                }));
                sessionStorage.removeItem("msSepetKuponDurumu");
                sessionStorage.removeItem("msTeslimatDurumu");
                // 2026-07-22: misafir akışı kalıntıları — sipariş tamamlandı, bayrak/adres düşer
                sessionStorage.removeItem("msMisafirSiparis");
                sessionStorage.removeItem("msMisafirAdres");
            } catch { /* depolama kapalı — onay sayfası sipariş no'suz açılır */ }

            // ── PayTR kart ödemesi (2026-07-30, YALNIZ TEST MODU) ──
            // Kart yöntemi seçiliyse sipariş oluştu (pending); şimdi PayTR Direct API'ye
            // gidilir. Kart alanları YALNIZ burada okunur, init'e iletilir, sonra bırakılır —
            // hiçbir yerde saklanmaz/loglanmaz. Başarıda callback siparişi paid yapar; kullanıcı
            // 3D'yi tamamlayıp /odeme-sonuc/basarili'ya döner. Ödeme çözülene dek sepet SİLİNMEZ
            // (başarısızlıkta kullanıcı yeniden deneyebilsin). Kapıda ödeme PayTR'a GİTMEZ.
            if (seciliOdemeYontemi() === "kart") {
                // NOT: kart alanları document'tan okunur — 'odemeAlani' başka script bloğunun
                // kapsamındaydı, bu blokta tanımsız olduğundan ReferenceError atıp "Sipariş
                // oluşturulamadı" hatası veriyordu (2026-07-30 düzeltmesi). Alanlar sayfada tekil.
                const kartNo = document.querySelector('[data-ms-kart-alan="numara"]')?.value || "";
                const kartSahibi = document.querySelector('[data-ms-kart-alan="isim"]')?.value || "";
                const sonKul = (document.querySelector('[data-ms-kart-alan="son-kullanma"]')?.value || "").replace(/\s/g, "");
                const kartCvv = document.querySelector('[data-ms-kart-alan="cvv"]')?.value || "";
                const [ay, yil] = sonKul.split("/");
                let initVeri = null;
                try {
                    const initCevap = await fetch("/api/store/payment/paytr/init", {
                        method: "POST",
                        headers: { "Content-Type": "application/json", ...(token() ? { Authorization: "Bearer " + token() } : {}) },
                        body: JSON.stringify({
                            orderId: veri.data.orderId,
                            email: null,
                            cardOwner: kartSahibi,
                            cardNumber: kartNo,
                            expiryMonth: ay || "",
                            expiryYear: yil ? ("20" + yil).slice(-4) : "",
                            cvv: kartCvv,
                            // Seçili taksit (1/yok = tek çekim; 2..12 = taksit) — PayTR installment_count
                            installment: parseInt(document.querySelector('input[name="siparis-taksit"]:checked')?.value || "1", 10) || 1
                        })
                    });
                    initVeri = await initCevap.json().catch(() => null);
                } catch { /* ağ hatası — aşağıda ele alınır */ }
                if (initVeri?.success && initVeri.mock) {
                    // MOCK ödeme (demo): sipariş anında paid+onaylı işaretlendi — 3D yok.
                    // Başarı bayrağını koyup tamamlandı sayfasına git (sepet orada temizlenir).
                    try { sessionStorage.setItem("msKartOdemeBekliyor", veri.data.orderId); } catch { }
                    window.location.href = "/siparis-tamamlandi";
                    return;
                }
                if (initVeri?.success && initVeri.html) {
                    // Kart ödeme niyeti bayrağı (2026-07-30): PayTR başarı dönüşünde merchant_ok_url'in
                    // query'si (?odeme=basarili) düşüyor — güvenilir sinyal bu sessionStorage bayrağı.
                    // Başarıda PayTR /siparis-tamamlandi'ya (merchant_ok_url), başarısızda
                    // /odeme-sonuc/basarisiz'a döner; özet sayfası bayrağı görürse "ödeme alındı"dır.
                    try { sessionStorage.setItem("msKartOdemeBekliyor", veri.data.orderId); } catch { }
                    // PayTR 3D içeriğini tam sayfaya bas → banka 3D sayfasına yönlenir
                    document.open(); document.write(initVeri.html); document.close();
                    return;
                }
                hataGoster([initVeri?.error || "Kart ödemesi başlatılamadı. Lütfen tekrar deneyin."]);
                return; // sipariş oluştu ama ödeme başlamadı — sepet korunur
            }

            const kismiSecim = !hizliMod && secimDisiKume().size > 0;
            if (kismiSecim) {
                // Kısmi seçim: yalnız sipariş edilen (seçili) kalemler sepetten düşer; seçilmeyenler
                // sepette kalır (sepet + ecspros_cart korunur). sepet.items zaten seçili olanlardır.
                for (const k of sepet.items) {
                    try { await fetch(`/api/store/cart/${sepet.id}/items/${k.id}`, { method: "DELETE" }); } catch { }
                }
                sessionStorage.removeItem("msSepetSecimDisi");
                window.msMiniSepetYenile?.();
            } else {
                try { await fetch("/api/store/cart/" + sepet.id, { method: "DELETE" }); } catch { }
                if (hizliMod) {
                    // Hızlı akış: yalnız geçici hızlı sepet düşer — ana sepet ve mini sepet
                    // rozeti aynen kalır (A seçeneğinin özü: biriktirilen sepet bozulmaz)
                    sessionStorage.removeItem("ecspros_hizli_sid");
                    sessionStorage.removeItem("ecspros_hizli_cart");
                } else {
                    localStorage.removeItem("ecspros_cart");
                    sessionStorage.removeItem("msSepetSecimDisi");
                    window.msMiniSepetYenile?.();
                }
            }
            window.location.href = "/siparis-tamamlandi";
        } catch {
            hataGoster(["Sipariş oluşturulamadı. Lütfen tekrar deneyin."]);
        } finally {
            gonderiliyor = false;
        }
    };

    // Odeme.cshtml'in yönlendirme fonksiyonunu sar: 'onay' hedefi checkout üzerinden geçer
    const oncekiGoster = window.msSiparisAsamasiGoster;
    window.msSiparisAsamasiGoster = (hedef) => {
        if (hedef === "onay") { siparisOlustur(); return; }
        oncekiGoster?.(hedef);
    };

    sepetiYukle();

    // ── Hızlı satın alma kupon girişi (2026-07-30): normal akışta kupon /sepet'te
    // girilir; hızlı akış o adımı atladığından giriş burada. Doğrulama sepetle aynı
    // endpoint'ten (checkout/coupon/validate); sonuç ortak `kupon` durumuna yazılır —
    // kapıda-ödeme kuralı ve sipariş gövdesi (couponId/couponDiscount) aynen işler.
    if (hizliMod) {
        const kuponAlani = document.querySelector("[data-ms-hizli-kupon-alani]");
        const kuponGirdisi = document.querySelector("[data-ms-hizli-kupon-kodu]");
        const kuponMesaji = document.querySelector("[data-ms-hizli-kupon-mesaj]");
        if (kuponAlani) { kuponAlani.hidden = false; }
        const kuponBildir = (metin) => {
            if (!kuponMesaji) { return; }
            kuponMesaji.textContent = metin;
            kuponMesaji.hidden = !metin;
        };
        const hizliKuponUygula = async () => {
            const kod = (kuponGirdisi?.value || "").trim().toLocaleUpperCase("tr-TR");
            if (!kod || !sepet) { return; }
            try {
                const { toplam } = toplamlar();
                const cevap = await fetch("/api/store/checkout/coupon/validate", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        ...(token() ? { Authorization: "Bearer " + token() } : {})
                    },
                    body: JSON.stringify({ code: kod, cartTotal: toplam })
                });
                const veri = await cevap.json().catch(() => null);
                if (!veri?.success) { kuponBildir(veri?.error || "Kupon kodu kullanılamıyor."); return; }
                kupon = {
                    couponId: veri.data.couponId,
                    kod,
                    odemeTipi: "tum",
                    tutar: veri.data.discountAmount || 0,
                    aciklama: veri.data.discountDescription || ""
                };
                // Tasarımın kupon kartı görünümü mevcut event sözleşmesiyle güncellenir
                window.dispatchEvent(new CustomEvent("ms:sepet-kupon-degisti", {
                    detail: { ...kupon, indirim: "-" + paraYaz(kupon.tutar) }
                }));
                kuponBildir("");
                if (kuponGirdisi) { kuponGirdisi.value = ""; }
                toplamlar();
                yontemBilgisiniGuncelle();
            } catch { kuponBildir("Kupon doğrulanamadı. Lütfen tekrar deneyin."); }
        };
        document.querySelector("[data-ms-hizli-kupon-uygula]")?.addEventListener("click", hizliKuponUygula);
        kuponGirdisi?.addEventListener("keydown", (olay) => {
            if (olay.key === "Enter") { olay.preventDefault(); hizliKuponUygula(); }
        });
    }

    // 2026-07-22: ödeme sayfasındayken giriş yapılırsa toplamlar reload'suz tazelenir
    document.addEventListener("ms:uye-giris", () => { sepetiYukle(); });
});
</script>
