<script>
    // Hızlı satın alma (?hizli=1, 2026-07-30): ana sepette uygulanmış kupon durumu bu
    // siparişe TAŞINMAZ — indirim tutarı ana sepet toplamına göre hesaplanmıştı, tek
    // ürünlük hızlı sepete yanlış tutar uygular. Tasarım script'i storage'ı okumadan
    // ÖNCE durum ASKIYA alınır (silinmez — /sepet'e dönüşte geri yüklenir); hızlı
    // akışın kendi kupon girişi ayrıca vardır.
    if (new URLSearchParams(window.location.search).get("hizli") === "1") {
        try {
            const mevcutKupon = sessionStorage.getItem("msSepetKuponDurumu");
            if (mevcutKupon !== null) {
                sessionStorage.setItem("msSepetKuponDurumuAskida", mevcutKupon);
                sessionStorage.removeItem("msSepetKuponDurumu");
            }
        } catch { }
        delete window.msSepetKuponDurumu;
    }
</script>

