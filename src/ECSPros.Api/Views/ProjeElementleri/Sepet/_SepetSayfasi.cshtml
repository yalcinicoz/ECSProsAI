    @* Bu script: TCKN modalı ve ilgili form doğrulama davranışını yönetir. *@
    <script>
    (() => {
        const sepetSayfasiKok = document.currentScript?.closest("[data-ms-sayfa-panel], .ms-panel") || document;
        const tcknModal = sepetSayfasiKok.querySelector("[data-ms-tckn-modal]");
        const tcknGirdi = tcknModal?.querySelector("[data-ms-tckn-girdi]");
        const tcknZorunluAlanlar = Array.from(tcknModal?.querySelectorAll("[data-ms-tckn-zorunlu]") || []);
        const tcknDurumBekliyor = tcknModal?.querySelector("[data-ms-tckn-durum-bekliyor]");
        const tcknDurumBasarili = tcknModal?.querySelector("[data-ms-tckn-durum-basarili]");
        const tcknDurumHata = tcknModal?.querySelector("[data-ms-tckn-durum-hata]");

        const tcknDurumunuGoster = (durum) => {
            tcknDurumBekliyor?.classList.toggle("ms-gizli", durum !== "bekliyor");
            tcknDurumBasarili?.classList.toggle("ms-gizli", durum !== "basarili");
            tcknDurumHata?.classList.toggle("ms-gizli", durum !== "hata");
        };

        const tcknAlanHatasiniAyarla = (alan, hataVar) => {
            const hata = alan.closest(".ms-form-alani")?.querySelector("[data-ms-tckn-hata]");
            alan.classList.toggle("ms-form-girdi-hata", hataVar);

            if (hata) {
                hata.hidden = !hataVar;
            }
        };

        const tcknFormHatalariniTemizle = () => {
            tcknZorunluAlanlar.forEach((alan) => tcknAlanHatasiniAyarla(alan, false));
        };

        const tcknModalAc = () => {
            tcknModal?.classList.add("ms-ornek-modal-acik");
            tcknModal?.setAttribute("aria-hidden", "false");
            tcknDurumunuGoster("bekliyor");
            tcknFormHatalariniTemizle();
            window.setTimeout(() => tcknGirdi?.focus(), 50);
        };

        const tcknModalKapat = () => {
            tcknModal?.classList.remove("ms-ornek-modal-acik");
            tcknModal?.setAttribute("aria-hidden", "true");
        };

        sepetSayfasiKok.querySelectorAll("[data-ms-tckn-modal-ac]").forEach((buton) => {
            buton.addEventListener("click", tcknModalAc);
        });

        tcknModal?.querySelectorAll("[data-ms-tckn-modal-kapat]").forEach((buton) => {
            buton.addEventListener("click", tcknModalKapat);
        });

        tcknModal?.querySelector("[data-ms-tckn-dogrula]")?.addEventListener("click", () => {
            const tckn = (tcknGirdi?.value || "").replace(/\D/g, "");
            let hataVar = false;

            tcknZorunluAlanlar.forEach((alan) => {
                const bos = !alan.value.trim();
                tcknAlanHatasiniAyarla(alan, bos);
                hataVar = hataVar || bos;
            });

            if (hataVar) {
                tcknDurumunuGoster("hata");
                tcknZorunluAlanlar.find((alan) => alan.classList.contains("ms-form-girdi-hata"))?.focus();
                return;
            }

            tcknDurumunuGoster(tckn.length === 11 ? "basarili" : "hata");
        });

        tcknGirdi?.addEventListener("input", () => {
            tcknGirdi.value = tcknGirdi.value.replace(/\D/g, "").slice(0, 11);
            tcknDurumunuGoster("bekliyor");
        });

        tcknZorunluAlanlar.forEach((alan) => {
            alan.addEventListener("input", () => {
                if (alan === tcknGirdi) {
                    alan.value = alan.value.replace(/\D/g, "").slice(0, 11);
                }

                if (alan.value.trim()) {
                    tcknAlanHatasiniAyarla(alan, false);
                }

                tcknDurumunuGoster("bekliyor");
            });
        });

        const kuponOdemeEtiketleri = {
            kart: "Sadece Kart ile Ödeme",
            kapida: "Kapıda Ödemeye Özel",
            "kapida-nakit": "Sadece Kapıda Nakit",
            "kapida-kart": "Sadece Kapıda Kart",
            tum: "Tüm Ödeme Yöntemleri"
        };

        const kuponOdemeTipiniBul = (kod) => {
            const temizKod = (kod || "").trim().toLocaleUpperCase("tr-TR");

            if (temizKod.includes("KART") || temizKod.includes("KK")) {
                return "kart";
            }

            if (temizKod.includes("NAKIT")) {
                return "kapida-nakit";
            }

            if (temizKod.includes("KAPIDA")) {
                return "kapida";
            }

            return "tum";
        };

        const kuponAciklamasiBul = (odemeTipi) => {
            if (odemeTipi === "kart") {
                return "Kredi kartı veya banka kartı ile ödemede geçerli kupon";
            }

            if (odemeTipi === "kapida" || odemeTipi === "kapida-nakit" || odemeTipi === "kapida-kart") {
                return "Kapıda ödeme yöntemlerinde geçerli kupon";
            }

            return "Tüm ödeme yöntemlerinde geçerli kupon";
        };

        const kuponDurumunuYayinla = (durum) => {
            window.msSepetKuponDurumu = durum || null;
            try {
                window.sessionStorage?.setItem("msSepetKuponDurumu", JSON.stringify(window.msSepetKuponDurumu));
            } catch {
                // Tarayıcı depolaması kapalıysa aynı sayfa içi event akışı devam eder.
            }

            window.dispatchEvent(new CustomEvent("ms:sepet-kupon-degisti", {
                detail: window.msSepetKuponDurumu
            }));
        };

        const kuponKartindanDurumAl = (kuponKarti) => {
            if (!kuponKarti || kuponKarti.hidden) {
                return null;
            }

            return {
                kod: kuponKarti.dataset.msKuponKod || "",
                odemeTipi: kuponKarti.dataset.msKuponOdemeTipi || "tum",
                indirim: kuponKarti.dataset.msKuponIndirim || "-25,00 TL",
                aciklama: kuponKarti.dataset.msKuponAciklama || kuponAciklamasiBul(kuponKarti.dataset.msKuponOdemeTipi || "tum")
            };
        };

        const kuponKartiniGuncelle = (kuponKarti, durum) => {
            if (!kuponKarti) {
                return;
            }

            kuponKarti.hidden = !durum;

            if (!durum) {
                kuponDurumunuYayinla(null);
                return;
            }

            kuponKarti.dataset.msKuponKod = durum.kod;
            kuponKarti.dataset.msKuponOdemeTipi = durum.odemeTipi;
            kuponKarti.dataset.msKuponIndirim = durum.indirim;
            kuponKarti.dataset.msKuponAciklama = durum.aciklama;

            const kodYazi = kuponKarti.querySelector("[data-ms-kupon-kod-yazi]");
            const kosulYazi = kuponKarti.querySelector("[data-ms-kupon-kosul]");
            const indirimYazi = kuponKarti.querySelector("[data-ms-kupon-indirim-yazi]");

            if (kodYazi) {
                kodYazi.textContent = durum.kod;
            }

            if (kosulYazi) {
                kosulYazi.textContent = kuponOdemeEtiketleri[durum.odemeTipi] || kuponOdemeEtiketleri.tum;
            }

            if (indirimYazi) {
                indirimYazi.textContent = durum.indirim;
            }

            kuponDurumunuYayinla(durum);
        };

        sepetSayfasiKok.querySelectorAll("[data-ms-kupon-uygula]").forEach((buton) => {
            buton.addEventListener("click", () => {
                const kuponAlani = buton.closest(".ms-siparis-kupon");
                const ozet = buton.closest(".ms-siparis-ozeti");
                const kuponKarti = ozet?.querySelector("[data-ms-uygulanan-kupon]");
                const kuponInput = kuponAlani?.querySelector("[data-ms-kupon-kodu]");
                const kod = (kuponInput?.value || "KART25").trim().toLocaleUpperCase("tr-TR");
                const odemeTipi = kuponOdemeTipiniBul(kod);
                const bildirimler = kuponAlani?.nextElementSibling?.matches("[data-ms-kupon-bildirimleri]")
                    ? kuponAlani.nextElementSibling
                    : null;

                kuponKartiniGuncelle(kuponKarti, {
                    kod,
                    odemeTipi,
                    indirim: odemeTipi === "tum" ? "-10,00 TL" : "-25,00 TL",
                    aciklama: kuponAciklamasiBul(odemeTipi)
                });

                if (kuponInput) {
                    kuponInput.value = "";
                }

                bildirimler?.querySelectorAll(".ms-siparis-kupon-bildirim").forEach((bildirim) => {
                    bildirim.classList.add("ms-siparis-kupon-bildirim-vurgulu");
                    window.setTimeout(() => {
                        bildirim.classList.remove("ms-siparis-kupon-bildirim-vurgulu");
                    }, 900);
                });
            });
        });

        sepetSayfasiKok.querySelectorAll("[data-ms-kupon-kaldir]").forEach((buton) => {
            buton.addEventListener("click", () => {
                const kuponKarti = buton.closest("[data-ms-uygulanan-kupon]");
                const kuponInput = kuponKarti?.closest(".ms-siparis-ozeti")?.querySelector("[data-ms-kupon-kodu]");

                kuponKartiniGuncelle(kuponKarti, null);
                kuponInput?.focus();
            });
        });

        sepetSayfasiKok.querySelectorAll("[data-ms-uygulanan-kupon]").forEach((kuponKarti) => {
            kuponDurumunuYayinla(kuponKartindanDurumAl(kuponKarti));
        });

        sepetSayfasiKok.querySelectorAll("[data-ms-kupon-modal-ac]").forEach((buton) => {
            buton.addEventListener("click", () => window.msKuponModalAc?.());
        });

        sepetSayfasiKok.querySelectorAll("[data-ms-sozlesme-modal-ac]").forEach((buton) => {
            buton.addEventListener("click", () => {
                const ozet = buton.closest(".ms-siparis-ozeti");
                window.msSozlesmeModalAc?.(ozet?.querySelector("[data-ms-sozlesme-onay-input]") || null);
            });
        });

        sepetSayfasiKok.querySelectorAll("[data-ms-sozlesme-onay-input]").forEach((checkbox) => {
            checkbox.addEventListener("click", (event) => {
                if (!checkbox.checked) {
                    return;
                }

                event.preventDefault();
                checkbox.checked = false;
                window.msSozlesmeModalAc?.(checkbox);
            });
        });

        sepetSayfasiKok.querySelectorAll("[data-ms-sepet-tumunu-sec]").forEach((tumunuSec) => {
            const sepetAlani = tumunuSec.closest(".ms-sepet-liste-alani") || sepetSayfasiKok;
            const urunSecimleri = Array.from(sepetAlani.querySelectorAll("[data-ms-sepet-urun-checkbox]"));

            if (!urunSecimleri.length) {
                return;
            }

            const tumunuSecDurumuGuncelle = () => {
                const seciliAdet = urunSecimleri.filter((secim) => secim.checked).length;
                tumunuSec.checked = seciliAdet === urunSecimleri.length;
                tumunuSec.indeterminate = seciliAdet > 0 && seciliAdet < urunSecimleri.length;
            };

            tumunuSec.addEventListener("change", () => {
                urunSecimleri.forEach((secim) => {
                    secim.checked = tumunuSec.checked;
                });
                tumunuSec.indeterminate = false;
            });

            urunSecimleri.forEach((secim) => {
                secim.addEventListener("change", tumunuSecDurumuGuncelle);
            });

            tumunuSecDurumuGuncelle();
        });

        const favoriIkonuOlustur = (src, siyah = true) => {
            const ikon = document.createElement("img");
            ikon.src = src;
            ikon.alt = "";
            ikon.setAttribute("aria-hidden", "true");
            if (siyah) {
                ikon.classList.add("ms-ikon-siyah");
            }
                return ikon;
        };

        sepetSayfasiKok.querySelectorAll("[data-ms-sepet-favori]").forEach((buton) => {
            if (buton.dataset.msSepetFavoriHazir === "true") {
                return;
            }

            const butonIkonunuGuncelle = (aktif) => {
                buton.innerHTML = "";
                buton.appendChild(favoriIkonuOlustur(aktif ? "/ikons/kalp.svg" : "/ikons/favorite.svg"));
            };

            buton.dataset.msSepetFavoriHazir = "true";
            butonIkonunuGuncelle(buton.getAttribute("aria-pressed") === "true");

            buton.addEventListener("click", () => {
                const aktif = buton.classList.toggle("ms-sepet-ikon-buton-aktif");
                buton.setAttribute("aria-pressed", aktif.toString());
                buton.setAttribute("aria-label", aktif ? "Favorilerden çıkar" : "Favorilere ekle");
                butonIkonunuGuncelle(aktif);

                const kalp = document.createElement("span");
                kalp.className = "ms-urun-favori-ekran-kalp";
                kalp.appendChild(favoriIkonuOlustur(aktif ? "/ikons/kalp.svg" : "/ikons/kirik-kalp.svg", false));
                document.body.appendChild(kalp);
                kalp.addEventListener("animationend", () => kalp.remove(), { once: true });
            });
        });

        sepetSayfasiKok.querySelectorAll("[data-ms-sepet-sil]").forEach((buton) => {
            if (buton.dataset.msSepetSilHazir === "true") {
                return;
            }

            buton.dataset.msSepetSilHazir = "true";
            buton.addEventListener("click", () => {
                const satir = buton.closest(".ms-sepet-satiri");

                if (!satir) {
                    return;
                }

                const urunAdi = satir.querySelector(".ms-sepet-basligi")?.textContent?.replace(/\s+/g, " ").trim();
                const aciklama = urunAdi
                    ? `${urunAdi} sepetinizden çıkarılacak. Emin misiniz?`
                    : "Bu ürün sepetinizden çıkarılacak. Emin misiniz?";

                if (typeof window.msSepetSilModalAc === "function") {
                    window.msSepetSilModalAc(satir, aciklama);
                    return;
                }

                satir.remove();
            });
        });

        const paraFormatla = (deger) => `${deger.toLocaleString("tr-TR", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        })} TL`;

        sepetSayfasiKok.querySelectorAll("[data-ms-sepet-satir]").forEach((satir) => {
            const adetAlani = satir.querySelector("[data-ms-sepet-adet]");
            const azalt = satir.querySelector("[data-ms-sepet-adet-azalt]");
            const artir = satir.querySelector("[data-ms-sepet-adet-artir]");
            const adetDeger = satir.querySelector("[data-ms-sepet-adet-deger]");
            const satirTutar = satir.querySelector("[data-ms-sepet-satir-tutar]");
            const birimFiyat = Number(satir.dataset.msBirimFiyat || 0);

            if (!adetAlani || !azalt || !artir || !adetDeger || !satirTutar || !birimFiyat) {
                return;
            }

            const adetGuncelle = (yeniAdet) => {
                const adet = Math.max(1, Math.min(yeniAdet, 10));
                adetDeger.textContent = adet.toString();
                satirTutar.textContent = paraFormatla(birimFiyat * adet);
                azalt.disabled = adet <= 1;
                artir.disabled = adet >= 10;
            };

            azalt.addEventListener("click", () => adetGuncelle(Number(adetDeger.textContent || 1) - 1));
            artir.addEventListener("click", () => adetGuncelle(Number(adetDeger.textContent || 1) + 1));
            adetGuncelle(Number(adetDeger.textContent || 1));
        });
    })();
</script>

@* C1: Canlı sepet script'i — satırlar GET /api/store/cart'tan (B5 mini sepet deseniyle aynı
   oturum anahtarları), adet PUT / silme DELETE (silme onayı misharix'in sil modalıyla:
   msSepetSilModalAc + onay butonuna eklenen ikinci dinleyici API'yi çağırır). Tümünü seç /
   satır checkbox'ları yalnız özet toplamını etkiler (sipariş C10'da tam sepetle kurulur).
   Yukarıdaki misharix demo script'i satır bulamadığından satır-düzeyi bağlamaları etkisizdir;
   TCKN/sözleşme modal davranışları ondan çalışmaya devam eder. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const platformId = document.querySelector("[data-ms-arama]")?.dataset.msAramaPlatform || "";
    const konteyner = document.querySelector("[data-ms-sepet-satir-konteyner]");
    const sablon = document.querySelector("[data-ms-sepet-satir-sablon]");
    if (!platformId || !konteyner || !sablon) { return; }

    const bosMesaj = document.querySelector("[data-ms-sepet-bos]");
    const ozetAciklama = document.querySelector("[data-ms-sepet-ozet-aciklama]");
    const urunToplami = document.querySelector("[data-ms-sepet-urun-toplami]");
    const odenecekler = [...document.querySelectorAll("[data-ms-sepet-odenecek]")];
    const tumunuSec = document.querySelector("[data-ms-sepet-tumunu-sec]");

    const paraYaz = (deger) => new Intl.NumberFormat("tr-TR",
        { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(deger || 0) + " TL";
    const trAd = (i18n) => (i18n && (i18n.tr || Object.values(i18n)[0])) || "";

    let sepetId = null;
    let silinecekKalemId = null;

    const toplamlariGuncelle = () => {
        let toplam = 0;
        konteyner.querySelectorAll("[data-ms-sepet-satir]").forEach((satir) => {
            const secili = satir.querySelector("[data-ms-sepet-urun-checkbox]")?.checked;
            const adet = Number(satir.querySelector("[data-ms-sepet-adet-deger]")?.textContent || 0);
            const birim = Number(satir.dataset.msBirimFiyat || 0);
            if (secili) { toplam += birim * adet; }
        });
        if (urunToplami) { urunToplami.textContent = paraYaz(toplam); }
        odenecekler.forEach((alan) => { alan.textContent = paraYaz(toplam); });
    };

    const tumunuSecDurumu = () => {
        const kutular = [...konteyner.querySelectorAll("[data-ms-sepet-urun-checkbox]:not(:disabled)")];
        if (!tumunuSec || kutular.length === 0) { return; }
        const secili = kutular.filter((k) => k.checked).length;
        tumunuSec.checked = secili === kutular.length;
        tumunuSec.indeterminate = secili > 0 && secili < kutular.length;
    };

    const adetGonder = async (kalemId, adet) => {
        try {
            await fetch(`/api/store/cart/${sepetId}/items/${kalemId}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ quantity: adet })
            });
            window.msMiniSepetYenile?.();
        } catch { yenile(); }
    };

    const satirKur = (kalem) => {
        const satir = sablon.content.firstElementChild.cloneNode(true);
        satir.dataset.msBirimFiyat = String(kalem.addedPrice || 0);
        satir.dataset.msKalemId = kalem.id;

        const ad = trAd(kalem.productNameI18n) || kalem.productCode || "Ürün";
        const detayUrl = kalem.productCode ? "/urun/" + encodeURIComponent(kalem.productCode) : "#";
        const gorselLink = satir.querySelector("[data-ms-sepet-gorsel-link]");
        const gorsel = satir.querySelector("[data-ms-sepet-gorsel]");
        const baslik = satir.querySelector("[data-ms-sepet-baslik]");
        gorselLink.href = detayUrl;
        baslik.href = detayUrl;
        baslik.textContent = ad;
        if (kalem.imageUrl) { gorsel.src = kalem.imageUrl; }
        gorsel.alt = ad;
        satir.querySelector("[data-ms-sepet-secenek]").textContent =
            (kalem.optionsText || "").replaceAll(", ", " • ");
        satir.querySelector(".sr-only").textContent = ad + " seç";

        const adetDeger = satir.querySelector("[data-ms-sepet-adet-deger]");
        const azalt = satir.querySelector("[data-ms-sepet-adet-azalt]");
        const artir = satir.querySelector("[data-ms-sepet-adet-artir]");
        const satirTutar = satir.querySelector("[data-ms-sepet-satir-tutar]");
        const birim = kalem.addedPrice || 0;

        const adetYaz = (adet) => {
            adetDeger.textContent = String(adet);
            satirTutar.textContent = paraYaz(birim * adet);
            azalt.disabled = adet <= 1;
            artir.disabled = adet >= 10;
        };
        adetYaz(kalem.quantity || 1);

        const adetDegistir = (fark) => {
            const yeni = Math.max(1, Math.min(10, Number(adetDeger.textContent || 1) + fark));
            if (yeni === Number(adetDeger.textContent)) { return; }
            adetYaz(yeni);
            toplamlariGuncelle();
            adetGonder(kalem.id, yeni);
        };
        azalt.addEventListener("click", () => adetDegistir(-1));
        artir.addEventListener("click", () => adetDegistir(1));

        // B12/C1: tükenen kalem tasarımdaki tükendi görünümüyle (checkbox pasif, adet gizli)
        if (kalem.isAvailable === false) {
            satir.classList.add("ms-sepet-satiri-tukendi");
            const kutu = satir.querySelector("[data-ms-sepet-urun-checkbox]");
            kutu.checked = false;
            kutu.disabled = true;
            satir.querySelector("[data-ms-sepet-stok-uyari]").hidden = false;
            satir.querySelector("[data-ms-sepet-adet]").hidden = true;
        }

        satir.querySelector("[data-ms-sepet-urun-checkbox]").addEventListener("change", () => {
            toplamlariGuncelle();
            tumunuSecDurumu();
        });

        satir.querySelector("[data-ms-sepet-sil]").addEventListener("click", () => {
            silinecekKalemId = kalem.id;
            const aciklama = `${ad} sepetinizden çıkarılacak. Emin misiniz?`;
            if (typeof window.msSepetSilModalAc === "function") {
                window.msSepetSilModalAc(satir, aciklama);
            } else {
                satir.remove();
                silmeOnaylandi();
            }
        });

        return satir;
    };

    const silmeOnaylandi = async () => {
        if (!silinecekKalemId || !sepetId) { return; }
        const kalemId = silinecekKalemId;
        silinecekKalemId = null;
        try {
            await fetch(`/api/store/cart/${sepetId}/items/${kalemId}`, { method: "DELETE" });
        } catch { /* yenile gerçek durumu getirir */ }
        window.msMiniSepetYenile?.();
        yenile();
    };
    // Misharix'in sil onay modalındaki onay butonu satırı DOM'dan kaldırır (kendi dinleyicisi);
    // bu ikinci dinleyici aynı tıklamada API silmesini yapar.
    document.querySelector("[data-ms-sepet-sil-onayla]")?.addEventListener("click", silmeOnaylandi);
    document.querySelectorAll("[data-ms-sepet-sil-modal-kapat]").forEach((kapat) => {
        kapat.addEventListener("click", () => { silinecekKalemId = null; });
    });

    tumunuSec?.addEventListener("change", () => {
        konteyner.querySelectorAll("[data-ms-sepet-urun-checkbox]:not(:disabled)").forEach((kutu) => {
            kutu.checked = tumunuSec.checked;
        });
        tumunuSec.indeterminate = false;
        toplamlariGuncelle();
    });

    const ciz = (sepet) => {
        const kalemler = sepet?.items || [];
        sepetId = sepet?.id || null;
        konteyner.innerHTML = "";
        kalemler.forEach((kalem) => konteyner.appendChild(satirKur(kalem)));
        if (bosMesaj) { bosMesaj.hidden = kalemler.length > 0; }
        if (ozetAciklama) {
            ozetAciklama.textContent = kalemler.length > 0
                ? `${kalemler.reduce((t, k) => t + (k.quantity || 0), 0)} ürün sepete eklendi.`
                : "Sepetinizde ürün yok.";
        }
        toplamlariGuncelle();
        tumunuSecDurumu();
    };

    const yenile = async () => {
        const sid = localStorage.getItem("ecspros_sid");
        const cartId = localStorage.getItem("ecspros_cart");
        if (!sid && !cartId) { ciz(null); return; }
        try {
            const parametreler = new URLSearchParams({ firmPlatformId: platformId });
            if (cartId) { parametreler.set("cartId", cartId); }
            if (sid) { parametreler.set("sessionId", sid); }
            const cevap = await fetch("/api/store/cart?" + parametreler.toString());
            const veri = await cevap.json().catch(() => null);
            ciz(veri?.success ? veri.data : null);
        } catch { ciz(null); }
    };

    yenile();
});
</script>
