    @* Bu script: Teslimat/adres kartı ve teslimat adımı geçişlerini yönetir. *@
    <script>
    (() => {
        const teslimatSayfasiKok = document.currentScript?.closest("[data-ms-sayfa-panel], .ms-panel") || document;

        const teslimatDavranislariBaslat = () => {
            const adresModal = teslimatSayfasiKok.querySelector("[data-ms-adres-modal]");
            const adresModalBaslikGirdi = adresModal?.querySelector("[data-ms-adres-modal-baslik-girdi]");
            const adresModalKaydet = adresModal?.querySelector("[data-ms-adres-modal-kaydet]");
            let aktifAdresKarti = null;

            const adresKartiSec = (kart) => {
                const adresListesi = kart?.closest("[data-ms-adres-listesi]");

                if (!kart || !adresListesi) {
                    return;
                }

                adresListesi.querySelectorAll("[data-ms-adres-karti]").forEach((adresKarti) => {
                    const secili = adresKarti === kart;
                    const etiket = adresKarti.querySelector("[data-ms-adres-etiket]");
                    const secButonu = adresKarti.querySelector("[data-ms-adres-sec]");

                    adresKarti.classList.toggle("ms-siparis-adres-karti-secili", secili);
                    etiket?.classList.toggle("ms-siparis-etiket-rozet-aktif", secili);

                    if (etiket) {
                        etiket.textContent = secili ? "Seçili" : "Alternatif";
                    }

                    if (secButonu) {
                        secButonu.textContent = secili ? "Seçili Adres" : "Bu Adresi Seç";
                        secButonu.disabled = secili;
                    }
                });

                adresListesi.prepend(kart);
            };

            const adresModalAc = (kart) => {
                if (!adresModal || !kart) {
                    return;
                }

                aktifAdresKarti = kart;

                if (adresModalBaslikGirdi) {
                    adresModalBaslikGirdi.value = kart.dataset.msAdresAd || kart.querySelector(".ms-siparis-asama-kart-ust strong")?.textContent?.trim() || "";
                }

                adresModal.classList.add("ms-ornek-modal-acik");
                adresModal.setAttribute("aria-hidden", "false");
                adresModalBaslikGirdi?.focus();
            };

            const adresModalKapat = () => {
                adresModal?.classList.remove("ms-ornek-modal-acik");
                adresModal?.setAttribute("aria-hidden", "true");
            };

            teslimatSayfasiKok.querySelectorAll("[data-ms-adres-sec]").forEach((buton) => {
                buton.addEventListener("click", () => adresKartiSec(buton.closest("[data-ms-adres-karti]")));
            });

            teslimatSayfasiKok.querySelectorAll("[data-ms-adres-duzenle]").forEach((buton) => {
                buton.addEventListener("click", () => adresModalAc(buton.closest("[data-ms-adres-karti]")));
            });

            teslimatSayfasiKok.querySelectorAll("[data-ms-adres-modal-kapat]").forEach((kapatici) => {
                kapatici.addEventListener("click", adresModalKapat);
            });

            adresModal?.querySelectorAll("[data-ms-adres-telefon-input]").forEach((input) => {
                input.addEventListener("keydown", (event) => {
                    if (event.key !== "Backspace" && event.key !== "Delete") {
                        return;
                    }

                    event.preventDefault();
                    input.value = "";
                    input.dispatchEvent(new Event("input", { bubbles: true }));
                });
            });

            adresModalKaydet?.addEventListener("click", () => {
                const yeniBaslik = adresModalBaslikGirdi?.value?.trim();

                if (aktifAdresKarti && yeniBaslik) {
                    aktifAdresKarti.dataset.msAdresAd = yeniBaslik;
                    const baslik = aktifAdresKarti.querySelector(".ms-siparis-asama-kart-ust strong");

                    if (baslik) {
                        baslik.textContent = yeniBaslik;
                    }
                }

                adresModalKapat();
            });

            teslimatSayfasiKok.querySelectorAll("[data-ms-siparis-asama-git]").forEach((buton) => {
                buton.addEventListener("click", () => window.msSiparisAsamasiGoster?.(buton.dataset.msSiparisAsamaGit));
            });
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", teslimatDavranislariBaslat, { once: true });
        } else {
            teslimatDavranislariBaslat();
        }
    })();
</script>


@* C4-b: Canlı teslimat script'i — adres kartları GET /api/store/account/addresses'ten (üye
   gerektirir; oturum yoksa giriş modalına yönlendirilir), yeni adres POST ile kaydedilir;
   İl/İlçe/Mahalle seçenekleri api/store/geo kademeli lookup'larından (aramalı — özel select
   görseliyle, davranış burada: site.js bileşeni dinamik seçenek desteklemiyor). Seçilen adres
   sessionStorage msTeslimatDurumu'na yazılır (ödeme/checkout C5-C10 okur); adres seçilmeden
   Ödemeye Geç engellenir (capture dinleyici kaynak yönlendirmesinden önce çalışır). *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const listeAlani = document.querySelector("[data-ms-adres-listesi]");
    const sablon = document.querySelector("[data-ms-adres-sablon]");
    if (!listeAlani || !sablon) { return; }

    const uyeDegil = document.querySelector("[data-ms-adres-uye-degil]");
    const bosMesaj = document.querySelector("[data-ms-adres-bos]");
    const ozetAdres = document.querySelector("[data-ms-teslimat-ozet-adres]");
    const modal = document.querySelector("[data-ms-adres-modal]");
    const modalHata = modal?.querySelector("[data-ms-adres-modal-hata]");

    const token = () => localStorage.getItem("ecspros_member_token");
    const yetki = () => ({ Authorization: "Bearer " + token() });
    // 2026-07-22: misafir sipariş akışı — sepetteki kapıda "Misafir Olarak Devam Et"
    // seçildiyse adres üye API'sine değil sessionStorage'a yazılır (msMisafirAdres);
    // seçim yine msTeslimatDurumu ile ödeme adımına akar.
    const misafirMi = () => !token() && sessionStorage.getItem("msMisafirSiparis") === "1";
    // 2026-09-02: misafir adresleri LİSTE (msMisafirAdresler) — fatura farklı adrese
    // istenebilsin diye birden çok kart; eski tekil msMisafirAdres geriye dönük okunur.
    const misafirAdresleriOku = () => {
        try {
            const liste = JSON.parse(sessionStorage.getItem("msMisafirAdresler") || "null");
            if (Array.isArray(liste)) { return liste; }
            const eski = JSON.parse(sessionStorage.getItem("msMisafirAdres") || "null");
            return eski ? [eski] : [];
        } catch { return []; }
    };
    let seciliAdres = null;
    // 2026-07-22: mahalle bazlı kargo seçimi — adres değişince seçenekler yenilenir,
    // seçim msTeslimatDurumu.kargo olarak ödeme adımına akar.
    let seciliKargo = null;
    let kargoIstekNo = 0; // yarış koruması: hızlı adres değişiminde eski yanıt kazanmasın
    const kargoPlatformId = document.querySelector("[data-ms-arama]")?.dataset.msAramaPlatform || "";
    const kargoListesi = document.querySelector("[data-ms-kargo-listesi]");
    const ozetKargo = document.querySelector("[data-ms-teslimat-ozet-kargo]");

    // ── Fatura adresi (2026-09-02, revizyon): ayrı blok yok — her adres kartındaki
    // "Fatura adresi" işaretiyle seçilir (radio gibi tek kart). İşaretli kart yoksa fatura
    // teslimat adresine kesilir. Kurumsal fatura adres seçiminden bağımsız opsiyondur.
    // Seçim msTeslimatDurumu.fatura ile ödeme adımına akar.
    const faturaKurumsalKutu = document.querySelector("[data-ms-fatura-kurumsal]");
    const faturaKurumsalAlani = document.querySelector("[data-ms-fatura-kurumsal-alani]");
    const faturaHata = document.querySelector("[data-ms-fatura-hata]");
    const ozetFatura = document.querySelector("[data-ms-teslimat-ozet-fatura]");
    const ozetFaturaSatiri = document.querySelector("[data-ms-teslimat-fatura-satiri]");
    let seciliFaturaAdres = null;

    const hataGoster = (mesaj) => {
        if (!modalHata) { return; }
        modalHata.textContent = mesaj || "";
        modalHata.hidden = !mesaj;
    };

    const faturaHataGoster = (mesaj) => {
        if (!faturaHata) { return; }
        faturaHata.textContent = mesaj || "";
        faturaHata.hidden = !mesaj;
    };

    // Fatura seçimi/kurumsal yoksa null döner → ödeme sayfası billingSameAsShipping:true
    // gönderir (eski davranış). Kurumsal işaretliyse fatura adressiz de dolu döner: adres
    // teslimat adresidir (aynı adrese kurumsal fatura — panel FATURA kartında tam görünür).
    const faturaDurumu = () => {
        const kurumsalAcik = faturaKurumsalKutu?.checked === true;
        const farkliAdres = seciliFaturaAdres && seciliFaturaAdres.id !== seciliAdres?.id
            ? seciliFaturaAdres : null;
        if (!farkliAdres && !kurumsalAcik) { return null; }
        const adres = farkliAdres || seciliAdres;
        if (!adres) { return null; }
        const kurumsal = kurumsalAcik ? {
            firmaAdi: document.querySelector("[data-ms-fatura-firma]")?.value.trim() || "",
            vergiDairesi: document.querySelector("[data-ms-fatura-vergi-dairesi]")?.value.trim() || "",
            vergiNo: document.querySelector("[data-ms-fatura-vergi-no]")?.value.trim() || ""
        } : null;
        return { adres, kurumsal };
    };

    const durumuYayinla = () => {
        const fatura = faturaDurumu();
        try {
            if (seciliAdres) { sessionStorage.setItem("msTeslimatDurumu", JSON.stringify({ ...seciliAdres, kargo: seciliKargo, fatura })); }
            else { sessionStorage.removeItem("msTeslimatDurumu"); }
        } catch { /* depolama kapalı */ }
        if (ozetAdres) { ozetAdres.textContent = seciliAdres?.title || "Seçilmedi"; }
        if (ozetKargo) { ozetKargo.textContent = seciliKargo?.ad || "Ücretsiz"; }
        if (ozetFaturaSatiri) {
            ozetFaturaSatiri.hidden = !fatura;
            if (ozetFatura && fatura) {
                ozetFatura.textContent = (fatura.adres.title || fatura.adres.recipientName || "Seçildi")
                    + (fatura.kurumsal ? " • Kurumsal" : "");
            }
        }
    };

    // ── Kargo seçenekleri (mahalle bazlı) ──
    const kargoCiz = (secenekler) => {
        if (!kargoListesi) { return; }
        kargoListesi.innerHTML = "";
        if (!secenekler.length) {
            const p = document.createElement("p");
            p.className = "ms-sepet-bolum-aciklama";
            p.setAttribute("data-ms-kargo-bos", "");
            p.textContent = seciliAdres
                ? "Bu adres için tanımlı kargo seçeneği bulunamadı."
                : "Kargo seçenekleri için önce teslimat adresi seçin.";
            kargoListesi.appendChild(p);
            return;
        }
        secenekler.forEach((k, i) => {
            const etiket = document.createElement("label");
            etiket.className = "ms-onay-kart";
            etiket.innerHTML = '<input class="ms-onay-input" type="radio" name="siparis-teslimat-tipi">'
                + '<span class="ms-onay-kutu ms-onay-kutu-yuvarlak" aria-hidden="true"></span>'
                + '<span class="ms-onay-metin"></span>';
            const girdi = etiket.querySelector("input");
            girdi.checked = i === 0;
            etiket.querySelector(".ms-onay-metin").textContent = k.name; // XSS: textContent
            girdi.addEventListener("change", () => {
                if (girdi.checked) { seciliKargo = { id: k.integrationId, ad: k.name }; durumuYayinla(); }
            });
            kargoListesi.appendChild(etiket);
        });
        seciliKargo = { id: secenekler[0].integrationId, ad: secenekler[0].name };
        durumuYayinla();
    };

    const kargoYukle = async () => {
        if (!kargoListesi) { return; }
        if (!seciliAdres || !kargoPlatformId) { seciliKargo = null; kargoCiz([]); return; }
        const istek = ++kargoIstekNo;
        try {
            const p = new URLSearchParams({ firmPlatformId: kargoPlatformId });
            if (seciliAdres.neighborhoodId) { p.set("neighborhoodId", seciliAdres.neighborhoodId); }
            const cevap = await fetch("/api/store/cargo-options?" + p.toString());
            const veri = await cevap.json().catch(() => null);
            if (istek !== kargoIstekNo) { return; } // daha yeni bir istek başladı
            seciliKargo = null;
            kargoCiz(veri?.success ? (veri.data || []) : []);
        } catch {
            if (istek === kargoIstekNo) { seciliKargo = null; kargoCiz([]); }
        }
    };

    // 2026-09-02: seçim kart radio'larıyla (Kargo Adresi / Fatura Adresi) — rol taşıyan
    // kartlar vurgulanır, radio işaretleri durumla eşitlenir.
    const kartlariIsaretle = () => {
        listeAlani.querySelectorAll("[data-ms-adres-karti]").forEach((kart) => {
            const kargoSecili = kart.dataset.msAdresId === seciliAdres?.id;
            const faturaSecili = kart.dataset.msAdresId === seciliFaturaAdres?.id;
            kart.classList.toggle("ms-siparis-adres-karti-secili", kargoSecili || faturaSecili);
            const kargoRol = kart.querySelector("[data-ms-adres-kargo-rol]");
            const faturaRol = kart.querySelector("[data-ms-adres-fatura-rol]");
            if (kargoRol) { kargoRol.checked = kargoSecili; }
            if (faturaRol) { faturaRol.checked = faturaSecili; }
        });
    };

    const kartKur = (adres) => {
        const kart = sablon.content.firstElementChild.cloneNode(true);
        kart.dataset.msAdresId = adres.id;
        kart.querySelector("[data-ms-adres-baslik]").textContent = adres.title;
        const parcalar = [adres.addressLine, adres.neighborhoodName, adres.districtName && adres.cityName
            ? `${adres.districtName} / ${adres.cityName}` : (adres.districtName || adres.cityName)]
            .filter(Boolean).join(" • ");
        kart.querySelector("[data-ms-adres-metin]").textContent = `${adres.recipientName} • ${parcalar}`;
        kart.querySelector("[data-ms-adres-telefon]").textContent = "Telefon: " + (adres.recipientPhone || "-");
        // Kargo rolü — teslimat adresi seçimi (eski "Bu Adresi Seç" düğmesinin yerine).
        // Fatura "aynı adres" durumundaysa (varsayılan) kargoyla birlikte taşınır;
        // başka karta açıkça alındıysa yerinde kalır.
        const kargoRol = kart.querySelector("[data-ms-adres-kargo-rol]");
        if (kargoRol) {
            kargoRol.checked = adres.id === seciliAdres?.id;
            kargoRol.addEventListener("change", () => {
                if (!kargoRol.checked) { return; }
                const oncekiId = seciliAdres?.id;
                seciliAdres = adres;
                if (!seciliFaturaAdres || seciliFaturaAdres.id === oncekiId) { seciliFaturaAdres = adres; }
                kartlariIsaretle();
                durumuYayinla();
                kargoYukle(); // adres (mahalle) değişti — kargo seçenekleri yenilenir
            });
        }
        // Fatura rolü — fatura hangi karttaysa o adrese kesilir; kargoyla aynı karttaysa
        // fiilen "teslimat adresiyle aynı"dır (billingSameAsShipping).
        const faturaRol = kart.querySelector("[data-ms-adres-fatura-rol]");
        if (faturaRol) {
            faturaRol.checked = adres.id === seciliFaturaAdres?.id;
            faturaRol.addEventListener("change", () => {
                if (!faturaRol.checked) { return; }
                seciliFaturaAdres = adres;
                faturaHataGoster("");
                kartlariIsaretle();
                durumuYayinla();
            });
        }
        return kart;
    };

    const ciz = (adresler) => {
        const liste = adresler || [];
        // Fatura seçimi listeden güncel nesneyle yenilenir (silinen adres düşer)
        seciliFaturaAdres = liste.find((a) => a.id === seciliFaturaAdres?.id) || null;
        listeAlani.innerHTML = "";
        liste.forEach((adres) => listeAlani.appendChild(kartKur(adres)));
        if (bosMesaj) { bosMesaj.hidden = liste.length > 0; }
        seciliAdres = liste.find((a) => a.isDefault) || liste[0] || null;
        // Varsayılan adreste iki rol de seçili başlar (fatura ayrıca seçilmemişse)
        if (!seciliFaturaAdres) { seciliFaturaAdres = seciliAdres; }
        kartlariIsaretle();
        durumuYayinla();
        kargoYukle(); // varsayılan adresle kargo seçenekleri gelir
    };

    const yenile = async () => {
        if (!token()) {
            if (misafirMi()) {
                // Misafir: kayıtlı adres(ler) varsa göster; yoksa boş liste + "Yeni Adres Ekle"
                // akışı. 2026-09-02: liste (msMisafirAdresler) — fatura farklı adrese istenirse
                // ikinci adres eklenip kartındaki "Fatura adresi" işaretlenir; eski tekil
                // msMisafirAdres kaydı geriye dönük okunur.
                if (uyeDegil) { uyeDegil.hidden = true; }
                ciz(misafirAdresleriOku());
                return;
            }
            if (uyeDegil) { uyeDegil.hidden = false; }
            if (bosMesaj) { bosMesaj.hidden = true; }
            ciz([]);
            if (uyeDegil) { uyeDegil.hidden = false; }
            return;
        }
        if (uyeDegil) { uyeDegil.hidden = true; }
        try {
            const cevap = await fetch("/api/store/account/addresses", { headers: yetki() });
            if (cevap.status === 401) { if (uyeDegil) { uyeDegil.hidden = false; } ciz([]); if (uyeDegil) { uyeDegil.hidden = false; } return; }
            const veri = await cevap.json().catch(() => null);
            ciz(veri?.success ? veri.data : []);
        } catch { ciz([]); }
    };

    // ── Geo aramalı select'ler (il/ilçe/mahalle) ──
    const geoDurum = { ulkeId: null, il: null, ilce: null, mahalle: null };
    const secGetir = (ad) => document.querySelector(`[data-ms-adres-select="${ad}"]`);

    const selectKur = (ad, secilince) => {
        const kok = secGetir(ad);
        const tetik = kok.querySelector("[data-ms-adres-select-tetikleyici]");
        const panel = kok.querySelector(".ms-ozel-select-panel");
        const arama = kok.querySelector("[data-ms-adres-select-arama]");
        const liste = kok.querySelector("[data-ms-adres-select-liste]");
        const deger = kok.querySelector("[data-ms-adres-select-deger]");
        let kayitlar = [];

        const kapat = () => { kok.classList.remove("ms-ozel-select-acik"); tetik.setAttribute("aria-expanded", "false"); };
        const doldur = (filtre) => {
            const f = (filtre || "").toLocaleLowerCase("tr");
            liste.innerHTML = "";
            kayitlar
                .filter((k) => !f || k.ad.toLocaleLowerCase("tr").includes(f))
                .slice(0, 60)
                .forEach((k) => {
                    const buton = document.createElement("button");
                    buton.type = "button";
                    buton.className = "ms-ozel-select-secenek";
                    buton.setAttribute("role", "option");
                    buton.textContent = k.ad;
                    buton.addEventListener("click", () => {
                        deger.textContent = k.ad;
                        kapat();
                        secilince(k);
                    });
                    liste.appendChild(buton);
                });
        };

        tetik.addEventListener("click", () => {
            const acik = !kok.classList.contains("ms-ozel-select-acik");
            kok.classList.toggle("ms-ozel-select-acik", acik);
            tetik.setAttribute("aria-expanded", String(acik));
            if (acik) { arama.value = ""; doldur(""); arama.focus(); }
        });
        arama.addEventListener("input", () => doldur(arama.value));
        document.addEventListener("click", (olay) => { if (!kok.contains(olay.target)) { kapat(); } });

        return {
            yukle: (yeniKayitlar, sifirla) => {
                kayitlar = yeniKayitlar;
                if (sifirla) { deger.textContent = "Seçim yapın"; }
                doldur("");
            },
            sifirla: () => { kayitlar = []; deger.textContent = "Seçim yapın"; liste.innerHTML = ""; }
        };
    };

    const geoGetir = async (yol) => {
        try {
            const cevap = await fetch("/api/store/geo/" + yol);
            const veri = await cevap.json().catch(() => null);
            return veri?.success ? veri.data : [];
        } catch { return []; }
    };

    const mahalleSelect = selectKur("mahalle", (k) => { geoDurum.mahalle = k; });
    const ilceSelect = selectKur("ilce", async (k) => {
        geoDurum.ilce = k; geoDurum.mahalle = null;
        mahalleSelect.sifirla();
        const mahalleler = await geoGetir(`neighborhoods?districtId=${k.id}&limit=200`);
        mahalleSelect.yukle(mahalleler.map((m) => ({ id: m.id, ad: m.nameI18n?.tr || "" })), true);
    });
    const ilSelect = selectKur("il", async (k) => {
        geoDurum.il = k; geoDurum.ilce = null; geoDurum.mahalle = null;
        ilceSelect.sifirla(); mahalleSelect.sifirla();
        const ilceler = await geoGetir(`districts?cityId=${k.id}`);
        ilceSelect.yukle(ilceler.map((d) => ({ id: d.id, ad: d.nameI18n?.tr || "" })), true);
    });

    const geoBaslat = async () => {
        if (geoDurum.ulkeId) { return; }
        const ulkeler = await geoGetir("countries");
        const tr = ulkeler.find((u) => u.code === "TR") || ulkeler[0];
        geoDurum.ulkeId = tr?.id || null;
        const ulkeAlani = document.querySelector("[data-ms-adres-ulke-id]");
        if (ulkeAlani && tr) { ulkeAlani.value = tr.id; }
        const iller = await geoGetir(`cities?countryId=${tr.id}`);
        ilSelect.yukle(iller.map((c) => ({ id: c.id, ad: c.nameI18n?.tr || "" })), true);
    };

    // ── Modal aç / kaydet ──
    const modalAc = () => {
        if (!token() && !misafirMi()) {
            document.querySelector("[data-ms-giris-modal-ac]")?.click();
            return;
        }
        hataGoster("");
        modal?.classList.add("ms-ornek-modal-acik");
        modal?.setAttribute("aria-hidden", "false");
        geoBaslat();
    };
    document.querySelector("[data-ms-adres-ekle]")?.addEventListener("click", modalAc);
    document.querySelector("[data-ms-adres-uye-degil] [data-ms-giris-modal-ac]")?.addEventListener("click", () => {});

    // ── Kurumsal fatura etkileşimleri (adres seçiminden bağımsız opsiyon) ──
    faturaKurumsalKutu?.addEventListener("change", () => {
        if (faturaKurumsalAlani) { faturaKurumsalAlani.hidden = !faturaKurumsalKutu.checked; }
        faturaHataGoster("");
        durumuYayinla();
    });
    ["[data-ms-fatura-firma]", "[data-ms-fatura-vergi-dairesi]", "[data-ms-fatura-vergi-no]"].forEach((secici) => {
        document.querySelector(secici)?.addEventListener("input", durumuYayinla);
    });

    modal?.querySelector("[data-ms-adres-modal-kaydet]")?.addEventListener("click", async (olay) => {
        const buton = olay.currentTarget;
        const oku = (secici) => modal.querySelector(secici)?.value.trim() || "";
        const baslik = oku("[data-ms-adres-modal-baslik-girdi]");
        const ad = oku("[data-ms-adres-ad]");
        const soyad = oku("[data-ms-adres-soyad]");
        const adresSatiri = oku("[data-ms-adres-satiri]");
        const telefonHam = (modal.querySelector("[data-ms-adres-telefon-input]")?.value || "").replace(/\D/g, "");

        hataGoster("");
        if (!baslik || !ad || !soyad || !adresSatiri) { hataGoster("Başlık, ad, soyad ve adres zorunludur."); return; }
        if (!geoDurum.il || !geoDurum.ilce) { hataGoster("İl ve ilçe seçimi zorunludur."); return; }
        if (telefonHam.length < 10) { hataGoster("Geçerli bir telefon numarası girin."); return; }

        // 2026-07-22: misafir adresi sunucuya değil sessionStorage'a yazılır — sipariş
        // oluştuğunda adres bilgisi checkout isteğiyle (shipping* alanları) sunucuya gider.
        // 2026-09-02: liste modeli (msMisafirAdresler) — her kayıt listeye EKLENİR; ilk kayıt
        // varsayılan teslimat adresi olur, sonrakiler fatura/teslimat için kartlardan seçilir.
        if (misafirMi()) {
            const liste = misafirAdresleriOku();
            liste.push({
                id: "misafir-adres-" + Date.now(),
                title: baslik,
                countryId: geoDurum.ulkeId, countryName: "Türkiye",
                cityId: geoDurum.il.id, cityName: geoDurum.il.ad,
                districtId: geoDurum.ilce.id, districtName: geoDurum.ilce.ad,
                neighborhoodId: geoDurum.mahalle?.id || null, neighborhoodName: geoDurum.mahalle?.ad || null,
                addressLine: adresSatiri, postalCode: null,
                recipientName: `${ad} ${soyad}`,
                recipientPhone: "0" + telefonHam,
                deliveryNotes: oku("[data-ms-adres-notu]") || null,
                isDefault: liste.length === 0
            });
            try {
                sessionStorage.setItem("msMisafirAdresler", JSON.stringify(liste));
                sessionStorage.removeItem("msMisafirAdres"); // eski tekil kayıt listeye taşındı
            } catch { }
            modal.classList.remove("ms-ornek-modal-acik");
            modal.setAttribute("aria-hidden", "true");
            yenile();
            return;
        }

        buton.disabled = true;
        try {
            const cevap = await fetch("/api/store/account/addresses", {
                method: "POST",
                headers: { "Content-Type": "application/json", ...yetki() },
                body: JSON.stringify({
                    memberId: "00000000-0000-0000-0000-000000000000",
                    title: baslik,
                    countryId: geoDurum.ulkeId, countryName: "Türkiye",
                    cityId: geoDurum.il.id, cityName: geoDurum.il.ad,
                    districtId: geoDurum.ilce.id, districtName: geoDurum.ilce.ad,
                    neighborhoodId: geoDurum.mahalle?.id || null, neighborhoodName: geoDurum.mahalle?.ad || null,
                    addressLine: adresSatiri, postalCode: null,
                    recipientName: `${ad} ${soyad}`,
                    recipientPhone: "0" + telefonHam,
                    deliveryNotes: oku("[data-ms-adres-notu]") || null,
                    isDefault: modal.querySelector("[data-ms-adres-varsayilan]")?.checked === true
                })
            });
            const veri = await cevap.json().catch(() => null);
            if (!veri?.success) { hataGoster(veri?.error || "Adres kaydedilemedi."); return; }
            modal.classList.remove("ms-ornek-modal-acik");
            modal.setAttribute("aria-hidden", "true");
            yenile();
        } catch {
            hataGoster("Adres kaydedilemedi. Lütfen tekrar deneyin.");
        } finally {
            buton.disabled = false;
        }
    });

    // ── Ödemeye Geç guard'ı: adres seçilmeden geçilmez (capture, kaynak yönlendirmesinden önce);
    // kurumsal fatura işaretliyse firma/vergi alanları dolu olmadan geçilmez.
    document.querySelectorAll("[data-ms-siparis-asama-git='odeme']").forEach((buton) => {
        buton.addEventListener("click", (olay) => {
            if (!seciliAdres) {
                olay.stopImmediatePropagation();
                if (!token() && !misafirMi()) { document.querySelector("[data-ms-giris-modal-ac]")?.click(); return; }
                modalAc();
                return;
            }
            if (faturaKurumsalKutu?.checked) {
                const f = faturaDurumu();
                if (!f?.kurumsal?.firmaAdi || !f.kurumsal.vergiDairesi || !f.kurumsal.vergiNo) {
                    olay.stopImmediatePropagation();
                    faturaHataGoster("Kurumsal fatura için firma adı, vergi dairesi ve vergi numarası zorunludur.");
                    faturaKurumsalAlani?.scrollIntoView({ behavior: "smooth", block: "center" });
                }
            }
        }, true);
    });

    yenile();
});
</script>

@* 2026-07-30: Sepet Özeti tutarları — gerçek sepetten (ödeme sayfasıyla aynı çözümleme:
   hızlı modda yalnız hızlı sepet kimlikleri + token'sız; normalde sid/cart/üye token).
   Kupon indirimi normal akışta sepette uygulanmışsa ödenecek tutara yansıtılır. *@
<script>
document.addEventListener("DOMContentLoaded", async () => {
    const platformId = document.querySelector("[data-ms-arama]")?.dataset.msAramaPlatform || "";
    const alanlar = [...document.querySelectorAll("[data-ms-teslimat-odenecek]")];
    const toplamAlani = document.querySelector("[data-ms-teslimat-ozet-toplam]");
    if (!platformId || (!alanlar.length && !toplamAlani)) { return; }

    const hizliMod = new URLSearchParams(window.location.search).get("hizli") === "1";
    const sid = hizliMod ? sessionStorage.getItem("ecspros_hizli_sid") : localStorage.getItem("ecspros_sid");
    const cartId = hizliMod ? sessionStorage.getItem("ecspros_hizli_cart") : localStorage.getItem("ecspros_cart");
    const uyeToken = hizliMod ? null : localStorage.getItem("ecspros_member_token");

    const p = new URLSearchParams({ firmPlatformId: platformId });
    if (cartId) { p.set("cartId", cartId); }
    if (sid) { p.set("sessionId", sid); }
    // 2026-08-03: sepetteki seçim dışı kalemler kampanya hesabına da girmesin —
    // sunucu campaignDiscount'u seçili kalemler üzerinden hesaplar.
    if (!hizliMod) {
        try {
            const disiListe = JSON.parse(sessionStorage.getItem("msSepetSecimDisi") || "[]");
            if (disiListe.length) { p.set("excludedVariantIds", disiListe.join(",")); }
        } catch { }
    }
    let sepet = null;
    try {
        const cevap = await fetch("/api/store/cart?" + p.toString(),
            uyeToken ? { headers: { Authorization: "Bearer " + uyeToken } } : undefined);
        sepet = (await cevap.json().catch(() => null))?.data || null;
    } catch { /* tutar alanları — kalır */ }

    // Sepet sayfasında seçilmeyen (checkbox kaldırılan) kalemleri özet dışı bırak (2026-07-31).
    // Hızlı akış (Şimdi Al) ayrı tek-ürün sepeti kullandığından seçime tabi değildir.
    if (!hizliMod && sepet?.items) {
        let disi = new Set();
        try { disi = new Set(JSON.parse(sessionStorage.getItem("msSepetSecimDisi") || "[]")); } catch { }
        if (disi.size) { sepet.items = sepet.items.filter((k) => !disi.has(k.variantId)); }
    }

    const toplam = (sepet?.items || []).reduce((t, k) => t + (k.lineTotal || 0), 0);
    let indirim = 0;
    if (!hizliMod) {
        try { indirim = JSON.parse(sessionStorage.getItem("msSepetKuponDurumu") || "null")?.tutar || 0; } catch { }
    }
    // 2026-08-03: sepet-seviyesi kampanya indirimi — sunucu hesaplar (GET cart)
    const kampanyaIndirim = sepet?.campaignDiscount || 0;
    const paraYaz = (d) => new Intl.NumberFormat("tr-TR",
        { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(d || 0) + " TL";
    if (toplamAlani) { toplamAlani.textContent = paraYaz(toplam); }
    const kampanyaSatiri = document.querySelector("[data-ms-teslimat-kampanya-satiri]");
    if (kampanyaSatiri && kampanyaIndirim > 0) {
        kampanyaSatiri.hidden = false;
        const tutarAlani = kampanyaSatiri.querySelector("[data-ms-teslimat-kampanya-tutar]");
        if (tutarAlani) { tutarAlani.textContent = "-" + paraYaz(kampanyaIndirim); }
    }
    alanlar.forEach((alan) => { alan.textContent = paraYaz(Math.max(0, toplam - indirim - kampanyaIndirim)); });
});
</script>
