    <section class="ms-siparis-asama-paneli" data-ms-siparis-asama-panel="onay" hidden>
        <div class="ms-siparis-asama-sayfasi">
            <section class="ms-siparis-asama-ana" aria-labelledby="ms-onay-baslik">
                <div class="ms-siparis-tamamlandi">
                    <div class="ms-siparis-tamamlandi-ikon" aria-hidden="true"><i class="fa-solid fa-circle-check ms-fa-ikon ms-ikon-beyaz" aria-hidden="true"></i></div>
                    <div>
                        <h3 id="ms-onay-baslik" class="ms-sepet-bolum-basligi">Siparişiniz Alınmıştır!</h3>
                        <p class="ms-sepet-bolum-aciklama">Sipariş bilgilerinizi Hesabım › Siparişlerim sayfasından takip edebilirsiniz.</p>
                        @* 2026-07-30: PayTR başarılı ödeme dönüşünde (?odeme=basarili) görünür bilgi.
                           Yeni ECSPros öğesi (tasarım kaynağında yok) — sade satır-içi stil.
                           display:none ile başlar, JS 'inline-flex' yapar (hidden özniteliği inline
                           display ile çakışırdı). *@
                        <p data-ms-onay-odeme-alindi
                           style="display:none;align-items:center;gap:6px;margin-top:8px;padding:6px 12px;border-radius:9999px;background:#dcfce7;color:#15803d;font-size:13px;font-weight:600">
                            <i class="fa-solid fa-circle-check ms-fa-ikon" aria-hidden="true"></i>
                            Ödemeniz başarıyla alındı.
                        </p>
                        <span class="ms-siparis-tamamlandi-uyari" data-ms-onay-mesaj></span>
                    </div>
                </div>

                <section class="ms-siparis-asama-kart">
                    <strong>Sipariş Tamamlandı</strong>
                    <div class="ms-siparis-onay-ozet">
                        <p><span>Sipariş Numaranız</span><strong data-ms-onay-no></strong></p>
                        <p><span>Ödeme Tipi</span><strong data-ms-onay-odeme-tipi></strong></p>
                        <p><span>Sipariş Tutarı</span><strong class="ms-fiyat-standart" data-ms-onay-tutar></strong></p>
                        <p><span>Ödenen Tutar</span><strong class="ms-fiyat-standart" data-ms-onay-odenen></strong></p>
                        <p><span>Ödeyeceğiniz Tutar</span><strong class="ms-fiyat-standart" data-ms-onay-kalan></strong></p>
                    </div>
                </section>

                @* H2 (2026-07-12): Kargo Bilgisi açıldı — firma adı platformun aktif kargo
                   anlaşmasından SSR (anlaşma yoksa satır gizli); durum sipariş anında hep
                   "Hazırlanıyor" (gönderi sonra oluşur, takibi Siparişlerim'de); teslimat
                   adresi msSiparisSonucu'ndan client-side. Tahmini teslim/takip no satırları
                   tasarımdan GİZLİ kaldı — o veriler sipariş anında yok (teslimat süresi
                   konfigürasyonu ileri iş, plan H2 bilinçli sınırı). *@
                @{ var msKargoFirmaAdi = ViewData["MsKargoFirmaAdi"] as string; }
                <section class="ms-siparis-asama-kart">
                    <strong>Kargo Bilgisi</strong>
                    <div class="ms-siparis-onay-ozet">
                        @if (!string.IsNullOrWhiteSpace(msKargoFirmaAdi))
                        {
                        <p><span>Kargo Firması</span><strong>@msKargoFirmaAdi</strong></p>
                        }
                        <p><span>Kargo Durumu</span><strong>Hazırlanıyor</strong></p>
                        <p hidden data-ms-onay-adres-satiri><span>Teslimat Adresi</span><strong data-ms-onay-adres></strong></p>
                    </div>
                </section>

                <section class="ms-siparis-asama-kart">
                    <strong>Alınan Ürünler</strong>
                    <div class="ms-siparis-tamamlandi-urun-listesi" data-ms-onay-urunler></div>
                    <template data-ms-onay-urun-sablon>
                        <article class="ms-siparis-tamamlandi-urun">
                            <img src="" alt="" width="554" height="554" loading="lazy" data-ms-onay-urun-gorsel>
                            <div>
                                <a href="#" data-ms-onay-urun-ad></a>
                                <span data-ms-onay-urun-secenek></span>
                            </div>
                            <strong class="ms-urun-fiyat" data-ms-onay-urun-tutar></strong>
                        </article>
                    </template>
                </section>
            </section>

            <aside class="ms-siparis-ozeti" aria-labelledby="ms-onay-ozet-baslik">
                <h3 id="ms-onay-ozet-baslik" class="ms-siparis-basligi">Nihai Sipariş Özeti</h3>
                <div class="ms-siparis-satirlari">
                    <div class="ms-siparis-satiri"><span class="ms-siparis-etiket">Ürün Toplamı</span><span class="ms-siparis-deger ms-fiyat-standart" data-ms-onay-urun-toplami></span></div>
                    <div class="ms-siparis-satiri"><span class="ms-siparis-etiket">Kargo</span><span class="ms-siparis-deger ms-siparis-ucretsiz">Ücretsiz</span></div>
                    
                    <div class="ms-siparis-satiri" data-ms-onay-kupon-satiri hidden><span class="ms-siparis-etiket">Kupon İndirimi</span><span class="ms-siparis-deger ms-urun-fiyat-indirimli" data-ms-onay-kupon-indirim></span></div>
                </div>
                <div class="ms-siparis-toplam">
                    <span class="ms-siparis-toplam-etiket">Nihai Toplam</span>
                    <span class="ms-siparis-toplam-deger ms-urun-fiyat" data-ms-onay-nihai></span>
                </div>
                <div class="ms-siparis-satirlari">
                    <div class="ms-siparis-satiri"><span class="ms-siparis-etiket">Ödenen Tutar</span><span class="ms-siparis-deger ms-fiyat-standart" data-ms-onay-odenen2></span></div>
                    <div class="ms-siparis-satiri"><span class="ms-siparis-etiket">Kalan Tutar</span><span class="ms-siparis-deger ms-fiyat-standart" data-ms-onay-kalan2></span></div>
                </div>
                <div class="ms-siparis-ozet-aksiyonlar">
                    <a class="ms-buton ms-buton-m ms-buton-devam" href="/">Alışverişe Devam Et</a>
                    <a class="ms-buton ms-buton-m ms-buton-satin-al" href="/Hesabim/Siparislerim">Siparişlerime Git</a>
                </div>
            </aside>
        </div>
    </section>



@* C10: Onay içeriği sessionStorage msSiparisSonucu'ndan; sipariş numarası üyenin sipariş
   listesinden (en yeni kayıt) doğrulanarak gösterilir. Sonuç yoksa ana sayfaya dönülür. *@
<script>
document.addEventListener("DOMContentLoaded", async () => {
    let sonuc = null;
    try { sonuc = JSON.parse(sessionStorage.getItem("msSiparisSonucu") || "null"); } catch { }
    if (!sonuc) { window.location.href = "/"; return; }

    const paraYaz = (deger) => new Intl.NumberFormat("tr-TR",
        { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(deger || 0) + " TL";
    const yaz = (secici, metin) => { const alan = document.querySelector(secici); if (alan) { alan.textContent = metin; } };

    // Sipariş numarası: checkout yanıtı artık orderNumber döner (2026-07-30 — misafirde
    // GUID görünüyordu); eski oturum kayıtları için üye-listesi geri araması yedek kalır.
    let siparisNo = sonuc.orderNumber || "";
    const token = localStorage.getItem("ecspros_member_token");
    if (!siparisNo && token) {
        try {
            const cevap = await fetch("/api/store/account/orders?page=1", { headers: { Authorization: "Bearer " + token } });
            const veri = await cevap.json().catch(() => null);
            const kayitlar = veri?.data?.items || veri?.data || [];
            const eslesen = kayitlar.find?.((o) => o.id === sonuc.orderId) || kayitlar[0];
            siparisNo = eslesen?.orderNumber || "";
        } catch { /* no'suz devam */ }
    }

    // 2026-07-30: PayTR başarılı kart ödemesi dönüşü. merchant_ok_url'in query'si (?odeme=basarili)
    // PayTR yönlendirmesinde DÜŞÜYOR — güvenilir sinyal ödeme sayfasının koyduğu sessionStorage
    // bayrağıdır. Bu sayfaya YALNIZ başarıda (merchant_ok_url) gelinir; başarısızlık
    // /odeme-sonuc/basarisiz'a gider (orada bayrak temizlenir). Bayrağı bir kez okuyup sil.
    var kartBekliyor = null;
    try { kartBekliyor = sessionStorage.getItem("msKartOdemeBekliyor"); } catch { }
    var kartOdemesiAlindi = !!kartBekliyor
        || new URLSearchParams(window.location.search).get("odeme") === "basarili";
    try { sessionStorage.removeItem("msKartOdemeBekliyor"); } catch { }
    if (kartOdemesiAlindi) {
        const bilgi = document.querySelector("[data-ms-onay-odeme-alindi]");
        if (bilgi) { bilgi.style.display = "inline-flex"; }
        // Kart akışında sepet 3D öncesi silinmiyordu (başarısızlıkta korunsun diye) —
        // ödeme başarılıysa burada temizlenir; mini sepet rozeti sıfırlanır.
        try {
            const cartId = localStorage.getItem("ecspros_cart");
            if (cartId) { await fetch("/api/store/cart/" + cartId, { method: "DELETE" }); }
        } catch { /* temizlik başarısızsa sipariş yine de tamam */ }
        localStorage.removeItem("ecspros_cart");
        sessionStorage.removeItem("ecspros_hizli_sid");
        sessionStorage.removeItem("ecspros_hizli_cart");
        window.msMiniSepetYenile?.();
    }

    yaz("[data-ms-onay-mesaj]", `Sayın ${sonuc.aliciAd}, ${sonuc.odemeTipi} ile yapmış olduğunuz${siparisNo ? " " + siparisNo + " nolu" : ""} siparişiniz${kartOdemesiAlindi ? " oluşturulmuş ve ödemesi alınmıştır." : " oluşturulmuştur."}`);
    // GUID asla gösterilmez — numara çözülemezse alan "—" kalır (insan okunur sözleşmesi)
    yaz("[data-ms-onay-no]", siparisNo || "—");
    yaz("[data-ms-onay-odeme-tipi]", sonuc.odemeTipi);
    yaz("[data-ms-onay-tutar]", paraYaz(sonuc.tutar));
    // Kart ödemesi başarılıysa tutar TAHSİL EDİLDİ: ödenen = nihai, kalan = 0.
    // Aksi halde (kapıda vb. — K2 mock) "ödenen 0, ödeyeceğiniz = nihai".
    yaz("[data-ms-onay-odenen]", paraYaz(kartOdemesiAlindi ? sonuc.odenecek : 0));
    yaz("[data-ms-onay-kalan]", paraYaz(kartOdemesiAlindi ? 0 : sonuc.odenecek));
    yaz("[data-ms-onay-urun-toplami]", paraYaz(sonuc.tutar));
    yaz("[data-ms-onay-nihai]", paraYaz(sonuc.odenecek));
    yaz("[data-ms-onay-odenen2]", paraYaz(kartOdemesiAlindi ? sonuc.odenecek : 0));
    yaz("[data-ms-onay-kalan2]", paraYaz(sonuc.odenecek));

    const kuponSatiri = document.querySelector("[data-ms-onay-kupon-satiri]");
    if (kuponSatiri && sonuc.indirim > 0) {
        kuponSatiri.hidden = false;
        yaz("[data-ms-onay-kupon-indirim]", "-" + paraYaz(sonuc.indirim));
    }

    // H2: Kargo Bilgisi'ndeki teslimat adresi — checkout'un yazdığı özet (başlık / ilçe, il)
    const adresSatiri = document.querySelector("[data-ms-onay-adres-satiri]");
    if (adresSatiri && (sonuc.adresBaslik || sonuc.adresYer)) {
        adresSatiri.hidden = false;
        yaz("[data-ms-onay-adres]", [sonuc.adresBaslik, sonuc.adresYer].filter(Boolean).join(" / "));
    }

    const liste = document.querySelector("[data-ms-onay-urunler]");
    const sablon = document.querySelector("[data-ms-onay-urun-sablon]");
    if (liste && sablon) {
        (sonuc.kalemler || []).forEach((kalem) => {
            const satir = sablon.content.firstElementChild.cloneNode(true);
            const gorsel = satir.querySelector("[data-ms-onay-urun-gorsel]");
            if (kalem.gorsel) { gorsel.src = kalem.gorsel; }
            gorsel.alt = kalem.ad;
            const ad = satir.querySelector("[data-ms-onay-urun-ad]");
            ad.textContent = kalem.ad;
            ad.href = kalem.kod ? "/urun/" + encodeURIComponent(kalem.kod) : "#";
            satir.querySelector("[data-ms-onay-urun-secenek]").textContent =
                [kalem.secenek, "Adet: " + kalem.adet].filter(Boolean).join(" • ");
            satir.querySelector("[data-ms-onay-urun-tutar]").textContent = paraYaz(kalem.tutar);
            liste.appendChild(satir);
        });
    }
});
</script>
