@using ECSPros.Api.Models.Store
@{
    // B7: Ürün alanı canlı veriye bağlandı. Kart markup'ı misharix template'inin birebir
    // kopyasıdır — B6'dan itibaren paylaşılan _UrunKarti partial'ında (ana sayfa carousel'leri
    // ile tek kaynak); ilk sayfa sunucudan render edilir (plan 3.3), devamı misharix
    // infinite-scroll modülüyle (kartHazirla/sonra hook'ları) JSON'dan gelir.
    var vm = ViewData["MsUrunListesi"] as UrunListesiVm
             ?? new UrunListesiVm("Ürünler", 0, 24, [], "", [], 0, 0, []);
}
<section class="ms-urun-listesi-urun-alani lazy-infinite-on" data-ms-page-module="infinite-scroll" data-ms-infinite-scroll data-ms-infinite-config="urun-listesi" data-ms-infinite-toplam="100" data-ms-infinite-ilk="20" data-ms-infinite-adet="20" data-ms-infinite-esik="0.8" data-ms-infinite-sadece-ilk="true" aria-label="Ürünlerin yayınlanacağı alan">
    @await Html.PartialAsync("~/Views/ProjeElementleri/UrunListesi/_UrunListesiSagUstFiltre.cshtml")

    <div class="ms-urun-listesi-urun-grid" data-ms-infinite-liste aria-live="polite">
        @foreach (var urun in vm.IlkSayfa)
        {
            @await Html.PartialAsync("~/Views/ProjeElementleri/Urun/_UrunKarti.cshtml", urun)
        }
    </div>
    <template data-ms-infinite-template>
        @await Html.PartialAsync("~/Views/ProjeElementleri/Urun/_UrunKarti.cshtml", null)
    </template>
    <div class="ms-infinite-ornek-yukleniyor" data-ms-infinite-yukleniyor>Yeni ürünler yükleniyor...</div>
</section>

@* Bu script: Ürün listesi sayfası için infinite-scroll ayarını tanımlar (B7: canlı veri;
   B10: filtre/sıralama sunucu tarafında — değişiklikler URL parametreleriyle yeniden yükler). *@
<script>
    window.msInfiniteConfigs = window.msInfiniteConfigs || {};
    (() => {
        const durum = {
            sayfaBoyu: @vm.SayfaBoyu,
            toplam: @vm.ToplamUrun,
            ssrAdet: @vm.IlkSayfa.Count,
            devamUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vm.DevamApiUrl)),
            tampon: {},              // globalIndex -> normalize edilmiş ürün
            istenenSayfalar: new Set()
        };

        const kacir = (metin) => String(metin ?? "").replace(/[&<>"']/g, (k) =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[k]);

        const trAd = (i18n) => (i18n && (i18n.tr || Object.values(i18n)[0])) || "";

        // İki liste DTO'su tek biçime indirgenir (kategori: basePrice, arama: minPrice).
        // Görselsiz renkler tooltip'te listelenmez (B9 kuralı — detay onları göstermez).
        const normallestir = (p) => {
            const secenekler = ((p.axisColors && p.axisColors.length > 0 ? p.axisColors : p.colors) || [])
                .filter((c) => c.imageUrl)
                .map((c) => ({ id: c.valueId, ad: trAd(c.nameI18n), gorsel: c.imageUrl }));
            return {
                kod: p.code,
                ad: trAd(p.nameI18n),
                gorsel: p.mainImageUrl || "",
                fiyat: p.basePrice ?? p.minPrice ?? 0,
                renkler: (p.colors || []).filter((c) => c.hexCode).map((c) => c.hexCode),
                renkSayisi: secenekler.length > 0 ? secenekler.length : (p.colors || []).length,
                degerler: (p.colors || []).map((c) => c.valueId)
                    .concat((p.attrs || []).map((a) => a.valueId)),
                galeri: (p.galleryUrls && p.galleryUrls.length > 0)
                    ? p.galleryUrls
                    : (p.mainImageUrl ? [p.mainImageUrl] : []),
                renkSecenekleri: secenekler,
                seciliRenk: p.selectedColorValueId || null,
                sponsorlu: p.isFeatured === true
            };
        };

        const sayfaGetir = (sayfaNo) => {
            if (durum.istenenSayfalar.has(sayfaNo)) {
                return;
            }

            durum.istenenSayfalar.add(sayfaNo);
            const ayirici = durum.devamUrl.includes("?") ? "&" : "?";
            fetch(`${durum.devamUrl}${ayirici}page=${sayfaNo}`)
                .then((cevap) => cevap.ok ? cevap.json() : null)
                .then((veri) => {
                    const kayitlar = veri?.data?.items || [];
                    kayitlar.forEach((kayit, i) => {
                        durum.tampon[(sayfaNo - 1) * durum.sayfaBoyu + i] = normallestir(kayit);
                    });
                    bekleyenleriDoldur();
                })
                .catch(() => durum.istenenSayfalar.delete(sayfaNo));
        };

        const kartDoldur = (kart, v) => {
            kart.dataset.msFiyat = String(v.fiyat);
            kart.dataset.msDegerler = v.degerler.join(",");

            const detayUrl = "/urun/" + encodeURIComponent(v.kod)
                + (v.seciliRenk ? "?color=" + encodeURIComponent(v.seciliRenk) : "");
            const link = kart.querySelector("[data-ms-kart-link]");
            if (link) {
                link.href = detayUrl;
                link.setAttribute("aria-label", v.ad + " ürün detayına git");
            }

            // B8 hover galerisi: görsel listesi + nokta göstergeleri. Modül skeleton'da boş
            // veriyle "hazır" işaretlenmiş olabilir — bayrak silinir ki yenile yeniden bağlasın.
            const galeri = kart.querySelector("[data-ms-urun-galeri]");
            if (galeri) {
                galeri.dataset.msUrunGaleriResimler = v.galeri.join("|") || v.gorsel;
                delete galeri.dataset.msUrunGaleriHazir;
            }

            const gorsel = kart.querySelector("[data-ms-urun-galeri-gorsel]");
            if (gorsel && v.gorsel) {
                gorsel.dataset.msLazySrc = v.gorsel;
                gorsel.alt = v.ad;
            }

            if (v.galeri.length > 1 && !kart.querySelector(".ms-urun-slider-noktalari")) {
                const noktalar = document.createElement("span");
                noktalar.className = "ms-urun-slider-noktalari";
                noktalar.setAttribute("aria-hidden", "true");
                noktalar.innerHTML = v.galeri
                    .map((_, i) => `<span${i === 0 ? ' class="ms-urun-slider-nokta-aktif"' : ""}></span>`)
                    .join("");
                kart.querySelector(".ms-urun-gorsel-alani")?.appendChild(noktalar);
            }

            const baslik = kart.querySelector(".ms-urun-basligi");
            if (baslik) {
                const [ilk, ...kalan] = v.ad.split(" ");
                baslik.innerHTML = `<strong>${kacir(ilk)}</strong> ${kacir(kalan.join(" "))}`;
            }

            const fiyat = kart.querySelector(".ms-urun-fiyat");
            if (fiyat) {
                fiyat.textContent = v.fiyat.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " TL";
            }

            // B8 renk tooltip'i — SSR markup'ının birebir aynısı; rozetten ÖNCE eklenmeli
            // (site.js rozeti bağlarken tooltip alanını arar, bulamazsa bir daha bağlamaz)
            if (v.renkSecenekleri.length >= 2 && !kart.querySelector(".ms-urun-renk-tooltip-alani")) {
                const secenekHtml = (renk, ekSinif) => `
                    <a class="ms-urun-renk-tooltip-gorsel${ekSinif}" href="/urun/${encodeURIComponent(v.kod)}?color=${encodeURIComponent(renk.id)}">
                        <img data-ms-lazy-src="${kacir(renk.gorsel || v.gorsel)}" alt="${kacir(renk.ad)} renk seçeneği"><span>${kacir(renk.ad)}</span></a>`;
                const alan = document.createElement("div");
                alan.className = "ms-urun-renk-tooltip-alani";
                const fazlasi = v.renkSecenekleri.length > 4
                    ? `<span>+${v.renkSecenekleri.length - 4} Renk ›</span>`
                    : "";
                alan.innerHTML = `
                    <span class="ms-urun-renk-tooltip">
                        <span class="ms-urun-renk-tooltip-baslik">
                            <span>Farklı Renk Seçenekleri <span class="ms-urun-renk-tooltip-sayac">(${v.renkSecenekleri.length})</span></span>
                            ${fazlasi}
                            <button class="ms-urun-renk-tooltip-kapat" type="button" data-ms-renk-tooltip-kapat aria-label="Renk seçeneklerini kapat">×</button>
                        </span>
                        <span class="ms-urun-renk-tooltip-liste">
                            ${v.renkSecenekleri.slice(0, 4).map((renk) => secenekHtml(renk, "")).join("")}
                            ${v.renkSecenekleri.map((renk) => secenekHtml(renk, " ms-urun-renk-tooltip-gorsel-mobil")).join("")}
                        </span>
                    </span>`;
                kart.querySelector(".ms-urun-gorsel-alani")?.after(alan);
            }

            // B11: Sponsorlu rozeti — SSR markup'la birebir (öne çıkar penceresi içindekiler)
            if (v.sponsorlu && !kart.querySelector(".ms-urun-sponsor")) {
                const sponsor = document.createElement("span");
                sponsor.className = "ms-urun-sponsor";
                sponsor.textContent = "Sponsorlu";
                kart.querySelector(".ms-urun-gorsel-alani")?.prepend(sponsor);
            }

            // Renk rozeti — SSR kartlarındaki markup'ın birebir aynısı enjekte edilir
            if (v.renkSayisi >= 2 && v.renkler.length > 0 && !kart.querySelector(".ms-urun-renk-rozet")) {
                const rozet = document.createElement("span");
                rozet.className = "ms-urun-renk-rozet";
                const ikinci = v.renkler[1]
                    ? `<span class="ms-urun-renk ms-urun-renk-pembe" style="background-image:none;background-color:${kacir(v.renkler[1])}"></span>`
                    : "";
                rozet.innerHTML = `<span class="ms-urun-renkler" aria-hidden="true"><span class="ms-urun-renk ms-urun-renk-mavi" style="background-image:none;background-color:${kacir(v.renkler[0])}"></span>${ikinci}</span> ${v.renkSayisi}`;
                kart.querySelector(".ms-urun-gorsel-alani")?.appendChild(rozet);
            }

            kart.dataset.msDolu = "true";
        };

        const bekleyenleriDoldur = () => {
            const liste = document.querySelector(".ms-urun-listesi-urun-alani [data-ms-infinite-liste]");
            if (!liste) {
                return;
            }

            let dolduruldu = false;
            liste.querySelectorAll("[data-ms-veri-index]:not([data-ms-dolu='true'])").forEach((kart) => {
                const index = Number(kart.dataset.msVeriIndex);
                const veri = durum.tampon[index];

                if (veri) {
                    kartDoldur(kart, veri);
                    dolduruldu = true;
                } else {
                    sayfaGetir(Math.floor(index / durum.sayfaBoyu) + 1);
                }
            });

            if (dolduruldu) {
                window.msLazyLoadYenile?.(liste);
                window.msUrunKartDavranislariYenile?.(liste);
            }
        };

        // ── B10: Filtre + sıralama SUNUCU tarafında — her değişiklik URL query
        // parametreleriyle (attrs/priceMin/priceMax/sort, api/store adlarıyla birebir)
        // sayfayı yeniden yükler; SSR seçili durumu geri işaretler, infinite scroll aynı
        // parametrelerle devam eder. B7'nin yüklü-kartlara-uygulanan client motoru kaldırıldı.
        const parametrelerleGit = (degisiklik = {}) => {
            const p = new URLSearchParams(window.location.search);

            const seciliDegerler = [...new Set([...document.querySelectorAll("[data-ms-filtre-deger]")]
                .filter((girdi) => girdi.checked)
                .map((girdi) => girdi.dataset.msFiltreDeger))];
            seciliDegerler.length ? p.set("attrs", seciliDegerler.join(",")) : p.delete("attrs");

            if ("fiyatMin" in degisiklik) {
                degisiklik.fiyatMin === null ? p.delete("priceMin") : p.set("priceMin", String(degisiklik.fiyatMin));
            }
            if ("fiyatMax" in degisiklik) {
                degisiklik.fiyatMax === null ? p.delete("priceMax") : p.set("priceMax", String(degisiklik.fiyatMax));
            }
            if ("sirala" in degisiklik) {
                degisiklik.sirala && degisiklik.sirala !== "default"
                    ? p.set("sort", degisiklik.sirala)
                    : p.delete("sort");
            }

            const sorgu = p.toString();
            window.location.href = window.location.pathname + (sorgu ? "?" + sorgu : "");
        };

        const panelFiyatOku = (panel) => {
            const [enAz, enCok] = panel.querySelectorAll("input[type='number']");
            const radyo = panel.querySelector("input[type='radio']:checked");
            const aralik = radyo?.closest("label")?.dataset.msFiyatAralik;

            if (aralik) {
                const [min, max] = aralik.split("-").map(Number);
                return {
                    fiyatMin: Number.isFinite(min) ? min : null,
                    fiyatMax: Number.isFinite(max) ? max : null
                };
            }

            const min = parseFloat(enAz?.value ?? "");
            const max = parseFloat(enCok?.value ?? "");
            return {
                fiyatMin: Number.isFinite(min) ? min : null,
                fiyatMax: Number.isFinite(max) ? max : null
            };
        };

        document.addEventListener("change", (olay) => {
            const girdi = olay.target;

            if (girdi.matches?.("[data-ms-kategori-url]") && girdi.checked) {
                window.location.href = girdi.dataset.msKategoriUrl;
                return;
            }

            if (girdi.matches?.("[data-ms-filtre-deger]")) {
                // Aynı değerin diğer kopyalarını senkronla (sol filtre + üst panel + mobil
                // paneller aynı valueId'yi taşır; SSR hepsini işaretli getirir — kopya
                // senkronlanmazsa kaldırma işlemi URL'den düşmez).
                document.querySelectorAll(`[data-ms-filtre-deger="${girdi.dataset.msFiltreDeger}"]`)
                    .forEach((es) => { es.checked = girdi.checked; });

                // Sol filtre anında uygular; panel içindekiler (üst filtre, mobil chip/detay)
                // kendi "Filtrele" butonunu bekler — panelde çoklu seçim her tıklamada
                // sayfa yenilemesin.
                if (!girdi.closest("[data-ms-urun-listesi-filtre-panel], [data-ms-mobil-chip-panel], [data-ms-urun-mobil-filtre-detay]")) {
                    parametrelerleGit();
                }
            }
        });

        document.addEventListener("click", (olay) => {
            const uygula = olay.target.closest?.(".ms-filtre-uygula-buton, [data-ms-mobil-chip-panel-kapat], [data-ms-urun-mobil-filtre-detay-kapat]");
            if (uygula) {
                const panel = uygula.closest("[data-filter-content], [data-ms-urun-listesi-filtre-panel], [data-ms-mobil-chip-panel], [data-ms-urun-mobil-filtre-detay]");
                const degisiklik = panel?.querySelector("input[type='number']")
                    ? panelFiyatOku(panel)
                    : {};
                parametrelerleGit(degisiklik);
                return;
            }

            const siralamaSecenegi = olay.target.closest?.("[data-ms-siralama-kod]");
            if (siralamaSecenegi) {
                parametrelerleGit({ sirala: siralamaSecenegi.dataset.msSiralamaKod });
            }
        });

        window.msInfiniteConfigs["urun-listesi"] = {
            ilk: 0, // ilk sayfa sunucudan render edildi (plan 3.3) — modül devam kartlarını üretir
            adet: durum.sayfaBoyu,
            toplam: Math.max(0, durum.toplam - durum.ssrAdet),
            esik: 0.8,
            sadeceIlkYukle: true,
            stateKey: "ms-infinite-scroll:" + window.location.pathname + window.location.search,
            kartHazirla: (parca, sira) => {
                parca.querySelectorAll("[data-ms-kart-link-alani]").forEach((kart) => {
                    kart.dataset.msVeriIndex = String(durum.ssrAdet + sira - 1);
                });
            },
            sonra: (liste) => {
                window.msProjeElementleriScrollGeriYukle?.();
                window.msUrunKartDavranislariYenile?.(liste);
                bekleyenleriDoldur();
            }
        };

        // İlk devam sayfasını önden getir + kısa içerikte scroll tetiklenemiyorsa modülü dürt
        document.addEventListener("DOMContentLoaded", () => {
            if (durum.ssrAdet < durum.toplam) {
                sayfaGetir(2);
                window.setTimeout(() => window.dispatchEvent(new Event("resize")), 300);
            }
        });
    })();
</script>
