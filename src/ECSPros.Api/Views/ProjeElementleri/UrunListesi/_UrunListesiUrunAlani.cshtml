@using ECSPros.Api.Models.Store
@{
    // B7: Ürün alanı canlı veriye bağlandı. Kart markup'ı misharix template'inin birebir
    // kopyasıdır — B6'dan itibaren paylaşılan _UrunKarti partial'ında (ana sayfa carousel'leri
    // ile tek kaynak); ilk sayfa sunucudan render edilir (plan 3.3), devamı misharix
    // infinite-scroll modülüyle (kartHazirla/sonra hook'ları) JSON'dan gelir.
    var vm = ViewData["MsUrunListesi"] as UrunListesiVm
             ?? new UrunListesiVm("Ürünler", 0, 24, [], "", [], 0, 0, []);
}
<section class="ms-urun-listesi-urun-alani lazy-infinite-on" data-ms-page-module="infinite-scroll" data-ms-infinite-scroll data-ms-infinite-config="urun-listesi" data-ms-infinite-toplam="100" data-ms-infinite-ilk="20" data-ms-infinite-adet="20" data-ms-infinite-esik="0.8" data-ms-infinite-sadece-ilk="true" aria-label="Ürünlerin yayınlanacağı alan">
    @await Html.PartialAsync("~/Views/ProjeElementleri/UrunListesi/_UrunListesiSagUstFiltre.cshtml")

    <div class="ms-urun-listesi-urun-grid" data-ms-infinite-liste aria-live="polite">
        @foreach (var urun in vm.IlkSayfa)
        {
            @await Html.PartialAsync("~/Views/ProjeElementleri/Urun/_UrunKarti.cshtml", urun)
        }
    </div>
    @if (vm.IlkSayfa.Count == 0 && vm.BosDurumMesaji is { Length: > 0 })
    {
        @* Bos liste aciklamasi: bos kategori / sonucsuz arama / sonucsuz filtre. *@
        <div class="ms-urun-listesi-bos" data-ms-liste-bos>
            <i class="fa-solid fa-box-open ms-fa-ikon ms-urun-listesi-bos-ikon" aria-hidden="true"></i>
            <p class="ms-urun-listesi-bos-metin">@vm.BosDurumMesaji</p>
            <a class="ms-buton ms-buton-m ms-buton-koyu" href="/urun-listesi">Tüm ürünlere göz atın</a>
        </div>
        <style>
            .ms-urun-listesi-bos { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 56px 16px; text-align: center; }
            .ms-urun-listesi-bos-ikon { font-size: 40px; color: #c4c4c4; }
            .ms-urun-listesi-bos-metin { margin: 0; font-size: 16px; color: #4a4a4a; }
        </style>
    }
    <template data-ms-infinite-template>
        @await Html.PartialAsync("~/Views/ProjeElementleri/Urun/_UrunKarti.cshtml", null)
    </template>
    <div class="ms-infinite-ornek-yukleniyor" data-ms-infinite-yukleniyor>Yeni ürünler yükleniyor...</div>
</section>

@* Bu script: Ürün listesi sayfası için infinite-scroll ayarını tanımlar (B7: canlı veri;
   B10: filtre/sıralama sunucu tarafında — değişiklikler URL parametreleriyle yeniden yükler). *@
<script>
    window.msInfiniteConfigs = window.msInfiniteConfigs || {};
    (() => {
        const durum = {
            sayfaBoyu: @vm.SayfaBoyu,
            toplam: @vm.ToplamUrun,
            ssrAdet: @vm.IlkSayfa.Count,
            // 2026-07-17: ?page=N ile gelindiğinde SSR N. sayfadan başlar — iç sayfa
            // numaraları (1=ilk SSR bloğu) API'ye bu ofsetle çevrilir, URL de öyle yazılır.
            sayfaOfset: @(vm.BaslangicSayfa - 1),
            devamUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vm.DevamApiUrl)),
            tampon: {},              // globalIndex -> normalize edilmiş ürün
            istenenSayfalar: new Set()
        };
        // Ofsetli başlangıçta kalan ürün sayısı (önceki sayfalar listelenmez)
        durum.kalanToplam = Math.max(0, durum.toplam - durum.sayfaOfset * durum.sayfaBoyu);

        const kacir = (metin) => String(metin ?? "").replace(/[&<>"']/g, (k) =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[k]);

        const trAd = (i18n) => (i18n && (i18n.tr || Object.values(i18n)[0])) || "";

        // İki liste DTO'su tek biçime indirgenir (kategori: basePrice, arama: minPrice).
        // Görselsiz renkler tooltip'te listelenmez (B9 kuralı — detay onları göstermez).
        const normallestir = (p) => {
            const secenekler = ((p.axisColors && p.axisColors.length > 0 ? p.axisColors : p.colors) || [])
                .filter((c) => c.imageUrl)
                .map((c) => ({ id: c.valueId, ad: trAd(c.nameI18n), gorsel: c.imageUrl, slug: c.slug || null })); // 2b: renk slug'ı
            return {
                kod: p.code,
                ad: trAd(p.nameI18n),
                gorsel: p.mainImageUrl || "",
                fiyat: p.basePrice ?? p.minPrice ?? 0,
                renkler: (p.colors || []).filter((c) => c.hexCode).map((c) => c.hexCode),
                renkSayisi: secenekler.length > 0 ? secenekler.length : (p.colors || []).length,
                degerler: (p.colors || []).map((c) => c.valueId)
                    .concat((p.attrs || []).map((a) => a.valueId)),
                galeri: (p.galleryUrls && p.galleryUrls.length > 0)
                    ? p.galleryUrls
                    : (p.mainImageUrl ? [p.mainImageUrl] : []),
                renkSecenekleri: secenekler,
                seciliRenk: p.selectedColorValueId || null,
                slug: p.slug || null,         // 2b: kartın gerçek URL slug'ı (varsa doğrudan link)
                sponsorlu: p.isFeatured === true,
                puan: p.rating || 0,          // E7: onaylı yorum ortalaması
                puanSayisi: p.reviewCount || 0,
                videoUrl: p.videoUrl || null, // H5: Videolu Ürün rozeti
                eskiFiyat: p.compareAtPrice || null,  // 2026-07-31: indirim öncesi çizili fiyat
                kampanyaAd: p.campaignName || null,   // F3: kampanya adı/rozeti
                kampanyaFiyat: p.campaignPrice || null, // F3: ürün-bazlı kampanyalı fiyat
                kampanyaRozetler: (p.campaignBadges || []).map((b) => ({ ad: b.name, renk: b.color || null })), // 2026-08-03: bantta dönüşümlü (ad+renk)
                kartMesajlar: (p.cardMessages || []).map((m) => ({ slot: m.slot, metin: m.text, ikon: m.icon || null, renk: m.color || null })), // F2: elle kart mesajları
                sepetteSayisi: p.cartCount || 0,  // sosyal kanıt: son 30 günde kaç farklı sepette
                favoriSayisi: p.favoriteCount || 0, // sosyal kanıt: kaç farklı üyenin favorisi
                bakanSayisi: p.viewCount || 0     // sosyal kanıt: kaç farklı üye baktı
            };
        };

        const sayfaGetir = (sayfaNo) => {
            if (durum.istenenSayfalar.has(sayfaNo)) {
                return;
            }

            durum.istenenSayfalar.add(sayfaNo);
            const ayirici = durum.devamUrl.includes("?") ? "&" : "?";
            fetch(`${durum.devamUrl}${ayirici}page=${sayfaNo + durum.sayfaOfset}`)
                .then((cevap) => cevap.ok ? cevap.json() : null)
                .then((veri) => {
                    const kayitlar = veri?.data?.items || [];
                    kayitlar.forEach((kayit, i) => {
                        durum.tampon[(sayfaNo - 1) * durum.sayfaBoyu + i] = normallestir(kayit);
                    });
                    bekleyenleriDoldur();
                })
                .catch(() => durum.istenenSayfalar.delete(sayfaNo));
        };

        // F1 (2026-08-09): JS'in enjekte ettiği elementler kanal kart ayarına uyar
        // (_MsKartAyarlari partial'ı window.msKartAyarlari'nı basar; yoksa hepsi açık).
        // SSR placeholder'ları (puan/bant/indirim/kampanya fiyatı) kapalıyken şablonda hiç
        // olmadığından aşağıdaki querySelector'lar null döner ve bloklar kendiliğinden atlanır.
        const kartAyar = window.msKartAyarlari || {};

        const kartDoldur = (kart, v) => {
            kart.dataset.msFiyat = String(v.fiyat);
            kart.dataset.msDegerler = v.degerler.join(",");
            kart.dataset.msUrunKod = v.kod; // E5 favori/bookmark kod çözümü
            kart.dataset.msUrunId = v.kod;  // tasarım sözleşmesi: ortak renk modalı ürün kimliği
            kart.dataset.msSeciliRenk = v.seciliRenk || ""; // favori anahtarı ürün+renk

            // E7: puan bölümü (SSR markup'la birebir; yorumsuz üründe gizli kalır)
            const puanAlani = kart.querySelector("[data-ms-kart-puan]");
            if (puanAlani && v.puanSayisi > 0) {
                const dolu = Math.round(v.puan);
                puanAlani.innerHTML = `
                    <span>${v.puan.toLocaleString("tr-TR", { minimumFractionDigits: 1, maximumFractionDigits: 1 })}</span>
                    <span class="ms-urun-yildizlar" aria-label="${v.puan} yıldız">
                        ${[1, 2, 3, 4, 5].map((y) => `<i class="fa-${y <= dolu ? "solid" : "regular"} fa-star ms-fa-ikon " aria-hidden="true"></i>`).join("")}
                    </span>
                    <span>(${v.puanSayisi})</span>`;
                puanAlani.hidden = false;
            }

            // 2b: gerçek URL slug'ı varsa doğrudan (301 hop'u yok); yoksa /urun/{kod}?color= (güvenlik ağı)
            const detayUrl = v.slug
                ? "/" + v.slug
                : "/urun/" + encodeURIComponent(v.kod)
                    + (v.seciliRenk ? "?color=" + encodeURIComponent(v.seciliRenk) : "");
            const link = kart.querySelector("[data-ms-kart-link]");
            if (link) {
                link.href = detayUrl;
                link.setAttribute("aria-label", v.ad + " ürün detayına git");
            }

            // B8 hover galerisi: görsel listesi + nokta göstergeleri. Modül skeleton'da boş
            // veriyle "hazır" işaretlenmiş olabilir — bayrak silinir ki yenile yeniden bağlasın.
            const galeri = kart.querySelector("[data-ms-urun-galeri]");
            if (galeri) {
                galeri.dataset.msUrunGaleriResimler = v.galeri.join("|") || v.gorsel;
                delete galeri.dataset.msUrunGaleriHazir;
            }

            const gorsel = kart.querySelector("[data-ms-urun-galeri-gorsel]");
            if (gorsel && v.gorsel) {
                gorsel.dataset.msLazySrc = v.gorsel;
                gorsel.alt = v.ad;
            } else if (gorsel) {
                // Görselsiz ürün: no-image placeholder (site geneli kuralı, 2026-07-17)
                gorsel.src = "/images/no-image.svg";
                gorsel.alt = v.ad;
                gorsel.dataset.msNoImage = "true";
            }

            if (kartAyar.galeriNoktalari !== false && v.galeri.length > 1 && !kart.querySelector(".ms-urun-slider-noktalari")) {
                const noktalar = document.createElement("span");
                noktalar.className = "ms-urun-slider-noktalari";
                noktalar.setAttribute("aria-hidden", "true");
                noktalar.innerHTML = v.galeri
                    .map((_, i) => `<span${i === 0 ? ' class="ms-urun-slider-nokta-aktif"' : ""}></span>`)
                    .join("");
                kart.querySelector(".ms-urun-gorsel-alani")?.appendChild(noktalar);
            }

            const baslik = kart.querySelector(".ms-urun-basligi");
            if (baslik) {
                const [ilk, ...kalan] = v.ad.split(" ");
                baslik.innerHTML = `<strong>${kacir(ilk)}</strong> ${kacir(kalan.join(" "))}`;
            }

            const fiyat = kart.querySelector(".ms-urun-fiyat");
            if (fiyat) {
                fiyat.textContent = v.fiyat.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " TL";
            }

            // İndirim satırı: eski (çizili) fiyat + indirim yüzdesi (eskiFiyat > satış fiyatı ise)
            const indirimSatiri = kart.querySelector("[data-ms-kart-indirim-satiri]");
            if (indirimSatiri) {
                if (v.eskiFiyat && v.eskiFiyat > v.fiyat) {
                    const yuzde = Math.round((v.eskiFiyat - v.fiyat) / v.eskiFiyat * 100);
                    const rozet = indirimSatiri.querySelector("[data-ms-kart-indirim-rozet]");
                    const eski = indirimSatiri.querySelector("[data-ms-kart-eski-fiyat]");
                    if (rozet) { rozet.textContent = "-%" + yuzde; }
                    if (eski) { eski.textContent = v.eskiFiyat.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " TL"; }
                    indirimSatiri.hidden = false;
                } else {
                    indirimSatiri.hidden = true;
                }
            }

            // F2: değişken alanlar (1 = bant, 2/3 = mesaj satırları) — kaynaklar (elle mesajlar +
            // kampanya rozetleri) kanal ayarındaki önceliğe göre birleşir; rotasyonları _Layout
            // script'leri döndürür. Placeholder ayar gereği şablonda yoksa alan hiç oluşmaz.
            const alanCfg = (n) => kartAyar["alan" + n]
                || { acik: true, kampanyalar: n === 1, mesajlar: true, mesajlarOnce: true };
            const temizIkon = (s) => String(s || "").replace(/[^a-z0-9-]/g, "");
            const paletHex = { yesil: "#16a34a", turuncu: "#ea580c", bordo: "#9f1239", pembe: "#db2777" };
            const kampanyaRozetListesi = () => (v.kampanyaRozetler && v.kampanyaRozetler.length)
                ? v.kampanyaRozetler
                : (v.kampanyaAd ? [{ ad: v.kampanyaAd, renk: null }] : []);

            const kmpBant = kart.querySelector("[data-ms-kart-kampanya-bandi]");
            if (kmpBant) {
                const a1 = alanCfg(1);
                const kampanyalar = a1.kampanyalar ? kampanyaRozetListesi() : [];
                const mesajlar = a1.mesajlar !== false
                    ? (v.kartMesajlar || []).filter((m) => m.slot === 1)
                        .map((m) => ({ ad: m.metin, renk: m.renk ? (paletHex[m.renk] || null) : null }))
                    : [];
                const rozetler = a1.mesajlarOnce !== false
                    ? mesajlar.concat(kampanyalar) : kampanyalar.concat(mesajlar);
                if (rozetler.length) {
                    kmpBant.textContent = rozetler[0].ad;
                    kmpBant.style.backgroundColor = rozetler[0].renk || "";
                    kmpBant.dataset.msKampanyaRotasyon = JSON.stringify(rozetler);
                    kmpBant.hidden = false;
                } else {
                    kmpBant.hidden = true;
                    kmpBant.style.backgroundColor = "";
                    delete kmpBant.dataset.msKampanyaRotasyon;
                }
            }

            // F2 alan 2/3: şablondaki placeholder (ms-urun-teslimat / ms-urun-kargo) doldurulur
            const alanDoldur = (slot) => {
                const alanEl = kart.querySelector(`[data-ms-kart-alan="${slot}"]`);
                if (!alanEl) { return; }
                const cfg = alanCfg(slot);
                const mesajlar = cfg.mesajlar !== false
                    ? (v.kartMesajlar || []).filter((m) => m.slot === slot)
                        .map((m) => ({ metin: m.metin, ikon: temizIkon(m.ikon), sinif: m.renk ? "ms-metin-" + m.renk : null, renk: null }))
                    : [];
                const kampanyalar = cfg.kampanyalar
                    ? kampanyaRozetListesi().map((k) => ({ metin: k.ad, ikon: "fa-tags", sinif: null, renk: k.renk }))
                    : [];
                const ogeler = cfg.mesajlarOnce !== false
                    ? mesajlar.concat(kampanyalar) : kampanyalar.concat(mesajlar);
                // Sosyal kanıt (yalnız alan 3): canlı sepet/favori sayaçları rotasyona sondan
                // eklenir; sayaç 0 ise satır hiç oluşmaz (SSR kartıyla aynı kural).
                if (slot === 3) {
                    if (cfg.sepetSayisi && v.sepetteSayisi > 0) {
                        ogeler.push({ metin: v.sepetteSayisi.toLocaleString("tr-TR") + " kişinin sepetinde", ikon: "fa-cart-shopping", sinif: "ms-metin-turuncu", renk: null });
                    }
                    if (cfg.favoriSayisi && v.favoriSayisi > 0) {
                        ogeler.push({ metin: v.favoriSayisi.toLocaleString("tr-TR") + " kişinin favorisi", ikon: "fa-heart", sinif: "ms-metin-turuncu", renk: null });
                    }
                    if (cfg.bakanSayisi && v.bakanSayisi > 0) {
                        ogeler.push({ metin: v.bakanSayisi.toLocaleString("tr-TR") + " kişi baktı", ikon: "fa-eye", sinif: "ms-metin-turuncu", renk: null });
                    }
                }
                const gecis = alanEl.querySelector("[data-ms-mesaj-rotasyon]");
                if (!ogeler.length || !gecis) { alanEl.hidden = true; return; }
                const ilk = ogeler[0];
                gecis.dataset.msMesajRotasyon = JSON.stringify(ogeler);
                gecis.setAttribute("aria-label", ogeler.map((o) => o.metin).join(", "));
                gecis.innerHTML = `<span class="ms-urun-mesaj-satiri"><i class="fa-solid ${ilk.ikon || "fa-circle-info"} ms-fa-ikon ms-urun-mini-ikon" aria-hidden="true"></i><span${ilk.sinif ? ` class="${ilk.sinif}"` : ""}${ilk.renk ? ` style="color:${kacir(ilk.renk)}"` : ""}></span></span>`;
                gecis.querySelector(".ms-urun-mesaj-satiri").lastElementChild.textContent = ilk.metin;
                alanEl.hidden = false;
            };
            alanDoldur(2);
            alanDoldur(3);
            const kmpSatiri = kart.querySelector("[data-ms-kart-kampanya-fiyat-satiri]");
            if (kmpSatiri) {
                if (v.kampanyaFiyat && v.kampanyaFiyat < v.fiyat) {
                    const kf = kmpSatiri.querySelector("[data-ms-kart-kampanya-fiyat]");
                    if (kf) { kf.textContent = v.kampanyaFiyat.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " TL"; }
                    kmpSatiri.hidden = false;
                } else {
                    kmpSatiri.hidden = true;
                }
            }

            // B8 renk tooltip'i — SSR markup'ının birebir aynısı; rozetten ÖNCE eklenmeli
            // (site.js rozeti bağlarken tooltip alanını arar, bulamazsa bir daha bağlamaz)
            if (kartAyar.renkRozeti !== false && v.renkSecenekleri.length >= 2 && !kart.querySelector(".ms-urun-renk-tooltip-alani")) {
                const secenekHtml = (renk, ekSinif) => `
                    <a class="ms-urun-renk-tooltip-gorsel${ekSinif}" href="${renk.slug ? "/" + renk.slug : "/urun/" + encodeURIComponent(v.kod) + "?color=" + encodeURIComponent(renk.id)}">
                        <img data-ms-lazy-src="${kacir(renk.gorsel || v.gorsel)}" alt="${kacir(renk.ad)} renk seçeneği" width="90" height="134" loading="lazy" decoding="async"><span>${kacir(renk.ad)}</span></a>`;
                const alan = document.createElement("div");
                alan.className = "ms-urun-renk-tooltip-alani";
                alan.setAttribute("role", "dialog");
                alan.setAttribute("aria-label", "Ürünün diğer renkleri");
                const fazlasi = v.renkSecenekleri.length > 4
                    ? `<span>+${v.renkSecenekleri.length - 4} Renk <i class="fa-solid fa-chevron-right ms-fa-ikon" aria-hidden="true"></i></span>`
                    : "";
                alan.innerHTML = `
                    <span class="ms-urun-renk-tooltip">
                        <span class="ms-urun-renk-tooltip-baslik">
                            <span>Farklı Renk Seçenekleri <span class="ms-urun-renk-tooltip-sayac">(${v.renkSecenekleri.length})</span></span>
                            ${fazlasi}
                            <button class="ms-urun-renk-tooltip-kapat" type="button" data-ms-renk-tooltip-kapat aria-label="Renk seçeneklerini kapat"><i class="fa-solid fa-xmark ms-fa-ikon" aria-hidden="true"></i></button>
                        </span>
                        <span class="ms-urun-renk-tooltip-liste">
                            ${v.renkSecenekleri.slice(0, 4).map((renk) => secenekHtml(renk, "")).join("")}
                            ${v.renkSecenekleri.map((renk) => secenekHtml(renk, " ms-urun-renk-tooltip-gorsel-mobil")).join("")}
                        </span>
                    </span>`;
                kart.querySelector(".ms-urun-gorsel-alani")?.after(alan);
            }

            // H5: Videolu Ürün rozeti — SSR kartlarındaki markup'ın birebir aynısı enjekte
            // edilir (hover tooltip videosu site.js data-ms-urun-video davranışıyla).
            if (kartAyar.videoRozeti !== false && v.videoUrl && !kart.querySelector("[data-ms-urun-video]")) {
                const etiketAlani = document.createElement("span");
                etiketAlani.className = "ms-urun-gorsel-etiketleri";
                etiketAlani.innerHTML = `<span class="ms-urun-video-alani" data-ms-urun-video>
                    <button class="ms-urun-video-rozeti" type="button" aria-expanded="false" aria-label="Videolu ürünü göster">
                        <i class="fa-solid fa-play ms-fa-ikon ms-urun-video-ikon" aria-hidden="true"></i>
                        Videolu Ürün
                    </button>
                    <span class="ms-urun-video-tooltip">
                        <video class="ms-urun-video" src="${kacir(v.videoUrl)}" muted loop playsinline preload="none"></video>
                    </span>
                </span>`;
                kart.querySelector(".ms-urun-gorsel-alani")?.prepend(etiketAlani);
                window.msUrunVideoDavranisiHazirla?.(etiketAlani);
            }

            // B11: Sponsorlu rozeti — SSR markup'la birebir (öne çıkar penceresi içindekiler)
            if (kartAyar.sponsorRozeti !== false && v.sponsorlu && !kart.querySelector(".ms-urun-sponsor")) {
                const sponsor = document.createElement("span");
                sponsor.className = "ms-urun-sponsor";
                sponsor.textContent = "Sponsorlu";
                kart.querySelector(".ms-urun-gorsel-alani")?.prepend(sponsor);
            }

            // Renk rozeti — tasarım kaynağı markup'ı BİREBİR (iki sabit dekoratif nokta + sayı).
            // Çok renkli her üründe (SSR ile aynı koşul: renkSecenekleri >= 2). Yorum/inline style yok.
            if (kartAyar.renkRozeti !== false && v.renkSecenekleri.length >= 2 && !kart.querySelector(".ms-urun-renk-rozet")) {
                const rozet = document.createElement("button");
                rozet.type = "button";
                rozet.className = "ms-urun-renk-rozet";
                rozet.setAttribute("aria-haspopup", "dialog");
                rozet.setAttribute("aria-expanded", "false");
                rozet.setAttribute("aria-label", `${v.renkSayisi} diğer renk seçeneğini göster`);
                rozet.innerHTML = `<span class="ms-urun-renkler" aria-hidden="true"><span class="ms-urun-renk ms-urun-renk-mavi"></span><span class="ms-urun-renk ms-urun-renk-pembe"></span></span> ${v.renkSayisi}`;
                kart.querySelector(".ms-urun-gorsel-alani")?.appendChild(rozet);
            }

            kart.dataset.msDolu = "true";
        };

        const bekleyenleriDoldur = () => {
            const liste = document.querySelector(".ms-urun-listesi-urun-alani [data-ms-infinite-liste]");
            if (!liste) {
                return;
            }

            let dolduruldu = false;
            liste.querySelectorAll("[data-ms-veri-index]:not([data-ms-dolu='true'])").forEach((kart) => {
                const index = Number(kart.dataset.msVeriIndex);
                const veri = durum.tampon[index];

                if (veri) {
                    kartDoldur(kart, veri);
                    dolduruldu = true;
                } else {
                    sayfaGetir(Math.floor(index / durum.sayfaBoyu) + 1);
                }
            });

            if (dolduruldu) {
                window.msLazyLoadYenile?.(liste);
                window.msUrunKartDavranislariYenile?.(liste);
            }
        };

        // ── B10: Filtre + sıralama SUNUCU tarafında — her değişiklik URL query
        // parametreleriyle (attrs/priceMin/priceMax/sort, api/store adlarıyla birebir)
        // sayfayı yeniden yükler; SSR seçili durumu geri işaretler, infinite scroll aynı
        // parametrelerle devam eder. B7'nin yüklü-kartlara-uygulanan client motoru kaldırıldı.
        const parametrelerleGit = (degisiklik = {}) => {
            const p = new URLSearchParams(window.location.search);

            const seciliDegerler = [...new Set([...document.querySelectorAll("[data-ms-filtre-deger]")]
                .filter((girdi) => girdi.checked)
                .map((girdi) => girdi.dataset.msFiltreDeger))];
            seciliDegerler.length ? p.set("attrs", seciliDegerler.join(",")) : p.delete("attrs");
            p.delete("page"); // filtre/sıralama değişince sayfa numarası sıfırlanır

            if ("fiyatMin" in degisiklik) {
                degisiklik.fiyatMin === null ? p.delete("priceMin") : p.set("priceMin", String(degisiklik.fiyatMin));
            }
            if ("fiyatMax" in degisiklik) {
                degisiklik.fiyatMax === null ? p.delete("priceMax") : p.set("priceMax", String(degisiklik.fiyatMax));
            }
            if ("sirala" in degisiklik) {
                degisiklik.sirala && degisiklik.sirala !== "default"
                    ? p.set("sort", degisiklik.sirala)
                    : p.delete("sort");
            }

            // Seçili kategori varsa hedef o kategorinin sayfasıdır; mevcut seçimler
            // query ile taşınır (SSR yeniden işaretler).
            const seciliKategori = document.querySelector("[data-ms-kategori-url]:checked");
            const hedefYol = seciliKategori
                ? seciliKategori.dataset.msKategoriUrl
                : window.location.pathname;

            const sorgu = p.toString();
            window.location.href = hedefYol + (sorgu ? "?" + sorgu : "");
        };

        const panelFiyatOku = (panel) => {
            const [enAz, enCok] = panel.querySelectorAll("input[type='number']");
            const radyo = panel.querySelector("input[type='radio']:checked");
            const aralik = radyo?.closest("label")?.dataset.msFiyatAralik;

            if (aralik) {
                const [min, max] = aralik.split("-").map(Number);
                return {
                    fiyatMin: Number.isFinite(min) ? min : null,
                    fiyatMax: Number.isFinite(max) ? max : null
                };
            }

            const min = parseFloat(enAz?.value ?? "");
            const max = parseFloat(enCok?.value ?? "");
            return {
                fiyatMin: Number.isFinite(min) ? min : null,
                fiyatMax: Number.isFinite(max) ? max : null
            };
        };

        document.addEventListener("change", (olay) => {
            const girdi = olay.target;

            // Tasarım davranışı: hiçbir seçim anında uygulanmaz — tüm bloklar kendi
            // "Filtrele" butonunu bekler. Kategori tek seçimdir (diğer kopyalar düşer).
            if (girdi.matches?.("[data-ms-kategori-url]") && girdi.checked) {
                document.querySelectorAll("[data-ms-kategori-url]:checked").forEach((es) => {
                    if (es !== girdi) { es.checked = false; }
                });
                return;
            }

            if (girdi.matches?.("[data-ms-filtre-deger]")) {
                // Aynı değerin diğer kopyalarını senkronla (sol filtre + üst panel + mobil
                // paneller aynı valueId'yi taşır; SSR hepsini işaretli getirir — kopya
                // senkronlanmazsa kaldırma işlemi URL'den düşmez).
                document.querySelectorAll(`[data-ms-filtre-deger="${girdi.dataset.msFiltreDeger}"]`)
                    .forEach((es) => { es.checked = girdi.checked; });
            }
        });

        // "Filtreleri Temizle": site.js checkbox/girdileri boşaltıp bu olayı yayınlar;
        // URL'de uygulanmış filtre varsa tek tıkta filtresiz listeye dönülür.
        document.addEventListener("ms:filtreler-temizlendi", () => {
            const p = new URLSearchParams(window.location.search);
            if (p.has("attrs") || p.has("priceMin") || p.has("priceMax")) {
                parametrelerleGit({ fiyatMin: null, fiyatMax: null });
            }
        });

        // CAPTURE şart (2026-07-30): üst filtre modülü panel tıklamalarında stopPropagation
        // çağırır — bubble'daki document dinleyicisine üst paneldeki "Filtrele" tıklaması
        // hiç ulaşmıyordu (üst Fiyat Aralığı/Cinsiyet uygulanmıyordu; sol panel bubble'la
        // çalışmaya devam ediyordu). Seçili-filtre kaldırma dinleyicisiyle aynı desen.
        document.addEventListener("click", (olay) => {
            const uygula = olay.target.closest?.(".ms-filtre-uygula-buton, [data-ms-mobil-chip-panel-kapat], [data-ms-urun-mobil-filtre-detay-kapat]");
            if (uygula) {
                const panel = uygula.closest("[data-filter-content], [data-ms-urun-listesi-filtre-panel], [data-ms-mobil-chip-panel], [data-ms-urun-mobil-filtre-detay]");
                const degisiklik = panel?.querySelector("input[type='number']")
                    ? panelFiyatOku(panel)
                    : {};
                parametrelerleGit(degisiklik);
                return;
            }

            const siralamaSecenegi = olay.target.closest?.("[data-ms-siralama-kod]");
            if (siralamaSecenegi) {
                parametrelerleGit({ sirala: siralamaSecenegi.dataset.msSiralamaKod });
            }
        }, true);

        window.msInfiniteConfigs["urun-listesi"] = {
            ilk: 0, // ilk sayfa sunucudan render edildi (plan 3.3) — modül devam kartlarını üretir
            adet: durum.sayfaBoyu,
            toplam: Math.max(0, durum.kalanToplam - durum.ssrAdet),
            esik: 0.8,
            sadeceIlkYukle: true,
            stateKey: "ms-infinite-scroll:" + window.location.pathname + window.location.search,
            kartHazirla: (parca, sira) => {
                parca.querySelectorAll("[data-ms-kart-link-alani]").forEach((kart) => {
                    kart.dataset.msVeriIndex = String(durum.ssrAdet + sira - 1);
                });
            },
            sonra: (liste) => {
                window.msProjeElementleriScrollGeriYukle?.();
                window.msUrunKartDavranislariYenile?.(liste);
                bekleyenleriDoldur();
            }
        };

        // İlk devam sayfasını önden getir + kısa içerikte scroll tetiklenemiyorsa modülü dürt
        document.addEventListener("DOMContentLoaded", () => {
            if (durum.ssrAdet < durum.kalanToplam) {
                sayfaGetir(2);
                window.setTimeout(() => window.dispatchEvent(new Event("resize")), 300);
            }
        });

        // ── 2026-07-17: görünür sayfa URL'e yazılır (?page=N, replaceState) + İKİ YÖNLÜ
        // yükleme — paylaşılan ?page=N sayfasından yukarı kaydırınca önceki sayfalar
        // listenin üstüne otomatik eklenir (kaydırma konumu korunur, ekran zıplamaz).
        (() => {
            const alanEl = document.querySelector("[data-ms-infinite-config='urun-listesi']");
            const liste = alanEl?.querySelector("[data-ms-infinite-liste]");
            const sablon = alanEl?.querySelector("[data-ms-infinite-template]");
            if (!alanEl || !liste) { return; }

            // İlk DOM kartının GERÇEK sayfa numarası — yukarı yükleme yaptıkça azalır
            const ustDurum = { ustSayfa: durum.sayfaOfset + 1, yukluyor: false };
            let sonYazilanSayfa = ustDurum.ustSayfa;
            let bekliyor = false;

            const oncekiSayfayiYukle = async () => {
                if (ustDurum.yukluyor || ustDurum.ustSayfa <= 1 || !sablon) { return; }
                ustDurum.yukluyor = true;
                const hedefSayfa = ustDurum.ustSayfa - 1;
                try {
                    const ayirici = durum.devamUrl.includes("?") ? "&" : "?";
                    const cevap = await fetch(`${durum.devamUrl}${ayirici}page=${hedefSayfa}`);
                    const veri = cevap.ok ? await cevap.json() : null;
                    const kayitlar = veri?.data?.items || [];
                    if (kayitlar.length === 0) { ustDurum.ustSayfa = 1; return; } // güvenlik ağı

                    const parca = document.createDocumentFragment();
                    kayitlar.forEach((kayit) => {
                        const kartParcasi = sablon.content.cloneNode(true);
                        const kart = kartParcasi.querySelector("[data-ms-kart-link-alani]");
                        if (!kart) { return; }
                        kartDoldur(kart, normallestir(kayit));
                        parca.appendChild(kartParcasi);
                    });

                    // Kaydırma çapası: mevcut ilk kartın ekran konumu korunur (CSS
                    // overflow-anchor:none — tarayıcının kendi çapasıyla çakışmasın)
                    const referans = liste.firstElementChild;
                    const oncekiTop = referans?.getBoundingClientRect().top ?? 0;
                    liste.insertBefore(parca, liste.firstElementChild);
                    ustDurum.ustSayfa = hedefSayfa;
                    const yeniTop = referans?.getBoundingClientRect().top ?? 0;
                    if (referans && yeniTop !== oncekiTop) {
                        window.scrollBy(0, yeniTop - oncekiTop);
                    }
                    window.msLazyLoadYenile?.(liste);
                    window.msUrunKartDavranislariYenile?.(liste);
                } catch { /* sonraki kaydırma denemesinde tekrar */ }
                finally { ustDurum.yukluyor = false; }
            };

            const yukariYuklemeGerekliMi = () =>
                ustDurum.ustSayfa > 1
                && !ustDurum.yukluyor
                && liste.getBoundingClientRect().top > -600; // liste başı yaklaşıyor

            const gorunenSayfayiYaz = () => {
                bekliyor = false;
                if (yukariYuklemeGerekliMi()) { oncekiSayfayiYukle(); }

                const kartlar = liste.querySelectorAll(".ms-urun-karti");
                if (kartlar.length === 0) { return; }
                const esikY = window.innerHeight * 0.6;
                let gorunenIndex = 0;
                for (let i = 0; i < kartlar.length; i++) {
                    if (kartlar[i].getBoundingClientRect().top <= esikY) { gorunenIndex = i; }
                    else { break; }
                }
                const sayfa = ustDurum.ustSayfa + Math.floor(gorunenIndex / durum.sayfaBoyu);
                if (sayfa === sonYazilanSayfa) { return; }
                sonYazilanSayfa = sayfa;
                const url = new URL(window.location.href);
                if (sayfa > 1) { url.searchParams.set("page", String(sayfa)); }
                else { url.searchParams.delete("page"); }
                window.history.replaceState(window.history.state, "", url);
            };

            window.addEventListener("scroll", () => {
                if (bekliyor) { return; }
                bekliyor = true;
                window.requestAnimationFrame(gorunenSayfayiYaz);
            }, { passive: true });

            // Paylaşılan sayfadan gelişte bir üst sayfa önden hazırlanır — ilk yukarı
            // kaydırma beklemesiz olsun.
            if (durum.sayfaOfset > 0) {
                document.addEventListener("DOMContentLoaded", () => { oncekiSayfayiYukle(); });
            }

            // (b) kararı: "sayfa başına dön" butonu, liste henüz 1. sayfadan başlamıyorsa
            // ?page'i temizleyip 1. sayfaya döner (document CAPTURE — layout'un smooth
            // scroll dinleyicisinden önce çalışır); liste 1'e ulaşmışsa normal kaydırma.
            document.addEventListener("click", (event) => {
                const buton = event.target instanceof Element
                    ? event.target.closest("[data-ms-sayfa-basi]")
                    : null;
                if (!buton || ustDurum.ustSayfa <= 1) { return; }
                event.preventDefault();
                event.stopPropagation();
                const url = new URL(window.location.href);
                url.searchParams.delete("page");
                window.location.href = url.toString();
            }, true);
        })();
    })();
</script>
