<section class="ms-urun-listesi-sayfa" data-ms-urun-listesi-gorunum="5" aria-label="Ürün listesi sayfa tasarımı">
    @await Html.PartialAsync("~/Views/ProjeElementleri/UrunListesi/_UrunListesiMobilFiltre.cshtml")

    <div class="ms-urun-listesi-grid">
        @await Html.PartialAsync("~/Views/ProjeElementleri/UrunListesi/_UrunListesiSolFiltre.cshtml")

        <div class="ms-urun-listesi-icerik" aria-label="Ürün listeleme alanı">
            @await Html.PartialAsync("~/Views/ProjeElementleri/UrunListesi/_UrunListesiUrunAlani.cshtml")
        </div>
    </div>
</section>

@* İE-3 (2026-08-22): takip için liste verisi — site.js msTakip view_item_list (+search) *@
@{
    var msTakipListe = ViewData["MsUrunListesi"] as ECSPros.Api.Models.Store.UrunListesiVm;
    var msTakipArama = Context.Request.Query["search"].FirstOrDefault();
}
@if (msTakipListe is not null)
{
<script type="application/json" id="ms-takip-liste">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
{
    listeId = Context.Request.Path.Value,
    baslik = msTakipListe.Baslik,
    arama = string.IsNullOrWhiteSpace(msTakipArama) ? null : msTakipArama,
    toplam = msTakipListe.ToplamUrun,
    urunler = msTakipListe.IlkSayfa.Take(20).Select(u => new { kod = u.Kod, ad = u.Ad, fiyat = u.Fiyat })
}))</script>
}
