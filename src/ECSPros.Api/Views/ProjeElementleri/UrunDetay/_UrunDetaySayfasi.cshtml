        (() => {
            document.querySelectorAll('a[href="#urun-tum-ozellikleri"]').forEach((baglanti) => {
                baglanti.addEventListener("click", (event) => {
                    const hedef = document.querySelector(baglanti.getAttribute("href"));
                    if (!hedef) {
                        return;
                    }

                    event.preventDefault();
                    hedef.scrollIntoView({ behavior: "smooth", block: "start" });
                });
            });
        })();

        (() => {
            const buton = document.querySelector("[data-ms-urun-detay-daha-fazla]");
            const ekDetay = document.querySelector("[data-ms-urun-detay-ek-detay]");

            if (!buton || !ekDetay) {
                return;
            }

            buton.addEventListener("click", () => {
                const acik = buton.getAttribute("aria-expanded") === "true";
                const yeniDurum = !acik;
                buton.setAttribute("aria-expanded", yeniDurum ? "true" : "false");
                ekDetay.hidden = !yeniDurum;
                const metin = buton.querySelector("span");
                if (metin) {
                    metin.textContent = yeniDurum ? "DAHA AZ GÖSTER" : "DAHA FAZLA GÖSTER";
                }
            });
        })();

        (() => {
            const mobilSabitAksiyon = document.querySelector(".ms-urun-detay-mobil-sabit-aksiyon");
            const modal = document.querySelector("[data-ms-urun-paylas-modal]");
            const acButonlari = document.querySelectorAll("[data-ms-urun-paylas-ac]");
            const kapaticilar = document.querySelectorAll("[data-ms-urun-paylas-kapat]");
            const kopyalaButonu = document.querySelector("[data-ms-urun-paylas-kopyala]");
            const whatsappLinki = document.querySelector("[data-ms-urun-paylas-whatsapp]");
            const facebookLinki = document.querySelector("[data-ms-urun-paylas-facebook]");
            const pinterestLinki = document.querySelector("[data-ms-urun-paylas-pinterest]");
            const xLinki = document.querySelector("[data-ms-urun-paylas-x]");
            let oncekiBodyOverflow = "";
            let oncekiOdak = null;

            if (!modal) {
                return;
            }

            const mobilSabitYuksekligiGuncelle = () => {
                if (!mobilSabitAksiyon) {
                    return;
                }

                const yukseklik = Math.ceil(mobilSabitAksiyon.getBoundingClientRect().height);
                document.documentElement.style.setProperty("--ms-urun-detay-mobil-sabit-yukseklik", `${yukseklik}px`);
            };

            mobilSabitYuksekligiGuncelle();
            window.addEventListener("resize", mobilSabitYuksekligiGuncelle);
            if (window.ResizeObserver && mobilSabitAksiyon) {
                new ResizeObserver(mobilSabitYuksekligiGuncelle).observe(mobilSabitAksiyon);
            }

            const urunPaylasimMetni = document.querySelector(".ms-urun-detay-baslik")?.textContent?.trim() || document.title;
            const paylasimUrl = encodeURIComponent(window.location.href);
            const paylasimGorseli = encodeURIComponent(document.querySelector(".ms-urun-detay-resim-ana")?.getAttribute("src") || "");
            whatsappLinki?.setAttribute("href", `https://wa.me/?text=${encodeURIComponent(urunPaylasimMetni)}%20${paylasimUrl}`);
            facebookLinki?.setAttribute("href", `https://www.facebook.com/sharer/sharer.php?u=${paylasimUrl}`);
            pinterestLinki?.setAttribute("href", `https://www.pinterest.com/pin/create/button/?url=${paylasimUrl}&media=${paylasimGorseli}&description=${encodeURIComponent(urunPaylasimMetni)}`);
            xLinki?.setAttribute("href", `https://x.com/intent/tweet?text=${encodeURIComponent(urunPaylasimMetni)}&url=${paylasimUrl}`);

            const modalAc = () => {
                mobilSabitYuksekligiGuncelle();
                oncekiOdak = document.activeElement instanceof HTMLElement ? document.activeElement : null;
                oncekiBodyOverflow = document.body.style.overflow;
                document.body.style.overflow = "hidden";
                document.documentElement.style.overflow = "hidden";
                modal.classList.add("ms-ornek-modal-acik");
                modal.setAttribute("aria-hidden", "false");
            };

            const modalKapat = () => {
                if (document.activeElement instanceof HTMLElement && modal.contains(document.activeElement)) {
                    document.activeElement.blur();
                }

                modal.classList.remove("ms-ornek-modal-acik");
                modal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = oncekiBodyOverflow === "hidden" ? "" : oncekiBodyOverflow;
                document.documentElement.style.overflow = "";

                if (oncekiOdak && document.contains(oncekiOdak)) {
                    oncekiOdak.focus({ preventScroll: true });
                }
            };

            acButonlari.forEach((buton) => {
                buton.addEventListener("click", modalAc);
            });

            kapaticilar.forEach((buton) => {
                buton.addEventListener("click", modalKapat);
            });

            kopyalaButonu?.addEventListener("click", async () => {
                const paylasLinki = window.location.href;
                try {
                    await navigator.clipboard.writeText(paylasLinki);
                    kopyalaButonu.querySelector("span:last-child").textContent = "Bağlantı Kopyalandı";
                } catch {
                    const geciciInput = document.createElement("input");
                    geciciInput.value = paylasLinki;
                    document.body.appendChild(geciciInput);
                    geciciInput.select();
                    document.execCommand("copy");
                    geciciInput.remove();
                    kopyalaButonu.querySelector("span:last-child").textContent = "Bağlantı Kopyalandı";
                }
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && modal.classList.contains("ms-ornek-modal-acik")) {
                    modalKapat();
                }
            });
        })();
    </script>

    @* B9 canlı veri script'i: renk seçimi SSR navigasyonu (?color=) + sepete ekleme
       (api/store/cart — SPA ile aynı localStorage anahtarları: ecspros_sid / ecspros_cart).
       Misharix'in beden/feedback script'ine dokunmaz; onun üstüne API çağrısını ekler. *@
    <script type="application/json" id="ms-urun-detay-config">@Html.Raw(sepetConfig)</script>
    <script>
        (() => {
            const configElemani = document.getElementById("ms-urun-detay-config");
            const cfg = configElemani ? JSON.parse(configElemani.textContent || "null") : null;
            if (!cfg) {
                return;
            }

            // Renk butonları: seçim = aynı sayfanın ?color= ile SSR yeniden yüklenmesi.
            // (Misharix'in renk script'i aktif sınıfını bizden önce değiştirdiğinden
            // karşılaştırma sınıfla değil sunucunun bildirdiği seçili renkle yapılır.)
            document.querySelectorAll(".ms-urun-detay-renk[data-ms-renk-url]").forEach((buton) => {
                buton.addEventListener("click", () => {
                    const hedefRenk = new URLSearchParams(buton.dataset.msRenkUrl).get("color");
                    if (hedefRenk && hedefRenk !== cfg.seciliRenk) {
                        window.location.href = buton.dataset.msRenkUrl;
                    }
                });
            });

            if (!localStorage.getItem("ecspros_sid")) {
                localStorage.setItem("ecspros_sid", "sess_" + crypto.getRandomValues(new Uint32Array(2)).join(""));
            }
            const oturumId = localStorage.getItem("ecspros_sid");
            const bedenSayisi = Object.keys(cfg.bedenler || {}).length;

            const seciliVaryant = () => {
                if (bedenSayisi === 0) {
                    return cfg.tekVaryant || null;
                }
                const beden = document.querySelector(".ms-urun-detay-beden-alani .ms-beden-secim-input:checked")?.value;
                return beden ? cfg.bedenler[beden] || null : null;
            };

            let gonderiliyor = false;
            const sepeteEkle = async () => {
                const varyant = seciliVaryant();
                if (!varyant || gonderiliyor) {
                    return;
                }
                gonderiliyor = true;
                try {
                    const cevap = await fetch("/api/store/cart/items", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            firmPlatformId: cfg.firmPlatformId,
                            variantId: varyant.id,
                            quantity: 1,
                            price: varyant.fiyat,
                            currencyCode: cfg.paraBirimi,
                            sessionId: oturumId
                        })
                    });
                    const veri = await cevap.json().catch(() => null);
                    if (veri?.success && veri.data?.cartId) {
                        localStorage.setItem("ecspros_cart", veri.data.cartId);
                    } else if (!veri?.success) {
                        console.error("Sepete ekleme başarısız:", veri?.error || cevap.status);
                    }
                } catch (hata) {
                    console.error("Sepete ekleme hatası:", hata);
                } finally {
                    gonderiliyor = false;
                }
            };

            document.querySelectorAll("[data-ms-urun-detay-sepete-ekle], .ms-buton-simdi-al").forEach((buton) => {
                buton.addEventListener("click", () => {
                    if (seciliVaryant()) {
                        sepeteEkle();

                        // Beden alanı yokken misharix'in geri bildirim script'i devrede olmaz;
                        // kısa metin geri bildirimini burada veriyoruz.
                        if (bedenSayisi === 0) {
                            const oncekiMetin = buton.textContent;
                            buton.textContent = "Sepete Eklendi";
                            window.setTimeout(() => {
                                buton.textContent = oncekiMetin;
                            }, 1300);
                        }
                    }
                });
            });

            // Beden modalından seçim: misharix radio'yu işaretleyip modalı kapatır;
            // ardından bekleyen sepete ekleme burada gerçekleşir.
            document.querySelector("[data-ms-urun-detay-beden-modal-listesi]")?.addEventListener("click", (event) => {
                if (event.target.closest(".ms-urun-beden-modal-secim")) {
                    window.setTimeout(sepeteEkle, 0);
                }
            });
        })();
    </script>
