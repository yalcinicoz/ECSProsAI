@using ECSPros.Api.Models.Store
@{
    // B9: canlı veri UrunDetayController'dan ViewData ile gelir; misharix davranış
    // script'leri (galeri, beden, favori, paylaş) değişmedi — yalnız demo içerik
    // bağlandı ve dosya sonuna sepet/renk config script'i eklendi.
    var vmSayfa = ViewData["MsUrunDetay"] as UrunDetayVm;
    var s = vmSayfa!;
    var sepetConfig = System.Text.Json.JsonSerializer.Serialize(new
    {
        firmPlatformId = s.FirmPlatformId,
        paraBirimi = s.ParaBirimi,
        tekVaryant = s.TekVaryantId is { } tekId
            ? new { id = tekId, fiyat = s.TekVaryantFiyat ?? 0 }
            : null,
        bedenler = s.Bedenler.ToDictionary(x => x.Ad, x => new { id = x.VariantId, fiyat = x.Fiyat }),
        seciliRenk = s.Renkler.FirstOrDefault(r => r.Secili)?.ValueId
    });
}
<div class="ms-urun-detay-sayfa">
    <partial name="~/Views/ProjeElementleri/UrunDetay/_UrunDetayBreadcrumb.cshtml" />

    <div class="ms-urun-detay-kapsayici">
        <section class="ms-urun-detay-ust">
            <partial name="~/Views/ProjeElementleri/UrunDetay/_UrunDetayResimAlani.cshtml" />

            <partial name="~/Views/ProjeElementleri/UrunDetay/_UrunDetayBilgi.cshtml" />
        </section>

        <partial name="~/Views/ProjeElementleri/UrunDetay/_UrunDetayAltBilgi.cshtml" />

        @if (s.Bedenler.Count > 0)
        {
        <aside class="ms-urun-detay-sabit-beden" data-ms-urun-detay-sabit-beden aria-hidden="true" aria-label="Sabit beden seçimi">
            <fieldset class="ms-urun-detay-sabit-beden-alani">
                <legend class="ms-form-etiket">@s.BedenEtiketi: <strong data-ms-urun-detay-sabit-beden-secili>Seçilmedi</strong></legend>
                <div class="ms-beden-secim-listesi" aria-label="@s.BedenEtiketi seçimi">
                    @foreach (var beden in s.Bedenler)
                    {
                    <label class="ms-beden-secim">
                        <input class="ms-beden-secim-input" type="radio" name="urun-detay-sabit-beden" value="@beden.Ad">
                        <span class="ms-beden-secim-kutu">@beden.Ad</span>
                    </label>
                    }
                </div>
            </fieldset>
        </aside>
        }

        <div class="ms-urun-detay-mobil-sabit-aksiyon" aria-label="Mobil ürün aksiyonları">
            <div class="ms-urun-detay-mobil-fiyat">
                <strong class="ms-urun-fiyat ms-urun-detay-tutar">@UrunDetayVm.FiyatMetni(s.Fiyat)</strong>
            </div>
            <button class="ms-buton ms-buton-l ms-buton-simdi-al ms-urun-detay-mobil-buton" type="button">Şimdi Al</button>
            <button class="ms-buton ms-buton-l ms-buton-satin-al ms-urun-detay-mobil-buton" type="button" data-ms-urun-detay-sepete-ekle>Sepete Ekle</button>
            <button class="ms-urun-detay-favori ms-urun-detay-mobil-ikon-buton" type="button" aria-label="Favorilere ekle" aria-pressed="false">
                <img class="ms-urun-detay-favori-ikon" src="/ikons/favorite.svg" alt="" aria-hidden="true">
            </button>
            <button class="ms-urun-detay-koleksiyon ms-urun-detay-mobil-ikon-buton" type="button" aria-label="Koleksiyona ekle" aria-pressed="false" data-ms-urun-detay-koleksiyon>
                <i class="fa-solid fa-bookmark ms-fa-ikon" aria-hidden="true"></i>
            </button>
            <button class="ms-urun-detay-mobil-ikon-buton" type="button" data-ms-urun-paylas-ac aria-label="Ürünü paylaş">
                <i class="fa-solid fa-share-nodes ms-fa-ikon" aria-hidden="true"></i>
            </button>
        </div>

        <div class="ms-ornek-modal ms-urun-paylas-modal" data-ms-urun-paylas-modal aria-hidden="true">
            <div class="ms-ornek-modal-kaplama" data-ms-urun-paylas-kapat></div>
            <section class="ms-ornek-modal-kutu ms-ornek-modal-kutu-uyari ms-urun-paylas-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-urun-paylas-baslik">
                <button class="ms-ornek-modal-kapat" type="button" data-ms-urun-paylas-kapat aria-label="Paylaşım kartını kapat">×</button>
                <h2 id="ms-urun-paylas-baslik" class="ms-ornek-modal-baslik">Ürünü Paylaş</h2>
                <div class="ms-urun-paylas-icerik">
                    <div class="ms-urun-paylas-urun">
                        @if (s.Gorseller.Count > 0)
                        {
                        <img src="@s.Gorseller[0]" alt="@s.Ad ürün görseli">
                        }
                        <div>
                            <strong>@s.Ad</strong>
                            <span>@UrunDetayVm.FiyatMetni(s.Fiyat)</span>
                        </div>
                    </div>
                    <div class="ms-urun-paylas-secenekleri">
                        <button class="ms-urun-paylas-secenek" type="button" data-ms-urun-paylas-kopyala>
                            <span class="ms-urun-paylas-ikon ms-urun-paylas-ikon-kopyala" aria-hidden="true">
                                <i class="fa-solid fa-copy ms-fa-ikon" aria-hidden="true"></i>
                            </span>
                            <span>Bağlantıyı Kopyala</span>
                        </button>
                        <a class="ms-urun-paylas-secenek" href="https://wa.me/" target="_blank" rel="noopener" data-ms-urun-paylas-whatsapp>
                            <span class="ms-urun-paylas-ikon ms-urun-paylas-ikon-gorsel" aria-hidden="true">
                                <img src="/images/whatsapp.png" alt="">
                            </span>
                            <span>WhatsApp</span>
                        </a>
                        <a class="ms-urun-paylas-secenek" href="https://www.facebook.com/sharer/sharer.php" target="_blank" rel="noopener" data-ms-urun-paylas-facebook>
                            <span class="ms-urun-paylas-ikon ms-urun-paylas-ikon-gorsel" aria-hidden="true">
                                <img src="/images/facebook.png" alt="">
                            </span>
                            <span>Facebook</span>
                        </a>
                        <a class="ms-urun-paylas-secenek" href="https://www.pinterest.com/pin/create/button/" target="_blank" rel="noopener" data-ms-urun-paylas-pinterest>
                            <span class="ms-urun-paylas-ikon ms-urun-paylas-ikon-gorsel" aria-hidden="true">
                                <img src="/images/pinterest.png" alt="">
                            </span>
                            <span>Pinterest</span>
                        </a>
                        <a class="ms-urun-paylas-secenek" href="https://x.com/intent/tweet" target="_blank" rel="noopener" data-ms-urun-paylas-x>
                            <span class="ms-urun-paylas-ikon ms-urun-paylas-ikon-gorsel" aria-hidden="true">
                                <img src="/images/x.png" alt="">
                            </span>
                            <span>X</span>
                        </a>
                    </div>
                </div>
            </section>
        </div>

        <div class="ms-ornek-modal ms-urun-beden-modal" data-ms-urun-detay-beden-modal aria-hidden="true">
            <div class="ms-ornek-modal-kaplama" data-ms-urun-detay-beden-modal-kapat></div>
            <section class="ms-ornek-modal-kutu ms-ornek-modal-kutu-uyari ms-urun-beden-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-urun-beden-modal-baslik">
                <button class="ms-ornek-modal-kapat" type="button" data-ms-urun-detay-beden-modal-kapat aria-label="Beden seçimini kapat">×</button>
                <h2 id="ms-urun-beden-modal-baslik" class="ms-ornek-modal-baslik">Beden Seçiniz</h2>
                <p class="ms-ornek-modal-aciklama">Sepete eklemek için uygun bedeni seçin.</p>
                <div class="ms-urun-beden-modal-listesi" data-ms-urun-detay-beden-modal-listesi></div>
            </section>
        </div>
    </div>
</div>

    @* Bu script: Ürün detay sayfasında üst menü davranışı, görsel galeri ve renk seçimi etkileşimlerini başlatır. *@
    <script>
        (() => {
            document.querySelectorAll(".ms-urun-detay-renk-alani").forEach((renkAlani) => {
                const renkBasligi = renkAlani.querySelector(".ms-urun-detay-renk-baslik strong");
                const renkButonlari = Array.from(renkAlani.querySelectorAll(".ms-urun-detay-renk"));
                const seciliIkon = renkAlani.querySelector(".ms-urun-detay-renk-secili-ikon");

                if (renkButonlari.length === 0) {
                    return;
                }

                const renkSec = (seciliButon) => {
                    renkButonlari.forEach((buton) => {
                        const aktif = buton === seciliButon;
                        buton.classList.toggle("ms-urun-detay-renk-aktif", aktif);
                        buton.setAttribute("aria-pressed", aktif ? "true" : "false");
                    });

                    if (seciliIkon && seciliIkon.parentElement !== seciliButon) {
                        seciliButon.prepend(seciliIkon);
                    }

                    const renkAdi = seciliButon.querySelector(":scope > span:last-child")?.textContent?.trim();
                    if (renkBasligi && renkAdi) {
                        renkBasligi.textContent = renkAdi;
                    }
                };

                renkButonlari.forEach((buton) => {
                    buton.addEventListener("click", () => renkSec(buton));
                });
            });
        })();

        (() => {
            const bedenAlani = document.querySelector(".ms-urun-detay-beden-alani");
            const seciliBedenYazisi = bedenAlani?.querySelector("[data-ms-urun-detay-beden-secili]");
            const bedenSecimleri = Array.from(bedenAlani?.querySelectorAll(".ms-beden-secim-input") || []);
            const aksiyonButonlari = Array.from(document.querySelectorAll(".ms-urun-detay-aksiyon, .ms-urun-detay-mobil-buton"));
            const detayAksiyonAlanlari = Array.from(document.querySelectorAll(".ms-urun-detay-sayfa .ms-urun-detay-aksiyonlar"));
            const bedenModal = document.querySelector("[data-ms-urun-detay-beden-modal]");
            const bedenModalListe = document.querySelector("[data-ms-urun-detay-beden-modal-listesi]");
            const bedenModalKapaticilar = document.querySelectorAll("[data-ms-urun-detay-beden-modal-kapat]");
            const sabitBedenPanel = document.querySelector("[data-ms-urun-detay-sabit-beden]");
            const sabitBedenSeciliYazisi = sabitBedenPanel?.querySelector("[data-ms-urun-detay-sabit-beden-secili]");
            const sabitBedenSecimleri = Array.from(sabitBedenPanel?.querySelectorAll(".ms-beden-secim-input") || []);
            let oncekiBodyOverflow = "";
            let oncekiHtmlOverflow = "";
            let bedenModalOncekiOdak = null;
            let bekleyenAksiyonButonu = null;
            let sabitBedenGuncellemePlanlandi = false;

            if (!bedenAlani || !seciliBedenYazisi || bedenSecimleri.length === 0) {
                return;
            }

            const aktifBedenSecimleri = bedenSecimleri.filter((secim) => !secim.disabled);
            if (aktifBedenSecimleri.length === 1) {
                aktifBedenSecimleri[0].checked = true;
            } else if (aktifBedenSecimleri.length > 1) {
                bedenSecimleri.forEach((secim) => {
                    secim.checked = false;
                });
            }

            const seciliBedenAl = () => bedenSecimleri.find((secim) => secim.checked && !secim.disabled);

            const sabitBedenSeciminiYansit = () => {
                const seciliBeden = seciliBedenAl();
                const seciliDeger = seciliBeden?.value || "";

                sabitBedenSecimleri.forEach((secim) => {
                    const kaynak = bedenSecimleri.find((bedenSecimi) => bedenSecimi.value === secim.value);
                    secim.disabled = Boolean(kaynak?.disabled);
                    secim.checked = secim.value === seciliDeger;
                });

                if (sabitBedenSeciliYazisi) {
                    sabitBedenSeciliYazisi.textContent = seciliDeger || "Seçilmedi";
                }
            };

            const mobilBedenPaneliMu = () => window.matchMedia("(max-width: 767px)").matches;

            const mobilYerlesimiGuncelle = () => {
                const mobil = mobilBedenPaneliMu();

                bedenAlani.style.display = mobil ? "grid" : "";
                detayAksiyonAlanlari.forEach((aksiyonAlani) => {
                    aksiyonAlani.style.display = mobil ? "none" : "";
                });
            };

            const bedenAlaniGorunurMu = () => {
                const rect = bedenAlani.getBoundingClientRect();
                return rect.bottom > 0 && rect.top < window.innerHeight - 12;
            };

            const bedenAlaniGecildiMi = () => bedenAlani.getBoundingClientRect().bottom < 0;

            const sabitBedenYuksekliginiYaz = () => {
                if (!sabitBedenPanel) {
                    return;
                }

                const yukseklik = sabitBedenPanel.classList.contains("ms-urun-detay-sabit-beden-acik")
                    ? Math.ceil(sabitBedenPanel.getBoundingClientRect().height)
                    : 0;
                document.documentElement.style.setProperty("--ms-urun-detay-sabit-beden-yukseklik", `${yukseklik}px`);
            };

            const sabitBedenDurumunuGuncelle = () => {
                sabitBedenGuncellemePlanlandi = false;

                if (!sabitBedenPanel) {
                    return;
                }

                const sabitGoster = mobilBedenPaneliMu() && bedenAlaniGecildiMi() && !bedenAlaniGorunurMu();
                sabitBedenPanel.classList.toggle("ms-urun-detay-sabit-beden-acik", sabitGoster);
                sabitBedenPanel.setAttribute("aria-hidden", (!sabitGoster).toString());
                sabitBedenSeciminiYansit();
                sabitBedenYuksekliginiYaz();
            };

            const sabitBedenDurumunuPlanla = () => {
                if (sabitBedenGuncellemePlanlandi) {
                    return;
                }

                sabitBedenGuncellemePlanlandi = true;
                window.requestAnimationFrame(sabitBedenDurumunuGuncelle);
            };

            const bedenYazisiniGuncelle = () => {
                const seciliBeden = seciliBedenAl();
                seciliBedenYazisi.textContent = seciliBeden?.value || "Seçilmedi";
                bedenAlani.classList.toggle("ms-urun-detay-beden-secildi", Boolean(seciliBeden));
                sabitBedenSeciminiYansit();
                sabitBedenDurumunuPlanla();
            };

            const gorunurRectMi = (rect) => rect.width > 0
                && rect.height > 0
                && rect.bottom > 0
                && rect.right > 0
                && rect.top < window.innerHeight
                && rect.left < window.innerWidth;

            const sepetHedefiAl = () => {
                const hedefler = Array.from(document.querySelectorAll("[data-ms-sepet-menu-tetikleyici] .ms-ana-navigasyon-sepet-ikon-alani, [data-ms-sepet-menu-tetikleyici]"));
                return hedefler.find((hedef) => gorunurRectMi(hedef.getBoundingClientRect())) || null;
            };

            const animasyonGorseliAl = () => {
                const gorseller = Array.from(document.querySelectorAll(".ms-urun-detay-resim-ana-gorunur, .ms-urun-detay-resim-ana"));
                return gorseller.find((gorsel) => gorsel instanceof HTMLImageElement && gorunurRectMi(gorsel.getBoundingClientRect())) || null;
            };

            const sepeteUcanAnimasyonBaslat = (buton) => {
                const hedef = sepetHedefiAl();

                if (!buton || !hedef) {
                    return;
                }

                const kaynakGorsel = animasyonGorseliAl();
                const kaynakRect = (kaynakGorsel || buton).getBoundingClientRect();
                const hedefRect = hedef.getBoundingClientRect();

                if (!gorunurRectMi(kaynakRect) || hedefRect.width === 0 || hedefRect.height === 0) {
                    return;
                }

                const boyut = Math.min(74, Math.max(40, Math.min(kaynakRect.width, kaynakRect.height) * 0.28));
                const bitisBoyutu = 18;
                const baslangicX = kaynakRect.left + (kaynakRect.width / 2) - (boyut / 2);
                const baslangicY = kaynakRect.top + (kaynakRect.height / 2) - (boyut / 2);
                const bitisX = hedefRect.left + (hedefRect.width / 2) - (bitisBoyutu / 2);
                const bitisY = hedefRect.top + (hedefRect.height / 2) - (bitisBoyutu / 2);
                const farkX = bitisX - baslangicX;
                const farkY = bitisY - baslangicY;
                const kavisY = Math.min((farkY * 0.42) - 72, -56);
                const ucan = document.createElement("span");

                ucan.className = "ms-urun-detay-sepet-ucan";
                ucan.setAttribute("aria-hidden", "true");
                ucan.style.left = `${baslangicX}px`;
                ucan.style.top = `${baslangicY}px`;
                ucan.style.width = `${boyut}px`;
                ucan.style.height = `${boyut}px`;

                if (kaynakGorsel) {
                    const gorsel = document.createElement("img");
                    gorsel.src = kaynakGorsel.currentSrc || kaynakGorsel.src;
                    gorsel.alt = "";
                    ucan.appendChild(gorsel);
                }

                document.body.appendChild(ucan);

                const sepetMenu = hedef.closest("[data-ms-sepet-menu]");
                sepetMenu?.classList.remove("ms-ana-navigasyon-sepet-animasyon");

                if (sepetMenu) {
                    void sepetMenu.offsetWidth;
                }

                const animasyon = ucan.animate([
                    { opacity: 0, transform: "translate3d(0, 0, 0) scale(0.72)" },
                    { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)", offset: 0.14 },
                    { opacity: 0.95, transform: `translate3d(${farkX * 0.52}px, ${kavisY}px, 0) scale(0.82)`, offset: 0.58 },
                    { opacity: 0, transform: `translate3d(${farkX}px, ${farkY}px, 0) scale(0.22)` }
                ], {
                    duration: 880,
                    easing: "cubic-bezier(0.22, 0.82, 0.2, 1)",
                    fill: "forwards"
                });

                window.setTimeout(() => {
                    sepetMenu?.classList.add("ms-ana-navigasyon-sepet-animasyon");
                }, 640);

                window.setTimeout(() => {
                    sepetMenu?.classList.remove("ms-ana-navigasyon-sepet-animasyon");
                }, 1320);

                animasyon.finished
                    .catch(() => {})
                    .finally(() => ucan.remove());
            };

            const aksiyonGeriBildirimiGoster = (buton) => {
                if (!buton) {
                    return;
                }

                const oncekiMetin = buton.textContent;
                const sepetAksiyonu = buton.matches("[data-ms-urun-detay-sepete-ekle], .ms-buton-satin-al");
                buton.textContent = sepetAksiyonu ? "Sepete Eklendi" : "Devam Ediliyor";

                if (sepetAksiyonu) {
                    sepeteUcanAnimasyonBaslat(buton);
                }

                window.setTimeout(() => {
                    buton.textContent = oncekiMetin;
                }, 1300);
            };

            const bedenModalKapat = () => {
                if (!bedenModal) {
                    return;
                }

                if (document.activeElement instanceof HTMLElement && bedenModal.contains(document.activeElement)) {
                    document.activeElement.blur();
                }

                bedenModal.classList.remove("ms-ornek-modal-acik");
                bedenModal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = oncekiBodyOverflow;
                document.documentElement.style.overflow = oncekiHtmlOverflow;

                if (bedenModalOncekiOdak && document.contains(bedenModalOncekiOdak)) {
                    bedenModalOncekiOdak.focus({ preventScroll: true });
                }
            };

            const bedenModalAc = (buton) => {
                if (!bedenModal) {
                    return;
                }

                bekleyenAksiyonButonu = buton;
                bedenModalOncekiOdak = document.activeElement instanceof HTMLElement ? document.activeElement : null;
                oncekiBodyOverflow = document.body.style.overflow;
                oncekiHtmlOverflow = document.documentElement.style.overflow;
                document.body.style.overflow = "hidden";
                document.documentElement.style.overflow = "hidden";
                bedenModal.classList.add("ms-ornek-modal-acik");
                bedenModal.setAttribute("aria-hidden", "false");
            };

            const bedenSec = (deger) => {
                const hedef = bedenSecimleri.find((secim) => secim.value === deger && !secim.disabled);
                if (!hedef) {
                    return;
                }

                hedef.checked = true;
                hedef.dispatchEvent(new Event("change", { bubbles: true }));
                bedenModalKapat();
                aksiyonGeriBildirimiGoster(bekleyenAksiyonButonu);
                bekleyenAksiyonButonu = null;
            };

            bedenModalListe?.replaceChildren(...aktifBedenSecimleri.map((secim) => {
                const buton = document.createElement("button");
                buton.className = "ms-urun-beden-modal-secim";
                buton.type = "button";
                buton.textContent = secim.value;
                buton.dataset.msUrunDetayBedenModalDeger = secim.value;
                buton.addEventListener("click", () => bedenSec(secim.value));
                return buton;
            }));

            bedenSecimleri.forEach((secim) => {
                secim.addEventListener("change", bedenYazisiniGuncelle);
            });

            sabitBedenSecimleri.forEach((secim) => {
                secim.addEventListener("change", () => {
                    const hedef = bedenSecimleri.find((bedenSecimi) => bedenSecimi.value === secim.value && !bedenSecimi.disabled);

                    if (!hedef) {
                        return;
                    }

                    hedef.checked = true;
                    hedef.dispatchEvent(new Event("change", { bubbles: true }));
                });
            });

            aksiyonButonlari.forEach((buton) => {
                buton.addEventListener("click", (event) => {
                    if (seciliBedenAl()) {
                        aksiyonGeriBildirimiGoster(buton);
                        return;
                    }

                    event.preventDefault();
                    bedenModalAc(buton);
                });
            });

            bedenModalKapaticilar.forEach((kapatici) => {
                kapatici.addEventListener("click", bedenModalKapat);
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && bedenModal?.classList.contains("ms-ornek-modal-acik")) {
                    bedenModalKapat();
                }
            });

            window.addEventListener("scroll", sabitBedenDurumunuPlanla, { passive: true });
            window.addEventListener("resize", () => {
                mobilYerlesimiGuncelle();
                sabitBedenDurumunuPlanla();
            });
            window.addEventListener("pageshow", sabitBedenDurumunuPlanla);

            mobilYerlesimiGuncelle();
            bedenYazisiniGuncelle();
        })();

        (() => {
            document.querySelectorAll("[data-ms-urun-detay-resim-alani]").forEach((alan) => {
                const anaKapsayici = alan.querySelector("[data-ms-urun-detay-resim-surukle]");
                const track = alan.querySelector("[data-ms-urun-detay-resim-track]");
                const slaytlar = Array.from(alan.querySelectorAll("[data-ms-urun-detay-resim-slide]"));
                const thumbButonlari = Array.from(alan.querySelectorAll("[data-ms-urun-detay-resim-thumb]"));
                const thumbListesi = alan.querySelector(".ms-urun-detay-resim-thumb-listesi");
                const yonButonlari = alan.querySelectorAll("[data-ms-urun-detay-resim-yon]");
                const zoomLens = alan.querySelector("[data-ms-urun-detay-resim-zoom-lens]");
                const zoomPanel = alan.querySelector("[data-ms-urun-detay-resim-zoom-panel]");
                const modal = alan.querySelector("[data-ms-urun-detay-resim-modal]");
                const modalTrack = alan.querySelector("[data-ms-urun-detay-resim-modal-track]");
                const modalSlaytlar = Array.from(alan.querySelectorAll("[data-ms-urun-detay-resim-modal-slide]"));
                const modalViewport = alan.querySelector("[data-ms-urun-detay-resim-modal-surukle]");
                const modalYonButonlari = alan.querySelectorAll("[data-ms-urun-detay-resim-modal-yon]");
                const modalKapaticilar = alan.querySelectorAll("[data-ms-urun-detay-resim-modal-kapat]");
                const modalThumbButonlari = Array.from(alan.querySelectorAll("[data-ms-urun-detay-resim-modal-thumb]"));
                const modalPaylasButonu = alan.querySelector("[data-ms-urun-detay-resim-modal-paylas]");
                const slaytKaynaklari = slaytlar.map((slayt) => slayt.currentSrc || slayt.getAttribute("src")).filter(Boolean);
                let aktifIndex = 0;
                let modalAktifIndex = 0;
                let suruklemeTakipEdiliyor = false;
                let surukleniyor = false;
                let baslangicX = 0;
                let baslangicY = 0;
                let suruklemeFarki = 0;
                let suruklemeYonu = "";
                let anaTouchSuruklemeAktif = false;
                let modalSurukleniyor = false;
                let modalSuruklemeTuru = "";
                let modalBaslangicX = 0;
                let modalBaslangicY = 0;
                let modalSuruklemeFarki = 0;
                let modalTiklamaEngellenecek = false;
                let modalZoom = 1;
                let modalPanX = 0;
                let modalPanY = 0;
                let modalPanBaslangicX = 0;
                let modalPanBaslangicY = 0;
                let modalPinchAktif = false;
                let modalPinchBaslangicMesafe = 0;
                let modalPinchBaslangicZoom = 1;
                let modalSonDokunmaZamani = 0;
                let tiklamaEngellenecek = false;
                let gecisYapiliyor = false;
                let modalGecisYapiliyor = false;
                let gecisZamani;
                let modalGecisZamani;
                let oncekiBodyOverflow = "";
                let oncekiHtmlOverflow = "";
                let modalOncekiOdak = null;
                const zoomKatsayisi = 2.35;

                if (!anaKapsayici || !track || !modalTrack || slaytlar.length === 0 || modalSlaytlar.length === 0 || slaytKaynaklari.length === 0) {
                    return;
                }

                anaKapsayici.style.touchAction = "pan-y";
                anaKapsayici.style.overscrollBehavior = "auto";

                const sar = (index) => (index + slaytlar.length) % slaytlar.length;
                const anaPointerBaslatilabilir = (event) => event.pointerType !== "mouse" || event.button === 0;
                const zoomAktifOlabilir = (event) => event.pointerType === "mouse" && window.matchMedia("(min-width: 1024px)").matches;
                const videoSlaytMi = (slayt) => slayt?.tagName?.toLowerCase() === "video";

                const videoDurumlariniGuncelle = (liste, aktifListeIndex) => {
                    liste.forEach((slayt, slaytIndex) => {
                        if (!videoSlaytMi(slayt)) {
                            return;
                        }

                        if (slaytIndex === aktifListeIndex) {
                            slayt.play?.().catch(() => {});
                        } else {
                            slayt.pause?.();
                        }
                    });
                };

                const resimOraniniUygula = (resim) => {
                    const genislik = videoSlaytMi(resim) ? resim.videoWidth : resim?.naturalWidth;
                    const yukseklik = videoSlaytMi(resim) ? resim.videoHeight : resim?.naturalHeight;

                    if (!resim || !genislik || !yukseklik) {
                        return;
                    }

                    anaKapsayici.style.setProperty("--ms-urun-detay-resim-orani", `${genislik} / ${yukseklik}`);
                };

                const aktifResimOraniniGuncelle = () => {
                    const aktifSlayt = slaytlar[aktifIndex];

                    if (!aktifSlayt) {
                        return;
                    }

                    if (videoSlaytMi(aktifSlayt)) {
                        if (aktifSlayt.readyState >= 1) {
                            resimOraniniUygula(aktifSlayt);
                        } else {
                            aktifSlayt.addEventListener("loadedmetadata", () => resimOraniniUygula(aktifSlayt), { once: true });
                        }
                    } else if (aktifSlayt.complete) {
                        resimOraniniUygula(aktifSlayt);
                    } else {
                        aktifSlayt.addEventListener("load", () => resimOraniniUygula(aktifSlayt), { once: true });
                    }
                };

                const zoomKapat = () => {
                    alan.classList.remove("ms-urun-detay-resim-zoom-aktif");
                    alan.style.zIndex = "";
                    zoomPanel?.style.removeProperty("z-index");
                };

                const aktifResimYerlesimi = () => {
                    const aktifSlayt = slaytlar[aktifIndex];

                    if (!aktifSlayt || videoSlaytMi(aktifSlayt) || !aktifSlayt.naturalWidth || !aktifSlayt.naturalHeight) {
                        return null;
                    }

                    const kapsayiciGenislik = anaKapsayici.clientWidth;
                    const kapsayiciYukseklik = anaKapsayici.clientHeight;
                    const resimOrani = aktifSlayt.naturalWidth / aktifSlayt.naturalHeight;
                    const kapsayiciOrani = kapsayiciGenislik / kapsayiciYukseklik;
                    let genislik = kapsayiciGenislik;
                    let yukseklik = kapsayiciYukseklik;

                    if (resimOrani > kapsayiciOrani) {
                        yukseklik = genislik / resimOrani;
                    } else {
                        genislik = yukseklik * resimOrani;
                    }

                    return {
                        resim: aktifSlayt,
                        sol: (kapsayiciGenislik - genislik) / 2,
                        ust: (kapsayiciYukseklik - yukseklik) / 2,
                        genislik,
                        yukseklik
                    };
                };

                const zoomGuncelle = (event) => {
                    if (!zoomLens || !zoomPanel || !zoomAktifOlabilir(event) || surukleniyor || gecisYapiliyor || event.target.closest("[data-ms-urun-detay-resim-yon]")) {
                        zoomKapat();
                        return;
                    }

                    const yerlesim = aktifResimYerlesimi();

                    if (!yerlesim) {
                        zoomKapat();
                        return;
                    }

                    const kapsayiciRect = anaKapsayici.getBoundingClientRect();
                    zoomPanel.style.height = `${kapsayiciRect.height}px`;
                    zoomPanel.style.zIndex = "1000";
                    const panelRect = zoomPanel.getBoundingClientRect();
                    const hamX = event.clientX - kapsayiciRect.left - yerlesim.sol;
                    const hamY = event.clientY - kapsayiciRect.top - yerlesim.ust;

                    if (hamX < 0 || hamX > yerlesim.genislik || hamY < 0 || hamY > yerlesim.yukseklik) {
                        zoomKapat();
                        return;
                    }

                    const x = hamX;
                    const y = hamY;
                    const panelOrani = panelRect.width / panelRect.height;
                    let lensGenislik = Math.min(yerlesim.genislik, panelRect.width / zoomKatsayisi);
                    let lensYukseklik = lensGenislik / panelOrani;

                    if (lensYukseklik > yerlesim.yukseklik || lensYukseklik > panelRect.height / zoomKatsayisi) {
                        lensYukseklik = Math.min(yerlesim.yukseklik, panelRect.height / zoomKatsayisi);
                        lensGenislik = lensYukseklik * panelOrani;
                    }

                    if (lensGenislik > yerlesim.genislik) {
                        lensGenislik = yerlesim.genislik;
                        lensYukseklik = lensGenislik / panelOrani;
                    }

                    const lensSol = yerlesim.sol + Math.min(Math.max(x - (lensGenislik / 2), 0), yerlesim.genislik - lensGenislik);
                    const lensUst = yerlesim.ust + Math.min(Math.max(y - (lensYukseklik / 2), 0), yerlesim.yukseklik - lensYukseklik);
                    const lensResimSol = lensSol - yerlesim.sol;
                    const lensResimUst = lensUst - yerlesim.ust;
                    const lensOlcekX = panelRect.width / lensGenislik;
                    const lensOlcekY = panelRect.height / lensYukseklik;

                    zoomPanel.style.backgroundImage = `url("${yerlesim.resim.currentSrc || yerlesim.resim.src}")`;
                    zoomPanel.style.backgroundSize = `${yerlesim.genislik * lensOlcekX}px ${yerlesim.yukseklik * lensOlcekY}px`;
                    zoomPanel.style.backgroundPosition = `${-(lensResimSol * lensOlcekX)}px ${-(lensResimUst * lensOlcekY)}px`;

                    zoomLens.style.width = `${lensGenislik}px`;
                    zoomLens.style.height = `${lensYukseklik}px`;
                    zoomLens.style.transform = `translate3d(${lensSol}px, ${lensUst}px, 0)`;
                    alan.style.zIndex = "999";
                    alan.classList.add("ms-urun-detay-resim-zoom-aktif");
                };

                const thumbOdakTemizle = () => {
                    if (document.activeElement instanceof HTMLElement && thumbListesi?.contains(document.activeElement)) {
                        document.activeElement.blur();
                    }
                };

                const sayfaScrollKoruyarak = (islem) => {
                    const oncekiScrollX = window.scrollX;
                    const oncekiScrollY = window.scrollY;

                    islem();

                    if (window.scrollX !== oncekiScrollX || window.scrollY !== oncekiScrollY) {
                        window.scrollTo(oncekiScrollX, oncekiScrollY);
                    }

                    window.requestAnimationFrame(() => {
                        if (window.scrollX !== oncekiScrollX || window.scrollY !== oncekiScrollY) {
                            window.scrollTo(oncekiScrollX, oncekiScrollY);
                        }
                    });
                };

                const thumbGuncelle = () => {
                    thumbOdakTemizle();

                    thumbButonlari.forEach((buton, butonIndex) => {
                        const aktif = butonIndex === aktifIndex;
                        buton.classList.toggle("ms-urun-detay-resim-thumb-aktif", aktif);
                        buton.setAttribute("aria-pressed", aktif.toString());
                    });

                    thumbOdakTemizle();
                };

                const modalThumbGuncelle = () => {
                    modalThumbButonlari.forEach((buton, butonIndex) => {
                        const aktif = butonIndex === modalAktifIndex;
                        buton.classList.toggle("ms-urun-detay-resim-modal-thumb-aktif", aktif);
                        buton.setAttribute("aria-pressed", aktif.toString());
                    });
                };

                const konumlariGuncelle = (suruklemeYuzdesi = 0, yon = 0) => {
                    const oncekiIndex = sar(aktifIndex - 1);
                    const sonrakiIndex = sar(aktifIndex + 1);

                    slaytlar.forEach((slayt, slaytIndex) => {
                        let pozisyon = 200;
                        let gorunur = slaytIndex === aktifIndex;

                        if (slaytIndex === aktifIndex) {
                            pozisyon = suruklemeYuzdesi;
                        } else if (yon < 0 && slaytIndex === sonrakiIndex) {
                            pozisyon = 100 + suruklemeYuzdesi;
                            gorunur = true;
                        } else if (yon > 0 && slaytIndex === oncekiIndex) {
                            pozisyon = -100 + suruklemeYuzdesi;
                            gorunur = true;
                        }

                        slayt.style.transform = `translate3d(${pozisyon}%, 0, 0)`;
                        slayt.classList.toggle("ms-urun-detay-resim-ana-gorunur", gorunur);
                        slayt.classList.toggle("ms-urun-detay-resim-ana-aktif", slaytIndex === aktifIndex);
                    });

                    if (suruklemeYuzdesi === 0 && yon === 0) {
                        videoDurumlariniGuncelle(slaytlar, aktifIndex);
                    }
                };

                const anaKonumuSifirla = () => {
                    track.classList.add("ms-urun-detay-resim-gecis-hazirlaniyor");
                    konumlariGuncelle(0, 0);
                    track.offsetHeight;
                    track.classList.remove("ms-urun-detay-resim-gecis-hazirlaniyor");
                };

                const anaSuruklemeTemizle = (event, tiklamayiEngelle = false, konumuSifirla = true) => {
                    suruklemeTakipEdiliyor = false;
                    surukleniyor = false;
                    suruklemeYonu = "";
                    suruklemeFarki = 0;
                    tiklamaEngellenecek = tiklamayiEngelle;
                    anaKapsayici.classList.remove("ms-urun-detay-resim-surukleniyor");

                    if (konumuSifirla) {
                        anaKonumuSifirla();
                    }

                    if (event?.pointerId !== undefined && anaKapsayici.hasPointerCapture?.(event.pointerId)) {
                        anaKapsayici.releasePointerCapture(event.pointerId);
                    }
                };

                const modalAktifResimYerlesimi = () => {
                    const aktifSlayt = modalSlaytlar[modalAktifIndex];

                    if (!aktifSlayt || videoSlaytMi(aktifSlayt) || !aktifSlayt.naturalWidth || !aktifSlayt.naturalHeight) {
                        return null;
                    }

                    const trackRect = modalTrack.getBoundingClientRect();

                    if (!trackRect.width || !trackRect.height) {
                        return null;
                    }

                    const resimOrani = aktifSlayt.naturalWidth / aktifSlayt.naturalHeight;
                    const trackOrani = trackRect.width / trackRect.height;
                    let genislik = trackRect.width;
                    let yukseklik = trackRect.height;

                    if (resimOrani > trackOrani) {
                        yukseklik = genislik / resimOrani;
                    } else {
                        genislik = yukseklik * resimOrani;
                    }

                    return {
                        alanGenislik: trackRect.width,
                        alanYukseklik: trackRect.height,
                        genislik,
                        yukseklik
                    };
                };

                const modalPanSinirla = () => {
                    if (modalZoom <= 1.02) {
                        modalPanX = 0;
                        modalPanY = 0;
                        return;
                    }

                    const yerlesim = modalAktifResimYerlesimi();

                    if (!yerlesim) {
                        modalPanX = 0;
                        modalPanY = 0;
                        return;
                    }

                    const maksimumX = Math.max(0, ((yerlesim.genislik * modalZoom) - yerlesim.alanGenislik) / 2);
                    const maksimumY = Math.max(0, ((yerlesim.yukseklik * modalZoom) - yerlesim.alanYukseklik) / 2);

                    modalPanX = Math.min(maksimumX, Math.max(-maksimumX, modalPanX));
                    modalPanY = Math.min(maksimumY, Math.max(-maksimumY, modalPanY));
                };

                const modalKonumlariGuncelle = (suruklemeYuzdesi = 0, yon = 0) => {
                    const oncekiIndex = sar(modalAktifIndex - 1);
                    const sonrakiIndex = sar(modalAktifIndex + 1);

                    modalSlaytlar.forEach((slayt, slaytIndex) => {
                        let pozisyon = 200;
                        let gorunur = slaytIndex === modalAktifIndex;

                        if (slaytIndex === modalAktifIndex) {
                            pozisyon = suruklemeYuzdesi;
                        } else if (yon < 0 && slaytIndex === sonrakiIndex) {
                            pozisyon = 100 + suruklemeYuzdesi;
                            gorunur = true;
                        } else if (yon > 0 && slaytIndex === oncekiIndex) {
                            pozisyon = -100 + suruklemeYuzdesi;
                            gorunur = true;
                        }

                        const zoom = slaytIndex === modalAktifIndex ? modalZoom : 1;
                        const panX = slaytIndex === modalAktifIndex ? modalPanX : 0;
                        const panY = slaytIndex === modalAktifIndex ? modalPanY : 0;
                        slayt.style.transform = `translate3d(calc(${pozisyon}% + ${panX}px), ${panY}px, 0) scale(${zoom})`;
                        slayt.classList.toggle("ms-urun-detay-resim-modal-gorsel-gorunur", gorunur);
                    });

                    if (suruklemeYuzdesi === 0 && yon === 0) {
                        videoDurumlariniGuncelle(modalSlaytlar, modalAktifIndex);
                        modalThumbGuncelle();
                    }
                };

                const modalZoomUygula = () => {
                    modalPanSinirla();
                    modalViewport?.classList.toggle("ms-urun-detay-resim-modal-zoomlu", modalZoom > 1.02);
                    modalKonumlariGuncelle(0, 0);
                };

                const modalZoomDegeriniAyarla = (zoomDegeri) => {
                    modalZoom = Math.min(3, Math.max(1, zoomDegeri));

                    if (modalZoom <= 1.02) {
                        modalZoom = 1;
                        modalPanX = 0;
                        modalPanY = 0;
                    }

                    modalZoomUygula();
                };

                const modalZoomSifirla = () => {
                    modalZoom = 1;
                    modalPanX = 0;
                    modalPanY = 0;
                    modalZoomUygula();
                };

                const dokunmaMesafesiAl = (event) => {
                    if (!event.touches || event.touches.length < 2) {
                        return 0;
                    }

                    const ilkDokunma = event.touches[0];
                    const ikinciDokunma = event.touches[1];
                    const xFarki = ikinciDokunma.clientX - ilkDokunma.clientX;
                    const yFarki = ikinciDokunma.clientY - ilkDokunma.clientY;
                    return Math.hypot(xFarki, yFarki);
                };

                const goster = (index) => {
                    const hedefIndex = sar(index);

                    if (hedefIndex === aktifIndex || gecisYapiliyor) {
                        return;
                    }

                    let fark = hedefIndex - aktifIndex;

                    if (Math.abs(fark) > slaytlar.length / 2) {
                        fark += fark > 0 ? -slaytlar.length : slaytlar.length;
                    }

                    const yon = fark > 0 ? -1 : 1;
                    const hedefSurukleme = fark > 0 ? -100 : 100;
                    gecisYapiliyor = true;
                    window.clearTimeout(gecisZamani);
                    track.classList.add("ms-urun-detay-resim-gecis-hazirlaniyor");
                    konumlariGuncelle(0, yon);
                    track.offsetHeight;
                    track.classList.remove("ms-urun-detay-resim-gecis-hazirlaniyor");

                    window.requestAnimationFrame(() => {
                        konumlariGuncelle(hedefSurukleme, yon);
                    });

                    gecisZamani = window.setTimeout(() => {
                        aktifIndex = hedefIndex;
                        gecisYapiliyor = false;
                        track.classList.add("ms-urun-detay-resim-gecis-hazirlaniyor");
                        sayfaScrollKoruyarak(() => {
                            konumlariGuncelle(0, 0);
                            aktifResimOraniniGuncelle();
                        });
                        zoomKapat();
                        thumbGuncelle();
                        if (modal?.classList.contains("ms-ornek-modal-acik")) {
                            modalAktifIndex = aktifIndex;
                            modalKonumlariGuncelle(0, 0);
                        }
                        track.offsetHeight;
                        track.classList.remove("ms-urun-detay-resim-gecis-hazirlaniyor");
                    }, 300);
                };

                const surukleyerekGoster = (fark) => {
                    const yon = fark > 0 ? -1 : 1;
                    const hedefIndex = sar(aktifIndex + fark);
                    gecisYapiliyor = true;
                    window.clearTimeout(gecisZamani);
                    konumlariGuncelle(fark > 0 ? -100 : 100, yon);

                    gecisZamani = window.setTimeout(() => {
                        aktifIndex = hedefIndex;
                        gecisYapiliyor = false;
                        track.classList.add("ms-urun-detay-resim-gecis-hazirlaniyor");
                        sayfaScrollKoruyarak(() => {
                            konumlariGuncelle(0, 0);
                            aktifResimOraniniGuncelle();
                        });
                        zoomKapat();
                        thumbGuncelle();
                        if (modal?.classList.contains("ms-ornek-modal-acik")) {
                            modalAktifIndex = aktifIndex;
                            modalKonumlariGuncelle(0, 0);
                        }
                        track.offsetHeight;
                        track.classList.remove("ms-urun-detay-resim-gecis-hazirlaniyor");
                    }, 300);
                };

                const modalGoster = (index) => {
                    const hedefIndex = sar(index);

                    if (!modal?.classList.contains("ms-ornek-modal-acik") || hedefIndex === modalAktifIndex || modalGecisYapiliyor) {
                        return;
                    }

                    let fark = hedefIndex - modalAktifIndex;

                    if (Math.abs(fark) > modalSlaytlar.length / 2) {
                        fark += fark > 0 ? -modalSlaytlar.length : modalSlaytlar.length;
                    }

                    const yon = fark > 0 ? -1 : 1;
                    const hedefSurukleme = fark > 0 ? -100 : 100;
                    modalGecisYapiliyor = true;
                    modalZoomSifirla();
                    window.clearTimeout(modalGecisZamani);
                    modalTrack.classList.add("ms-urun-detay-resim-modal-gecis-hazirlaniyor");
                    modalKonumlariGuncelle(0, yon);
                    modalTrack.offsetHeight;
                    modalTrack.classList.remove("ms-urun-detay-resim-modal-gecis-hazirlaniyor");

                    window.requestAnimationFrame(() => {
                        modalKonumlariGuncelle(hedefSurukleme, yon);
                    });

                    modalGecisZamani = window.setTimeout(() => {
                        modalAktifIndex = hedefIndex;
                        modalGecisYapiliyor = false;
                        modalTrack.classList.add("ms-urun-detay-resim-modal-gecis-hazirlaniyor");
                        modalKonumlariGuncelle(0, 0);
                        modalThumbGuncelle();
                        modalTrack.offsetHeight;
                        modalTrack.classList.remove("ms-urun-detay-resim-modal-gecis-hazirlaniyor");
                    }, 300);
                };

                const modalSurukleyerekGoster = (fark) => {
                    const yon = fark > 0 ? -1 : 1;
                    const hedefIndex = sar(modalAktifIndex + fark);
                    modalGecisYapiliyor = true;
                    modalZoomSifirla();
                    window.clearTimeout(modalGecisZamani);
                    modalKonumlariGuncelle(fark > 0 ? -100 : 100, yon);

                    modalGecisZamani = window.setTimeout(() => {
                        modalAktifIndex = hedefIndex;
                        modalGecisYapiliyor = false;
                        modalTrack.classList.add("ms-urun-detay-resim-modal-gecis-hazirlaniyor");
                        modalKonumlariGuncelle(0, 0);
                        modalThumbGuncelle();
                        modalTrack.offsetHeight;
                        modalTrack.classList.remove("ms-urun-detay-resim-modal-gecis-hazirlaniyor");
                    }, 300);
                };

                const sayfaPaylasimLinkiAl = () => {
                    const paylasimLinki = new URL(window.location.href);
                    paylasimLinki.hash = "";
                    return paylasimLinki.href;
                };

                const paylasimLinkiniKopyala = async (paylasLinki) => {
                    if (navigator.clipboard) {
                        await navigator.clipboard.writeText(paylasLinki);
                        return;
                    }

                    const geciciInput = document.createElement("input");
                    geciciInput.value = paylasLinki;
                    geciciInput.setAttribute("readonly", "");
                    geciciInput.style.position = "fixed";
                    geciciInput.style.opacity = "0";
                    document.body.appendChild(geciciInput);
                    geciciInput.select();
                    document.execCommand("copy");
                    geciciInput.remove();
                };

                const modalPaylasButonuMetniniGuncelle = (metin) => {
                    if (!modalPaylasButonu) {
                        return;
                    }

                    const oncekiMetin = modalPaylasButonu.textContent;
                    modalPaylasButonu.textContent = metin;
                    window.setTimeout(() => {
                        modalPaylasButonu.textContent = oncekiMetin;
                    }, 1300);
                };

                const modalAktifResmiPaylas = async () => {
                    const paylasLinki = sayfaPaylasimLinkiAl();
                    const paylasBaslik = document.querySelector(".ms-urun-detay-baslik")?.textContent?.trim() || "Misharitalia ürünü";

                    try {
                        if (navigator.share) {
                            await navigator.share({
                                title: paylasBaslik,
                                text: paylasBaslik,
                                url: paylasLinki
                            });
                        } else {
                            await paylasimLinkiniKopyala(paylasLinki);
                            modalPaylasButonuMetniniGuncelle("Kopyalandı");
                        }
                    } catch (error) {
                        if (error?.name === "AbortError") {
                            return;
                        }

                        await paylasimLinkiniKopyala(paylasLinki);
                        modalPaylasButonuMetniniGuncelle("Kopyalandı");
                    }
                };

                const modalAc = () => {
                    if (!modal) {
                        return;
                    }

                    const guncelAktifIndex = slaytlar.findIndex((slayt) => slayt.classList.contains("ms-urun-detay-resim-ana-aktif"));

                    if (guncelAktifIndex >= 0) {
                        aktifIndex = guncelAktifIndex;
                    }

                    modalAktifIndex = aktifIndex;
                    modalZoomSifirla();
                    modalOncekiOdak = document.activeElement instanceof HTMLElement ? document.activeElement : null;
                    modal.classList.add("ms-ornek-modal-acik");
                    modal.setAttribute("aria-hidden", "false");
                    modalTrack.classList.add("ms-urun-detay-resim-modal-gecis-hazirlaniyor");
                    modalKonumlariGuncelle(0, 0);
                    modalThumbGuncelle();
                    modalTrack.offsetHeight;
                    modalTrack.classList.remove("ms-urun-detay-resim-modal-gecis-hazirlaniyor");
                    oncekiBodyOverflow = document.body.style.overflow;
                    oncekiHtmlOverflow = document.documentElement.style.overflow;
                    document.body.style.overflow = "hidden";
