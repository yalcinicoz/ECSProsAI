@model string
@{
    var aktif = Model ?? string.Empty;
}

<div class="ms-hesabim-mobil-menu-kontrol">
    <button class="ms-hesabim-mobil-menu-ac" type="button" data-ms-hesabim-menu-ac aria-expanded="false" aria-label="Hesabım menüsünü aç">
        <span class="ms-hesabim-mobil-menu-cizgi" aria-hidden="true"></span>
        <span>Hesabım Menüsü</span>
    </button>
</div>

<div class="ms-hesabim-menu-perde" data-ms-hesabim-menu-kapat aria-hidden="true"></div>

<aside class="ms-hesabim-yan-menu" aria-label="Hesabım menüsü">
    <div class="ms-hesabim-menu-mobil-baslik">
        <strong>Hesabım</strong>
        <button type="button" data-ms-hesabim-menu-kapat aria-label="Hesabım menüsünü kapat"><i class="fa-solid fa-xmark ms-fa-ikon" aria-hidden="true"></i></button>
    </div>

    @* H10 SADE SÜRÜM (2026-07-22 kullanıcı kararı): statü adı = üye grubu (grupsuz 'Standart'),
       Aylık = son 30 gün sipariş toplamı. Eşik/kazanç/progress DETAYI GİZLİ KALIR — tam statü
       modeli (E13: eşik+kazanç kataloğu) tanımlanınca toggle+detay bölümü açılır. *@
    @{ var msHesapStatu = ViewData["MsHesapStatu"] as ECSPros.Api.Controllers.Store.HesapStatuVm; }
    @if (msHesapStatu is not null)
    {
    <section class="ms-hesap-statu ms-hesap-statu-premium ms-hesabim-menu-statu">
        <div class="ms-hesap-statu-ust">
            <span class="ms-hesap-statu-ikon" aria-hidden="true"><i class="fa-solid fa-crown ms-fa-ikon " aria-hidden="true"></i></span>
            <span class="ms-hesap-statu-bilgi">
                <small>Statünüz</small>
                <strong>@msHesapStatu.StatuAdi</strong>
            </span>
            <span class="ms-hesap-harcama">
                <small>Aylık</small>
                <strong>@msHesapStatu.AylikHarcama.ToString("N2", new System.Globalization.CultureInfo("tr-TR")) ₺</strong>
            </span>
        </div>
    </section>
    }

    <section class="ms-hesabim-menu-grubu">
        <h3>Üyeliğim</h3>
        <nav class="ms-hesabim-menu-linkleri">
            <a rel="nofollow" class="@(aktif == "uyelik" ? "ms-hesabim-menu-aktif" : null)" href="/uyelik-bilgilerim">
                <i class="fa-solid fa-user ms-fa-ikon " aria-hidden="true"></i>
                <span>Üyelik Bilgilerim</span>
            </a>
            <a rel="nofollow" class="@(aktif == "adresler" ? "ms-hesabim-menu-aktif" : null)" href="/adreslerim">
                <i class="fa-solid fa-location-dot ms-fa-ikon " aria-hidden="true"></i>
                <span>Adreslerim</span>
            </a>
        </nav>
    </section>

    <section class="ms-hesabim-menu-grubu">
        <h3>Bana Özel</h3>
        <nav class="ms-hesabim-menu-linkleri">
            <a rel="nofollow" class="@(aktif == "siparisler" ? "ms-hesabim-menu-aktif" : null)" href="/siparislerim">
                <i class="fa-solid fa-box ms-fa-ikon " aria-hidden="true"></i>
                <span>Siparişlerim</span>
            </a>
            <a rel="nofollow" class="@(aktif == "tekrar-satin-al" ? "ms-hesabim-menu-aktif" : null)" href="/tekrar-satin-al">
                <i class="fa-solid fa-arrow-rotate-right ms-fa-ikon " aria-hidden="true"></i>
                <span>Tekrar Satın Al</span>
            </a>
            <a rel="nofollow" class="@(aktif == "onceden-gezdiklerim" ? "ms-hesabim-menu-aktif" : null)" href="/onceden-gezdiklerim">
                <i class="fa-solid fa-clock-rotate-left ms-fa-ikon " aria-hidden="true"></i>
                <span>Önceden Gezdiklerim</span>
            </a>
            <a rel="nofollow" class="@(aktif == "iadeler" ? "ms-hesabim-menu-aktif" : null)" href="/iadelerim">
                <i class="fa-solid fa-arrow-rotate-left ms-fa-ikon " aria-hidden="true"></i>
                <span>İadelerim</span>
            </a>
            <a rel="nofollow" class="@(aktif == "yorumlar" ? "ms-hesabim-menu-aktif" : null)" href="/yorumlarim">
                <i class="fa-solid fa-comment ms-fa-ikon " aria-hidden="true"></i>
                <span>Yorumlarım</span>
            </a>
            <a rel="nofollow" class="@(aktif == "sorular" ? "ms-hesabim-menu-aktif" : null)" href="/sorularim">
                <i class="fa-solid fa-comment-dots ms-fa-ikon " aria-hidden="true"></i>
                <span>Sorularım</span>
            </a>
            <a rel="nofollow" class="@(aktif == "favoriler" ? "ms-hesabim-menu-aktif" : null)" href="/favorilerim">
                <img class="" src="/ikons/favorilerim-sade-icon.svg" alt="" aria-hidden="true" width="20" height="20" loading="lazy">
                <span>Favorilerim</span>
            </a>
            <a rel="nofollow" class="@(aktif == "koleksiyonlar" ? "ms-hesabim-menu-aktif" : null)" href="/koleksiyonlarim">
                <i class="fa-solid fa-layer-group ms-fa-ikon " aria-hidden="true"></i>
                <span>Koleksiyonlarım</span>
            </a>
            <a rel="nofollow" class="@(aktif == "kuponlar" ? "ms-hesabim-menu-aktif" : null)" href="/indirim-kuponlarim">
                <i class="fa-solid fa-ticket ms-fa-ikon " aria-hidden="true"></i>
                <span>İndirim Kuponlarım</span>
            </a>
            <a rel="nofollow" class="@(aktif == "favori-aramalar" ? "ms-hesabim-menu-aktif" : null)" href="/favori-aramalarim">
                <img class="ms-ikon-siyah" src="/ikons/favori-aramalarim-sade-icon.svg" alt="" aria-hidden="true" width="20" height="20" loading="lazy">
                <span>Favori Aramalarım</span>
            </a>
        </nav>
    </section>
</aside>

    @* Bu script: Hesabım yan menüsünün açma/kapatma ve perde davranışını yönetir. *@
    <script>
    (() => {
        document.querySelectorAll(".ms-hesabim-sayfa").forEach((sayfa) => {
            if (sayfa.dataset.msHesabimMenuHazir === "true") {
                return;
            }

            sayfa.dataset.msHesabimMenuHazir = "true";

            const acButon = sayfa.querySelector("[data-ms-hesabim-menu-ac]");
            const menu = sayfa.querySelector(".ms-hesabim-yan-menu");
            const perde = sayfa.querySelector(".ms-hesabim-menu-perde");
            const kapatButonlari = sayfa.querySelectorAll("[data-ms-hesabim-menu-kapat]");

            const menuDurumunuAyarla = (acik) => {
                menu?.classList.toggle("ms-hesabim-yan-menu-acik", acik);
                sayfa.classList.toggle("ms-hesabim-menu-acik", acik);
                acButon?.setAttribute("aria-expanded", acik.toString());
                perde?.setAttribute("aria-hidden", (!acik).toString());
                document.body.classList.toggle("ms-hesabim-menu-body-kilitli", acik);

                if (acik) {
                    menu?.querySelector("[data-ms-hesabim-menu-kapat]")?.focus();
                }
            };

            acButon?.addEventListener("click", () => menuDurumunuAyarla(true));

            kapatButonlari.forEach((buton) => {
                buton.addEventListener("click", () => menuDurumunuAyarla(false));
            });

            menu?.querySelectorAll("a").forEach((link) => {
                link.addEventListener("click", () => menuDurumunuAyarla(false));
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && menu?.classList.contains("ms-hesabim-yan-menu-acik")) {
                    menuDurumunuAyarla(false);
                }
            });
        });
    })();
</script>
