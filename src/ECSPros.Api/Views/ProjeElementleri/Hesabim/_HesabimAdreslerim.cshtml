<section class="ms-hesabim-sayfa" aria-labelledby="ms-hesabim-adresler-baslik">
    <partial name="~/Views/ProjeElementleri/Hesabim/_HesabimYanMenu.cshtml" model='@("adresler")' />

    <section class="ms-hesabim-icerik">
        <header class="ms-hesabim-baslik">
            <h2 id="ms-hesabim-adresler-baslik">Adreslerim</h2>
        </header>

        <div class="ms-hesabim-adres-sayfa">
            <div class="ms-hesabim-adres-ust">
                <div>
                    <h3>Teslimat ve fatura adresleri</h3>
                    <p>Siparişlerinizde kullanacağınız teslimat ve fatura adreslerini bu alandan yönetebilirsiniz.</p>
                </div>
                <button class="ms-buton ms-buton-m ms-buton-satin-al" type="button" data-ms-adresler-yeni>Yeni Adres Ekle</button>
            </div>

            <div class="ms-hesabim-adres-grid">
                @* E3: kartlar account/addresses'ten; İP-4.4: form yan panelden tasarımın
                   ortak adres MODALINA taşındı (data-ms-adres-modal). Varsayılan kartta
                   Sil yok (tasarımdaki gibi), diğerlerinde Varsayılan+Sil. *@
                <section class="ms-hesabim-adres-listesi" aria-labelledby="ms-kayitli-adresler-baslik">
                    <h3 id="ms-kayitli-adresler-baslik">Kayıtlı Adresler</h3>
                    <p data-ms-adresler-bos hidden>Kayıtlı adresiniz yok. "Yeni Adres Ekle" ile ilk adresinizi ekleyin.</p>
                    <div data-ms-adresler-liste></div>
                    <template data-ms-adresler-kart-sablon>
                    <article class="ms-hesabim-adres-karti" data-ms-hesabim-adres-karti>
                        <div class="ms-hesabim-adres-kart-ust">
                            <div>
                                <strong data-alan="baslik"></strong>
                                <span data-alan="altbaslik">Varsayılan Teslimat</span>
                            </div>
                            <span class="ms-hesabim-adres-etiket" data-alan="etiket">Aktif</span>
                        </div>
                        <p data-alan="alici"></p>
                        <address data-alan="adres"></address>
                        <p data-alan="telefon"></p>
                        <div class="ms-hesabim-adres-aksiyonlar">
                            <button class="ms-buton ms-buton-ornek ms-buton-simdi-al ms-buton-simdi-al-mavi ms-buton-x" type="button" data-aksiyon="duzenle" data-ms-hesabim-adres-duzenle>Düzenle</button>
                            <button class="ms-buton ms-buton-x ms-buton-cizgili-birincil" type="button" data-aksiyon="varsayilan">Varsayılan</button>
                            <button class="ms-buton ms-buton-x ms-buton-tehlikeli" type="button" data-aksiyon="sil">Sil</button>
                        </div>
                    </article>
                    </template>
                </section>
            </div>
        </div>
    </section>

    @* İP-4.4: tasarımın ortak adres modalı — form canlı (E3): yeni adres POST, Düzenle PUT;
       il/ilçe aramalı özel-select (api/store/geo'dan doldurulur), ülke TR kilitli. *@
    <div class="ms-ornek-modal ms-siparis-adres-modal" data-ms-adres-modal aria-hidden="true">
        <div class="ms-ornek-modal-kaplama" data-ms-adres-modal-kapat></div>
        <section class="ms-ornek-modal-kutu ms-ornek-modal-boyut-xl" role="dialog" aria-modal="true" aria-labelledby="ms-hesabim-adres-modal-baslik">
            <button class="ms-ornek-modal-kapat" type="button" data-ms-adres-modal-kapat aria-label="Adres düzenleme modalını kapat"><i class="fa-solid fa-xmark ms-fa-ikon" aria-hidden="true"></i></button>
            <h3 id="ms-hesabim-adres-modal-baslik" class="ms-ornek-modal-baslik" data-ms-modal-surukleme-alani data-ms-adres-modal-ana-baslik>Adresi Düzenle</h3>
            <p class="ms-ornek-modal-aciklama">Teslimat adresi, alıcı bilgisi ve telefon bilgisini bu alanda güncelleyebilirsiniz.</p>

            <form class="ms-hesabim-adres-formu" action="/Hesabim/Adreslerim" method="post">
            <div class="ms-form-izgara">
                <label class="ms-form-alani ms-form-alani-genis">
                    <span class="ms-form-etiket">Adres Başlığı</span>
                    <input name="AdresBasligi" class="ms-form-girdi" type="text" value="" autocomplete="address-line1" data-ms-adres-modal-baslik-girdi data-ms-adres-form="baslik">
                </label>
                <label class="ms-form-alani">
                    <span class="ms-form-etiket">Ad</span>
                    <input name="Ad" class="ms-form-girdi" type="text" value="" autocomplete="given-name" data-ms-adres-form="ad">
                </label>
                <label class="ms-form-alani">
                    <span class="ms-form-etiket">Soyad</span>
                    <input name="Soyad" class="ms-form-girdi" type="text" value="" autocomplete="family-name" data-ms-adres-form="soyad">
                </label>
                @if (false)
                {
                @* Tasarımın Fatura Türü (Bireysel/Kurumsal) seçimi — adres modelinde alan
                   karşılığı yok; kurumsal fatura alanları backend'e gelince açılır. *@
                <div class="ms-form-alani ms-form-alani-genis">
                    <span class="ms-form-etiket">Fatura Türü</span>
                    <div class="ms-onay-listesi ms-siparis-adres-secim-listesi">
                        <label class="ms-onay-kart">
                            <input class="ms-onay-input" type="radio" name="ms-hesabim-adres-fatura-turu" checked>
                            <span class="ms-onay-kutu ms-onay-kutu-yuvarlak" aria-hidden="true"></span>
                            <span class="ms-onay-metin">
                                Bireysel
                                <span class="ms-onay-yardim">Kişisel fatura bilgileriyle devam et</span>
                            </span>
                        </label>
                        <label class="ms-onay-kart">
                            <input class="ms-onay-input" type="radio" name="ms-hesabim-adres-fatura-turu">
                            <span class="ms-onay-kutu ms-onay-kutu-yuvarlak" aria-hidden="true"></span>
                            <span class="ms-onay-metin">
                                Kurumsal
                                <span class="ms-onay-yardim">Firma bilgileriyle fatura oluştur</span>
                            </span>
                        </label>
                    </div>
                </div>
                }
                <div class="ms-form-alani">
                    <span class="ms-form-etiket">Ülke</span>
                    <div class="ms-ozel-select ms-ozel-select-kilitli" data-ms-ozel-select>
                        <button class="ms-ozel-select-tetikleyici" type="button" disabled aria-disabled="true">
                            <span data-ms-ozel-select-deger>Türkiye</span>
                            <i class="fa-solid fa-chevron-down ms-fa-ikon ms-ozel-select-ok" aria-hidden="true"></i>
                        </button>
                        <input type="hidden" name="Ulke" value="Türkiye">
                    </div>
                </div>
                <div class="ms-form-alani">
                    <span class="ms-form-etiket">İl</span>
                    <div data-ms-adres-il-kapsayici></div>
                    <input type="hidden" name="Il" data-ms-adres-form="il">
                </div>
                <div class="ms-form-alani">
                    <span class="ms-form-etiket">İlçe</span>
                    <div data-ms-adres-ilce-kapsayici></div>
                    <input type="hidden" name="Ilce" data-ms-adres-form="ilce">
                </div>
                <label class="ms-form-alani ms-form-alani-genis">
                    <span class="ms-form-etiket">Mahalle</span>
                    <input name="Mahalle" class="ms-form-girdi" type="text" value="" autocomplete="address-level3" data-ms-adres-form="mahalle">
                </label>
                <label class="ms-form-alani ms-form-alani-genis">
                    <span class="ms-form-etiket">Adres</span>
                    <textarea name="AcikAdres" class="ms-form-metin-alani" rows="4" autocomplete="street-address" data-ms-adres-form="acikadres"></textarea>
                </label>
                <label class="ms-form-alani ms-form-alani-genis">
                    <span class="ms-form-etiket">Telefon</span>
                    <span class="ms-telefon-girdi">
                        <span class="ms-telefon-ulke" data-ms-telefon-ulke-select>
                            <button class="ms-telefon-ulke-tetikleyici" type="button" data-ms-telefon-ulke-tetikleyici aria-haspopup="listbox" aria-expanded="false">
                                <img class="ms-telefon-bayrak" src="https://flagcdn.com/tr.svg" alt="Türkiye" loading="lazy">
                                <span data-ms-telefon-ulke-kod>+90</span>
                                <i class="fa-solid fa-chevron-down ms-fa-ikon ms-telefon-ulke-ok" aria-hidden="true"></i>
                            </button>
                            <span class="ms-telefon-ulke-panel" role="listbox" aria-label="Ülke kodları">
                                <input name="telefon_ulke_arama" class="ms-telefon-ulke-arama" type="search" placeholder="Ülke ara" data-ms-telefon-ulke-arama>
                                <button class="ms-telefon-ulke-secenek ms-telefon-ulke-secenek-aktif" type="button" data-ms-telefon-ulke-secenek data-kod="+90" data-bayrak="https://flagcdn.com/tr.svg" data-ulke="Türkiye">
                                    <img class="ms-telefon-bayrak" src="https://flagcdn.com/tr.svg" alt="" loading="lazy"> Türkiye <strong>+90</strong>
                                </button>
                            </span>
                        </span>
                        <input name="Telefon" type="tel" value="" placeholder="___ ___ __ __" inputmode="numeric" autocomplete="tel-national" maxlength="13" data-ms-telefon-input data-ms-adres-telefon-input data-ms-adres-form="telefon">
                    </span>
                </label>
                <label class="ms-onay-kart ms-siparis-varsayilan-adres">
                    <input name="VarsayilanAdres" class="ms-onay-input" type="checkbox" data-ms-adres-form="varsayilan">
                    <span class="ms-onay-kutu" aria-hidden="true"></span>
                    <span class="ms-onay-metin">
                        Varsayılan adres olarak ayarla
                        <span class="ms-onay-yardim">Bu adresi varsayılan teslimat adresi olarak kullan</span>
                    </span>
                </label>
            </div>

            <div class="ms-uyari ms-uyari-hata" data-ms-adres-form-mesaj hidden></div>
            <div class="ms-ornek-modal-aksiyonlar">
                <button class="ms-buton ms-buton-m ms-buton-sade" type="button" data-ms-adres-modal-kapat>Vazgeç</button>
                <button class="ms-buton ms-buton-m ms-buton-satin-al" type="submit" data-ms-adres-modal-kaydet>Adresi Kaydet</button>
            </div>
            </form>
        </section>
    </div>
</section>

@* E3 + İP-4.4: Adreslerim canlı — kartlar GET addresses; modal formu yeni adres POST /
   Düzenle PUT; Varsayılan POST default; Sil DELETE. İl/ilçe geo API'den tasarımın aramalı
   özel-select'iyle (seçenekler dinamik geldiğinden select düğümü her dolumda yeniden
   kurulur ve window.msOzelSelectleriBaslat ile bağlanır); mahalle serbest metin; ülke TR sabit. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const sayfa = document.querySelector(".ms-hesabim-adres-sayfa")?.closest(".ms-hesabim-sayfa");
    if (!sayfa) { return; }
    const token = () => localStorage.getItem("ecspros_member_token");
    const basliklar = () => ({ "Content-Type": "application/json", Authorization: "Bearer " + token() });
    const el = (sec) => sayfa.querySelector(sec);
    const modal = el("[data-ms-adres-modal]");
    const form = modal.querySelector(".ms-hesabim-adres-formu");
    const alan = (ad) => modal.querySelector(`[data-ms-adres-form="${ad}"]`);
    const mesaj = modal.querySelector("[data-ms-adres-form-mesaj]");
    const anaBaslik = modal.querySelector("[data-ms-adres-modal-ana-baslik]");
    let adresler = [];
    let duzenlenenId = null;
    let trUlke = null; // { id, ad }

    const mesajGoster = (metin, hata) => {
        mesaj.textContent = metin || "";
        mesaj.hidden = !metin;
        mesaj.classList.toggle("ms-uyari-hata", !!hata);
    };

    // ── Modal aç/kapat (tasarım kalıbı: ms-ornek-modal-acik) ──
    const modalAc = (baslik) => {
        anaBaslik.textContent = baslik;
        modal.classList.add("ms-ornek-modal-acik");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        alan("baslik").focus();
    };
    const modalKapat = () => {
        modal.classList.remove("ms-ornek-modal-acik");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    };
    modal.querySelectorAll("[data-ms-adres-modal-kapat]").forEach((buton) => {
        buton.addEventListener("click", modalKapat);
    });

    // ── Aramalı özel-select (il/ilçe) — dinamik seçenek: düğüm her dolumda yeniden kurulur ──
    const geoGetir = async (yol) => {
        try {
            const cevap = await (await fetch("/api/store/geo/" + yol)).json();
            return cevap?.success ? cevap.data : [];
        } catch { return []; }
    };

    const ozelSelectKur = (kapsayici, girdi, kayitlar, placeholder, aramaEtiketi, secildi) => {
        kapsayici.innerHTML = "";
        girdi.value = "";
        girdi.dataset.msSecilenAd = "";
        const kok = document.createElement("div");
        kok.className = "ms-ozel-select";
        kok.setAttribute("data-ms-ozel-select", "");
        kok.innerHTML = `
            <button class="ms-ozel-select-tetikleyici" type="button" data-ms-ozel-select-tetikleyici aria-haspopup="listbox" aria-expanded="false">
                <span data-ms-ozel-select-deger>${placeholder}</span>
                <i class="fa-solid fa-chevron-down ms-fa-ikon ms-ozel-select-ok" aria-hidden="true"></i>
            </button>
            <div class="ms-ozel-select-panel" role="listbox" aria-label="${aramaEtiketi} seçenekleri">
                <input name="ozel_select_arama" class="ms-ozel-select-arama" type="search" placeholder="${aramaEtiketi} ara" data-ms-ozel-select-arama>
                <div class="ms-ozel-select-secenek-listesi"></div>
            </div>`;
        const listeKutusu = kok.querySelector(".ms-ozel-select-secenek-listesi");
        kayitlar.forEach((k) => {
            const ad = k.nameI18n?.tr || k.code || "";
            const secenek = document.createElement("button");
            secenek.className = "ms-ozel-select-secenek" + (secildi === k.id ? " ms-ozel-select-secenek-aktif" : "");
            secenek.type = "button";
            secenek.setAttribute("role", "option");
            secenek.setAttribute("data-ms-ozel-select-secenek", "");
            secenek.dataset.msDeger = k.id;
            secenek.textContent = ad;
            secenek.addEventListener("click", () => {
                girdi.value = k.id;
                girdi.dataset.msSecilenAd = ad;
                girdi.dispatchEvent(new Event("change", { bubbles: true }));
            });
            listeKutusu.appendChild(secenek);
            if (secildi === k.id) {
                kok.querySelector("[data-ms-ozel-select-deger]").textContent = ad;
                girdi.value = k.id;
                girdi.dataset.msSecilenAd = ad;
            }
        });
        kapsayici.appendChild(kok);
        window.msOzelSelectleriBaslat?.(kok);
    };

    const ilKapsayici = modal.querySelector("[data-ms-adres-il-kapsayici]");
    const ilceKapsayici = modal.querySelector("[data-ms-adres-ilce-kapsayici]");
    let iller = [];

    const illeriKur = (secilecek) => ozelSelectKur(ilKapsayici, alan("il"), iller, "Seçim yapın", "İl", secilecek || null);
    const ilceleriYukle = async (cityId, secilecek) => {
        const ilceler = cityId ? await geoGetir("districts?cityId=" + cityId) : [];
        ozelSelectKur(ilceKapsayici, alan("ilce"), ilceler, "Seçim yapın", "İlçe", secilecek || null);
    };

    alan("il").addEventListener("change", () => {
        ilceleriYukle(alan("il").value);
    });

    // ── Kart listesi ──
    const liste = el("[data-ms-adresler-liste]");
    const sablon = el("[data-ms-adresler-kart-sablon]");
    const bosMesaj = el("[data-ms-adresler-bos]");

    const kartlariCiz = () => {
        liste.innerHTML = "";
        bosMesaj.hidden = adresler.length > 0;
        adresler.forEach((adres) => {
            const kart = sablon.content.cloneNode(true);
            const kutu = kart.querySelector("article");
            kutu.classList.toggle("ms-hesabim-adres-varsayilan", adres.isDefault);
            kutu.dataset.msAdresAd = adres.title || "";
            kart.querySelector('[data-alan="baslik"]').textContent = adres.title;
            kart.querySelector('[data-alan="altbaslik"]').style.display = adres.isDefault ? "" : "none";
            kart.querySelector('[data-alan="etiket"]').style.display = adres.isDefault ? "" : "none";
            kart.querySelector('[data-alan="alici"]').textContent = adres.recipientName;
            kart.querySelector('[data-alan="adres"]').textContent = [
                adres.neighborhoodName, adres.addressLine,
                [adres.districtName, adres.cityName].filter(Boolean).join(" / ")
            ].filter(Boolean).join(", ");
            const tel = (adres.recipientPhone || "").replace(/\D/g, "").replace(/^90/, "");
            kart.querySelector('[data-alan="telefon"]').textContent = tel
                ? "Telefon: " + [tel.slice(0, 3), tel.slice(3, 6), tel.slice(6, 8), tel.slice(8, 10)].filter(Boolean).join(" ")
                : "";
            if (adres.isDefault) {
                kart.querySelector('[data-aksiyon="varsayilan"]').remove();
                kart.querySelector('[data-aksiyon="sil"]').remove();
            }
            kart.querySelector('[data-aksiyon="duzenle"]').addEventListener("click", () => formaAl(adres));
            kart.querySelector('[data-aksiyon="varsayilan"]')?.addEventListener("click", async () => {
                await fetch(`/api/store/account/addresses/${adres.id}/default`, { method: "POST", headers: basliklar() });
                await adresleriYukle();
            });
            kart.querySelector('[data-aksiyon="sil"]')?.addEventListener("click", async () => {
                await fetch(`/api/store/account/addresses/${adres.id}`, { method: "DELETE", headers: basliklar() });
                if (duzenlenenId === adres.id) { duzenlenenId = null; }
                await adresleriYukle();
            });
            liste.appendChild(kart);
        });
    };

    const adresleriYukle = async () => {
        try {
            const cevap = await (await fetch("/api/store/account/addresses", { headers: basliklar() })).json();
            adresler = cevap?.success ? cevap.data : [];
            kartlariCiz();
        } catch { /* liste yüklenemedi */ }
    };

    // ── Form ──
    const formuTemizle = () => {
        duzenlenenId = null;
        form.reset();
        illeriKur(null);
        ilceleriYukle(null);
        mesajGoster("");
    };

    const formaAl = async (adres) => {
        duzenlenenId = adres.id;
        alan("baslik").value = adres.title || "";
        const adParcalari = (adres.recipientName || "").split(" ");
        alan("soyad").value = adParcalari.length > 1 ? adParcalari.pop() : "";
        alan("ad").value = adParcalari.join(" ");
        const tel = (adres.recipientPhone || "").replace(/\D/g, "").replace(/^90/, "");
        alan("telefon").value = [tel.slice(0, 3), tel.slice(3, 6), tel.slice(6, 8), tel.slice(8, 10)].filter(Boolean).join(" ");
        alan("mahalle").value = adres.neighborhoodName || "";
        alan("acikadres").value = adres.addressLine || "";
        alan("varsayilan").checked = !!adres.isDefault;
        illeriKur(adres.cityId || null);
        await ilceleriYukle(adres.cityId || null, adres.districtId || null);
        mesajGoster("");
        modalAc("Adresi Düzenle");
    };

    el("[data-ms-adresler-yeni]").addEventListener("click", () => {
        formuTemizle();
        modalAc("Yeni Adres Ekle");
    });

    form.addEventListener("submit", async (olay) => {
        olay.preventDefault();
        mesajGoster("");
        if (!alan("baslik").value.trim() || !alan("ad").value.trim()) {
            mesajGoster("Adres başlığı ve ad zorunludur.", true); return;
        }
        if (!alan("il").value || !alan("ilce").value) {
            mesajGoster("İl ve ilçe seçin.", true); return;
        }
        const rakamlar = alan("telefon").value.replace(/\D/g, "");
        const govde = {
            title: alan("baslik").value.trim(),
            countryId: trUlke?.id || null,
            countryName: trUlke?.ad || "Türkiye",
            cityId: alan("il").value,
            cityName: alan("il").dataset.msSecilenAd || "",
            districtId: alan("ilce").value,
            districtName: alan("ilce").dataset.msSecilenAd || "",
            neighborhoodId: null,
            neighborhoodName: alan("mahalle").value.trim() || null,
            addressLine: alan("acikadres").value.trim() || null,
            postalCode: null,
            recipientName: (alan("ad").value.trim() + " " + alan("soyad").value.trim()).trim(),
            recipientPhone: rakamlar ? "90" + rakamlar : "",
            deliveryNotes: null,
            isDefault: alan("varsayilan").checked
        };
        try {
            const cevap = await fetch(
                duzenlenenId ? `/api/store/account/addresses/${duzenlenenId}` : "/api/store/account/addresses",
                { method: duzenlenenId ? "PUT" : "POST", headers: basliklar(), body: JSON.stringify(govde) });
            const veri = await cevap.json().catch(() => null);
            if (!veri?.success) {
                mesajGoster(veri?.error || "Adres kaydedilemedi.", true); return;
            }
            formuTemizle();
            modalKapat();
            await adresleriYukle();
        } catch {
            mesajGoster("Adres kaydedilemedi. Lütfen tekrar deneyin.", true);
        }
    });

    // ── Başlangıç: TR + iller + kartlar ──
    (async () => {
        const ulkeler = await geoGetir("countries");
        const tr = ulkeler.find((u) => u.code === "TR") || ulkeler[0];
        if (tr) {
            trUlke = { id: tr.id, ad: tr.nameI18n?.tr || "Türkiye" };
            iller = await geoGetir("cities?countryId=" + tr.id);
        }
        illeriKur(null);
        ilceleriYukle(null);
        await adresleriYukle();
    })();
});
</script>
