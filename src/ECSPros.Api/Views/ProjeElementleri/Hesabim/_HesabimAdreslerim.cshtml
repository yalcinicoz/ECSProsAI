<section class="ms-hesabim-sayfa" aria-labelledby="ms-hesabim-adresler-baslik">
    <partial name="~/Views/ProjeElementleri/Hesabim/_HesabimYanMenu.cshtml" model='@("adresler")' />

    <section class="ms-hesabim-icerik">
        <header class="ms-hesabim-baslik">
            <h2 id="ms-hesabim-adresler-baslik">Adreslerim</h2>
        </header>

        <div class="ms-hesabim-adres-sayfa">
            <div class="ms-hesabim-adres-ust">
                <div>
                    <h3>Teslimat ve fatura adresleri</h3>
                    <p>Siparişlerinizde kullanacağınız teslimat ve fatura adreslerini bu alandan yönetebilirsiniz.</p>
                </div>
                <button class="ms-buton ms-buton-m ms-buton-satin-al" type="button">Yeni Adres Ekle</button>
            </div>

            <div class="ms-hesabim-adres-grid">
                <section class="ms-hesabim-adres-listesi" aria-labelledby="ms-kayitli-adresler-baslik">
                    <h3 id="ms-kayitli-adresler-baslik">Kayıtlı Adresler</h3>

                    <article class="ms-hesabim-adres-karti ms-hesabim-adres-varsayilan">
                        <div class="ms-hesabim-adres-kart-ust">
                            <div>
                                <strong>Ev Adresim</strong>
                                <span>Varsayılan Teslimat</span>
                            </div>
                            <span class="ms-hesabim-adres-etiket">Aktif</span>
                        </div>
                        <p>Emre Sağlam</p>
                        <address>Atatürk Mahallesi, Çiçek Sokak No:12 Daire:5, Kadıköy / İstanbul</address>
                        <p>Telefon: 555 123 45 67</p>
                        <div class="ms-hesabim-adres-aksiyonlar">
                            <button class="ms-buton ms-buton-s ms-buton-sade" type="button">Düzenle</button>
                            <button class="ms-buton ms-buton-s ms-buton-cizgili-birincil" type="button">Varsayılan</button>
                        </div>
                    </article>

                    <article class="ms-hesabim-adres-karti">
                        <div class="ms-hesabim-adres-kart-ust">
                            <div>
                                <strong>İş Adresim</strong>
                                <span>Fatura Adresi</span>
                            </div>
                        </div>
                        <p>Emre Sağlam</p>
                        <address>Merkez Mahallesi, Ofis Caddesi No:34 Kat:3, Şişli / İstanbul</address>
                        <p>Telefon: 555 987 65 43</p>
                        <div class="ms-hesabim-adres-aksiyonlar">
                            <button class="ms-buton ms-buton-s ms-buton-sade" type="button">Düzenle</button>
                            <button class="ms-buton ms-buton-s ms-buton-tehlikeli" type="button">Sil</button>
                        </div>
                    </article>
                </section>

                <section class="ms-hesabim-adres-form-karti" aria-labelledby="ms-adres-form-baslik">
                    <h3 id="ms-adres-form-baslik">Adres Bilgileri</h3>
                    <form class="ms-hesabim-adres-formu" action="/Hesabim/Adreslerim" method="post">
                        <div class="ms-form-izgara">
                            <label class="ms-form-alani ms-form-alani-genis">
                                <span class="ms-form-etiket">Adres Başlığı</span>
                                <input class="ms-form-girdi" type="text" name="AdresBasligi" value="Ev Adresim" autocomplete="address-line1" />
                            </label>
                            <label class="ms-form-alani">
                                <span class="ms-form-etiket">Ad</span>
                                <input class="ms-form-girdi" type="text" name="Ad" value="Emre" autocomplete="given-name" />
                            </label>
                            <label class="ms-form-alani">
                                <span class="ms-form-etiket">Soyad</span>
                                <input class="ms-form-girdi" type="text" name="Soyad" value="Sağlam" autocomplete="family-name" />
                            </label>
                            <label class="ms-form-alani ms-form-alani-genis">
                                <span class="ms-form-etiket">Telefon</span>
                                <span class="ms-telefon-girdi">
                                    <span class="ms-telefon-ulke" data-ms-telefon-ulke-select>
                                        <button class="ms-telefon-ulke-tetikleyici" type="button" data-ms-telefon-ulke-tetikleyici aria-haspopup="listbox" aria-expanded="false">
                                            <img class="ms-telefon-bayrak" src="https://flagcdn.com/tr.svg" alt="Türkiye">
                                            <span data-ms-telefon-ulke-kod>+90</span>
                                            <i class="fa-solid fa-chevron-down ms-fa-ikon ms-telefon-ulke-ok " aria-hidden="true"></i>
                                        </button>
                                        <span class="ms-telefon-ulke-panel" role="listbox">
                                            <input class="ms-telefon-ulke-arama" type="search" placeholder="Ülke ara" data-ms-telefon-ulke-arama>
                                            <button class="ms-telefon-ulke-secenek ms-telefon-ulke-secenek-aktif" type="button" data-ms-telefon-ulke-secenek data-kod="+90" data-bayrak="https://flagcdn.com/tr.svg" data-ulke="Türkiye">
                                                <img class="ms-telefon-bayrak" src="https://flagcdn.com/tr.svg" alt=""> Türkiye <strong>+90</strong>
                                            </button>
                                            <button class="ms-telefon-ulke-secenek" type="button" data-ms-telefon-ulke-secenek data-kod="+49" data-bayrak="https://flagcdn.com/de.svg" data-ulke="Almanya">
                                                <img class="ms-telefon-bayrak" src="https://flagcdn.com/de.svg" alt=""> Almanya <strong>+49</strong>
                                            </button>
                                            <button class="ms-telefon-ulke-secenek" type="button" data-ms-telefon-ulke-secenek data-kod="+44" data-bayrak="https://flagcdn.com/gb.svg" data-ulke="Birleşik Krallık">
                                                <img class="ms-telefon-bayrak" src="https://flagcdn.com/gb.svg" alt=""> Birleşik Krallık <strong>+44</strong>
                                            </button>
                                        </span>
                                    </span>
                                    <input type="tel" name="Telefon" value="555 123 45 67" placeholder="___ ___ __ __" inputmode="numeric" autocomplete="tel-national" maxlength="13" data-ms-telefon-input>
                                </span>
                            </label>
                            <label class="ms-form-alani">
                                <span class="ms-form-etiket">İl</span>
                                <select class="ms-form-girdi" name="Il">
                                    <option>İstanbul</option>
                                    <option>Ankara</option>
                                    <option>İzmir</option>
                                </select>
                            </label>
                            <label class="ms-form-alani">
                                <span class="ms-form-etiket">İlçe</span>
                                <select class="ms-form-girdi" name="Ilce">
                                    <option>Kadıköy</option>
                                    <option>Şişli</option>
                                    <option>Beşiktaş</option>
                                </select>
                            </label>
                            <label class="ms-form-alani ms-form-alani-genis">
                                <span class="ms-form-etiket">Mahalle</span>
                                <input class="ms-form-girdi" type="text" name="Mahalle" value="Atatürk Mahallesi" autocomplete="address-level3" />
                            </label>
                            <label class="ms-form-alani ms-form-alani-genis">
                                <span class="ms-form-etiket">Açık Adres</span>
                                <textarea class="ms-form-metin-alani" name="AcikAdres" rows="4" autocomplete="street-address">Çiçek Sokak No:12 Daire:5</textarea>
                            </label>
                        </div>

                        <label class="ms-onay-kart ms-hesabim-adres-varsayilan-secim">
                            <input class="ms-onay-input" type="checkbox" name="VarsayilanAdres" checked>
                            <span class="ms-onay-kutu" aria-hidden="true"></span>
                            <span class="ms-onay-metin">
                                Varsayılan adres olarak kullan
                                <span class="ms-onay-yardim">Sepet ve ödeme adımlarında bu adres otomatik seçilir.</span>
                            </span>
                        </label>

                        <div class="ms-hesabim-adres-form-aksiyonlar">
                            <button class="ms-buton ms-buton-m ms-buton-sade" type="button">Temizle</button>
                            <button class="ms-buton ms-buton-m ms-buton-satin-al" type="submit">Adresi Kaydet</button>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </section>
</section>
