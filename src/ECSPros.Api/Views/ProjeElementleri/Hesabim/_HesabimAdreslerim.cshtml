@* E3: Adreslerim canlı — kartlar GET addresses; form yeni adres POST / Düzenle PUT;
   Varsayılan POST default; Sil DELETE. İl/ilçe geo API'den kademeli; mahalle serbest
   metin (tasarımdaki gibi); ülke TR sabit (telefon ülke seçici görsel — site.js). *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const sayfa = document.querySelector(".ms-hesabim-adres-sayfa");
    if (!sayfa) { return; }
    const token = () => localStorage.getItem("ecspros_member_token");
    const basliklar = () => ({ "Content-Type": "application/json", Authorization: "Bearer " + token() });
    const el = (sec) => sayfa.querySelector(sec);
    const form = el(".ms-hesabim-adres-formu");
    const alan = (ad) => sayfa.querySelector(`[data-ms-adres-form="${ad}"]`);
    const mesaj = el("[data-ms-adres-form-mesaj]");
    let adresler = [];
    let duzenlenenId = null;
    let trUlke = null; // { id, ad }
    let iller = [];

    const mesajGoster = (metin, hata) => {
        mesaj.textContent = metin || "";
        mesaj.hidden = !metin;
        mesaj.classList.toggle("ms-uyari-hata", !!hata);
    };

    const geoGetir = async (yol) => {
        try {
            const cevap = await (await fetch("/api/store/geo/" + yol)).json();
            return cevap?.success ? cevap.data : [];
        } catch { return []; }
    };

    const secimDoldur = (secim, kayitlar) => {
        secim.querySelectorAll("option:not([value=''])").forEach((s) => s.remove());
        kayitlar.forEach((k) => {
            const secenek = document.createElement("option");
            secenek.value = k.id;
            secenek.textContent = k.nameI18n?.tr || k.code || "";
            secim.appendChild(secenek);
        });
    };

    const ilceleriYukle = async (cityId, secilecek) => {
        const ilceler = await geoGetir("districts?cityId=" + cityId);
        secimDoldur(alan("ilce"), ilceler);
        if (secilecek) { alan("ilce").value = secilecek; }
    };

    alan("il").addEventListener("change", () => {
        alan("ilce").value = "";
        alan("ilce").querySelectorAll("option:not([value=''])").forEach((s) => s.remove());
        if (alan("il").value) { ilceleriYukle(alan("il").value); }
    });

    // ── Kart listesi ──
    const liste = el("[data-ms-adresler-liste]");
    const sablon = el("[data-ms-adresler-kart-sablon]");
    const bosMesaj = el("[data-ms-adresler-bos]");

    const kartlariCiz = () => {
        liste.innerHTML = "";
        bosMesaj.hidden = adresler.length > 0;
        adresler.forEach((adres) => {
            const kart = sablon.content.cloneNode(true);
            const kutu = kart.querySelector("article");
            kutu.classList.toggle("ms-hesabim-adres-varsayilan", adres.isDefault);
            kart.querySelector('[data-alan="baslik"]').textContent = adres.title;
            kart.querySelector('[data-alan="altbaslik"]').style.display = adres.isDefault ? "" : "none";
            kart.querySelector('[data-alan="etiket"]').style.display = adres.isDefault ? "" : "none";
            kart.querySelector('[data-alan="alici"]').textContent = adres.recipientName;
            kart.querySelector('[data-alan="adres"]').textContent = [
                adres.neighborhoodName, adres.addressLine,
                [adres.districtName, adres.cityName].filter(Boolean).join(" / ")
            ].filter(Boolean).join(", ");
            const tel = (adres.recipientPhone || "").replace(/\D/g, "").replace(/^90/, "");
            kart.querySelector('[data-alan="telefon"]').textContent = tel
                ? "Telefon: " + [tel.slice(0, 3), tel.slice(3, 6), tel.slice(6, 8), tel.slice(8, 10)].filter(Boolean).join(" ")
                : "";
            if (adres.isDefault) {
                kart.querySelector('[data-aksiyon="varsayilan"]').remove();
                kart.querySelector('[data-aksiyon="sil"]').remove();
            }
            kart.querySelector('[data-aksiyon="duzenle"]').addEventListener("click", () => formaAl(adres));
            kart.querySelector('[data-aksiyon="varsayilan"]')?.addEventListener("click", async () => {
