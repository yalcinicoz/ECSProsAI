@* E9: İndirim Kuponlarım canlıya bağlandı — kartlar SSR (ViewData["MsKuponlar"];
   yalnız üyeye/üye grubuna tanımlı kullanılabilir kuponlar). "Sepette Kullan" C3'ün
   sessionStorage kupon sözleşmesine ({kod}) yazıp sepete gider — sepet açılışta kodu
   sessizce doğrulayıp uygular. "Kupon Kodu Ekle" tasarım demo'su gizli (kupon kodu
   sepetteki alandan girilir — ayrı bir "kod tanımlama/claim" modeli yok). *@
@{
    var msKuponlar = ViewData["MsKuponlar"] as List<ECSPros.Api.Models.Store.HesabimKuponVm> ?? new();
}
<section class="ms-hesabim-sayfa" aria-labelledby="ms-hesabim-kuponlar-baslik">
    <partial name="~/Views/ProjeElementleri/Hesabim/_HesabimYanMenu.cshtml" model='@("kuponlar")' />

    <section class="ms-hesabim-icerik">
        <header class="ms-hesabim-baslik">
            <h2 id="ms-hesabim-kuponlar-baslik">İndirim Kuponlarım</h2>
        </header>

        <div class="ms-hesabim-liste-sayfa">
            <div class="ms-hesabim-liste-ust">
                <div>
                    <h3>Kullanılabilir kuponlar</h3>
                    <p>Sepette kullanabileceğiniz kuponları ve son kullanım tarihlerini takip edin.</p>
                </div>
                @if (false)
                {
                @* Kupon kodu girişi sepetteki alandan yapılır — ayrı kod tanımlama akışı yok. *@
                <button class="ms-buton ms-buton-m ms-buton-sade" type="button">Kupon Kodu Ekle</button>
                }
            </div>

            @if (msKuponlar.Count == 0)
            {
            <section class="ms-hesabim-bos-durum" aria-labelledby="ms-kuponlar-bos-baslik">
                <i class="fa-solid fa-ticket ms-fa-ikon " aria-hidden="true"></i>
                <div>
                    <h3 id="ms-kuponlar-bos-baslik">Kullanılabilir kuponunuz yok</h3>
                    <p>Size özel kampanya veya indirim kuponu tanımlandığında burada görünür.</p>
                </div>
                <a class="ms-buton ms-buton-m ms-buton-sade" href="/">Kampanyaları Gör</a>
            </section>
            }
            else
            {
            <div class="ms-hesabim-mini-grid">
                @foreach (var kupon in msKuponlar)
                {
                <article class="ms-hesabim-kupon-karti">
                    <span>@kupon.Code</span>
                    <strong>@kupon.IndirimMetni</strong>
                    <p>@kupon.KosulMetni</p>
                    <button class="ms-buton ms-buton-s ms-buton-satin-al" type="button" data-ms-kupon-sepette-kullan="@kupon.Code">Sepette Kullan</button>
                </article>
                }
            </div>
            }
        </div>
    </section>
</section>

@* E9: Sepette Kullan — C3 kupon sözleşmesi: sepet sayfası açılışta sessionStorage
   msSepetKuponDurumu.kod'u sessizce yeniden doğrulayıp uygular. *@
<script>
    document.querySelectorAll("[data-ms-kupon-sepette-kullan]").forEach((buton) => {
        buton.addEventListener("click", () => {
            try {
                sessionStorage.setItem("msSepetKuponDurumu",
                    JSON.stringify({ kod: buton.dataset.msKuponSepetteKullan }));
            } catch { /* depolama kapalıysa kod sepette elle girilir */ }
            window.location.href = "/Sepet";
        });
    });
</script>
