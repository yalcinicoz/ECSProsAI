@* E5: Favorilerim canlı — demo kartlar yerine paylaşılan _UrunKarti partial'ı (liste/ana
   sayfayla tek kart kaynağı; kalpler _FavoriDavranis'ın GET işaretlemesiyle aktif gelir,
   çıkarma aynı kalpten). Paylaş butonu gizli (paylaşılabilir liste E6 koleksiyon kararıyla). *@
@{
    var msFavoriKartlar = ViewData["MsFavoriKartlar"] as List<ECSPros.Api.Models.Store.UrunKartVm> ?? new();
}

<section class="ms-hesabim-sayfa" aria-labelledby="ms-hesabim-favoriler-baslik">
    <partial name="~/Views/ProjeElementleri/Hesabim/_HesabimYanMenu.cshtml" model='@("favoriler")' />

    <section class="ms-hesabim-icerik">
        <header class="ms-hesabim-baslik">
            <h2 id="ms-hesabim-favoriler-baslik">Favorilerim</h2>
        </header>

        <div class="ms-hesabim-liste-sayfa">
            <div class="ms-hesabim-liste-ust">
                <div>
                    <h3>Favori ürünler</h3>
                    <p>Beğendiğiniz ürünleri takip edin, stok ve fiyat değişikliklerini kaçırmayın.</p>
                </div>
                @if (false)
                {
                <button class="ms-buton ms-buton-m ms-buton-sade" type="button">Paylaş</button>
                }
            </div>

            @if (msFavoriKartlar.Count == 0)
            {
            <section class="ms-hesabim-bos-durum" aria-labelledby="ms-favoriler-bos-baslik">
                <img class="ms-ikon-siyah" src="/ikons/favorilerim-sade-icon.svg" alt="" aria-hidden="true">
                <div>
                    <h3 id="ms-favoriler-bos-baslik">Henüz favori ürününüz yok</h3>
                    <p>Beğendiğiniz ürünleri favorilere eklediğinizde burada saklanır.</p>
                </div>
                <a class="ms-buton ms-buton-m ms-buton-satin-al" href="/urunler">Favori Ekle</a>
            </section>
            }
            else
            {
            <div class="ms-hesabim-favori-urun-listesi">
                @foreach (var kart in msFavoriKartlar)
                {
                    <partial name="~/Views/ProjeElementleri/Urun/_UrunKarti.cshtml" model="kart" />
                }
            </div>
            }
        </div>
    </section>
</section>
