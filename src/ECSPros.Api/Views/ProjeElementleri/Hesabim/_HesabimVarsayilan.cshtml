                <img src=\
                <span>Favorilerim</span>
            </a>
            <a class="ms-hesabim-kisayol" href="/Hesabim/Koleksiyonlarim">
                <img src=\
                <span>Koleksiyonlarım</span>
            </a>
            <a class="ms-hesabim-kisayol" href="/Hesabim/Yorumlarim">
                <img src=\
                <span>Yorumlarım</span>
            </a>
            <a class="ms-hesabim-kisayol" href="/Hesabim/Iadelerim">
