@* E1: karşılama adı SSR kimlikten. E13: özet kartları eklendi (plan şartı — tasarımda
   yoktu; E4 Siparişlerim özet grid kalıbı: sipariş/iade/kupon/favori sayıları + hediye
   çeki bakiyesi + kullanılabilir puan, hepsi gerçek sorgulardan). Kısayol grid'inin
   tasarım kaynağındaki bozuk markup'ı (`<img src=\` — E1'de kayda geçen kaynak kusuru)
   mevcut sade ikon setiyle onarıldı. *@
@{
    var msOzetTr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var msKisayollar = new (string Link, string Ikon, string Ad)[]
    {
        ("/Hesabim/UyelikBilgilerim", "uyelik-bilgilerim-sade-icon.svg", "Üyelik Bilgilerim"),
        ("/Hesabim/Adreslerim", "adreslerim-sade-icon.svg", "Adreslerim"),
        ("/Hesabim/Siparislerim", "siparislerim-sade-icon.svg", "Siparişlerim"),
        ("/Favorilerim", "favorilerim-sade-icon.svg", "Favorilerim"),
        ("/Hesabim/Koleksiyonlarim", "koleksiyonlarim-sade-icon.svg", "Koleksiyonlarım"),
        ("/Hesabim/Yorumlarim", "yorumlarim-sade-icon.svg", "Yorumlarım"),
        ("/Hesabim/Iadelerim", "iadelerim-sade-icon.svg", "İadelerim")
    };
}
<section class="ms-hesabim-sayfa" aria-labelledby="ms-hesabim-varsayilan-baslik">
    <partial name="~/Views/ProjeElementleri/Hesabim/_HesabimYanMenu.cshtml" model="@string.Empty" />

    <section class="ms-hesabim-icerik">
        <header class="ms-hesabim-baslik">
            <h2 id="ms-hesabim-varsayilan-baslik">Hesabım</h2>
        </header>

        @* E1: karşılama adı SSR kimlikten (D1 ViewData["MsUye"] — guard'lı sayfada hep dolu). *@
        <div class="ms-hesabim-karsilama">
            <h3>Merhaba @(((ViewData["MsUye"] as ECSPros.Api.Services.StoreUyeKimlik)?.FullName ?? "").ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR")))</h3>
            <p>"Hesabım" sayfasından siparişlerinizi ve arıza/iade/değişim işlemlerinizi takip edebilir, kazandığınız hediye çeki ve puanları görüntüleyebilir, üyelik bilgisi güncelleme, şifre ve adres değişikliği gibi hesap ayarlarınızı kolayca yapabilirsiniz.</p>
        </div>

        <section class="ms-hesabim-siparis-ozet-grid" aria-label="Hesap özeti">
            <article>
                <span>Toplam Sipariş</span>
                <strong>@(ViewData["MsOzetSiparis"] ?? 0)</strong>
            </article>
            <article>
                <span>İade Süreci</span>
                <strong>@(ViewData["MsOzetIade"] ?? 0)</strong>
            </article>
            <article>
                <span>Kullanılabilir Kupon</span>
                <strong>@(ViewData["MsOzetKupon"] ?? 0)</strong>
            </article>
            <article>
                <span>Favori Ürün</span>
                <strong>@(ViewData["MsOzetFavori"] ?? 0)</strong>
            </article>
            <article>
                <span>Hediye Çeki Bakiyesi</span>
                <strong>@(((decimal)(ViewData["MsOzetBakiye"] ?? 0m)).ToString("N2", msOzetTr)) TL</strong>
            </article>
            <article>
                <span>Kullanılabilir Puan</span>
                <strong>@(ViewData["MsOzetPuan"] ?? 0)</strong>
            </article>
        </section>

        <div class="ms-hesabim-kisayol-grid" aria-label="Hesabım kısayolları">
            @foreach (var (link, ikon, ad) in msKisayollar)
            {
            <a class="ms-hesabim-kisayol" href="@link">
                <img class="ms-ikon-siyah" src="/ikons/@ikon" alt="" aria-hidden="true">
                <span>@ad</span>
            </a>
            }
        </div>
    </section>
</section>
