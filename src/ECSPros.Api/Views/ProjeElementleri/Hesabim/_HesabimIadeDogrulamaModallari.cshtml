@* E8: SMS doğrulama + iade kodu modalları canlıya bağlandı. Kod üyenin KAYITLI
   telefonuna gider (D4 OTP altyapısı, purpose=phone_verify) — bu yüzden telefon alanı
   salt okunur, tasarımdaki ülke seçici kaldırıldı. Durum kutuları doğrulama sonucuna
   göre gösterilir. İade kodu modalı POST sonucundaki gerçek kodlarla dolar (sipariş
   başına bir iade açıldığından birden çok kod olabilir). *@
@{
    var msIadeSmsUye = ViewData["MsIadeUye"] as ECSPros.Crm.Application.Queries.GetMemberDetail.MemberDetailDto;

    string MsIadeSmsTelefonYaz(string? telefon)
    {
        var rakamlar = new string((telefon ?? "").Where(char.IsDigit).ToArray());
        if (rakamlar.Length < 10) return telefon ?? "";
        var son10 = rakamlar[^10..];
        return $"{son10[..3]} {son10[3..6]} {son10[6..8]} {son10[8..]}";
    }
}
<div class="ms-ornek-modal ms-iade-sms-modal" data-ms-iade-sms-modal aria-hidden="true">
    <div class="ms-ornek-modal-kaplama" data-ms-iade-sms-kapat></div>
    <section class="ms-ornek-modal-kutu ms-ornek-modal-boyut-l ms-iade-sms-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-iade-sms-baslik">
        <button class="ms-ornek-modal-kapat" type="button" data-ms-iade-sms-kapat aria-label="SMS doğrulama modalını kapat">×</button>
        <h3 id="ms-iade-sms-baslik" class="ms-ornek-modal-baslik">SMS Doğrulama</h3>
        <p class="ms-ornek-modal-aciklama">İade kodu oluşturulmadan önce telefon numaranızın doğrulanması gerekir. Kod, üyeliğinizde kayıtlı numaraya gönderilir.</p>

        <div class="ms-iade-sms-formu">
            <label class="ms-form-alani">
                <span class="ms-form-etiket">Ülke Kodlu Telefon</span>
                <div class="ms-telefon-girdi">
                    <div class="ms-telefon-ulke">
                        <button class="ms-telefon-ulke-tetikleyici" type="button" disabled>
                            <span data-ms-telefon-ulke-kod>+90</span>
                        </button>
                    </div>
                    <input type="tel" inputmode="numeric" value="@MsIadeSmsTelefonYaz(msIadeSmsUye?.Phone)" data-ms-telefon-input aria-label="Telefon numarası" readonly>
                </div>
            </label>

            <div class="ms-iade-sms-kod-alani">
                <div class="ms-iade-sms-kod-baslik">
                    <span>6 Haneli Kod</span>
                    <strong data-ms-iade-sms-sayac>02:00</strong>
                </div>
                <div class="ms-kod-giris" data-ms-kod-giris aria-label="SMS doğrulama kodu">
                    <input class="ms-kod-giris-input" type="text" inputmode="numeric" maxlength="1" aria-label="1. hane">
                    <input class="ms-kod-giris-input" type="text" inputmode="numeric" maxlength="1" aria-label="2. hane">
                    <input class="ms-kod-giris-input" type="text" inputmode="numeric" maxlength="1" aria-label="3. hane">
                    <input class="ms-kod-giris-input" type="text" inputmode="numeric" maxlength="1" aria-label="4. hane">
                    <input class="ms-kod-giris-input" type="text" inputmode="numeric" maxlength="1" aria-label="5. hane">
                    <input class="ms-kod-giris-input" type="text" inputmode="numeric" maxlength="1" aria-label="6. hane">
                </div>
                <span class="ms-iade-sms-bilgi-etiketi ms-gizli" data-ms-iade-sms-bilgi role="status" aria-live="polite"></span>
            </div>

            <div class="ms-iade-sms-durumlari">
                @* inline display: sınıf display'i hidden attribute'ünü ezebilir *@
                <article class="ms-iade-sms-durum ms-iade-sms-durum-basarili" style="display:none">
                    <strong>Telefon doğrulandı</strong>
                    <small>İade kodu oluşturma adımına devam edebilirsiniz.</small>
                </article>
                <article class="ms-iade-sms-durum ms-iade-sms-durum-hata">
                    <strong>Telefon doğrulanmadı</strong>
                    <small>İade kodu alabilmek için SMS kodu ile numaranızı doğrulamalısınız.</small>
                </article>
            </div>
        </div>

        <div class="ms-ornek-modal-aksiyonlar">
            <button class="ms-buton ms-buton-m ms-buton-sade" type="button" data-ms-iade-sms-kapat>Vazgeç</button>
            <button class="ms-buton ms-buton-m ms-buton-ikincil" type="button" data-ms-iade-sms-yeniden-gonder>Kodu Tekrar Gönder</button>
            <button class="ms-buton ms-buton-m ms-buton-satin-al" type="button" data-ms-iade-sms-onayla>Doğrula</button>
        </div>
    </section>
</div>

<div class="ms-ornek-modal ms-iade-kodu-modal" data-ms-iade-kodu-modal aria-hidden="true">
    <div class="ms-ornek-modal-kaplama" data-ms-iade-kodu-kapat></div>
    <section class="ms-ornek-modal-kutu ms-ornek-modal-kutu-basarili ms-iade-kodu-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-iade-kodu-baslik">
        <button class="ms-ornek-modal-kapat" type="button" data-ms-iade-kodu-kapat aria-label="İade kodu modalını kapat">×</button>
        <h3 id="ms-iade-kodu-baslik" class="ms-ornek-modal-baslik">İade Kodunuz Hazır</h3>
        <p class="ms-ornek-modal-aciklama">Paketi anlaşmalı kargonun teslim noktasına bu kod ile bırakabilirsiniz.</p>
        <div data-ms-iade-kodu-liste>
            <div class="ms-iade-kodu-kutu">
                <span>Kargo İade Kodu</span>
                <button type="button" data-ms-iade-kodu-kopyala></button>
                <small data-ms-iade-kodu-kopya-bilgi>Kodu kopyalamak için tıklayın.</small>
            </div>
        </div>
        <div class="ms-ornek-modal-aksiyonlar">
            <button class="ms-buton ms-buton-m ms-buton-satin-al" type="button" data-ms-iade-kodu-kapat>Tamam</button>
        </div>
    </section>
</div>
