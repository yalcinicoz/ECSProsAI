@* E4: detay modalı canlı — içerik, Siparişlerim sayfasındaki gömülü sipariş JSON'undan
   Detay butonunun data-siparis-id'siyle dolar (doldurma script'i _HesabimSiparislerim
   sonunda). Demo değerler data-alan kancalarına çevrildi; ürün satırı template oldu.
   Kargo bilgisi H2'ye, fatura H1'e köprü — veri varsa gösterilir. *@
<div class="ms-ornek-modal ms-siparis-detay-modal" data-ms-siparis-detay-modal aria-hidden="true">
    <div class="ms-ornek-modal-kaplama" data-ms-siparis-detay-kapat></div>
    <section class="ms-ornek-modal-kutu ms-ornek-modal-boyut-xl ms-siparis-detay-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-siparis-detay-baslik">
        <button class="ms-ornek-modal-kapat" type="button" data-ms-siparis-detay-kapat aria-label="Sipariş detay modalını kapat">×</button>
        <div class="ms-siparis-modal-ust">
            <span class="ms-hesabim-siparis-durum" data-alan="durum"></span>
            <h3 id="ms-siparis-detay-baslik" class="ms-ornek-modal-baslik">Sipariş Detayı</h3>
            <p class="ms-ornek-modal-aciklama" data-alan="aciklama"></p>
        </div>

        <div class="ms-siparis-detay-bilgi-grid">
            <article><span>Sipariş No</span><strong data-alan="no"></strong></article>
            <article><span>Sipariş Tarihi</span><strong data-alan="tarih"></strong></article>
            <article><span>Ödeme</span><strong data-alan="odeme"></strong></article>
            <article><span>Kargo</span><strong data-alan="kargo"></strong></article>
        </div>

        <div class="ms-siparis-detay-bolum">
            <h4>Ürünler</h4>
            <div data-alan="urunler"></div>
            <template data-ms-detay-urun-sablon>
            <div class="ms-siparis-detay-urun">
                <img data-alan="gorsel" src="" alt="">
                <div><strong data-alan="ad"></strong><p data-alan="secenek"></p></div>
                <strong class="ms-urun-fiyat" data-alan="fiyat"></strong>
            </div>
            </template>
        </div>

        <div class="ms-siparis-detay-iki-kolon">
            <article>
                <h4>Teslimat Adresi</h4>
                <p data-alan="teslimat"></p>
            </article>
            <article>
                <h4>Kargo Bilgisi</h4>
                <p data-alan="kargo-bilgi"></p>
            </article>
            <article>
                <h4>Ödeme Özeti</h4>
                <dl>
                    <div><dt>Ürün Toplamı</dt><dd data-alan="ara-toplam"></dd></div>
                    <div><dt>İndirim</dt><dd data-alan="indirim"></dd></div>
                    <div><dt>Ödenen Tutar</dt><dd data-alan="genel-toplam"></dd></div>
                </dl>
            </article>
        </div>
    </section>
</div>
