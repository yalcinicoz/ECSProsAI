        document.querySelectorAll("[data-ms-kargo-takip-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => kapat(kapatici.closest("[data-ms-kargo-takip-modal]")));
        });

        document.querySelectorAll("[data-ms-hazirlik-durumu-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => kapat(kapatici.closest("[data-ms-hazirlik-durumu-modal]")));
        });

        document.querySelectorAll("[data-ms-iade-talep-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => kapat(kapatici.closest("[data-ms-iade-talep-modal]")));
        });

        document.querySelectorAll("[data-ms-iade-kodu-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => kapat(kapatici.closest("[data-ms-iade-kodu-modal]")));
        });

        document.querySelectorAll("[data-ms-iade-sms-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => kapat(kapatici.closest("[data-ms-iade-sms-modal]")));
        });

        document.querySelectorAll("[data-ms-iade-hata-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => kapat(kapatici.closest("[data-ms-iade-hata-modal]")));
        });

        document.querySelectorAll("[data-ms-fatura-modal-kapat]").forEach((kapatici) => {
            kapatici.addEventListener("click", () => kapat(kapatici.closest("[data-ms-fatura-modal]")));
        });

        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") {
                return;
            }

            document.querySelectorAll(acikModalSecici).forEach(kapat);
        });
    })();
</script>

@* E4: detay modalı doldurma — gömülü sipariş JSON'undan; misharix'in açma dinleyicisi
   modalı açar, bu dinleyici içeriği yazar (ikisi de aynı tıklamada çalışır). *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const siparisler = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(msSiparisler.Select(s => new
    {
        id = s.Id,
        no = s.OrderNumber,
        tarih = s.TarihMetni,
        durumMetni = s.DurumMetni,
        durumSinifi = s.DurumSinifi,
        odeme = s.OdemeMetni,
        araToplam = s.AraToplam,
        indirim = s.Indirim,
        genelToplam = s.ToplamTutar,
        teslimatAdi = s.TeslimatAdi,
        teslimatAdresi = s.TeslimatAdresi,
        faturaAlicisi = s.FaturaAlicisi,
        kargoTakipNo = s.Kargo == null ? null : s.Kargo.TakipNo,
        kargoDurum = s.Kargo == null ? null : s.Kargo.DurumMetni,
        kargoFirma = s.Kargo == null ? null : s.Kargo.FirmaAdi,
        urunler = s.Urunler.Select(u => new { ad = u.Ad, secenek = u.SecenekOzeti, adet = u.Adet, fiyat = u.Fiyat, gorsel = u.GorselUrl })
    })));
    const modal = document.querySelector("[data-ms-siparis-detay-modal]");
    if (!modal || !siparisler.length) { return; }
    const alan = (ad) => modal.querySelector(`[data-alan="${ad}"]`);
    const tl = (deger) => deger.toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " TL";

    document.querySelectorAll("[data-ms-siparis-detay-ac]").forEach((buton) => {
        buton.addEventListener("click", () => {
            const s = siparisler.find((x) => x.id === buton.dataset.siparisId);
            if (!s) { return; }
            const durum = alan("durum");
            durum.textContent = s.durumMetni;
            durum.className = "ms-hesabim-siparis-durum ms-hesabim-siparis-durum-" + s.durumSinifi;
            alan("aciklama").textContent = `${s.no} numaralı siparişiniz · ${s.tarih}`;
            alan("no").textContent = s.no;
            alan("tarih").textContent = s.tarih;
            alan("odeme").textContent = s.odeme;
            alan("kargo").textContent = s.kargoTakipNo ? "Takip No: " + s.kargoTakipNo : "—";
            alan("teslimat").textContent = `${s.teslimatAdi} — ${s.teslimatAdresi}`;
            alan("fatura-bilgi").textContent = s.faturaAlicisi
                ? `${s.faturaAlicisi} — E-arşiv fatura oluşturuldu.`
                : "Fatura oluşturulduğunda burada görünür.";
            alan("kargo-bilgi").textContent = s.kargoDurum
                ? `${s.kargoFirma ? s.kargoFirma + " · " : ""}${s.kargoDurum}${s.kargoTakipNo ? " · Takip No: " + s.kargoTakipNo : ""}`
                : "Kargoya verildiğinde takip bilgisi burada görünür.";
            alan("ara-toplam").textContent = tl(s.araToplam);
            alan("indirim").textContent = s.indirim > 0 ? "-" + tl(s.indirim) : "—";
            alan("genel-toplam").textContent = tl(s.genelToplam);

            const kap = alan("urunler");
            const sablon = modal.querySelector("[data-ms-detay-urun-sablon]");
            kap.innerHTML = "";
            s.urunler.forEach((u) => {
                const satir = sablon.content.cloneNode(true);
                const gorsel = satir.querySelector('[data-alan="gorsel"]');
                if (u.gorsel) { gorsel.src = u.gorsel; gorsel.alt = u.ad; } else { gorsel.remove(); }
                satir.querySelector('[data-alan="ad"]').textContent = u.ad;
                satir.querySelector('[data-alan="secenek"]').textContent =
                    (u.secenek ? u.secenek + " · " : "") + "Adet: " + u.adet;
                satir.querySelector('[data-alan="fiyat"]').textContent = tl(u.fiyat);
                kap.appendChild(satir);
            });
        });
    });
});
</script>

@* F3 (2026-08-04): müşteri sipariş iptali — onay diyaloğu sonrası üye token'ıyla
   POST /api/store/account/orders/{id}/cancel; başarıda sayfa yenilenir (SSR liste taze).
   İptal eski sisteme outbox'la yansır; başarısızlıkta sunucu hatası kullanıcıya gösterilir. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    // O3: bekleyen siparişi onayla (SMS linkine alternatif)
    document.querySelectorAll("[data-ms-siparis-onayla]").forEach((buton) => {
        buton.addEventListener("click", async () => {
            const no = buton.dataset.msSiparisOnaylaNo || "";
            if (!window.confirm(`${no} numaralı siparişinizi onaylıyor musunuz?`)) { return; }
            buton.disabled = true;
            buton.textContent = "Onaylanıyor…";
            try {
                const cevap = await fetch(`/api/store/account/orders/${buton.dataset.msSiparisOnayla}/confirm`, {
                    method: "POST",
                    headers: { Authorization: "Bearer " + (localStorage.getItem("ecspros_member_token") || "") }
                });
                const veri = await cevap.json().catch(() => null);
                if (veri?.success) { window.location.reload(); return; }
                window.alert(veri?.error || "Sipariş onaylanamadı. Lütfen tekrar deneyin.");
            } catch {
                window.alert("Sipariş onaylanamadı. Lütfen tekrar deneyin.");
            }
            buton.disabled = false;
            buton.textContent = "Siparişi Onayla";
        });
    });

    document.querySelectorAll("[data-ms-siparis-iptal]").forEach((buton) => {
        buton.addEventListener("click", async () => {
            const no = buton.dataset.msSiparisIptalNo || "";
            if (!window.confirm(`${no} numaralı siparişiniz iptal edilecek. Emin misiniz?`)) { return; }
            buton.disabled = true;
            buton.textContent = "İptal ediliyor…";
            try {
                const cevap = await fetch(`/api/store/account/orders/${buton.dataset.msSiparisIptal}/cancel`, {
                    method: "POST",
                    headers: { Authorization: "Bearer " + (localStorage.getItem("ecspros_member_token") || "") }
                });
                const veri = await cevap.json().catch(() => null);
                if (veri?.success) { window.location.reload(); return; }
                window.alert(veri?.error || "Sipariş iptal edilemedi. Lütfen tekrar deneyin.");
            } catch {
                window.alert("Sipariş iptal edilemedi. Lütfen tekrar deneyin.");
            }
            buton.disabled = false;
            buton.textContent = "Siparişi İptal Et";
        });
    });
});
</script>
