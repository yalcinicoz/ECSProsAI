@* E6: Koleksiyonlarım canlı — kartlar SSR (ViewData["MsKoleksiyonlar"]); oluşturma
   modalının davranışı misharix site.js'te (sekmeler/seçim/ms:koleksiyon-olustur event'i),
   panelleri gerçek favori/koleksiyon ürünleriyle SSR dolar; event yakalanıp POST atılır,
   sayfa yenilenir (demo kart-render script'inin yerine). Durum rozeti eklendi (pending/
   rejected — moderasyon spec şartı); "Koleksiyonu Aç" hedefi + public koleksiyon sayfası
   Faz G koleksiyon bloğuyla gelir. *@
@{
    var msKoleksiyonlar = ViewData["MsKoleksiyonlar"] as List<ECSPros.Api.Models.Store.HesabimKoleksiyonVm> ?? new();
    var msModalFavoriler = ViewData["MsKoleksiyonFavorileri"] as List<ECSPros.Api.Models.Store.HesabimKoleksiyonUrunVm> ?? new();
    var msPanelUrunleri = ViewData["MsKoleksiyonPanelUrunleri"] as List<(ECSPros.Api.Models.Store.HesabimKoleksiyonUrunVm Urun, string Meta)> ?? new();
    var msUye = ViewData["MsUye"] as ECSPros.Api.Services.StoreUyeKimlik;
    var msUyeAd = msUye?.FullName ?? "";
    var msAvatar = string.Concat(msUyeAd.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p[0])).ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
    if (msAvatar.Length > 3) { msAvatar = msAvatar[..3]; }
}

<section class="ms-hesabim-sayfa" aria-labelledby="ms-hesabim-koleksiyonlar-baslik">
    <partial name="~/Views/ProjeElementleri/Hesabim/_HesabimYanMenu.cshtml" model='@("koleksiyonlar")' />

    <section class="ms-hesabim-icerik">
        <header class="ms-hesabim-baslik">
            <h2 id="ms-hesabim-koleksiyonlar-baslik">Koleksiyonlarım</h2>
        </header>

        <div class="ms-hesabim-liste-sayfa">
            <div class="ms-hesabim-liste-ust">
                <div>
                    <h3>Ürün koleksiyonları</h3>
                    <p>Favori ürünlerinizi alışveriş listelerine, kombinlere veya hediye planlarına göre düzenleyin.</p>
                </div>
                <button class="ms-buton ms-buton-m ms-buton-satin-al" type="button" data-ms-koleksiyon-modal-ac>Yeni Koleksiyon</button>
            </div>

            @if (msKoleksiyonlar.Count == 0)
            {
            <section class="ms-hesabim-bos-durum" aria-labelledby="ms-koleksiyonlar-bos-baslik">
                <i class="fa-solid fa-layer-group ms-fa-ikon " aria-hidden="true"></i>
                <div>
                    <h3 id="ms-koleksiyonlar-bos-baslik">Henüz koleksiyonunuz yoksa buradan başlayın</h3>
                    <p>Ürünleri temalara göre gruplayabilir, herkese açık veya paylaşılabilir koleksiyonlar hazırlayabilirsiniz.</p>
                </div>
                <button class="ms-buton ms-buton-m ms-buton-satin-al" type="button" data-ms-koleksiyon-modal-ac>Koleksiyon Oluştur</button>
            </section>
            }

            <div class="ms-hesabim-koleksiyon-grid" data-ms-koleksiyon-listesi>
                @foreach (var k in msKoleksiyonlar)
                {
                <article class="ms-hesabim-koleksiyon-karti">
                    <div class="ms-hesabim-koleksiyon-ust">
                        <div class="ms-hesabim-koleksiyon-kullanici">
                            <span class="ms-hesabim-koleksiyon-avatar" aria-hidden="true">@msAvatar</span>
                            <div>
                                <strong>@msUyeAd</strong>
                                <p>@k.Ad</p>
                            </div>
                        </div>
                        <button class="ms-hesabim-koleksiyon-ikon-buton" type="button" aria-label="Koleksiyon seçenekleri"><i class="fa-solid fa-ellipsis-vertical ms-fa-ikon " aria-hidden="true"></i></button>
                    </div>

                    <div class="ms-hesabim-koleksiyon-kapak">
                        @foreach (var u in k.KapakUrunleri)
                        {
                        <a href="/urun/@u.Kod" aria-label="@k.Ad koleksiyonundaki @u.Ad ürününü aç">
                            <img src="@u.GorselUrl" alt="@u.Ad" />
                        </a>
                        }
                        @if (k.UrunSayisi > k.KapakUrunleri.Count)
                        {
                        <span class="ms-hesabim-koleksiyon-kapak-bos">+@(k.UrunSayisi - k.KapakUrunleri.Count)</span>
                        }
                        else if (k.KapakUrunleri.Count == 0)
                        {
                        <span class="ms-hesabim-koleksiyon-kapak-bos">Ürün bekliyor</span>
                        }
                    </div>

                    <div class="ms-hesabim-koleksiyon-icerik">
                        <h3><a href="/#">@k.Ad</a></h3>
                        @if (!string.IsNullOrWhiteSpace(k.Aciklama))
                        {
                        <p>@k.Aciklama</p>
                        }
                        <div class="ms-hesabim-koleksiyon-rozetler" aria-label="Koleksiyon bilgileri">
                            <span>@k.UrunSayisi Ürün</span>
                            <span>@(k.HerkeseAcik ? "Herkese açık" : "Gizli")</span>
                            <span>@(k.Paylasilabilir ? "Paylaşılabilir" : "Paylaşıma kapalı")</span>
                            <span>@k.ViewCount Görüntülenme</span>
                        </div>
                        <div class="ms-hesabim-koleksiyon-alt">
                            @if (k.Status == "pending")
                            {
                            <span class="ms-hesabim-koleksiyon-rozet">Onay bekliyor</span>
                            }
                            else if (k.Status == "rejected")
                            {
                            <span class="ms-hesabim-koleksiyon-rozet ms-hesabim-koleksiyon-rozet-indirim">Onaylanmadı</span>
                            }
                            <span class="ms-hesabim-koleksiyon-rozet">Son güncelleme @k.SonGuncellemeMetni</span>
                        </div>
                        <div class="ms-hesabim-koleksiyon-aksiyonlar">
                            @if (false)
                            {
                            @* Faz G: public koleksiyon sayfası koleksiyon bloğuyla gelir *@
                            <a class="ms-buton ms-buton-s ms-buton-sade" href="/#">Koleksiyonu Aç</a>
                            }
                            @if (k.Paylasilabilir)
                            {
                            <button class="ms-buton ms-buton-s ms-buton-sade" type="button" data-ms-koleksiyon-paylas="@k.ShareCode">Paylaş</button>
                            }
                        </div>
                    </div>
                </article>
                }
            </div>
        </div>
    </section>

    <div class="ms-ornek-modal ms-koleksiyon-modal" data-ms-koleksiyon-modal aria-hidden="true">
        <div class="ms-ornek-modal-kaplama" data-ms-koleksiyon-modal-kapat></div>
        <section class="ms-ornek-modal-kutu ms-ornek-modal-boyut-xl ms-koleksiyon-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-koleksiyon-modal-baslik">
            <button class="ms-ornek-modal-kapat" type="button" aria-label="Koleksiyon modalını kapat" data-ms-koleksiyon-modal-kapat>&times;</button>
            <div>
                <h3 class="ms-ornek-modal-baslik" id="ms-koleksiyon-modal-baslik">Koleksiyon Oluştur</h3>
                <p class="ms-ornek-modal-aciklama">Koleksiyon bilgilerini yazın, koleksiyonlarınızdan veya favorilerinizden ürün seçerek listenizi hazırlayın.</p>
            </div>

            <div class="ms-koleksiyon-form-grid">
                <label class="ms-form-alani">
                    <span class="ms-form-etiket">Koleksiyon Adı</span>
                    <input class="ms-form-girdi" type="text" data-ms-koleksiyon-ad placeholder="Örn. Bayram Kombinleri" />
                </label>
                <label class="ms-form-alani">
                    <span class="ms-form-etiket">Açıklama</span>
                    <textarea class="ms-form-metin-alani" data-ms-koleksiyon-aciklama placeholder="Bu koleksiyonda hangi ürünleri takip edeceğinizi yazın."></textarea>
                </label>
            </div>

            <div class="ms-koleksiyon-onaylar">
                <label class="ms-onay-kart">
                    <input class="ms-onay-input" type="checkbox" data-ms-koleksiyon-herkese-acik checked />
                    <span class="ms-onay-kutu" aria-hidden="true"></span>
                    <span class="ms-onay-metin">
                        Herkese açık
                        <span class="ms-onay-yardim">Diğer kullanıcılar bu koleksiyonu görebilir.</span>
                    </span>
                </label>
                <label class="ms-onay-kart">
                    <input class="ms-onay-input" type="checkbox" data-ms-koleksiyon-paylasilabilir checked />
                    <span class="ms-onay-kutu" aria-hidden="true"></span>
                    <span class="ms-onay-metin">
                        Paylaşılabilir
                        <span class="ms-onay-yardim">Bu koleksiyon paylaşılabilir olsun.</span>
                    </span>
                </label>
            </div>

            <div class="ms-koleksiyon-secim-alani">
                <div class="ms-koleksiyon-sekmeleri" role="tablist" aria-label="Koleksiyona ürün ekleme sekmeleri">
                    <button class="ms-koleksiyon-sekme ms-koleksiyon-sekme-aktif" type="button" role="tab" aria-selected="true" data-ms-koleksiyon-sekme="koleksiyonlarim">Koleksiyonlarım</button>
                    <button class="ms-koleksiyon-sekme" type="button" role="tab" aria-selected="false" data-ms-koleksiyon-sekme="favorilerim">Favorilerim</button>
                    <button class="ms-koleksiyon-sekme" type="button" role="tab" aria-selected="false" data-ms-koleksiyon-sekme="sectiklerim">Seçtiklerim <span data-ms-koleksiyon-secili-sayac>0</span></button>
                </div>

                <div class="ms-koleksiyon-panel ms-koleksiyon-panel-aktif" data-ms-koleksiyon-panel="koleksiyonlarim">
                    <div class="ms-koleksiyon-urun-grid">
                        @foreach (var (urun, meta) in msPanelUrunleri)
                        {
                        <button class="ms-koleksiyon-urun-secim" type="button" data-ms-koleksiyon-urun data-urun-id="@urun.Kod" data-urun-ad="@urun.Ad" data-urun-gorsel="@urun.GorselUrl" data-urun-meta="@meta">
                            <img src="@urun.GorselUrl" alt="@urun.Ad" />
                            <span><strong>@urun.Ad</strong><small>@meta</small></span>
                            <em>Seçildi</em>
                        </button>
                        }
                    </div>
                </div>

                <div class="ms-koleksiyon-panel" data-ms-koleksiyon-panel="favorilerim" hidden>
                    <div class="ms-koleksiyon-urun-grid">
                        @foreach (var urun in msModalFavoriler)
                        {
                        <button class="ms-koleksiyon-urun-secim" type="button" data-ms-koleksiyon-urun data-urun-id="@urun.Kod" data-urun-ad="@urun.Ad" data-urun-gorsel="@urun.GorselUrl" data-urun-meta="Favorilerim">
                            <img src="@urun.GorselUrl" alt="@urun.Ad" />
                            <span><strong>@urun.Ad</strong><small>Favorilerim</small></span>
                            <em>Seçildi</em>
                        </button>
                        }
                    </div>
                </div>

                <div class="ms-koleksiyon-panel" data-ms-koleksiyon-panel="sectiklerim" hidden>
                    <div class="ms-koleksiyon-bos" data-ms-koleksiyon-secili-bos>
                        <strong>Henüz ürün seçmediniz</strong>
                        <p>Koleksiyonlarım veya Favorilerim sekmesinden ürün seçtiğinizde burada görünecek.</p>
                    </div>
                    <div class="ms-koleksiyon-secili-liste" data-ms-koleksiyon-secili-liste></div>
                </div>
            </div>

            <div class="ms-ornek-modal-aksiyonlar">
                <div class="ms-uyari ms-uyari-hata" data-ms-koleksiyon-hata hidden></div>
                <button class="ms-buton ms-buton-m ms-buton-sade" type="button" data-ms-koleksiyon-modal-kapat>Vazgeç</button>
                <button class="ms-buton ms-buton-m ms-buton-satin-al" type="button" data-ms-koleksiyon-olustur>Koleksiyon Oluştur</button>
            </div>
        </section>
    </div>

    @* E6: site.js'in ms:koleksiyon-olustur event'i API'ye bağlanır (demo kart-render
       script'inin yerine) — başarıda sayfa yenilenir (SSR kart gerçek veriyle gelir).
       Paylaş: paylaşılabilir link panoya kopyalanır (public sayfa Faz G). *@
    <script>
        (() => {
            const kok = document.currentScript?.closest(".ms-hesabim-sayfa");
            if (!kok || kok.dataset.msKoleksiyonCanliHazir === "true") { return; }
            kok.dataset.msKoleksiyonCanliHazir = "true";

            const modal = kok.querySelector("[data-ms-koleksiyon-modal]");
            const platformId = document.querySelector("[data-ms-arama]")?.dataset.msAramaPlatform || "";
            const hataAlani = modal?.querySelector("[data-ms-koleksiyon-hata]");

            modal?.addEventListener("ms:koleksiyon-olustur", async (olay) => {
                const detay = olay.detail || {};
                if (hataAlani) { hataAlani.hidden = true; }
                if (!(detay.ad || "").trim()) {
                    if (hataAlani) { hataAlani.textContent = "Koleksiyon adı gereklidir."; hataAlani.hidden = false; }
                    olay.preventDefault(); // site.js modalı kapatmasın
                    return;
                }
                try {
                    const cevap = await fetch("/api/store/collections", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Authorization: "Bearer " + localStorage.getItem("ecspros_member_token")
                        },
                        body: JSON.stringify({
                            firmPlatformId: platformId,
                            name: detay.ad,
                            description: detay.aciklama || null,
                            isPublic: !!detay.herkeseAcik,
                            isShareable: !!detay.paylasilabilir,
                            productCodes: (detay.urunler || []).map((u) => u.id)
                        })
                    });
                    const veri = await cevap.json().catch(() => null);
                    if (veri?.success) { location.reload(); return; }
                    if (hataAlani) { hataAlani.textContent = veri?.error || "Koleksiyon oluşturulamadı."; hataAlani.hidden = false; }
                } catch {
                    if (hataAlani) { hataAlani.textContent = "Koleksiyon oluşturulamadı. Lütfen tekrar deneyin."; hataAlani.hidden = false; }
                }
            });

            kok.querySelectorAll("[data-ms-koleksiyon-paylas]").forEach((buton) => {
                buton.addEventListener("click", async () => {
                    const link = location.origin + "/koleksiyon/" + buton.dataset.msKoleksiyonPaylas;
                    try {
                        await navigator.clipboard.writeText(link);
                        const eski = buton.textContent;
                        buton.textContent = "Kopyalandı ✓";
                        window.setTimeout(() => { buton.textContent = eski; }, 1600);
                    } catch { window.prompt("Koleksiyon bağlantısı:", link); }
                });
            });
        })();
    </script>
</section>
