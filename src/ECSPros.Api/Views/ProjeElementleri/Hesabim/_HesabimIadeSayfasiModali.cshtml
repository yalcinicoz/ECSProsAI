@* E8: Yeni İade Talebi modalı canlıya bağlandı — iade edilebilir ürünler teslim edilmiş
   siparişlerin kalemlerinden SSR (ViewData["MsIadeEdilebilirler"]); daha önce iade edilen
   kalem seçilemez ve önceki neden seçimi panelde gösterilir. Neden listesi Lookup'tan
   gömülü JSON'la ({id, ad, altNedenler}); telefon doğrulama durumu modal data attribute'ünde.
   Kargo sütunları H2 kargo entegrasyonuna dek gizli. *@
@{
    var msIadeUrunler = ViewData["MsIadeEdilebilirler"] as List<ECSPros.Api.Models.Store.HesabimIadeEdilebilirUrunVm> ?? new();
    var msIadeNedenler = ViewData["MsIadeNedenleri"] as List<ECSPros.Api.Models.Store.HesabimIadeNedeniVm> ?? new();
    var msIadeUye = ViewData["MsIadeUye"] as ECSPros.Crm.Application.Queries.GetMemberDetail.MemberDetailDto;
    var msIadeModalTr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");

    var msIadeSecilebilirler = msIadeUrunler.Where(u => !u.IadeEdildi).ToList();
    var msIadeSiparisSayisi = msIadeSecilebilirler.Select(u => u.SiparisNo).Distinct().Count();
    var msIadeToplamTutar = msIadeSecilebilirler.Select(u => (u.SiparisNo, u.SiparisTutari)).Distinct().Sum(x => x.SiparisTutari);

    string MsIadeTelefonYaz(string? telefon)
    {
        var rakamlar = new string((telefon ?? "").Where(char.IsDigit).ToArray());
        if (rakamlar.Length < 10) return telefon ?? "—";
        var son10 = rakamlar[^10..];
        return $"+90 {son10[..3]} {son10[3..6]} {son10[6..8]} {son10[8..]}";
    }

    var msIadeTelefonDogrulandi = msIadeUye?.IsPhoneVerified == true;
    var msIadeNedenlerJson = System.Text.Json.JsonSerializer.Serialize(
        msIadeNedenler.Select(n => new { id = n.Id, ad = n.Ad, altNedenler = n.AltNedenler }));
}
<div class="ms-ornek-modal ms-iade-talep-modal ms-iade-sayfasi-modal" data-ms-iade-sayfasi-modal data-ms-iade-telefon-dogrulandi="@(msIadeTelefonDogrulandi ? "true" : "false")" aria-hidden="true">
    <div class="ms-ornek-modal-kaplama" data-ms-iade-sayfasi-modal-kapat></div>
    <section class="ms-ornek-modal-kutu ms-ornek-modal-boyut-2xl ms-iade-talep-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-iade-sayfasi-modal-baslik">
