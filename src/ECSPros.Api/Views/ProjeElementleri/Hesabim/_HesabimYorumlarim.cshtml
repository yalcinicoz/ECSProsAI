@* E7 + İP-5 (2026-07-16): Yorumlarım canlı — 5 sekme SSR (Değerlendir = teslim edilmiş −
   yorumlanmış; diğerleri üyenin yorumlarından; sekme davranışı misharix site.js'te).
   "Yorum Yaz" artık tasarımın yorumYapModal'ı: konu chip'leri + puan/konu select + foto
   yükleme (/api/store/reviews/images) → POST /api/store/reviews (topic+photoUrls; satın
   alma şartı sunucuda, pending doğar); reddedilende "Yeniden Düzenle" eski yorumu silip
   yenisini gönderir. Tasarımdaki "Adınız" alanı yok — yayın adı üyelikten maskeli (E7). *@
@{
    var msDegerlendir = ViewData["MsYorumDegerlendir"] as List<ECSPros.Api.Models.Store.HesabimKoleksiyonUrunVm> ?? new();
    var msYorumlar = ViewData["MsYorumlar"] as List<(ECSPros.Storefront.Application.Queries.GetMemberReviews.MemberReviewDto Yorum, ECSPros.Api.Models.Store.HesabimKoleksiyonUrunVm? Urun)> ?? new();
    var msBekleyen = msYorumlar.Where(y => !y.Yorum.IsDeleted && y.Yorum.Status == "pending").ToList();
    var msOnayli = msYorumlar.Where(y => !y.Yorum.IsDeleted && y.Yorum.Status == "approved").ToList();
    var msRed = msYorumlar.Where(y => !y.Yorum.IsDeleted && y.Yorum.Status == "rejected").ToList();
    var msSilinen = msYorumlar.Where(y => y.Yorum.IsDeleted).ToList();
    var trKultur = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
}

<section class="ms-hesabim-sayfa" aria-labelledby="ms-hesabim-yorumlar-baslik">
    <partial name="~/Views/ProjeElementleri/Hesabim/_HesabimYanMenu.cshtml" model='@("yorumlar")' />

    <section class="ms-hesabim-icerik">
        <header class="ms-hesabim-baslik">
            <h2 id="ms-hesabim-yorumlar-baslik">Yorumlarım</h2>
        </header>

        <div class="ms-hesabim-liste-sayfa">
            <div class="ms-hesabim-liste-ust">
                <div>
                    <h3>Ürün değerlendirmeleri</h3>
                    <p>Yayınlanan yorumlarınızı, onay bekleyen değerlendirmelerinizi ve yorum yazabileceğiniz alışverişlerinizi yönetin.</p>
                </div>
                @if (false)
                {
                <a class="ms-buton ms-buton-m ms-buton-sade" href="/urun-degerlendirmeleri">Değerlendirmelere Git</a>
                }
            </div>

            <div class="ms-hesabim-yorum-sekmeleri" data-ms-yorum-sekmeleri aria-label="Yorum durumları">
                <div class="ms-kod-sekmeleri" role="tablist" aria-label="Yorum filtreleri">
                    <button class="ms-kod-sekme ms-kod-sekme-aktif" type="button" role="tab" data-ms-yorum-tab="degerlendir" aria-pressed="true">Değerlendir <span class="ms-kod-sekme-sayac">@msDegerlendir.Count</span></button>
                    <button class="ms-kod-sekme" type="button" role="tab" data-ms-yorum-tab="onay-bekleyenler" aria-pressed="false">Onay Bekleyenler <span class="ms-kod-sekme-sayac">@msBekleyen.Count</span></button>
                    <button class="ms-kod-sekme" type="button" role="tab" data-ms-yorum-tab="onaylananlar" aria-pressed="false">Onaylananlar <span class="ms-kod-sekme-sayac">@msOnayli.Count</span></button>
                    <button class="ms-kod-sekme" type="button" role="tab" data-ms-yorum-tab="reddedilenler" aria-pressed="false">Reddedilenler <span class="ms-kod-sekme-sayac">@msRed.Count</span></button>
                    <button class="ms-kod-sekme" type="button" role="tab" data-ms-yorum-tab="silinenler" aria-pressed="false">Silinenler <span class="ms-kod-sekme-sayac">@msSilinen.Count</span></button>
                </div>

                <section class="ms-hesabim-yorum-paneli" data-ms-yorum-panel="degerlendir" aria-labelledby="ms-yorum-degerlendir-baslik">
                    @if (msDegerlendir.Count == 0)
                    {
                    <section class="ms-hesabim-bos-durum" aria-labelledby="ms-yorum-degerlendir-bos-baslik">
                        <i class="fa-solid fa-pen-to-square ms-fa-ikon " aria-hidden="true"></i>
                        <div>
                            <h3 id="ms-yorum-degerlendir-bos-baslik">Değerlendirilecek ürün yok</h3>
                            <p>Teslim edilen ve yorum bekleyen ürünleriniz olduğunda burada görünür.</p>
                        </div>
                        <a rel="nofollow" class="ms-buton ms-buton-m ms-buton-sade" href="/siparislerim">Siparişlere Git</a>
                    </section>
                    }
                    else
                    {
                    <div class="ms-hesabim-durum-listesi" aria-labelledby="ms-yorum-degerlendir-baslik">
                        <h3 class="sr-only" id="ms-yorum-degerlendir-baslik">Değerlendirilecek ürünler</h3>
                        @foreach (var u in msDegerlendir)
                        {
                        <article class="ms-hesabim-durum-karti ms-hesabim-yorum-karti" data-ms-kart-link-alani>
                            <a class="ms-hesabim-kart-baglanti" href="/urun/@u.Kod" data-ms-kart-link aria-label="@u.Ad ürün detayına git"></a>
                            @if (u.GorselUrl is not null)
                            {
                            <img src="@u.GorselUrl" alt="@u.Ad" loading="lazy">
                            }
                            <div>
                                <span class="ms-hesabim-durum-etiket ms-hesabim-durum-beklemede">Yorum Bekliyor</span>
                                <strong>@u.Ad</strong>
                                <p>Teslim edildi. Ürün deneyiminizi paylaşarak diğer kullanıcılara yardımcı olabilirsiniz.</p>
                                <div class="ms-hesabim-kart-aksiyonlar">
                                    <button class="ms-buton ms-buton-s ms-buton-satin-al" type="button" data-ms-yorum-yaz="@u.Kod" data-urun-ad="@u.Ad">Yorum Yaz</button>
                                    <a rel="nofollow" class="ms-buton ms-buton-s ms-buton-sade" href="/Hesabim/Siparislerim">Siparişi Gör</a>
                                </div>
                            </div>
                        </article>
                        }
                    </div>
                    }
                </section>

                <section class="ms-hesabim-yorum-paneli ms-gizli" data-ms-yorum-panel="onay-bekleyenler" aria-labelledby="ms-yorum-onay-bekleyen-baslik" hidden>
                    @if (msBekleyen.Count == 0)
                    {
                    <section class="ms-hesabim-bos-durum">
                        <i class="fa-solid fa-clock ms-fa-ikon " aria-hidden="true"></i>
                        <div>
                            <h3>Onay bekleyen yorumunuz yok</h3>
                            <p>Yeni gönderdiğiniz yorumlar kontrol sürecindeyken bu alanda listelenir.</p>
                        </div>
                    </section>
                    }
                    else
                    {
                    <div class="ms-hesabim-durum-listesi">
                        <h3 class="sr-only" id="ms-yorum-onay-bekleyen-baslik">Onay bekleyen yorumlar</h3>
                        @foreach (var (yorum, urun) in msBekleyen)
                        {
                        <article class="ms-hesabim-durum-karti ms-hesabim-yorum-karti" data-ms-kart-link-alani>
                            <a class="ms-hesabim-kart-baglanti" href="/urun/@yorum.ProductCode" data-ms-kart-link aria-label="@(urun?.Ad ?? yorum.ProductCode) ürün detayına git"></a>
                            @if (urun?.GorselUrl is not null)
                            {
                            <img src="@urun.GorselUrl" alt="@urun.Ad">
                            }
                            <div>
                                <span class="ms-hesabim-durum-etiket ms-hesabim-durum-uyari">Onay Bekliyor</span>
                                <strong>@(urun?.Ad ?? yorum.ProductCode)</strong>
                                <p>@(string.IsNullOrWhiteSpace(yorum.Text) ? "Yorumunuz editör kontrolünde. Onaylandığında ürün sayfasında yayınlanacak." : yorum.Text)</p>
                                <div class="ms-hesabim-puan" aria-label="5 üzerinden @yorum.Rating puan">@yorum.Rating/5</div>
                            </div>
                        </article>
                        }
                    </div>
                    }
                </section>

                <section class="ms-hesabim-yorum-paneli ms-gizli" data-ms-yorum-panel="onaylananlar" aria-labelledby="ms-yorum-onaylanan-baslik" hidden>
                    @if (msOnayli.Count == 0)
                    {
                    <section class="ms-hesabim-bos-durum">
                        <i class="fa-solid fa-circle-check ms-fa-ikon " aria-hidden="true"></i>
                        <div>
                            <h3>Onaylanan yorumunuz yok</h3>
                            <p>Yayına alınan ürün değerlendirmeleriniz burada görünür.</p>
                        </div>
                    </section>
                    }
                    else
                    {
                    <div class="ms-hesabim-durum-listesi">
                        <h3 class="sr-only" id="ms-yorum-onaylanan-baslik">Onaylanan yorumlar</h3>
                        @foreach (var (yorum, urun) in msOnayli)
                        {
                        <article class="ms-hesabim-durum-karti ms-hesabim-yorum-karti" data-ms-kart-link-alani>
                            <a class="ms-hesabim-kart-baglanti" href="/urun/@yorum.ProductCode" data-ms-kart-link aria-label="@(urun?.Ad ?? yorum.ProductCode) ürün detayına git"></a>
                            @if (urun?.GorselUrl is not null)
                            {
                            <img src="@urun.GorselUrl" alt="@urun.Ad">
                            }
                            <div>
                                <span class="ms-hesabim-durum-etiket ms-hesabim-durum-basarili">Onaylandı</span>
                                <strong>@(urun?.Ad ?? yorum.ProductCode)</strong>
                                @if (!string.IsNullOrWhiteSpace(yorum.Text))
                                {
                                <p>@yorum.Text</p>
                                }
                                <div class="ms-hesabim-puan" aria-label="5 üzerinden @yorum.Rating puan">@yorum.Rating/5</div>
                            </div>
                        </article>
                        }
                    </div>
                    }
                </section>

                <section class="ms-hesabim-yorum-paneli ms-gizli" data-ms-yorum-panel="reddedilenler" aria-labelledby="ms-yorum-reddedilen-baslik" hidden>
                    @if (msRed.Count == 0)
                    {
                    <section class="ms-hesabim-bos-durum">
                        <i class="fa-solid fa-circle-xmark ms-fa-ikon " aria-hidden="true"></i>
                        <div>
                            <h3>Reddedilen yorumunuz yok</h3>
                            <p>Yayın kriterlerine takılan değerlendirmeleriniz olursa burada sebebiyle birlikte gösterilir.</p>
                        </div>
                    </section>
                    }
                    else
                    {
                    <div class="ms-hesabim-durum-listesi">
                        <h3 class="sr-only" id="ms-yorum-reddedilen-baslik">Reddedilen yorumlar</h3>
                        @foreach (var (yorum, urun) in msRed)
                        {
                        <article class="ms-hesabim-durum-karti ms-hesabim-yorum-karti" data-ms-kart-link-alani>
                            <a class="ms-hesabim-kart-baglanti" href="/urun/@yorum.ProductCode" data-ms-kart-link aria-label="@(urun?.Ad ?? yorum.ProductCode) ürün detayına git"></a>
                            @if (urun?.GorselUrl is not null)
                            {
                            <img src="@urun.GorselUrl" alt="@urun.Ad">
                            }
                            <div>
                                <span class="ms-hesabim-durum-etiket ms-hesabim-durum-tehlike">Reddedildi</span>
                                <strong>@(urun?.Ad ?? yorum.ProductCode)</strong>
                                <p>@(yorum.RejectReason ?? "Yayın kriterlerine uygun bulunmadı.")</p>
                                <div class="ms-hesabim-kart-aksiyonlar">
                                    <button class="ms-buton ms-buton-ornek ms-buton-simdi-al ms-buton-simdi-al-mavi ms-buton-x" type="button" data-ms-yorum-yaz="@yorum.ProductCode" data-urun-ad="@(urun?.Ad ?? yorum.ProductCode)" data-eski-yorum-id="@yorum.Id">Yeniden Düzenle</button>
                                </div>
                            </div>
                        </article>
                        }
                    </div>
                    }
                </section>

                <section class="ms-hesabim-yorum-paneli ms-gizli" data-ms-yorum-panel="silinenler" aria-labelledby="ms-yorum-silinen-baslik" hidden>
                    @if (msSilinen.Count == 0)
                    {
                    <section class="ms-hesabim-bos-durum">
                        <i class="fa-solid fa-trash ms-fa-ikon " aria-hidden="true"></i>
                        <div>
                            <h3>Silinen yorumunuz yok</h3>
                            <p>Kendi sildiğiniz veya kaldırılan yorumlar bu alanda arşivlenir.</p>
                        </div>
                    </section>
                    }
                    else
                    {
                    <div class="ms-hesabim-durum-listesi">
                        <h3 class="sr-only" id="ms-yorum-silinen-baslik">Silinen yorumlar</h3>
                        @foreach (var (yorum, urun) in msSilinen)
                        {
                        <article class="ms-hesabim-durum-karti ms-hesabim-yorum-karti" data-ms-kart-link-alani>
                            <a class="ms-hesabim-kart-baglanti" href="/urun/@yorum.ProductCode" data-ms-kart-link aria-label="@(urun?.Ad ?? yorum.ProductCode) ürün detayına git"></a>
                            @if (urun?.GorselUrl is not null)
                            {
                            <img src="@urun.GorselUrl" alt="@urun.Ad">
                            }
                            <div>
                                <span class="ms-hesabim-durum-etiket ms-hesabim-durum-pasif">Silindi</span>
                                <strong>@(urun?.Ad ?? yorum.ProductCode)</strong>
                                <p>Bu yorum @(yorum.DeletedAt?.ToString("dd.MM.yyyy", trKultur) ?? "") tarihinde kaldırıldı.</p>
                            </div>
                        </article>
                        }
                    </div>
                    }
                </section>
            </div>
        </div>
    </section>

    @* İP-5: tasarımın yorumYapModal'ı gerçek akışla — konu chip'leri, puan/konu select,
       foto yükleme; gönderim upload → POST /api/store/reviews. "Adınız" alanı bilinçli yok. *@
    <div class="ms-ornek-modal ms-yorum-yap-modal" data-ms-yorum-yap-modal aria-hidden="true">
        <div class="ms-ornek-modal-kaplama" data-ms-yorum-yap-kapat></div>
        <section class="ms-ornek-modal-kutu ms-ornek-modal-boyut-xl ms-yorum-yap-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-yorum-yap-modal-baslik">
            <button class="ms-ornek-modal-kapat" type="button" data-ms-yorum-yap-kapat aria-label="Yorum yazma modalını kapat"><i class="fa-solid fa-xmark ms-fa-ikon" aria-hidden="true"></i></button>

            <div class="ms-yorum-yap-modal-ust" data-ms-modal-surukleme-alani>
                <span class="ms-yorum-yap-modal-ikon"><i class="fa-solid fa-pen-to-square ms-fa-ikon" aria-hidden="true"></i></span>
                <div>
                    <h3 id="ms-yorum-yap-modal-baslik" class="ms-ornek-modal-baslik">Yorum Yap</h3>
                    <p class="ms-ornek-modal-aciklama" data-ms-yorum-yap-urun>Ürün deneyiminizi paylaşın; yorumunuz kontrol sonrası yayınlanır.</p>
                </div>
            </div>

            <div class="ms-yorum-filtreler ms-yorum-yap-modal-filtreler" aria-label="Yorum konusu hızlı seçimleri">
                <button class="ms-yorum-chip ms-aktif" type="button" data-ms-yorum-yap-konu-chip="beden">Beden</button>
                <button class="ms-yorum-chip" type="button" data-ms-yorum-yap-konu-chip="kumas">Kumaş</button>
                <button class="ms-yorum-chip" type="button" data-ms-yorum-yap-konu-chip="kalip">Kalıp</button>
                <button class="ms-yorum-chip" type="button" data-ms-yorum-yap-konu-chip="renk">Renk</button>
                <button class="ms-yorum-chip" type="button" data-ms-yorum-yap-konu-chip="teslimat">Teslimat</button>
            </div>

            <section class="ms-yorum-sag ms-yorum-yap-modal-sag">
                <form class="ms-yorum-yaz-formu" data-ms-hesabim-yorum-form>
                    <strong>Yorum Bilgileri</strong>
                    <div class="ms-yorum-yaz-ust">
                        <div class="ms-form-alani">
                            <span class="ms-form-etiket">Puan</span>
                            <div class="ms-ozel-select ms-yorum-puan-select" data-ms-hesabim-yorum-puan-select>
                                <input type="hidden" name="puan" value="5" data-ms-hesabim-yorum-puan-deger>
                                <button class="ms-form-girdi ms-yorum-puan-tetikleyici" type="button" data-ms-hesabim-yorum-puan-tetikleyici aria-haspopup="listbox" aria-expanded="false">
                                    <span data-ms-hesabim-yorum-puan-yazi>5 yıldız</span>
                                    <span class="ms-yorum-yildizlar" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                                    <i class="fa-solid fa-chevron-down ms-fa-ikon ms-yorum-puan-ok" aria-hidden="true"></i>
                                </button>
                                <div class="ms-ozel-select-panel" role="listbox" aria-label="Yorum puanı seçimi">
                                    <div class="ms-ozel-select-icerik">
                                        <button class="ms-yorum-puan-secenek ms-aktif" type="button" data-ms-hesabim-yorum-puan-secenek="5"><strong>5</strong><span class="ms-yorum-yildizlar" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></button>
                                        <button class="ms-yorum-puan-secenek" type="button" data-ms-hesabim-yorum-puan-secenek="4"><strong>4</strong><span class="ms-yorum-yildizlar" aria-hidden="true"><i></i><i></i><i></i><i></i><i data-bos="true"></i></span></button>
                                        <button class="ms-yorum-puan-secenek" type="button" data-ms-hesabim-yorum-puan-secenek="3"><strong>3</strong><span class="ms-yorum-yildizlar" aria-hidden="true"><i></i><i></i><i></i><i data-bos="true"></i><i data-bos="true"></i></span></button>
                                        <button class="ms-yorum-puan-secenek" type="button" data-ms-hesabim-yorum-puan-secenek="2"><strong>2</strong><span class="ms-yorum-yildizlar" aria-hidden="true"><i></i><i></i><i data-bos="true"></i><i data-bos="true"></i><i data-bos="true"></i></span></button>
                                        <button class="ms-yorum-puan-secenek" type="button" data-ms-hesabim-yorum-puan-secenek="1"><strong>1</strong><span class="ms-yorum-yildizlar" aria-hidden="true"><i></i><i data-bos="true"></i><i data-bos="true"></i><i data-bos="true"></i><i data-bos="true"></i></span></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="ms-form-alani">
                            <span class="ms-form-etiket">Konu</span>
                            <input type="hidden" name="konu" value="beden" data-ms-hesabim-yorum-konu-deger>
                            <div class="ms-ozel-select ms-yorum-konu-select" data-ms-hesabim-yorum-konu-select>
                                <button class="ms-ozel-select-tetikleyici" type="button" data-ms-hesabim-yorum-konu-tetikleyici aria-haspopup="listbox" aria-expanded="false">
                                    <span data-ms-hesabim-yorum-konu-yazi>Beden</span>
                                    <i class="fa-solid fa-chevron-down ms-fa-ikon ms-ozel-select-ok" aria-hidden="true"></i>
                                </button>
                                <div class="ms-ozel-select-panel" role="listbox" aria-label="Yorum konusu seçimi">
                                    <div class="ms-ozel-select-secenek-listesi">
                                        <button class="ms-ozel-select-secenek ms-ozel-select-secenek-aktif" type="button" role="option" data-ms-hesabim-yorum-konu-secenek="beden"><span data-ms-ozel-select-metin>Beden</span></button>
                                        <button class="ms-ozel-select-secenek" type="button" role="option" data-ms-hesabim-yorum-konu-secenek="kumas"><span data-ms-ozel-select-metin>Kumaş</span></button>
                                        <button class="ms-ozel-select-secenek" type="button" role="option" data-ms-hesabim-yorum-konu-secenek="kalip"><span data-ms-ozel-select-metin>Kalıp</span></button>
                                        <button class="ms-ozel-select-secenek" type="button" role="option" data-ms-hesabim-yorum-konu-secenek="renk"><span data-ms-ozel-select-metin>Renk</span></button>
                                        <button class="ms-ozel-select-secenek" type="button" role="option" data-ms-hesabim-yorum-konu-secenek="teslimat"><span data-ms-ozel-select-metin>Teslimat</span></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <label class="ms-form-alani">
                        <span class="ms-form-etiket">Yorumunuz</span>
                        <textarea class="ms-form-metin-alani ms-yorum-textarea" name="yorum" maxlength="2000" placeholder="Ürünle ilgili yorumunuzu yazın"></textarea>
                    </label>

                    <div class="ms-uyari ms-uyari-hata" data-ms-hesabim-yorum-hata hidden></div>
                    <div class="ms-yorum-form-alt">
                        <input name="hesabim_yorum_foto_input" class="sr-only" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple data-ms-hesabim-yorum-foto-input>
                        <button class="ms-yorum-chip" type="button" data-ms-hesabim-yorum-foto-ekle aria-pressed="false"><i class="fa-solid fa-camera ms-fa-ikon ms-yorum-mini-ikon" aria-hidden="true"></i><span data-ms-hesabim-yorum-foto-metin>Fotoğraf ekle</span></button>
                        <button class="ms-yorum-buton" type="submit" data-ms-hesabim-yorum-gonder>Yorumu Gönder</button>
                    </div>

                    <div class="ms-yorum-foto-onizleme" data-ms-hesabim-yorum-foto-onizleme hidden></div>
                </form>
            </section>
        </section>
    </div>

    <script>
        (() => {
            const kok = document.currentScript?.closest(".ms-hesabim-sayfa");
            if (!kok || kok.dataset.msYorumCanliHazir === "true") { return; }
            kok.dataset.msYorumCanliHazir = "true";

            const modal = kok.querySelector("[data-ms-yorum-yap-modal]");
            const form = modal.querySelector("[data-ms-hesabim-yorum-form]");
            const platformId = document.querySelector("[data-ms-arama]")?.dataset.msAramaPlatform || "";
            const hataAlani = modal.querySelector("[data-ms-hesabim-yorum-hata]");
            const urunSatiri = modal.querySelector("[data-ms-yorum-yap-urun]");
            let seciliKod = null;
            let eskiYorumId = null;

            const hata = (m) => { hataAlani.textContent = m || ""; hataAlani.hidden = !m; };
            const basliklar = () => ({ Authorization: "Bearer " + localStorage.getItem("ecspros_member_token") });

            // ── Puan select (tasarım mekaniği) ──
            const puanSelect = modal.querySelector("[data-ms-hesabim-yorum-puan-select]");
            const puanTetikleyici = modal.querySelector("[data-ms-hesabim-yorum-puan-tetikleyici]");
            const puanYazi = modal.querySelector("[data-ms-hesabim-yorum-puan-yazi]");
            const puanDeger = modal.querySelector("[data-ms-hesabim-yorum-puan-deger]");
            const puaniYaz = (puan) => {
                puanDeger.value = puan;
                puanYazi.textContent = `${puan} yıldız`;
                modal.querySelectorAll("[data-ms-hesabim-yorum-puan-secenek]").forEach((oge) =>
                    oge.classList.toggle("ms-aktif", oge.dataset.msHesabimYorumPuanSecenek === puan));
                const yildizAlani = puanTetikleyici?.querySelector(".ms-yorum-yildizlar");
                if (yildizAlani) yildizAlani.innerHTML = Array.from({ length: 5 }, (_, i) => `<i${i < Number(puan) ? "" : " data-bos=\"true\""}></i>`).join("");
            };
            puanTetikleyici?.addEventListener("click", (event) => {
                event.stopPropagation();
                const acik = puanSelect.classList.toggle("ms-ozel-select-acik");
                puanTetikleyici.setAttribute("aria-expanded", acik.toString());
            });
            modal.querySelectorAll("[data-ms-hesabim-yorum-puan-secenek]").forEach((secenek) => {
                secenek.addEventListener("click", () => {
                    puaniYaz(secenek.dataset.msHesabimYorumPuanSecenek || "5");
                    puanSelect.classList.remove("ms-ozel-select-acik");
                    puanTetikleyici?.setAttribute("aria-expanded", "false");
                });
            });
            document.addEventListener("click", (event) => {
                if (!puanSelect.contains(event.target)) {
                    puanSelect.classList.remove("ms-ozel-select-acik");
                    puanTetikleyici?.setAttribute("aria-expanded", "false");
                }
            });

            // ── Konu select + chip senkronu ──
            const konuSelect = modal.querySelector("[data-ms-hesabim-yorum-konu-select]");
            const konuTetikleyici = modal.querySelector("[data-ms-hesabim-yorum-konu-tetikleyici]");
            const konuDeger = modal.querySelector("[data-ms-hesabim-yorum-konu-deger]");
            const konuYazi = modal.querySelector("[data-ms-hesabim-yorum-konu-yazi]");
            const konuSec = (konu, metin) => {
                konuDeger.value = konu;
                konuYazi.textContent = metin;
                modal.querySelectorAll("[data-ms-hesabim-yorum-konu-secenek]").forEach((oge) =>
                    oge.classList.toggle("ms-ozel-select-secenek-aktif", oge.dataset.msHesabimYorumKonuSecenek === konu));
                modal.querySelectorAll("[data-ms-yorum-yap-konu-chip]").forEach((chip) =>
                    chip.classList.toggle("ms-aktif", chip.dataset.msYorumYapKonuChip === konu));
            };
            konuTetikleyici?.addEventListener("click", (event) => {
                event.stopPropagation();
                konuSelect.classList.toggle("ms-ozel-select-acik");
            });
            modal.querySelectorAll("[data-ms-hesabim-yorum-konu-secenek]").forEach((secenek) => {
                secenek.addEventListener("click", () => {
                    konuSec(secenek.dataset.msHesabimYorumKonuSecenek, secenek.textContent.trim());
                    konuSelect.classList.remove("ms-ozel-select-acik");
                });
            });
            document.addEventListener("click", (event) => {
                if (!konuSelect.contains(event.target)) konuSelect.classList.remove("ms-ozel-select-acik");
            });
            modal.querySelectorAll("[data-ms-yorum-yap-konu-chip]").forEach((chip) => {
                chip.addEventListener("click", () => {
                    modal.querySelector(`[data-ms-hesabim-yorum-konu-secenek="${chip.dataset.msYorumYapKonuChip}"]`)?.click();
                });
            });

            // ── Foto seç + önizleme (gönderimde upload edilir) ──
            const fotoInput = modal.querySelector("[data-ms-hesabim-yorum-foto-input]");
            const fotoEkle = modal.querySelector("[data-ms-hesabim-yorum-foto-ekle]");
            const fotoMetin = modal.querySelector("[data-ms-hesabim-yorum-foto-metin]");
            const fotoOnizleme = modal.querySelector("[data-ms-hesabim-yorum-foto-onizleme]");
            let seciliFotograflar = []; // { dosya, url }
            const fotoTemizle = () => {
                seciliFotograflar.forEach((f) => URL.revokeObjectURL(f.url));
                seciliFotograflar = [];
                if (fotoInput) fotoInput.value = "";
                fotoOnizleme.replaceChildren();
                fotoOnizleme.hidden = true;
                fotoMetin.textContent = "Fotoğraf ekle";
                fotoEkle.setAttribute("aria-pressed", "false");
                fotoEkle.classList.remove("ms-aktif");
            };
            fotoEkle?.addEventListener("click", () => fotoInput?.click());
            fotoInput?.addEventListener("change", () => {
                seciliFotograflar.forEach((f) => URL.revokeObjectURL(f.url));
                seciliFotograflar = Array.from(fotoInput.files || [])
                    .filter((dosya) => dosya.type.startsWith("image/"))
                    .slice(0, 5)
                    .map((dosya) => ({ dosya, url: URL.createObjectURL(dosya) }));
                hata("");
                if (seciliFotograflar.some((f) => f.dosya.size > 5_000_000)) {
                    hata("Her fotoğraf en fazla 5 MB olabilir.");
                    fotoTemizle();
                    return;
                }
                const secildi = seciliFotograflar.length > 0;
                fotoMetin.textContent = secildi ? `${seciliFotograflar.length} fotoğraf eklendi` : "Fotoğraf ekle";
                fotoEkle.setAttribute("aria-pressed", secildi.toString());
                fotoEkle.classList.toggle("ms-aktif", secildi);
                fotoOnizleme.hidden = !secildi;
                fotoOnizleme.replaceChildren();
                seciliFotograflar.forEach((foto, index) => {
                    const kart = document.createElement("span");
                    const gorsel = document.createElement("img");
                    kart.className = "ms-yorum-foto-onizleme-kart";
                    gorsel.src = foto.url;
                    gorsel.alt = `Seçilen fotoğraf ${index + 1}`;
                    kart.appendChild(gorsel);
                    fotoOnizleme.appendChild(kart);
                });
            });

            // ── Modal aç/kapat ──
            const ac = (kod, ad, eskiId) => {
                seciliKod = kod; eskiYorumId = eskiId || null;
                urunSatiri.textContent = ad ? `${ad} — deneyiminizi paylaşın; yorumunuz kontrol sonrası yayınlanır.` : "Ürün deneyiminizi paylaşın; yorumunuz kontrol sonrası yayınlanır.";
                form.reset();
                puaniYaz("5");
                konuSec("beden", "Beden");
                fotoTemizle();
                hata("");
                modal.classList.add("ms-ornek-modal-acik");
                modal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
            };
            const kapat = () => {
                modal.classList.remove("ms-ornek-modal-acik");
                modal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
            };
            kok.querySelectorAll("[data-ms-yorum-yaz]").forEach((buton) => {
                buton.addEventListener("click", () =>
                    ac(buton.dataset.msYorumYaz, buton.dataset.urunAd, buton.dataset.eskiYorumId));
            });
            modal.querySelectorAll("[data-ms-yorum-yap-kapat]").forEach((b) => b.addEventListener("click", kapat));
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && modal.classList.contains("ms-ornek-modal-acik")) kapat();
            });

            // ── Gönderim: (varsa eski yorum silinir) → foto upload → POST review ──
            let gonderimVar = false;
            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                if (gonderimVar) return;
                hata("");
                const metin = form.querySelector("[name='yorum']").value.trim();
                gonderimVar = true;
                try {
                    const jsonBasliklar = { "Content-Type": "application/json", ...basliklar() };
                    if (eskiYorumId) {
                        await fetch("/api/store/reviews/" + eskiYorumId, { method: "DELETE", headers: jsonBasliklar });
                    }
                    let fotoUrlleri = [];
                    if (seciliFotograflar.length > 0) {
                        const paket = new FormData();
                        seciliFotograflar.forEach((foto) => paket.append("files", foto.dosya));
                        const yukleCevap = await fetch("/api/store/reviews/images", { method: "POST", headers: basliklar(), body: paket });
                        const yukleVeri = await yukleCevap.json().catch(() => null);
                        if (!yukleVeri?.success) { hata(yukleVeri?.error || "Fotoğraflar yüklenemedi."); gonderimVar = false; return; }
                        fotoUrlleri = yukleVeri.data.urls || [];
                    }
                    const cevap = await fetch("/api/store/reviews", {
                        method: "POST", headers: jsonBasliklar,
                        body: JSON.stringify({
                            firmPlatformId: platformId,
                            productCode: seciliKod,
                            rating: Number.parseInt(puanDeger.value || "5", 10) || 5,
                            text: metin || null,
                            topic: konuDeger.value || null,
                            photoUrls: fotoUrlleri
                        })
                    });
                    const veri = await cevap.json().catch(() => null);
                    if (veri?.success) { location.href = location.pathname + "?utm_yorum=onay-bekleyenler"; return; }
                    hata(veri?.error || "Yorum gönderilemedi.");
                } catch {
                    hata("Yorum gönderilemedi. Lütfen tekrar deneyin.");
                }
                gonderimVar = false;
            });
        })();
    </script>
</section>
