<div class="ms-ana-navigasyon-wrapper">
    <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyonDuyuru.cshtml" />
    <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyonUst.cshtml" />
    <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyonDesktopMenu.cshtml" />
    <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyonMobilMenu.cshtml" />
</div>

@* ECSPros: gerçek SMS/OTP giriş akışı (GES Telekom — /api/store/auth/otp/*).
   UI akışı (modal aç/kapat, sekmeler, adım geçişi, 02:00 sayacı, kod kutuları,
   otomatik onay, yeniden gönder görünürlüğü) tasarımın site.js'ine aittir; burada
   YALNIZ backend bağları vardır (sözleşme: sayfaya özel endpoint Razor'da kalır).
   - Kod Gönder / Yeniden Gönder: tıklama site.js'e de akar (UI adımı o ilerletir),
     burada gerçek OTP gönderimi yapılır; API hatasında telefon adımına dönülür.
   - Kodu Onayla: document-capture'da DURDURULUR (site.js'in demo "Giriş Başarılı"
     akışı gerçek doğrulama olmadan çalışmasın); gerçek doğrulama başarılıysa token
     işleri _AnaNavigasyonGirisModal'daki msGirisBasarili köprüsüne devredilir,
     modal kapatılır ve tasarımın onay modalı (msOnayRedModalAc) gösterilir.
   Bu script parse anında kaydolur — document-capture dinleyicisi site.js'inkinden
   önce sıradadır; stopPropagation buton üstündeki demo handler'a inişi keser. *@
<script data-ms-ana-navigasyon-script>
(() => {
    const modalGetir = () => document.querySelector("[data-ms-giris-modal]");

    const hataGoster = (mesaj) => {
        const alan = modalGetir()?.querySelector("[data-ms-giris-sms-hata]");
        if (!alan) { return; }
        alan.textContent = mesaj || "";
        alan.hidden = !mesaj;
    };

    const telefonRakamlari = () =>
        (modalGetir()?.querySelector("[data-ms-giris-telefon]")?.value || "").replace(/\D/g, "");

    let gonderiliyor = false;
    const kodGonderApi = async () => {
        const rakamlar = telefonRakamlari();
        if (rakamlar.length < 10 || gonderiliyor) { return; }

        gonderiliyor = true;
        try {
            const cevap = await fetch("/api/store/auth/otp/send", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ phone: "90" + rakamlar })
            });
            const veri = await cevap.json().catch(() => null);

            if (!veri?.success) {
                hataGoster(veri?.error || "Kod gönderilemedi. Lütfen tekrar deneyin.");
                modalGetir()?.querySelector("[data-ms-giris-sms-geri]")?.click();
            }
        } catch {
            hataGoster("Kod gönderilemedi. Lütfen tekrar deneyin.");
            modalGetir()?.querySelector("[data-ms-giris-sms-geri]")?.click();
        } finally {
            gonderiliyor = false;
        }
    };

    let dogrulaniyor = false;
    const kodOnaylaApi = async (buton) => {
        const modal = modalGetir();
        if (!modal || dogrulaniyor) { return; }

        const kodInputlari = Array.from(modal.querySelectorAll(".ms-giris-kod-input"));
        const girilenKod = kodInputlari.map((input) => input.value).join("");

        if (girilenKod.length < kodInputlari.length) {
            kodInputlari.find((input) => !input.value)?.focus();
            return;
        }

        dogrulaniyor = true;
        if (buton) { buton.disabled = true; }
        try {
            const cevap = await fetch("/api/store/auth/otp/verify", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ phone: "90" + telefonRakamlari(), code: girilenKod })
            });
            const veri = await cevap.json().catch(() => null);

            if (!veri?.success) {
                hataGoster(veri?.error || "Kod doğrulanamadı. Lütfen tekrar deneyin.");
                return;
            }

            hataGoster("");
            window.msGirisBasarili?.(veri.data);
            modal.querySelector("[data-ms-giris-modal-kapat]")?.click();
            window.setTimeout(() => {
                window.msOnayRedModalAc?.({
                    tip: "onay",
                    baslik: "Giriş Başarılı",
                    altBaslik: "Giriş Yapıldı",
                    metin: "Hesabınıza başarıyla giriş yaptınız.",
                    sure: 1500
                });
            }, 40);
        } catch {
            hataGoster("Kod doğrulanamadı. Lütfen tekrar deneyin.");
        } finally {
            dogrulaniyor = false;
            if (buton) { buton.disabled = false; }
        }
    };

    document.addEventListener("click", (event) => {
        const hedef = event.target instanceof Element ? event.target : null;
        if (!hedef) { return; }

        const onayla = hedef.closest("[data-ms-giris-kod-onayla]");
        if (onayla) {
            event.preventDefault();
            event.stopPropagation();
            kodOnaylaApi(onayla);
            return;
        }

        if (hedef.closest("[data-ms-giris-kod-gonder]") || hedef.closest("[data-ms-giris-kod-yeniden-gonder]")) {
            hataGoster("");
            kodGonderApi();
        }
    }, true);
})();
</script>
