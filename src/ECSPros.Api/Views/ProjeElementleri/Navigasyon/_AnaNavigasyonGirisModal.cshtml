    <div class="ms-giris-modal" data-ms-giris-modal aria-hidden="true">
        <div class="ms-giris-modal-kaplama" data-ms-giris-modal-kapat></div>
        <section class="ms-giris-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-giris-modal-baslik">
            <button class="ms-giris-modal-kapat" type="button" data-ms-giris-modal-kapat aria-label="Giriş modalını kapat">
                <i class="fa-solid fa-xmark ms-fa-ikon" aria-hidden="true"></i>
            </button>

            <div class="ms-giris-modal-baslik-alani">
                <p id="ms-giris-modal-baslik" class="ms-giris-modal-baslik">Giriş Yap</p>
                <p class="ms-giris-modal-aciklama">Hızlı giriş yöntemlerinden birini seçin.</p>
            </div>

            <form class="ms-giris-modal-form" data-ms-giris-form>

            <div class="ms-giris-tab-listesi" role="tablist" aria-label="Giriş yöntemleri">
                <button class="ms-giris-tab ms-giris-tab-aktif" type="button" data-ms-giris-tab="sms" aria-pressed="true">SMS Kodu</button>
                <button class="ms-giris-tab" type="button" data-ms-giris-tab="telefon" aria-pressed="false">Telefon</button>
                <button class="ms-giris-tab" type="button" data-ms-giris-tab="eposta" aria-pressed="false">E-Posta</button>
            </div>

            <div class="ms-giris-panel ms-giris-panel-aktif" data-ms-giris-panel="sms">
                <div class="ms-uyari ms-uyari-hata" data-ms-giris-sms-hata hidden></div>
                <div class="ms-giris-sms-adim ms-giris-sms-adim-aktif" data-ms-giris-sms-adim="telefon">
                    <label class="ms-giris-form-alani">
                        <span>Telefon Numaranız</span>
                        <span class="ms-telefon-girdi ms-giris-telefon-girdi">
                            <span class="ms-telefon-ulke ms-giris-telefon-ulke">
                                <span class="ms-telefon-ulke-tetikleyici ms-giris-telefon-ulke-tetikleyici" aria-label="Türkiye ülke kodu">
                                    <img class="ms-telefon-bayrak" src="https://flagcdn.com/tr.svg" alt="Türkiye" loading="lazy">
                                    <span>+90</span>
                                </span>
                            </span>
                            <input name="giris_telefon" type="tel" placeholder="___ ___ __ __" inputmode="numeric" autocomplete="tel-national" maxlength="13" data-ms-giris-telefon>
                        </span>
                    </label>
                    <button class="ms-giris-buton ms-giris-buton-birincil" type="button" data-ms-giris-kod-gonder>Giriş Yap</button>
                </div>
                <div class="ms-giris-sms-adim" data-ms-giris-sms-adim="kod">
                    <button class="ms-giris-geri" type="button" data-ms-giris-sms-geri>Telefonu değiştir</button>
                    <p class="ms-giris-kod-yardim">Telefonunuza gelen 6 haneli kodu girin.</p>
                    <div class="ms-giris-kod-alani">
                    <div class="ms-giris-kod-giris" data-ms-giris-kod-giris>
                        <input name="kod_1_hane" class="ms-giris-kod-input" type="text" inputmode="numeric" maxlength="1" aria-label="Kod 1. hane">
                        <input name="kod_2_hane" class="ms-giris-kod-input" type="text" inputmode="numeric" maxlength="1" aria-label="Kod 2. hane">
                        <input name="kod_3_hane" class="ms-giris-kod-input" type="text" inputmode="numeric" maxlength="1" aria-label="Kod 3. hane">
                        <input name="kod_4_hane" class="ms-giris-kod-input" type="text" inputmode="numeric" maxlength="1" aria-label="Kod 4. hane">
                        <input name="kod_5_hane" class="ms-giris-kod-input" type="text" inputmode="numeric" maxlength="1" aria-label="Kod 5. hane">
                        <input name="kod_6_hane" class="ms-giris-kod-input" type="text" inputmode="numeric" maxlength="1" aria-label="Kod 6. hane">
                    </div>
                    <p class="ms-giris-kod-sayac" aria-live="polite">Kodun geçerlilik süresi: <strong data-ms-giris-kod-sayac>02:00</strong></p>
                    <button class="ms-giris-kod-yeniden-gonder" type="button" data-ms-giris-kod-yeniden-gonder hidden>Yeniden Kod Gönder</button>
                    </div>
                    <button class="ms-giris-buton ms-giris-buton-birincil" type="button" data-ms-giris-kod-onayla>Kodu Onayla</button>
                </div>
            </div>

            <div class="ms-giris-panel" data-ms-giris-panel="telefon">
                <label class="ms-giris-form-alani">
                    <span>Telefon Numaranız</span>
                    <span class="ms-telefon-girdi ms-giris-telefon-girdi">
                        <span class="ms-telefon-ulke ms-giris-telefon-ulke">
                            <span class="ms-telefon-ulke-tetikleyici ms-giris-telefon-ulke-tetikleyici" aria-label="Türkiye ülke kodu">
                                <img class="ms-telefon-bayrak" src="https://flagcdn.com/tr.svg" alt="Türkiye" loading="lazy">
                                <span>+90</span>
                            </span>
                        </span>
                        <input type="tel" name="telefon-giris" placeholder="___ ___ __ __" inputmode="numeric" autocomplete="username tel-national" maxlength="13" data-ms-giris-telefon-no>
                    </span>
                </label>
                <label class="ms-giris-form-alani">
                    <span>Şifre</span>
                    <input class="ms-giris-input" type="password" name="telefon-sifre" autocomplete="current-password" placeholder="Şifrenizi girin" data-ms-giris-telefon-sifre>
                </label>
                <div class="ms-uyari ms-uyari-hata" data-ms-giris-telefon-hata hidden></div>
                <button class="ms-giris-buton ms-giris-buton-birincil" type="button" data-ms-giris-telefon-gonder>Telefon ile Giriş Yap</button>
            </div>

            <div class="ms-giris-panel" data-ms-giris-panel="eposta">
                <label class="ms-giris-form-alani">
                    <span>E-posta</span>
                    <input class="ms-giris-input" type="email" name="eposta-giris" autocomplete="username email" placeholder="ornek@eposta.com" data-ms-giris-eposta>
                </label>
                <label class="ms-giris-form-alani">
                    <span>Şifre</span>
                    <input class="ms-giris-input" type="password" name="eposta-sifre" autocomplete="current-password" placeholder="Şifrenizi girin" data-ms-giris-sifre>
                </label>
                <div class="ms-uyari ms-uyari-hata" data-ms-giris-hata hidden></div>
                <button class="ms-giris-buton ms-giris-buton-birincil" type="button" data-ms-giris-eposta-gonder>E-Posta ile Giriş Yap</button>
            </div>

            <div class="ms-giris-ayrac"><span>veya</span></div>

            <div class="ms-giris-sosyal-listesi">
                <button class="ms-giris-sosyal ms-giris-sosyal-google" type="button"><span class="ms-giris-sosyal-ikon">G</span>Google ile giriş yap</button>
                <button class="ms-giris-sosyal ms-giris-sosyal-facebook" type="button"><span class="ms-giris-sosyal-ikon">f</span>Facebook ile giriş yap</button>
            </div>

            <button class="ms-giris-buton ms-giris-buton-misafir" type="button" data-ms-giris-modal-kapat>Misafir Olarak Devam Et</button>
            <button class="ms-giris-buton ms-giris-buton-kayit" type="button" data-ms-kayit-modal-ac>Kayıt Ol</button>
            </form>
        </section>
    </div>

@* B4: Gerçek üye oturumu — e-posta login/register api/store/auth'a bağlanır; oturum
   localStorage token'larıyla kalıcıdır (me endpoint'i), girişte misafir sepeti merge edilir.
   Misharix'in modal/panel davranış script'ine dokunulmaz: modal kapatma onun kapat
   butonlarına click ile devredilir, oturum UI durumu onunla aynı class/yazı kuralıyla
   ayarlanır. SMS/OTP gerçek akışı Faz D.
   D1: SSR kimlik (HttpOnly cookie → ViewData["MsUye"]) oturum UI'ını /me beklemeden
   boyar; /me yine doğrular. Çıkış artık logout endpoint'iyle session iptali de yapar. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const TOKEN_ANAHTARI = "ecspros_member_token";
    const REFRESH_ANAHTARI = "ecspros_member_refresh";
    const ssrUye = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ViewData["MsUye"] is ECSPros.Api.Services.StoreUyeKimlik u
            ? new { ad = u.FullName, iletisim = u.Email ?? "" }
            : null));
    const platformId = document.querySelector("[data-ms-arama]")?.dataset.msAramaPlatform || "";

    const girisModal = document.querySelector("[data-ms-giris-modal]");
    const kayitModal = document.querySelector("[data-ms-kayit-modal]");
    if (!girisModal) { return; }

    const hataGoster = (alan, mesaj) => {
        if (!alan) { return; }
        alan.textContent = mesaj || "";
        alan.hidden = !mesaj;
    };

    // Misharix'in oturumDurumuAyarla'sı IIFE içinde — aynı class/yazı kuralı burada uygulanır.
    const oturumUiAyarla = (acik) => {
        document.querySelectorAll("[data-ms-giris-menu]").forEach((menu) => {
            menu.classList.toggle("ms-ana-navigasyon-giris-oturum-acik", acik);
            menu.classList.remove("ms-ana-navigasyon-giris-acik");
            menu.querySelector("[data-ms-giris-menu-tetikleyici]")?.setAttribute("aria-expanded", "false");
            const yazi = menu.querySelector("[data-ms-giris-menu-yazi]");
            if (yazi) { yazi.textContent = acik ? "Hesabım" : "Giriş Yap"; }
        });
    };

    const hesapPaneliDoldur = (ad, iletisim) => {
        document.querySelectorAll("[data-ms-hesap-panel]").forEach((panel) => {
            const kimlik = panel.querySelector(".ms-hesap-kimlik");
            if (kimlik) {
                const adAlani = kimlik.querySelector("strong");
                const iletisimAlani = kimlik.querySelector("span");
                if (adAlani) { adAlani.textContent = ad; }
                if (iletisimAlani) { iletisimAlani.textContent = iletisim || ""; }
            }
            const avatar = panel.querySelector(".ms-hesap-avatar");
            if (avatar) {
                avatar.textContent = ad.split(" ").filter(Boolean).map((p) => p[0]).join("").slice(0, 3).toLocaleUpperCase("tr");
            }
        });
    };

    const tokenlariSakla = (veri) => {
        try {
            localStorage.setItem(TOKEN_ANAHTARI, veri.accessToken);
            localStorage.setItem(REFRESH_ANAHTARI, veri.refreshToken);
        } catch { /* storage kapalı — oturum sayfa ömrüyle sınırlı kalır */ }
    };

    const tokenlariTemizle = () => {
        try {
            localStorage.removeItem(TOKEN_ANAHTARI);
            localStorage.removeItem(REFRESH_ANAHTARI);
        } catch { /* yok say */ }
    };

    // H10 düzeltmesi: üye-özel (hesabım) sayfada oturum değişti — SSR içerik eski
    // üyeye ait kalmasın. Giriş: sayfayı yenile (yeni cookie ile yeni üyenin verisi);
    // çıkış: ana sayfaya dön (sayfa üye ister, reload zaten yönlendirirdi — direkt git).
    const uyeOzelSayfayiTazele = () => {
        // Kabul testi 2026-07-22: girişte sayfadaki davranış köprüleri (favori işaretleri,
        // bekleyen favori niyeti...) tazelensin — reload olmayan sayfalar bunu dinler.
        document.dispatchEvent(new CustomEvent("ms:uye-giris"));
        if (window.msUyeOzelSayfa) window.location.reload();
    };

    const sepetiBirlestir = async () => {
        const token = localStorage.getItem(TOKEN_ANAHTARI);
        const sid = localStorage.getItem("ecspros_sid");
        if (!token || !sid || !platformId) { return; }
        try {
            const cevap = await fetch("/api/store/cart/merge", {
                method: "POST",
                headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
                body: JSON.stringify({ guestSessionId: sid, firmPlatformId: platformId })
            });
            const veri = await cevap.json().catch(() => null);
            if (veri?.success && veri.data?.cartId) {
                localStorage.setItem("ecspros_cart", veri.data.cartId);
            }
            window.msMiniSepetYenile?.();
        } catch { /* birleşmezse misafir sepeti sonraki girişte birleşir */ }
    };

    const girisiUygula = (ad, iletisim) => {
        hesapPaneliDoldur(ad, iletisim);
        oturumUiAyarla(true);
    };

    // ── Oturum kalıcılığı: token varsa /me ile doğrula (401'de bir kez refresh dene) ──
    const beniGetir = async (tekrar) => {
        const token = localStorage.getItem(TOKEN_ANAHTARI);
        if (!token) { return; }
        try {
            const cevap = await fetch("/api/store/auth/me", { headers: { Authorization: "Bearer " + token } });
            if (cevap.status === 401) {
                const refresh = localStorage.getItem(REFRESH_ANAHTARI);
                if (!refresh || tekrar) { tokenlariTemizle(); return; }
                const yenile = await fetch("/api/store/auth/refresh", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ refreshToken: refresh })
                });
                const yeniVeri = await yenile.json().catch(() => null);
                if (yeniVeri?.success && yeniVeri.data?.accessToken) {
                    tokenlariSakla(yeniVeri.data);
                    return beniGetir(true);
                }
                tokenlariTemizle();
                return;
            }
            const veri = await cevap.json().catch(() => null);
            if (veri?.success && veri.data) {
                girisiUygula(`${veri.data.firstName} ${veri.data.lastName}`.trim(), veri.data.phone || veri.data.email || "");
            }
        } catch { /* ağ hatası — misafir görünümünde kal */ }
    };

    // ── E-posta ile giriş ──
    const girisHata = girisModal.querySelector("[data-ms-giris-hata]");
    girisModal.querySelector("[data-ms-giris-eposta-gonder]")?.addEventListener("click", async (olay) => {
        const buton = olay.currentTarget;
        const eposta = girisModal.querySelector("[data-ms-giris-eposta]")?.value.trim();
        const sifre = girisModal.querySelector("[data-ms-giris-sifre]")?.value;
        hataGoster(girisHata, "");
        if (!eposta || !sifre) { hataGoster(girisHata, "E-posta ve şifrenizi girin."); return; }

        buton.disabled = true;
        try {
            const cevap = await fetch("/api/store/auth/login", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: eposta, password: sifre })
            });
            const veri = await cevap.json().catch(() => null);
            if (!veri?.success) {
                hataGoster(girisHata, veri?.error || "Giriş yapılamadı. Bilgilerinizi kontrol edin.");
                return;
            }
            tokenlariSakla(veri.data);
            girisiUygula(veri.data.fullName || eposta, veri.data.email || eposta);
            girisModal.querySelector("[data-ms-giris-modal-kapat]")?.click();
            // sepet birleştirme tamamlanmadan reload isteği kesmesin
            sepetiBirlestir().finally(uyeOzelSayfayiTazele);
        } catch {
            hataGoster(girisHata, "Giriş yapılamadı. Lütfen tekrar deneyin.");
        } finally {
            buton.disabled = false;
        }
    });

    // ── Telefon + şifre ile giriş (2026-07-16) ──
    const telefonHata = girisModal.querySelector("[data-ms-giris-telefon-hata]");
    girisModal.querySelector("[data-ms-giris-telefon-gonder]")?.addEventListener("click", async (olay) => {
        const buton = olay.currentTarget;
        const rakamlar = (girisModal.querySelector("[data-ms-giris-telefon-no]")?.value || "").replace(/\D/g, "");
        const sifre = girisModal.querySelector("[data-ms-giris-telefon-sifre]")?.value;
        hataGoster(telefonHata, "");
        if (rakamlar.length < 10 || !sifre) { hataGoster(telefonHata, "Telefon numaranızı ve şifrenizi girin."); return; }

        buton.disabled = true;
        try {
            const cevap = await fetch("/api/store/auth/login", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ phone: "90" + rakamlar.slice(-10), password: sifre })
            });
            const veri = await cevap.json().catch(() => null);
            if (!veri?.success) {
                hataGoster(telefonHata, veri?.error || "Giriş yapılamadı. Bilgilerinizi kontrol edin.");
                return;
            }
            tokenlariSakla(veri.data);
            girisiUygula(veri.data.fullName || "", veri.data.email || "");
            girisModal.querySelector("[data-ms-giris-modal-kapat]")?.click();
            // sepet birleştirme tamamlanmadan reload isteği kesmesin
            sepetiBirlestir().finally(uyeOzelSayfayiTazele);
        } catch {
            hataGoster(telefonHata, "Giriş yapılamadı. Lütfen tekrar deneyin.");
        } finally {
            buton.disabled = false;
        }
    });

    // ── Kayıt ──
    const kayitHata = kayitModal?.querySelector("[data-ms-kayit-hata]");
    kayitModal?.querySelector("[data-ms-kayit-gonder]")?.addEventListener("click", async (olay) => {
        const buton = olay.currentTarget;
        const ad = kayitModal.querySelector("[data-ms-kayit-ad]")?.value.trim();
        const soyad = kayitModal.querySelector("[data-ms-kayit-soyad]")?.value.trim();
        const eposta = kayitModal.querySelector("[data-ms-kayit-eposta]")?.value.trim();
        const sifre = kayitModal.querySelector("[data-ms-kayit-sifre]")?.value;
        const telefonHam = kayitModal.querySelector("[data-ms-kayit-telefon]")?.value.replace(/\D/g, "");
        const cinsiyet = kayitModal.querySelector("[data-ms-kayit-cinsiyet]")?.value || null;
        const dogum = kayitModal.querySelector("[data-ms-kayit-dogum]")?.value || null;
        const onaylar = [...kayitModal.querySelectorAll(".ms-kayit-onay input[type='checkbox']")];

        hataGoster(kayitHata, "");
        if (!ad || !soyad || !eposta || !sifre) { hataGoster(kayitHata, "Ad, soyad, e-posta ve şifre zorunludur."); return; }
        if (onaylar.some((o) => !o.checked)) { hataGoster(kayitHata, "Devam etmek için sözleşme ve metinleri onaylayın."); return; }

        buton.disabled = true;
        try {
            const cevap = await fetch("/api/store/auth/register", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    email: eposta, password: sifre, firstName: ad, lastName: soyad,
                    phone: telefonHam ? "90" + telefonHam : null,
                    gender: cinsiyet, birthDate: dogum,
                    // D3: 3 zorunlu onay kutusu bu belgelere karşılık gelir — kabul kaydı
                    // (başlık + metin sürümü) sunucuda CMS'ten çözülerek üyeye yazılır
                    firmPlatformId: platformId || null,
                    acceptedContracts: ["uyelik-sozlesmesi", "kvkk-aydinlatma", "on-bilgilendirme-formu"]
                })
            });
            const veri = await cevap.json().catch(() => null);
            if (!veri?.success) {
                hataGoster(kayitHata, veri?.error || "Kayıt tamamlanamadı.");
                return;
            }
            // Kayıt sonrası otomatik giriş
            const girisCevap = await fetch("/api/store/auth/login", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: eposta, password: sifre })
            });
            const girisVeri = await girisCevap.json().catch(() => null);
            if (girisVeri?.success) {
                tokenlariSakla(girisVeri.data);
                girisiUygula(girisVeri.data.fullName || `${ad} ${soyad}`, girisVeri.data.email || eposta);
                // sepet birleştirme tamamlanmadan reload isteği kesmesin
            sepetiBirlestir().finally(uyeOzelSayfayiTazele);
            }
            kayitModal.querySelector("[data-ms-kayit-modal-kapat]")?.click();
        } catch {
            hataGoster(kayitHata, "Kayıt tamamlanamadı. Lütfen tekrar deneyin.");
        } finally {
            buton.disabled = false;
        }
    });

    // ── Çıkış: misharix script'i UI'ı sıfırlar; burada oturum sunucuda iptal edilir
    //    (session IsActive=false + SSR cookie silinir) ve token'lar temizlenir ──
    document.querySelectorAll("[data-ms-hesap-cikis]").forEach((cikis) => {
        cikis.addEventListener("click", () => {
            const refresh = localStorage.getItem(REFRESH_ANAHTARI);
            fetch("/api/store/auth/logout", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ refreshToken: refresh || null })
            }).catch(() => { /* ağ hatası — cookie süresiyle düşer, tokenlar yine silinir */ })
              .finally(() => {
                  // H10 düzeltmesi: üye-özel sayfada çıkış → eski üyenin SSR içeriği
                  // ekranda kalmasın; cookie sunucuda silindikten sonra ana sayfaya dön
                  if (window.msUyeOzelSayfa) window.location.href = "/";
              });
            tokenlariTemizle();
            window.msMiniSepetYenile?.();
        });
    });

    // D4: SMS/OTP girişi (nav script'indeki kod adımı) başarılı doğrulamada bu köprüyü
    // çağırır — token saklama, hesap paneli ve sepet birleştirme e-posta girişiyle ortak.
    window.msGirisBasarili = (veri) => {
        tokenlariSakla(veri);
        girisiUygula(veri.fullName || "", veri.email || "");
        sepetiBirlestir().finally(uyeOzelSayfayiTazele);
    };

    // D1: SSR kimlik varsa oturum UI'ı /me yanıtı beklenmeden boyanır (yalnız JS oturumu
    // da varken — localStorage boşsa SSR cookie'sine güvenilmez, /me akışı belirleyicidir).
    if (ssrUye?.ad && localStorage.getItem(TOKEN_ANAHTARI)) {
        girisiUygula(ssrUye.ad, ssrUye.iletisim || "");
    }
    beniGetir(false);
});
</script>
