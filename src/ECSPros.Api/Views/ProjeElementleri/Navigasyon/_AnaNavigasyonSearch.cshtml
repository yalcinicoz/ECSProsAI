@* B2: Canlı arama script'i — DOMContentLoaded'da bağlanır ki misharix'in kendi arama
   script'inden (parse anında çalışan IIFE, _AnaNavigasyon.cshtml) SONRA tetiklensin:
   misharix her tuş vuruşunda sonuç alanını sıfırlar (görünürlük yönetimi), bu script
   sonrasında içerik doldurur. Markup sınıfları misharix'inkiyle birebir aynı. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const kategoriKaynagi = @Html.Raw(aramaKategoriJson);

    document.querySelectorAll("[data-ms-arama]").forEach((aramaAlani) => {
        const platformId = aramaAlani.dataset.msAramaPlatform;
        if (!platformId) { return; }

        // B10: "Kategoride ara" kapsam daraltması — yalnız kategori sayfalarında aktif olabilir
        const kategoriId = aramaAlani.dataset.msAramaKategoriId || "";
        const kategoriSlug = aramaAlani.dataset.msAramaKategoriSlug || "";
        const kategoriAd = aramaAlani.dataset.msAramaKategoriAd || "";
        // Kabul testi 2026-07-22 (revizyon): kategori sayfasında arama VARSAYILAN olarak
        // kategori kapsamındadır — çip aktif başlar; tıklama kapsamı tüm mağazaya genişletir.
        let kategorideAra = kategoriId !== "";
        const kategorideMi = () => kategorideAra && kategoriId !== "";
        const tumSonucUrl = (terim) => kategorideMi()
            ? `/${encodeURIComponent(kategoriSlug)}?search=${encodeURIComponent(terim)}`
            : `/urunler?search=${encodeURIComponent(terim)}`;

        const input = aramaAlani.querySelector("[data-ms-arama-input]");
        const panelInput = aramaAlani.querySelector("[data-ms-arama-panel-input]");
        const gruplar = aramaAlani.querySelector("[data-ms-arama-sonuc-gruplari]");
        const sonucSayisi = aramaAlani.querySelector("[data-ms-arama-sonuc-sayisi]");
        const urunListesi = aramaAlani.querySelector("[data-ms-arama-urun-listesi]");
        const sonAramalarAlani = aramaAlani.querySelector("[data-ms-son-aramalar]");
        const sonAramalarListesi = aramaAlani.querySelector("[data-ms-son-aramalar-listesi]");
        const sonAramalarTemizle = aramaAlani.querySelector("[data-ms-son-aramalar-temizle]");
        if (!input || !gruplar) { return; }

        const SON_ARAMA_ANAHTARI = "ms-son-aramalar";
        const fiyatYaz = (deger) => new Intl.NumberFormat("tr-TR",
            { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(deger || 0) + " TL";
        const kacir = (metin) => String(metin ?? "").replace(/[&<>"']/g,
            (k) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[k]));

        const urunKartiHtml = (urun) => {
            const ad = (urun.nameI18n && (urun.nameI18n.tr || Object.values(urun.nameI18n)[0])) || urun.code;
            // Eşleşen arama rengi (2026-08-14): "sarı elbise" gibi aramada öneri kartı da
            // eşleşen rengin görseli ve ?color= linkiyle gelir (sonuç sayfası kuralıyla aynı)
            const eslesenRenk = urun.matchedColorValueId
                ? (urun.colors || []).find((c) => c.valueId === urun.matchedColorValueId)
                : null;
            const gorselUrl = (eslesenRenk && eslesenRenk.imageUrl) || urun.mainImageUrl || "/images/no-image.svg";
            const renkParam = urun.matchedColorValueId
                ? `?color=${encodeURIComponent(urun.matchedColorValueId)}` : "";
            const gorsel = `<img class="ms-search-urun-gorsel" src="${kacir(gorselUrl)}" alt="${kacir(ad)}" loading="lazy">`;
            return `<a class="ms-search-urun-karti" href="/urun/${encodeURIComponent(urun.code)}${renkParam}" aria-label="${kacir(ad)}">
                <span class="ms-search-urun-gorsel-alani">${gorsel}</span>
                <span class="ms-search-urun-icerik">
                    <span class="ms-search-urun-baslik">${kacir(ad)}</span>
                    <span class="ms-search-urun-fiyat ms-urun-fiyat">${fiyatYaz(urun.minPrice ?? urun.basePrice)}</span>
                </span>
            </a>`;
        };

        const durumYaz = (mesaj) => {
            gruplar.innerHTML = `<p class="ms-ana-navigasyon-arama-kategori-label"><span>${kacir(mesaj)}</span></p>`;
        };

        // ── Son aramalar (localStorage) ──
        const sonAramalariOku = () => {
            try { return JSON.parse(localStorage.getItem(SON_ARAMA_ANAHTARI)) || []; }
            catch { return []; }
        };

        const sonAramalariCiz = () => {
            if (!sonAramalarAlani || !sonAramalarListesi) { return; }
            const kayitlar = sonAramalariOku();
            sonAramalarAlani.hidden = kayitlar.length === 0;
            sonAramalarListesi.innerHTML = kayitlar.map((terim) => `
                <a class="ms-ana-navigasyon-son-arama-chip" href="#" data-ms-son-arama-terim="${kacir(terim)}">
                    <svg class="ms-ana-navigasyon-son-arama-ikon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m5-2a9 9 0 1 1-2.636-6.364" />
                    </svg>
                    ${kacir(terim)}
                </a>`).join("");
        };

        const sonAramaKaydet = (terim) => {
            const temiz = terim.trim();
            if (temiz.length < 2) { return; }
            const kayitlar = [temiz, ...sonAramalariOku().filter((t) => t.toLocaleLowerCase("tr") !== temiz.toLocaleLowerCase("tr"))].slice(0, 6);
            try { localStorage.setItem(SON_ARAMA_ANAHTARI, JSON.stringify(kayitlar)); } catch { /* dolu/kapalı storage */ }
            sonAramalariCiz();
        };

        sonAramalarTemizle?.addEventListener("click", () => {
            try { localStorage.removeItem(SON_ARAMA_ANAHTARI); } catch { /* yok say */ }
            sonAramalariCiz();
        });

        sonAramalariCiz();

        // ── B10: Kategoride ara butonları — bağlam varsa görünür, tıklayınca kapsam değişir ──
        const kategorideAraButonlari = [...aramaAlani.querySelectorAll("[data-ms-kategoride-ara]")];
        if (kategoriId) {
            kategorideAraButonlari.forEach((buton) => {
                buton.hidden = false;
                buton.textContent = kategoriAd ? `${kategoriAd} içinde ara` : "Kategoride ara";
                // Varsayılan kapsam kategori — çip aktif başlar (aria + görsel durum)
                buton.setAttribute("aria-pressed", "true");
                buton.classList.add("ms-ana-navigasyon-kategoride-ara-aktif");
                buton.addEventListener("click", () => {
                    // Toggle: aktifken tıklamak kapsamı TÜM MAĞAZAYA genişletir (öneri +
                    // Enter genel arar); tekrar tıklamak kategoriye döner. Sonuca gitme
                    // Enter/Tümünü Gör ile — kapsam hangisiyse oraya gider.
                    kategorideAra = !kategorideAra;
                    kategorideAraButonlari.forEach((b) => {
                        b.setAttribute("aria-pressed", kategorideAra ? "true" : "false");
                        b.classList.toggle("ms-ana-navigasyon-kategoride-ara-aktif", kategorideAra);
                    });
                    canliAra(input.value || panelInput?.value || "");
                });
            });
        }

        // ── Canlı öneri ──
        let zamanlayici = null;
        let istekSirasi = 0;

        const canliAra = (metin) => {
            const terim = metin.trim();
            window.clearTimeout(zamanlayici);

            if (terim.length < 2) {
                if (sonucSayisi) { sonucSayisi.textContent = ""; }
                if (terim.length === 1) { durumYaz("En az 2 karakter yazın."); }
                return;
            }

            durumYaz("Aranıyor…");

            zamanlayici = window.setTimeout(async () => {
                const buIstek = ++istekSirasi;
                try {
                    const kaynakUrl = kategorideMi()
                        ? `/api/store/catalog/channel-categories/${kategoriId}/products?search=${encodeURIComponent(terim)}&page=1&pageSize=10`
                        : `/api/store/catalog/products?firmPlatformId=${platformId}&search=${encodeURIComponent(terim)}&page=1&pageSize=10`;
                    const yanit = await fetch(kaynakUrl);
                    const veri = await yanit.json();
                    if (buIstek !== istekSirasi) { return; } // eski cevap — yenisi yolda

                    const urunler = veri?.data?.items || [];
                    // B-009: kategori sorgusu TotalCount'u ürün×renk KARTI sayar — sayaç
                    // ürün konuşmalı (mağaza geneliyle aynı birim); yeni additive alan
                    const toplam = veri?.data?.productTotalCount ?? veri?.data?.totalCount ?? 0;
                    const terimKucuk = terim.toLocaleLowerCase("tr");
                    const kategoriler = kategoriKaynagi
                        .filter((k) => k.ad.toLocaleLowerCase("tr").includes(terimKucuk))
                        .slice(0, 6);

                    if (sonucSayisi) { sonucSayisi.textContent = `${toplam} ürün`; }

                    let html = "";

                    if (kategoriler.length > 0) {
                        html += `<section class="ms-ana-navigasyon-arama-sonuc-grubu">
                            <div class="ms-ana-navigasyon-arama-kategori-label"><span>Kategoriler</span><small>${kategoriler.length}</small></div>
                            <div class="ms-ana-navigasyon-populer-listesi">
                                ${kategoriler.map((k) => `<a class="ms-ana-navigasyon-populer-chip" href="${kacir(k.url)}">${kacir(k.etiket)}</a>`).join("")}
                            </div>
                        </section>`;
                    }

                    if (urunler.length > 0) {
                        html += `<section class="ms-ana-navigasyon-arama-sonuc-grubu">
                            <div class="ms-ana-navigasyon-arama-kategori-label"><span>Ürünler</span><small>${toplam} ürün</small></div>
                            <div class="ms-ana-navigasyon-arama-sonuc-listesi">${urunler.map(urunKartiHtml).join("")}</div>
                            <a class="ms-ana-navigasyon-tumunu-gor" href="${tumSonucUrl(terim)}">
                                Tümünü Gör
                                <svg class="ms-ana-navigasyon-tumunu-gor-ikon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                                </svg>
                            </a>
                        </section>`;
                    }

                    if (html === "") {
                        durumYaz(`"${terim}" için sonuç bulunamadı.`);
                        return;
                    }

                    gruplar.innerHTML = html;
                } catch {
                    if (buIstek === istekSirasi) { durumYaz("Arama yapılamadı."); }
                }
            }, 300);
        };

        // ── Görsel arama köprüsü (2026-08-03) ──
        // site.js sonuçları dropdown'a basar (parse-anı dinleyicisi bizden önce çalışır);
        // burada sonuç KODLARINDAN /urunler?codes= URL'i kurulur: "Arama Sonuçları" başlık
        // satırına (dropdown'ın EN ÜSTÜ — alttaki link scroll'suz görünmüyordu) Tümünü Gör
        // eklenir ve Enter aynı sayfaya götürür. Kullanıcı yazmaya dönünce köprü düşer.
        let gorselAramaUrl = "";
        const gorselKopruyuKaldir = () => {
            gorselAramaUrl = "";
            aramaAlani.querySelector("[data-ms-gorsel-tumunu-gor]")?.remove();
        };
        document.addEventListener("ms:gorsel-arama-sonuc", (olay) => {
            gorselKopruyuKaldir();
            const kodlar = [...new Set((olay.detail?.results || [])
                .map((r) => r.modelCode).filter(Boolean))];
            if (!kodlar.length) { return; }
            gorselAramaUrl = "/urunler?codes=" + encodeURIComponent(kodlar.join(","));
            const ustSatir = aramaAlani.querySelector("[data-ms-arama-sonuc] .ms-ana-navigasyon-urunler-ust");
            if (!ustSatir) { return; }
            const link = document.createElement("a");
            link.className = "ms-ana-navigasyon-tumunu-gor";
            link.setAttribute("data-ms-gorsel-tumunu-gor", "");
            link.href = gorselAramaUrl;
            link.innerHTML = `Tümünü Gör
                <svg class="ms-ana-navigasyon-tumunu-gor-ikon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>`;
            ustSatir.appendChild(link);
        });

        [input, panelInput].filter(Boolean).forEach((aramaInput) => {
            aramaInput.addEventListener("input", () => {
                gorselKopruyuKaldir(); // kullanıcı yazmaya döndü — görsel arama bağlamı düşer
                canliAra(aramaInput.value);
            });
            aramaInput.addEventListener("keydown", (olay) => {
                if (olay.key !== "Enter") { return; }
                if (gorselAramaUrl) { window.location.href = gorselAramaUrl; return; }
                // Görsel arama modunda kod listesi boşsa Enter metin aramasına düşmesin
                // (input'ta site.js'in yazdığı "Görsel arama" yer tutucusu durur)
                if (aramaInput.value.trim() === "Görsel arama") { return; }
                if (aramaInput.value.trim().length >= 2) {
                    sonAramaKaydet(aramaInput.value);
                    window.location.href = tumSonucUrl(aramaInput.value.trim());
                }
            });
        });

        // Chip tıklamaları (popüler + son aramalar) → panel içi arama
        const terimleAra = (terim) => {
            input.value = terim;
            if (panelInput) { panelInput.value = terim; }
            // misharix'in görünürlük script'i input olayını dinliyor — durum sınıflarını o günceller
            input.dispatchEvent(new Event("input", { bubbles: true }));
            sonAramaKaydet(terim);
        };

        aramaAlani.addEventListener("click", (olay) => {
            const chip = olay.target.closest("[data-ms-populer-terim], [data-ms-son-arama-terim]");
            if (!chip) { return; }
            olay.preventDefault();
            terimleAra(chip.dataset.msPopulerTerim || chip.dataset.msSonAramaTerim || "");
        });

        // ── Popüler ürünler (geçici kaynak: ilk ürünler; 15 dk sessionStorage önbelleği) ──
        const populerUrunleriDoldur = async () => {
            if (!urunListesi) { return; }
            const ONBELLEK_ANAHTARI = "ms-populer-urunler:" + platformId;

            let urunler = null;
            try {
                const kayit = JSON.parse(sessionStorage.getItem(ONBELLEK_ANAHTARI));
                if (kayit && Date.now() - kayit.zaman < 15 * 60 * 1000) { urunler = kayit.urunler; }
            } catch { /* bozuk kayıt — yeniden çek */ }

            if (!urunler) {
                try {
                    const yanit = await fetch(`/api/store/catalog/products?firmPlatformId=${platformId}&page=1&pageSize=8`);
                    const veri = await yanit.json();
                    urunler = veri?.data?.items || [];
                    try { sessionStorage.setItem(ONBELLEK_ANAHTARI, JSON.stringify({ zaman: Date.now(), urunler })); } catch { /* yok say */ }
                } catch { return; } // panel popüler ürünsüz de çalışır
            }

            urunListesi.innerHTML = urunler.map((urun) => {
                const ad = (urun.nameI18n && (urun.nameI18n.tr || Object.values(urun.nameI18n)[0])) || urun.code;
                const gorsel = `<img class="ms-ana-navigasyon-urun-gorsel" src="${kacir(urun.mainImageUrl || "/images/no-image.svg")}" alt="${kacir(ad)}" loading="lazy">`;
                return `<a class="ms-ana-navigasyon-urun-karti" href="/urun/${encodeURIComponent(urun.code)}">
                    ${gorsel}
                    <span class="ms-ana-navigasyon-urun-icerik">
                        <span class="ms-ana-navigasyon-urun-baslik">${kacir(ad)}</span>
                        <span class="ms-ana-navigasyon-urun-fiyat ms-urun-fiyat">${fiyatYaz(urun.minPrice)}</span>
                    </span>
                </a>`;
            }).join("");
        };

        populerUrunleriDoldur();
    });
});
</script>
