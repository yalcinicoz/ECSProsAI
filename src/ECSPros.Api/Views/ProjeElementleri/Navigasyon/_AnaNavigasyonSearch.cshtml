@using ECSPros.Api.Models.Store
@using System.Text.Json
@{
    // B2: Canlı arama önerileri — ürünler products?search'ten, kategori önerileri nav
    // ağacından (client-side eşleşme). Demo içerik kaldırıldı; sonuç alanını sayfa
    // altındaki script dolduruyor (misharix'in görünürlük/panel script'i değişmedi).
    var aramaNav = ViewData["MsNavigasyon"] as NavigasyonVm ?? NavigasyonVm.Bos;
    var aramaPlatform = ViewData["MsPlatform"] as ECSPros.Api.Services.StorePlatformBilgisi;
    // Alt kategoriler "Kök › Çocuk" etiketiyle sunulur — aynı ada sahip kategoriler
    // (ör. Kadın/Elbise ile Çocuk & Bebek/Elbise) ayırt edilebilsin.
    var aramaKategorileri = aramaNav.Kokler
        .SelectMany(k => new[] { new { ad = k.Ad, etiket = k.Ad, url = k.Url } }
            .Concat(k.Cocuklar.SelectMany(c =>
                new[] { new { ad = c.Ad, etiket = $"{k.Ad} › {c.Ad}", url = c.Url } }
                    .Concat(c.Cocuklar.Select(t => new { ad = t.Ad, etiket = $"{c.Ad} › {t.Ad}", url = t.Url })))))
        .ToList();
    var aramaKategoriJson = JsonSerializer.Serialize(aramaKategorileri);
    // B10: "Kategoride ara" — kategori sayfası controller'ı ViewData["MsAktifKategori"]'yi
    // doldurur; buton yalnız bu bağlam varken görünür (misharix kuralı: !anaSayfaMi).
    var aramaAktifKategori = ViewData["MsAktifKategori"] as NavKategori;
}
