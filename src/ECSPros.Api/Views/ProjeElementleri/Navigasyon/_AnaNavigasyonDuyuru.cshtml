<div class="ms-ana-duyuru-bar">
    <div class="ms-ana-duyuru-ic">
        <div class="ms-ana-duyuru-uygulamalar">
            <a class="ms-ana-duyuru-link" href="#" target="_blank" rel="noopener noreferrer">
                <img src="/images/play-store-top.png" alt="Play Store">
                <span>Play Store</span>
            </a>
            <a class="ms-ana-duyuru-link" href="#" target="_blank" rel="noopener noreferrer">
                <img src="/images/app-store-top.png" alt="App Store">
                <span>App Store</span>
            </a>
            <a class="ms-ana-duyuru-link" href="#" target="_blank" rel="noopener noreferrer">
                <img src="/images/whatsapp-icon-top.png" alt="WhatsApp">
                <span>WhatsApp</span>
            </a>
        </div>

        <div class="ms-ana-duyuru-kayan-alan" aria-label="Duyurular">
            @* G8: metinler vitrin "announcement" bloklarından (global-top yerleşimi;
               admin Vitrin Yönetimi'nden). Kaynaktaki gibi ilk metin sona tekrar basılır
               (kayan döngü sürekliliği). Blok yoksa tasarımın statik metinleri yedek. *@
            @if (ViewData["MsDuyurular"] is List<string> msDuyurular)
            {
                <div class="ms-ana-duyuru-kayan-metin">
                    @foreach (var duyuru in msDuyurular)
                    {
                        <span>@duyuru</span>
                    }
                    <span>@msDuyurular[0]</span>
                </div>
            }
            else
            {
                <div class="ms-ana-duyuru-kayan-metin">
                    <span>Yeni sezon koleksiyonunu keşfet!</span>
                    <span>Mishar'a özel fırsatlar seni bekliyor.</span>
                    <span>Sepette avantajlı ürünleri kaçırma.</span>
                    <span>Yeni sezon koleksiyonunu keşfet!</span>
                </div>
            }
        </div>

        <div class="ms-ana-duyuru-sag-linkler">
            @{ var msSegment = ViewData["MsSegment"] as ECSPros.Api.Services.Store.VisitorSegment; }
            @* H2: Kargo Takip — üye Siparişlerim'e (takip modalları orada), misafir giriş
               modalına (B3'ten beri '#' bekliyordu). Yardım & Destek → kurumsal SSS (F2 rotası). *@
            @if (msSegment?.IsMember == true)
            {
            <a href="/Hesabim/Siparislerim">Kargo Takip</a>
            }
            else
            {
            <a href="#" data-ms-giris-modal-ac role="button">Kargo Takip</a>
            }
            <a href="/sik-sorulan-sorular">Yardım &amp; Destek</a>
            @* G9b: şehir çipi — segmentin çözdüğü konumu gösterir, tıklayınca 81 il
               modalı (_SehirSecim) açılır. Konum zinciri: adres → profil → ms_sehir
               cookie'si; modal cookie'yi yazar. *@
            <a href="#" data-ms-sehir-cip data-ms-sehir-kod="@(msSegment?.CityCode)"
               role="button" aria-haspopup="dialog" aria-label="Konum seç">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <span data-ms-sehir-cip-ad>@(msSegment?.CityName ?? "Konum Seç")</span>
            </a>
        </div>
    </div>
</div>
