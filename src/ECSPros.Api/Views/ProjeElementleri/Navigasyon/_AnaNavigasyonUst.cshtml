@using ECSPros.Api.Models.Store
@{
    var mevcutYol = Context.Request.Path.Value?.TrimEnd('/').ToLowerInvariant();
    var anaSayfaMi = string.IsNullOrWhiteSpace(mevcutYol) || mevcutYol == "/" || mevcutYol == "/home" || mevcutYol == "/home/index";
    // B1: Mobil kategori kaydırma şeridi kanal kategorilerinden beslenir (desktop menüyle aynı kaynak).
    var nav = ViewData["MsNavigasyon"] as NavigasyonVm ?? NavigasyonVm.Bos;
    // B5: Mini sepet api/store/cart çağrısı için platform kimliği
    var sepetPlatform = ViewData["MsPlatform"] as ECSPros.Api.Services.StorePlatformBilgisi;
}

<div class="ms-ana-navigasyon-ust">
        <button class="ms-ana-navigasyon-mobil-menu" type="button" aria-label="Menüyü aç" aria-controls="ms-ana-navigasyon-mobil-panel" aria-expanded="false" data-ms-mobil-menu-ac>
            <span></span>
            <span></span>
            <span></span>
        </button>

        <a class="ms-ana-navigasyon-logo-link" asp-controller="Home" asp-action="Index">
            <img class="ms-ana-navigasyon-logo" src="/images/site_logo.png" alt="Mishar Italia">
        </a>

        <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyonSearch.cshtml" />

        <partial name="_GorselAramaModal" />

        <div class="ms-ana-navigasyon-aksiyonlar">
            <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyonGirisMenu.cshtml" />
            <a class="ms-ana-navigasyon-aksiyon" href="#">
                <span class="ms-ana-navigasyon-aksiyon-ikon-grup" aria-hidden="true">
                    <img class="ms-ana-navigasyon-aksiyon-ikon ms-ana-navigasyon-aksiyon-ikon-normal " src="/ikons/favorite.svg" alt="">
                    <img class="ms-ana-navigasyon-aksiyon-ikon ms-ana-navigasyon-aksiyon-ikon-aktif " src="/ikons/favorite-active.svg" alt="">
                </span>
                Favorilerim
            </a>
            @* B5: Mini sepet canlı veriye bağlandı — demo satırlar kaldırıldı; liste dosya
               sonundaki script'le GET /api/store/cart'tan doldurulur (satır markup'ı demo
               satırın birebir kopyası). Sepete Git / Siparişi Tamamla Faz C'de bağlanacak. *@
            <div class="ms-ana-navigasyon-sepet" data-ms-sepet-menu>
                <button class="ms-ana-navigasyon-aksiyon" type="button" data-ms-sepet-menu-tetikleyici aria-haspopup="true" aria-expanded="false">
                    <span class="ms-ana-navigasyon-sepet-ikon-alani">
                        <span class="ms-ana-navigasyon-aksiyon-ikon-grup" aria-hidden="true">
                            <img class="ms-ana-navigasyon-aksiyon-ikon ms-ana-navigasyon-aksiyon-ikon-normal " src="/ikons/basket.svg" alt="">
                            <img class="ms-ana-navigasyon-aksiyon-ikon ms-ana-navigasyon-aksiyon-ikon-aktif " src="/ikons/basket-active.svg" alt="">
                        </span>
                        <span class="ms-ana-navigasyon-sepet-rozet" data-ms-sepet-rozet hidden>0</span>
                    </span>
                    <span class="ms-ana-navigasyon-sepet-yazi">Sepetim</span>
                </button>
                <div class="ms-ana-navigasyon-sepet-panel" data-ms-sepet-menu-panel>
                    <div class="ms-ana-navigasyon-sepet-panel-ust">
                        <strong>Sepetim</strong>
                        <span data-ms-sepet-adet>0 ürün</span>
                    </div>
                    <div class="ms-ana-navigasyon-sepet-urun-listesi" data-ms-sepet-liste>
                        <p data-ms-sepet-bos>Sepetiniz henüz boş.</p>
                    </div>
                    <div class="ms-ana-navigasyon-sepet-ozet">
                        <span>Sepet Toplamı</span>
                        <strong class="ms-urun-fiyat" data-ms-sepet-toplam>0,00 TL</strong>
                    </div>
                    <div class="ms-ana-navigasyon-sepet-aksiyonlar">
                        @* C1: Sepete Git canlı; Siparişi Tamamla C4 teslimat sayfası gelene dek sepete götürür *@
                        <a class="ms-ana-navigasyon-sepet-buton ms-ana-navigasyon-sepet-buton-ikincil" href="/sepet">Sepete Git</a>
                        <a class="ms-ana-navigasyon-sepet-buton ms-ana-navigasyon-sepet-buton-birincil" href="/sepet">Siparişi Tamamla</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (anaSayfaMi)
    {
        <nav class="ms-magaza-mobil-menu-kaydirma-alani" data-ms-mobil-menu-kaydirma-alani aria-label="Mobil kategori menüsü">
            <div class="ms-magaza-menu-kaydirma ms-magaza-menu-kaydirma-kaydirilabilir">
                @foreach (var kok in nav.Kokler)
                {
                    <a class="ms-magaza-menu-link" href="@kok.Url">@kok.Ad @if (!string.IsNullOrWhiteSpace(kok.Rozet)){<span class="ms-magaza-menu-yeni">@kok.Rozet</span>}</a>
                }
            </div>
        </nav>
    }
    <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyonGirisModal.cshtml" />

    <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyonKayitModal.cshtml" />

    <div class="ms-ornek-modal" data-ms-belge-modal aria-hidden="true">
        <div class="ms-ornek-modal-kaplama" data-ms-belge-modal-kapat></div>
        <section class="ms-ornek-modal-kutu ms-belge-modal-kutu" role="dialog" aria-modal="true" aria-labelledby="ms-belge-modal-baslik">
            <button class="ms-ornek-modal-kapat" type="button" data-ms-belge-modal-kapat aria-label="Belge modalını kapat">×</button>

            <span class="ms-modal-ornek-ikon ms-modal-ornek-ikon-standart" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M5 6.75A2.75 2.75 0 0 1 7.75 4h8.5A2.75 2.75 0 0 1 19 6.75v10.5A2.75 2.75 0 0 1 16.25 20h-8.5A2.75 2.75 0 0 1 5 17.25V6.75Z" stroke="currentColor" stroke-width="1.8" />
                    <path d="M8 9h8M8 12h8M8 15h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
            </span>
            <p id="ms-belge-modal-baslik" class="ms-ornek-modal-baslik">Bilgilendirme</p>
            <p class="ms-ornek-modal-aciklama"><strong data-ms-belge-modal-baslik>Belge</strong> içeriğini okuyup onaylayabilirsiniz.</p>

            <div class="ms-belge-modal-icerik" data-ms-belge-modal-icerik>
                <p>İlgili bilgilendirme metni burada görüntülenir.</p>
            </div>

            <div class="ms-ornek-modal-aksiyonlar">
                <button class="ms-buton ms-buton-m ms-buton-sade" type="button" data-ms-belge-modal-kapat>Reddet</button>
                <button class="ms-buton ms-buton-m ms-buton-koyu" type="button" data-ms-belge-modal-kabul>Kabul Et</button>
            </div>
        </section>
    </div>

@* B5: Mini sepet canlı veri script'i — GET /api/store/cart (SPA ile aynı oturum anahtarları:
   ecspros_sid / ecspros_cart). Satır markup'ı demo satırın birebir kopyasıdır; silme
   DELETE /api/store/cart/{cartId}/items/{itemId} sonrası yeniden çizer. Diğer sayfalar
   (ürün detay sepete ekleme) window.msMiniSepetYenile() ile rozeti tazeleyebilir. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const platformId = "@(sepetPlatform?.Id)";
    const sepetAlani = document.querySelector("[data-ms-sepet-menu]");
    if (!platformId || !sepetAlani) { return; }

    const rozet = sepetAlani.querySelector("[data-ms-sepet-rozet]");
    const adetAlani = sepetAlani.querySelector("[data-ms-sepet-adet]");
    const liste = sepetAlani.querySelector("[data-ms-sepet-liste]");
    const toplamAlani = sepetAlani.querySelector("[data-ms-sepet-toplam]");

    const kacir = (metin) => String(metin ?? "").replace(/[&<>"']/g,
        (k) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[k]));
    const fiyatYaz = (deger) => new Intl.NumberFormat("tr-TR",
        { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(deger || 0) + " TL";
    const trAd = (i18n) => (i18n && (i18n.tr || Object.values(i18n)[0])) || "";

    let sepetId = null;

    const satirHtml = (kalem) => {
        const ad = trAd(kalem.productNameI18n) || kalem.productCode || "Ürün";
        const gorsel = kalem.imageUrl
            ? `<img class="ms-ana-navigasyon-sepet-urun-gorsel" src="${kacir(kalem.imageUrl)}" alt="${kacir(ad)}">`
            : `<img class="ms-ana-navigasyon-sepet-urun-gorsel" alt="">`;
        const linkBas = kalem.productCode ? `<a href="/urun/${encodeURIComponent(kalem.productCode)}">` : "";
        const linkSon = kalem.productCode ? "</a>" : "";
        return `<div class="ms-ana-navigasyon-sepet-urun" data-ms-sepet-kalem="${kacir(kalem.id)}">
            ${linkBas}${gorsel}${linkSon}
            <div class="ms-ana-navigasyon-sepet-urun-bilgi">
                <strong class="ms-ana-navigasyon-sepet-urun-baslik">${kacir(ad)}</strong>
                <p>${kacir(kalem.optionsText || "")}</p>
                <div class="ms-ana-navigasyon-sepet-urun-alt">
                    <span>${kalem.quantity} adet</span>
                    <strong class="ms-fiyat-standart">${fiyatYaz(kalem.lineTotal)}</strong>
                </div>
            </div>
            <button class="ms-ana-navigasyon-sepet-sil" type="button" data-ms-sepet-kalem-sil="${kacir(kalem.id)}" aria-label="${kacir(ad)} ürününü sepetten sil">
                <i class="fa-solid fa-trash-can ms-fa-ikon" aria-hidden="true"></i>
            </button>
        </div>`;
    };

    const ciz = (sepet) => {
        const kalemler = sepet?.items || [];
        const adet = kalemler.reduce((t, k) => t + (k.quantity || 0), 0);
        sepetId = sepet?.id || null;

        if (rozet) {
            rozet.textContent = String(adet);
            rozet.hidden = adet === 0;
        }
        if (adetAlani) { adetAlani.textContent = `${adet} ürün`; }
        if (toplamAlani) { toplamAlani.textContent = fiyatYaz(sepet?.subtotal || 0); }
        if (liste) {
            liste.innerHTML = kalemler.length
                ? kalemler.map(satirHtml).join("")
                : `<p data-ms-sepet-bos>Sepetiniz henüz boş.</p>`;
        }
    };

    const yenile = async () => {
        const sid = localStorage.getItem("ecspros_sid");
        const cartId = localStorage.getItem("ecspros_cart");
        if (!sid && !cartId) { ciz(null); return; }

        try {
            const p = new URLSearchParams({ firmPlatformId: platformId });
            if (cartId) { p.set("cartId", cartId); }
            if (sid) { p.set("sessionId", sid); }
            const cevap = await fetch("/api/store/cart?" + p.toString());
            const veri = await cevap.json().catch(() => null);
            ciz(veri?.success ? veri.data : null);
        } catch { ciz(null); }
    };

    liste?.addEventListener("click", async (olay) => {
        const silButonu = olay.target.closest?.("[data-ms-sepet-kalem-sil]");
        if (!silButonu || !sepetId) { return; }
        olay.preventDefault();
        olay.stopPropagation();
        silButonu.disabled = true;
        try {
            await fetch(`/api/store/cart/${sepetId}/items/${silButonu.dataset.msSepetKalemSil}`, { method: "DELETE" });
        } catch { /* ağ hatası — yenile zaten gerçek durumu getirir */ }
        yenile();
    });

    window.msMiniSepetYenile = yenile;
    yenile();
});
</script>
