@* B5: Mini sepet canlı veri script'i — GET /api/store/cart (SPA ile aynı oturum anahtarları:
   ecspros_sid / ecspros_cart). Satır markup'ı demo satırın birebir kopyasıdır; silme
   DELETE /api/store/cart/{cartId}/items/{itemId} sonrası yeniden çizer. Diğer sayfalar
   (ürün detay sepete ekleme) window.msMiniSepetYenile() ile rozeti tazeleyebilir. *@
<script>
document.addEventListener("DOMContentLoaded", () => {
    const platformId = "@(sepetPlatform?.Id)";
    const sepetAlani = document.querySelector("[data-ms-sepet-menu]");
    if (!platformId || !sepetAlani) { return; }

    const rozet = sepetAlani.querySelector("[data-ms-sepet-rozet]");
    const adetAlani = sepetAlani.querySelector("[data-ms-sepet-urun-sayisi]");
    const liste = sepetAlani.querySelector("[data-ms-sepet-urun-listesi]");
    const toplamAlani = sepetAlani.querySelector("[data-ms-sepet-toplam]");

    const kacir = (metin) => String(metin ?? "").replace(/[&<>"']/g,
        (k) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[k]));
    const fiyatYaz = (deger) => new Intl.NumberFormat("tr-TR",
        { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(deger || 0) + " TL";
    const trAd = (i18n) => (i18n && (i18n.tr || Object.values(i18n)[0])) || "";

    let sepetId = null;

    const satirHtml = (kalem) => {
        const ad = trAd(kalem.productNameI18n) || kalem.productCode || "Ürün";
        const gorsel = kalem.imageUrl
            ? `<img class="ms-ana-navigasyon-sepet-urun-gorsel" src="${kacir(kalem.imageUrl)}" alt="${kacir(ad)}">`
            : `<img class="ms-ana-navigasyon-sepet-urun-gorsel" alt="">`;
        const linkBas = kalem.productCode ? `<a href="/urun/${encodeURIComponent(kalem.productCode)}">` : "";
        const linkSon = kalem.productCode ? "</a>" : "";
        return `<div class="ms-ana-navigasyon-sepet-urun" data-ms-sepet-kalem="${kacir(kalem.id)}">
            ${linkBas}${gorsel}${linkSon}
            <div class="ms-ana-navigasyon-sepet-urun-bilgi">
                <strong class="ms-ana-navigasyon-sepet-urun-baslik">${kacir(ad)}</strong>
                <p>${kacir(kalem.optionsText || "")}</p>
                <div class="ms-ana-navigasyon-sepet-urun-alt">
                    <span>${kalem.quantity} adet</span>
                    <strong class="ms-fiyat-standart">${fiyatYaz(kalem.lineTotal)}</strong>
                </div>
            </div>
            <button class="ms-ana-navigasyon-sepet-sil" type="button" data-ms-sepet-kalem-sil="${kacir(kalem.id)}" aria-label="${kacir(ad)} ürününü sepetten sil">
                <i class="fa-solid fa-trash-can ms-fa-ikon" aria-hidden="true"></i>
            </button>
        </div>`;
    };

    const ciz = (sepet) => {
        const kalemler = sepet?.items || [];
        const adet = kalemler.reduce((t, k) => t + (k.quantity || 0), 0);
        sepetId = sepet?.id || null;

        if (rozet) {
            rozet.textContent = String(adet);
            rozet.hidden = adet === 0;
        }
        if (adetAlani) { adetAlani.textContent = `${adet} ürün`; }
        if (toplamAlani) { toplamAlani.textContent = fiyatYaz(sepet?.subtotal || 0); }
        // Sepet-seviyesi kampanya indirimi (2026-08-03) — varsa satır açılır, kampanya adı yazılır
        const kampanyaSatiri = sepetAlani.querySelector("[data-ms-sepet-kampanya-satiri]");
        if (kampanyaSatiri) {
            const kampanyaIndirim = sepet?.campaignDiscount || 0;
            kampanyaSatiri.hidden = !(kampanyaIndirim > 0);
            if (kampanyaIndirim > 0) {
                const adAlaniK = kampanyaSatiri.querySelector("[data-ms-sepet-kampanya-ad]");
                const tutarAlaniK = kampanyaSatiri.querySelector("[data-ms-sepet-kampanya-tutar]");
                const adlar = (sepet?.campaigns || []).map((k) => k.name).filter(Boolean).join(", ");
                if (adAlaniK) { adAlaniK.textContent = adlar || "Kampanya İndirimi"; }
                if (tutarAlaniK) { tutarAlaniK.textContent = "-" + fiyatYaz(kampanyaIndirim); }
            }
        }
        if (liste) {
            liste.innerHTML = kalemler.length
                ? kalemler.map(satirHtml).join("")
                : `<p class="ms-ana-navigasyon-sepet-bos" data-ms-sepet-bos>Sepetiniz henüz boş.</p>`;
        }
    };

    const yenile = async () => {
        const sid = localStorage.getItem("ecspros_sid");
        const cartId = localStorage.getItem("ecspros_cart");
        // 2026-07-22: üyeyken token da gönderilir — cartId/sid yokken de üye sepeti bulunur
        const uyeToken = localStorage.getItem("ecspros_member_token");
        if (!sid && !cartId && !uyeToken) { ciz(null); return; }

        try {
            const p = new URLSearchParams({ firmPlatformId: platformId });
            if (cartId) { p.set("cartId", cartId); }
            if (sid) { p.set("sessionId", sid); }
            const cevap = await fetch("/api/store/cart?" + p.toString(),
                uyeToken ? { headers: { Authorization: "Bearer " + uyeToken } } : undefined);
            const veri = await cevap.json().catch(() => null);
            ciz(veri?.success ? veri.data : null);
        } catch { ciz(null); }
    };

    liste?.addEventListener("click", async (olay) => {
        const silButonu = olay.target.closest?.("[data-ms-sepet-kalem-sil]");
        if (!silButonu || !sepetId) { return; }
        olay.preventDefault();
        olay.stopPropagation();
        silButonu.disabled = true;
        try {
            await fetch(`/api/store/cart/${sepetId}/items/${silButonu.dataset.msSepetKalemSil}`, { method: "DELETE" });
        } catch { /* ağ hatası — yenile zaten gerçek durumu getirir */ }
        yenile();
    });

    window.msMiniSepetYenile = yenile;
    yenile();
});
</script>
