@using ECSPros.Api.Models.Store
@{
    // G8: ana sayfa tamamen vitrin sisteminden render edilir (B6 geçici kompozisyonu
    // kaldırıldı — varsayılan içerik seed'le yayınlandı, admin Vitrin Yönetimi'nden
    // düzenlenir). Yayın yoksa yerleşim boş kalır (admin kararı).
    ViewData["Title"] = "Ana Sayfa";
    ViewData["MsMobilAltBar"] = true;
    var vitrinBloklar = ViewData["MsVitrinBloklar"] as IReadOnlyList<VitrinBlokVm> ?? [];
}

<div class="ms-ana-sayfa lazy-infinite-on">
    @if (vitrinBloklar.Count > 0)
    {
        @await Html.PartialAsync("~/Views/Shared/Store/_VitrinBloklar.cshtml", vitrinBloklar)
    }
</div>

@* Faz 5: tasarımın sayfa-seviyesi ortak renk modalı — yalnız data-ms-urun-renk-ortak
   işaretli tetikleyiciler açar (renk verisi JSON'u vitrin kart eşlemesiyle, Faz 7'de
   bağlanır; o zamana dek kartlar mevcut rozet/tooltip davranışında). *@
<partial name="~/Views/ProjeElementleri/Urun/_UrunRenkModal.cshtml" />

@* Bu script: ana sayfa carousel kartlarına kart davranışlarını (hover galerisi, renk tooltip,
   favori/koleksiyon) bağlar — site.js bootstrap'i yalnız data-ms-infinite-liste
   konteynerlerini tarar, vitrin carousel'leri onun dışında kalır. site.js body sonunda
   yüklendiğinden çağrı DOMContentLoaded'a ertelenir. *@
<script>
    (() => {
        const kartlariBagla = () => window.msUrunKartDavranislariYenile?.(document);

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", kartlariBagla, { once: true });
        } else {
            kartlariBagla();
        }
    })();
</script>
