@* F4: kolonlar admin'in "footer" kodlu nav menüsünden (ViewData["MsFooterMenu"] —
   kök label node = kolon başlığı, çocuk link node'ları = bağlantılar); menü tanımlı
   değilse tasarımın statik kolonları basılır. Bülten formu POST /api/store/newsletter'a
   bağlı. Mobil uygulama/sosyal linkler statik '#' (gerçek URL'ler config/Faz G). *@
@{
    var msFooterMenu = ViewData["MsFooterMenu"]
        as ECSPros.Storefront.Application.Queries.GetNavigationMenuDetail.NavigationMenuDetailDto;
    var msFooterKolonlar = msFooterMenu?.Nodes?.Where(n => n.Children.Count > 0).ToList();

    static string MsFooterAd(ECSPros.Storefront.Application.Queries.GetNavigationMenuDetail.NavNodeDto n) =>
        n.NameOverrideI18n?.GetValueOrDefault("tr") ?? n.Slug ?? "";
    static string MsFooterUrl(ECSPros.Storefront.Application.Queries.GetNavigationMenuDetail.NavNodeDto n) =>
        !string.IsNullOrWhiteSpace(n.CustomUrl) ? n.CustomUrl! :
        !string.IsNullOrWhiteSpace(n.Slug) ? "/" + n.Slug : "/";
}
<footer class="ms-footer">
    <div class="ms-footer-ust">
        <section class="ms-footer-marka-kolon" aria-labelledby="ms-footer-marka-baslik">
            <a class="ms-footer-logo" href="/ana-sayfa" aria-label="Mishar Italia ana sayfa">
                <span>MISHAR</span>
                <strong>ITALIA</strong>
            </a>
            <h2 id="ms-footer-marka-baslik" class="ms-footer-baslik">Misharitalia ile alışveriş daha net.</h2>
            <p class="ms-footer-aciklama">Yeni sezon ürünleri, sipariş takibi ve üyelik avantajlarını tek yerden yönetin.</p>
            <div class="ms-footer-guven-listesi" aria-label="Misharitalia hizmet avantajları">
                <span><i class="fa-solid fa-shield-halved ms-fa-ikon" aria-hidden="true"></i> Güvenli alışveriş</span>
                <span><i class="fa-solid fa-rotate-left ms-fa-ikon" aria-hidden="true"></i> Kolay iade</span>
                <span><i class="fa-solid fa-truck-fast ms-fa-ikon" aria-hidden="true"></i> Hızlı teslimat</span>
            </div>
        </section>

        @if (msFooterKolonlar is { Count: > 0 })
        {
            foreach (var kolon in msFooterKolonlar)
            {
        <div class="ms-footer-kolon" data-ms-footer-akordiyon>
            <button class="ms-footer-akordiyon-baslik" type="button" data-ms-footer-akordiyon-tetikleyici aria-expanded="false">
                <span class="ms-footer-baslik">@MsFooterAd(kolon)</span>
                <span class="ms-footer-akordiyon-ok" aria-hidden="true"></span>
            </button>
            <nav class="ms-footer-akordiyon-icerik" data-ms-footer-akordiyon-icerik aria-label="@MsFooterAd(kolon) bağlantıları">
                @foreach (var link in kolon.Children)
                {
                <a href="@MsFooterUrl(link)" target="@(link.OpenInNewTab ? "_blank" : null)" rel="@(link.OpenInNewTab ? "noopener" : null)">@MsFooterAd(link)</a>
                }
            </nav>
        </div>
            }
        }
        else
        {
        <div class="ms-footer-kolon" data-ms-footer-akordiyon>
            <button class="ms-footer-akordiyon-baslik" type="button" data-ms-footer-akordiyon-tetikleyici aria-expanded="false">
                <span class="ms-footer-baslik">Kurumsal</span>
                <span class="ms-footer-akordiyon-ok" aria-hidden="true"></span>
            </button>
            <nav class="ms-footer-akordiyon-icerik" data-ms-footer-akordiyon-icerik aria-label="Kurumsal bağlantılar">
                <a href="/hakkimizda">Hakkımızda</a>
                <a href="/iletisim">İletişim</a>
                <a href="/kargo-ve-teslimat">Kargo ve Teslimat</a>
                <a href="/iade-ve-degisim">İade ve Değişim</a>
                <a href="/sik-sorulan-sorular">Sık Sorulan Sorular</a>
                <a href="/kullanim-kosullari">Kullanım Koşulları</a>
                <a href="/gizlilik-ve-guvenlik">Gizlilik ve Güvenlik</a>
            </nav>
        </div>

        <div class="ms-footer-kolon" data-ms-footer-akordiyon>
            <button class="ms-footer-akordiyon-baslik" type="button" data-ms-footer-akordiyon-tetikleyici aria-expanded="false">
                <span class="ms-footer-baslik">Hesabım</span>
                <span class="ms-footer-akordiyon-ok" aria-hidden="true"></span>
            </button>
            <nav class="ms-footer-akordiyon-icerik" data-ms-footer-akordiyon-icerik aria-label="Hesap bağlantıları">
                <a rel="nofollow" href="/hesabim-varsayilan">Hesabım</a>
                <a rel="nofollow" href="/siparislerim">Siparişlerim</a>
                <a rel="nofollow" href="/iadelerim">İadelerim</a>
                <a rel="nofollow" href="/favorilerim">Favorilerim</a>
                <a rel="nofollow" href="/adreslerim">Adreslerim</a>
                <a rel="nofollow" href="/indirim-kuponlarim">İndirim Kuponlarım</a>
            </nav>
        </div>
        }

        <section class="ms-footer-sag" aria-labelledby="ms-footer-bulten-baslik">
            <div class="ms-footer-bulten-kutu">
                <span class="ms-footer-eyebrow">Misharitalia haberleri</span>
                <h2 id="ms-footer-bulten-baslik" class="ms-footer-baslik">Fırsatları kaçırmayın</h2>
                <p class="ms-footer-aciklama">Yeni ürün, kampanya ve kupon bildirimlerini almak için kaydolun.</p>
                <form class="ms-footer-form" data-ms-bulten-form>
                    <label class="ms-footer-abone-satiri">
                        <span class="sr-only">E-posta adresi</span>
                        <input type="email" name="bultenEposta" autocomplete="email" placeholder="E-posta adresiniz" data-ms-bulten-eposta>
                        <button type="submit" data-ms-bulten-kaydol>Kaydol</button>
                    </label>
                    <small class="ms-footer-aciklama" data-ms-bulten-bilgi role="status" aria-live="polite" hidden></small>
                </form>
            </div>

            <div class="ms-footer-alt-bloklar">
                <section class="ms-footer-blok" aria-labelledby="ms-footer-mobil-baslik">
                    <h2 id="ms-footer-mobil-baslik" class="ms-footer-baslik">Mobil Uygulama</h2>
                    <div class="ms-footer-app-listesi">
                        <a class="ms-footer-app" href="https://play.google.com/store" target="_blank" rel="noopener noreferrer" aria-label="Google Play üzerinden indir">
                            <img src="/images/performance/footer/google-play-44-v2.webp" alt="" aria-hidden="true" width="44" height="44" loading="lazy">
                        </a>
                        <a class="ms-footer-app" href="https://www.apple.com/app-store/" target="_blank" rel="noopener noreferrer" aria-label="App Store üzerinden indir">
                            <img src="/images/performance/footer/app-store-44-v2.webp" alt="" aria-hidden="true" width="44" height="44" loading="lazy">
                        </a>
                    </div>
                </section>

                <section class="ms-footer-blok" aria-labelledby="ms-footer-sosyal-baslik">
                    <h2 id="ms-footer-sosyal-baslik" class="ms-footer-baslik">Bizi Takip Edin</h2>
                    <div class="ms-footer-sosyal-listesi" aria-label="Sosyal medya bağlantıları">
                        <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                            <img src="/images/performance/footer/facebook-20-v2.webp" alt="" aria-hidden="true" width="20" height="20" loading="lazy">
                        </a>
                        <a href="https://www.pinterest.com/" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
                            <img src="/images/performance/footer/pinterest-20-v2.webp" alt="" aria-hidden="true" width="20" height="20" loading="lazy">
                        </a>
                        <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                            <img src="/images/performance/footer/youtube-20-v2.webp" alt="" aria-hidden="true" width="20" height="20" loading="lazy">
                        </a>
                    </div>
                </section>
            </div>
        </section>
    </div>

    <div class="ms-footer-alt">
        <div class="ms-footer-alt-ic">
            <p>©2026 <strong>misharix</strong> Her hakkı saklıdır.</p>
            <nav class="ms-footer-alt-linkler" aria-label="Yasal bağlantılar">
                <a href="/gizlilik-ve-guvenlik">Gizlilik ve Güvenlik</a>
                <a href="/kullanim-kosullari">Kullanım Koşulları</a>
                <a href="/iletisim">Destek</a>
            </nav>
        </div>
    </div>
</footer>

<script data-ms-footer-script>
// F4: bülten aboneliği — POST /api/store/newsletter (idempotent; misafir de kaydolur).
(() => {
    const form = document.querySelector("[data-ms-bulten-form]");

    if (!form || form.dataset.msBultenHazir === "true") {
        return;
    }

    form.dataset.msBultenHazir = "true";
    const eposta = form.querySelector("[data-ms-bulten-eposta]");
    const bilgi = form.querySelector("[data-ms-bulten-bilgi]");
    const kaydol = form.querySelector("[data-ms-bulten-kaydol]");

    const bildir = (mesaj) => {
        if (bilgi) {
            bilgi.textContent = mesaj || "";
            bilgi.hidden = !mesaj;
        }
    };

    form.addEventListener("submit", async (olay) => {
        olay.preventDefault();

        if (kaydol.disabled) {
            return;
        }

        kaydol.disabled = true;
        try {
            const token = localStorage.getItem("ecspros_member_token");
            const cevap = await fetch("/api/store/newsletter", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    ...(token ? { Authorization: "Bearer " + token } : {})
                },
                body: JSON.stringify({
                    firmPlatformId: "@((ViewData["MsPlatform"] as ECSPros.Api.Services.StorePlatformBilgisi)?.Id)",
                    email: eposta?.value || ""
                })
            });
            const veri = await cevap.json().catch(() => null);

            if (!veri?.success) {
                bildir(veri?.error || "Kaydolunamadı. Lütfen tekrar deneyin.");
                return;
            }

            bildir("Bülten kaydınız alındı. ✓");
            if (eposta) { eposta.value = ""; }
        } catch {
            bildir("Kaydolunamadı. Lütfen tekrar deneyin.");
        } finally {
            kaydol.disabled = false;
        }
    });
})();

// Mobil footer akordiyon davranışı.
(() => {
    const akordiyonlar = document.querySelectorAll("[data-ms-footer-akordiyon]");

    akordiyonlar.forEach((akordiyon) => {
        const tetikleyici = akordiyon.querySelector("[data-ms-footer-akordiyon-tetikleyici]");

        if (!tetikleyici) {
            return;
        }

        tetikleyici.addEventListener("click", () => {
            if (window.matchMedia("(min-width: 1024px)").matches) {
                return;
            }

            const acik = akordiyon.classList.toggle("ms-footer-akordiyon-acik");
            tetikleyici.setAttribute("aria-expanded", acik ? "true" : "false");
        });
    });
})();
</script>
