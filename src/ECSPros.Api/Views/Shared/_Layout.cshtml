@inject ECSPros.Api.Services.IStoreContext MsLayoutStoreContext
@{
    var msPlatform = await MsLayoutStoreContext.GetPlatformAsync();
    var markaAdi = msPlatform?.BrandName ?? "Misharitalia";
    var canonicalKok = msPlatform?.CanonicalDomain ?? "https://www.misharitalia.com";
    var sayfaBasligi = ViewData["Title"]?.ToString() ?? markaAdi;
    var metaDescription = ViewData["MetaDescription"]?.ToString() ?? $"{markaAdi} ile yeni sezon ürünlerini keşfedin.";
    var canonicalPath = ViewData["CanonicalPath"]?.ToString() ?? Context.Request.Path.Value ?? "/";
    canonicalPath = canonicalPath.StartsWith('/') ? canonicalPath : $"/{canonicalPath}";
    var canonicalUrl = $"{canonicalKok}{canonicalPath}";
    var robots = ViewData["Robots"]?.ToString() ?? "index, follow";
    var openGraphType = ViewData["OpenGraphType"]?.ToString() ?? "website";
    var openGraphImage = ViewData["OpenGraphImage"]?.ToString() ?? "/images/site_logo.png";
    var openGraphImageUrl = openGraphImage.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? openGraphImage
        : $"{canonicalKok}{(openGraphImage.StartsWith('/') ? openGraphImage : $"/{openGraphImage}")}";
    var jsonLd = ViewData["JsonLd"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* 2026-07-23 API kapısı: SSR'ın gömdüğü kısa ömürlü web token'ı. Aşağıdaki fetch
       yaması /api/* çağrılarına otomatik ekler — view'lardaki fetch'ler değişmeden çalışır. *@
    <meta name="ms-api-token" content="@(ViewData["MsApiToken"] as string)" />
    <script>
        (function () {
            var esasFetch = window.fetch;
            function msToken() {
                var m = document.querySelector('meta[name="ms-api-token"]');
                return m ? m.content : '';
            }
            function apiMi(url) {
                return typeof url === 'string' &&
                    (url.indexOf('/api/') === 0 || url.indexOf(location.origin + '/api/') === 0);
            }
            window.fetch = function (girdi, ayarlar) {
                var url = typeof girdi === 'string' ? girdi : (girdi && girdi.url) || '';
                if (!apiMi(url)) return esasFetch.call(this, girdi, ayarlar);
                ayarlar = ayarlar || {};
                var basliklar = new Headers(ayarlar.headers ||
                    (girdi instanceof Request ? girdi.headers : undefined) || {});
                var bizEkledik = false;
                if (!basliklar.has('Authorization') && msToken()) {
                    basliklar.set('Authorization', 'Bearer ' + msToken());
                    bizEkledik = true;
                }
                ayarlar.headers = basliklar;
                var kendisi = this;
                return esasFetch.call(kendisi, girdi, ayarlar).then(function (yanit) {
                    // Web token'ı süresi dolmuşsa (uzun açık kalan sekme): bir kez yenile + tekrarla
                    if (yanit.status !== 401 || !bizEkledik) return yanit;
                    return esasFetch('/api/store/web-token/renew', {
                        method: 'POST',
                        headers: { Authorization: 'Bearer ' + msToken() }
                    }).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
                        if (!d || !d.success) return yanit;
                        document.querySelector('meta[name="ms-api-token"]').content = d.data.token;
                        basliklar.set('Authorization', 'Bearer ' + d.data.token);
                        ayarlar.headers = basliklar;
                        return esasFetch.call(kendisi, girdi, ayarlar);
                    });
                });
            };
            // Sekme açık kaldıkça 10 dk'da bir sessiz yenileme (token ömrü 15 dk)
            setInterval(function () {
                esasFetch('/api/store/web-token/renew', {
                    method: 'POST',
                    headers: { Authorization: 'Bearer ' + msToken() }
                }).then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
                    if (d && d.success)
                        document.querySelector('meta[name="ms-api-token"]').content = d.data.token;
                }).catch(function () { });
            }, 10 * 60 * 1000);
        })();
    </script>
    <title>@sayfaBasligi | @markaAdi</title>
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="@markaAdi" />
    <meta property="og:type" content="@openGraphType" />
    <meta property="og:title" content="@sayfaBasligi" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@openGraphImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    @if (ViewData["MsPreloadHero"] is string msPreloadHero)
    {
        @* LCP görseli erken indirilsin — ana sayfa ilk slider görseli (D fazı, 2026-07-30).
           imagesrcset: preload, <img srcset>'in seçeceği varyantla aynı dosyayı indirsin
           (yoksa çift indirme olur); varyantsız eski görselde düz href'e düşer (A fazı). *@
        var msHeroSrcset = Context.RequestServices
            .GetService<ECSPros.Api.Services.Store.VitrinSrcsetSaglayici>()?.Srcset(msPreloadHero);
        <link rel="preload" as="image" href="@msPreloadHero" imagesrcset="@msHeroSrcset" imagesizes="@(msHeroSrcset is null ? null : "100vw")" fetchpriority="high" />
    }
    <link rel="stylesheet" href="~/fontawesome-free-7.2.0-web/css/ikonall.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <partial name="~/Views/Shared/_MsTemaTokenlari.cshtml" />
    <partial name="~/Views/Shared/_MsKartAyarlari.cshtml" />
    @if (!string.IsNullOrWhiteSpace(jsonLd))
    {
        <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    }
    @* İE-3 (2026-08-22): reklam/analytics takip — kanalda aktif entegrasyon yoksa boş *@
    <partial name="~/Views/Shared/Store/_TakipBasligi.cshtml" />
</head>
@* Görsel hover efekti (2026-08-14): "zoom" seçiliyken kart görseli hover'da büyür,
   galeri gezinmesi kapalıdır (site.js msKartAyarlari.hoverEfekti'ne bakar). *@
<body class="min-h-screen bg-white text-ms-siyah @((await MsLayoutStoreContext.GetPlatformAsync())?.KartAyarlari?.YakinlastirmaEfekti == true ? "ms-kart-hover-zoom" : "")">
    @* H4: mobil alt bar _AnaNavigasyon'dan ÖNCE — misafir Favorilerim/Hesabım linklerinin
       data-ms-giris-modal-ac dinleyicileri nav script'inde parse anında bağlanır. *@
    @* Mobil alt bar yalnız ana sayfa ve ürün listesi/kategori sayfalarında (kullanıcı
       kararı 2026-07-16) — ilgili view ViewData["MsMobilAltBar"]=true set eder. *@
    @if (ViewData["MsMobilAltBar"] is true)
    {
    <partial name="~/Views/Shared/Store/_MobilAltBarNav.cshtml" />
    }
    <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyon.cshtml" />
    @if (ViewData["MsOrtakKoleksiyonModallariGizle"] is not true)
    {
    <template data-ms-koleksiyon-modallari-sablon>
        <partial name="~/Views/ProjeElementleri/Ortak/_KoleksiyonModal.cshtml" />
        <partial name="~/Views/ProjeElementleri/Ortak/_KoleksiyonVarolanModal.cshtml" />
        <partial name="~/Views/ProjeElementleri/Ortak/_KoleksiyonYeniOzetModal.cshtml" />
    </template>
    }
    <template data-ms-onay-red-modal-sablon>
        <partial name="~/Views/ProjeElementleri/Ortak/onayRedModal.cshtml" />
    </template>
    @if (ViewData["MsOrtakKoleksiyonModallariGizle"] is not true)
    {
    <partial name="~/Views/Shared/Store/_KoleksiyonAkisKoprusu.cshtml" />
    }

    <main role="main">
        @RenderBody()
    </main>

    <partial name="~/Views/Shared/_Footer.cshtml" />
    @* İE-3: çerez/consent bandı — yalnız takip entegrasyonu olan kanalda ve tercih yoksa görünür *@
    <partial name="~/Views/Shared/Store/_TakipCerezBandi.cshtml" />

    <environment include="Development">
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/site.min.js" asp-append-version="true"></script>
    </environment>
    @* Ürün görseli yüklenemezse (kırık/eksik URL) no-image placeholder'ına düşülür —
       yalnız ürün bağlamındaki görseller; site geneli kuralı (2026-07-17). Boş URL hiç
       error üretmediğinden null-görsel dalları ayrıca no-image.svg basar. *@
    <script>
        document.addEventListener("error", (olay) => {
            const gorsel = olay.target;
            if (!(gorsel instanceof HTMLImageElement)) { return; }
            if (gorsel.dataset.msNoImage === "true") { return; }
            if (!gorsel.closest(".ms-urun-karti, .ms-search-urun-karti, .ms-ana-navigasyon-urun-karti, .ms-gorunum-kart, .ms-gorunum-reklam-vitrin-urun, .ms-gorunum-kategori-cok-satanlar-kart, .ms-urun-detay-resim-alani, .ms-urun-renk-tooltip-gorsel, .ms-hesabim-koleksiyon-kapak, .ms-sepet-urun-gorsel, .ms-urun-renk-modal-liste")) { return; }
            gorsel.dataset.msNoImage = "true";
            gorsel.removeAttribute("srcset");
            gorsel.src = "/images/no-image.svg";
        }, true);
    </script>
    @* 2026-08-03: kart kampanya bandı rotasyonu — bir ürünü birden çok kampanya kapsıyorsa
       rozetler (ad + palet rengi) data-ms-kampanya-rotasyon'da JSON taşınır ve 3 sn'de bir
       animasyonlu (yukarı kayarak) dönüşümlü gösterilir; kampanyanın rengi bandın arka
       planına uygulanır (renk yoksa CSS'teki marka rengi kalır). prefers-reduced-motion'da
       animasyonsuz düz geçiş. Her turda DOM taranır: continuation kartları da kapsanır. *@
    <script>
        (() => {
            const hareketAzalt = window.matchMedia?.("(prefers-reduced-motion: reduce)");
            let tur = 0;
            window.setInterval(() => {
                const bantlar = document.querySelectorAll("[data-ms-kampanya-rotasyon]");
                if (!bantlar.length) { return; }
                tur++;
                bantlar.forEach((bant) => {
                    let rozetler = [];
                    try { rozetler = JSON.parse(bant.dataset.msKampanyaRotasyon || "[]"); } catch { }
                    if (rozetler.length < 2) { return; }
                    const rozet = rozetler[tur % rozetler.length];
                    // Metin, bandın İÇİNDEKİ span'da kayar (bant sabit, arka plan yalnız renk
                    // geçişi yapar) — ilk turda span sarılır, bant overflow'u kapatılır.
                    let metin = bant.querySelector("[data-ms-kampanya-metin]");
                    if (!metin) {
                        metin = document.createElement("span");
                        metin.setAttribute("data-ms-kampanya-metin", "");
                        metin.textContent = bant.textContent;
                        bant.textContent = "";
                        bant.appendChild(metin);
                        bant.style.overflow = "hidden";
                        bant.style.transition = "background-color 300ms ease";
                    }
                    const uygula = () => {
                        metin.textContent = rozet.ad;
                        bant.style.backgroundColor = rozet.renk || "";
                    };
                    if (hareketAzalt?.matches || typeof metin.animate !== "function") { uygula(); return; }
                    // Yukarı kayarak çıkış → içerik+renk değişimi → alttan kayarak giriş
                    const cikis = metin.animate(
                        [{ transform: "translateY(0)", opacity: 1 }, { transform: "translateY(-100%)", opacity: 0 }],
                        { duration: 220, easing: "ease-in", fill: "forwards" });
                    cikis.onfinish = () => {
                        uygula();
                        metin.animate(
                            [{ transform: "translateY(100%)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 }],
                            { duration: 220, easing: "ease-out", fill: "forwards" });
                    };
                });
            }, 3000);
        })();
    </script>
    @* Ürün Kartı F2 (2026-08-09): alan 2/3 mesaj satırı rotasyonu — data-ms-mesaj-rotasyon
       JSON'undaki öğeler ({metin, ikon, sinif, renk}) bant script'iyle aynı kalıpla 3.5 sn'de
       bir döner (yukarı kayarak çıkış, alttan giriş; prefers-reduced-motion'da düz geçiş).
       Tek satır swap edildiğinden CSS'in sabit 3'lü/5'li keyframe'lerine bağlı değildir;
       her turda DOM taranır — continuation kartları da kapsanır. *@
    <script>
        (() => {
            const hareketAzalt = window.matchMedia?.("(prefers-reduced-motion: reduce)");
            let tur = 0;
            window.setInterval(() => {
                const alanlar = document.querySelectorAll("[data-ms-mesaj-rotasyon]");
                if (!alanlar.length) { return; }
                tur++;
                alanlar.forEach((alan) => {
                    let ogeler = [];
                    try { ogeler = JSON.parse(alan.dataset.msMesajRotasyon || "[]"); } catch { }
                    if (ogeler.length < 2) { return; }
                    const oge = ogeler[tur % ogeler.length];
                    const satir = alan.querySelector(".ms-urun-mesaj-satiri");
                    if (!satir) { return; }
                    const uygula = () => {
                        satir.innerHTML = `<i class="fa-solid ${oge.ikon || "fa-circle-info"} ms-fa-ikon ms-urun-mini-ikon" aria-hidden="true"></i>`
                            + `<span${oge.sinif ? ` class="${oge.sinif}"` : ""}${oge.renk ? ` style="color:${oge.renk}"` : ""}></span>`;
                        satir.lastElementChild.textContent = oge.metin || "";
                    };
                    if (hareketAzalt?.matches || typeof satir.animate !== "function") { uygula(); return; }
                    const cikis = satir.animate(
                        [{ transform: "translateY(0)", opacity: 1 }, { transform: "translateY(-100%)", opacity: 0 }],
                        { duration: 220, easing: "ease-in", fill: "forwards" });
                    cikis.onfinish = () => {
                        uygula();
                        satir.animate(
                            [{ transform: "translateY(100%)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 }],
                            { duration: 220, easing: "ease-out", fill: "forwards" });
                    };
                });
            }, 3500);
        })();
    </script>
    @* 2026-07-17: sayfa başına dön float butonu — 600px kaydırma sonrası görünür,
       mobilde alt bar/sepet sabit aksiyonunun üstünde konumlanır (CSS). *@
    <button class="ms-sayfa-basi-buton" type="button" data-ms-sayfa-basi aria-label="Sayfa başına dön" hidden>
        <i class="fa-solid fa-chevron-up ms-fa-ikon" aria-hidden="true"></i>
    </button>
    <script>
        (() => {
            const buton = document.querySelector("[data-ms-sayfa-basi]");
            if (!buton) { return; }
            const esik = 600;
            let gorunur = false;
            const guncelle = () => {
                const gerekli = window.scrollY > esik;
                if (gerekli === gorunur) { return; }
                gorunur = gerekli;
                buton.hidden = !gerekli;
            };
            window.addEventListener("scroll", guncelle, { passive: true });
            guncelle();
            buton.addEventListener("click", () => {
                window.scrollTo({ top: 0, behavior: "smooth" });
            });
        })();
    </script>
    <partial name="~/Views/ProjeElementleri/Urun/_FavoriDavranis.cshtml" />
    <partial name="~/Views/ProjeElementleri/Urun/_KartSepetDavranis.cshtml" />
    <partial name="~/Views/Shared/Store/_SehirSecim.cshtml" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
