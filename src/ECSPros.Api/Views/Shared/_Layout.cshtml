<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - misharix</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/fontawesome-free-7.2.0-web/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <partial name="~/Views/Shared/_MsTemaTokenlari.cshtml" />
</head>
<body class="min-h-screen bg-white text-ms-siyah">
    <partial name="~/Views/ProjeElementleri/Navigasyon/_AnaNavigasyon.cshtml" />

    <main role="main">
        @RenderBody()
    </main>

    <partial name="~/Views/Shared/_Footer.cshtml" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
