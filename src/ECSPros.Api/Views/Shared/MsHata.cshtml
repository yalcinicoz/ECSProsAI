@model int
@{
    // Storefront hata sayfası (2026-07-30) — İZİNLİ YENİ dosya (tasarım paketinde hata
    // sayfası şablonu yok; mevcut buton/tipografi sınıflarıyla site kabuğu içinde basit
    // bir gövde). 404 dışındaki kodlar için genel "bir sorun oluştu" metni kullanılır.
    var dortYuzDort = Model == 404;
}

<div class="mx-auto max-w-2xl px-4 py-20 text-center sm:py-28">
    <p class="text-7xl font-bold text-ms-siyah sm:text-8xl" aria-hidden="true">@Model</p>
    <h1 class="mt-4 text-xl font-semibold text-ms-siyah sm:text-2xl">
        @(dortYuzDort ? "Aradığınız sayfa bulunamadı" : "Bir sorun oluştu")
    </h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-500 sm:text-base">
        @if (dortYuzDort)
        {
            <text>Sayfa taşınmış, adı değişmiş ya da bağlantı hatalı yazılmış olabilir.
            Menüden devam edebilir veya aşağıdaki bağlantıları kullanabilirsiniz.</text>
        }
        else
        {
            <text>İsteğiniz şu anda tamamlanamadı. Lütfen biraz sonra yeniden deneyin.</text>
        }
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a class="ms-buton" href="/">Ana Sayfaya Dön</a>
        <a class="ms-buton ms-buton-sade" href="/urun-listesi">Ürünlere Göz At</a>
    </div>
</div>
