                            <a class="ms-gorunum-carousel-cercevesiz-kart" href="@(oge.LinkUrl ?? "#")" target="@(oge.YeniSekme ? "_blank" : null)">
                                <img data-ms-lazy-src="@oge.GorselUrl" data-ms-lazy-srcset="@cercevesizSrcset" data-ms-lazy-sizes="@(cercevesizSrcset is null ? null : "(max-width: 768px) 90vw, 400px")" alt="@oge.Baslik çerçevesiz carousel görseli" width="@(cercevesizBoyut?.Genislik ?? 400)" height="@(cercevesizBoyut?.Yukseklik ?? 489)" loading="lazy">
                                <span class="ms-gorunum-carousel-cercevesiz-yazi">
