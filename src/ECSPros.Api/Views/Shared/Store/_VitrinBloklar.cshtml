@using ECSPros.Api.Models.Store
@using System.Text.Json
@inject ECSPros.Api.Services.Store.VitrinSrcsetSaglayici MsSrcset
@model IReadOnlyList<ECSPros.Api.Models.Store.VitrinBlokVm>
@{
    // G5: vitrin blokları — her tipin markup'ı tasarımın GorunumTipleri/Ortak
    // partial'larından birebir alındı (demo sayfa kabukları — açıklama kutuları,
    // tema seçici — taşınmadı). Görünmeyen/boş blok PageComposer'da elendi; burada
    // her blok basılır. site.js modülleri (slider, story, carousel kontrol,
    // içerik tabs, reklam vitrin, lazy) markup'taki data-ms-* kancalarıyla çalışır.
    // 2026-07-17: tasarım AnaSayfa kalıbı — her blok ms-ana-sayfa-elment sarmalayıcıda
    // (bölüm aralıkları + content-visibility bu class'tan); düz ms-gorunum-demo kutuları
    // ve blok başlıkları kaldırıldı (kullanıcı kararı: ana sayfa bölümlerinde başlık yok;
    // carousel'lerdeki ms-gorunum-demo bileşimi tasarımdaki gibi korunur — tema/zemin
    // CSS'i o class'a bağlı). announcement bloğu sarmalanmaz (görsel bölüm değil).
    var tr = new System.Globalization.CultureInfo("tr-TR");
    string Fiyat(decimal f) => f.ToString("N2", tr) + " TL";
    var msVitrinPlatformId = (ViewData["MsPlatform"] as ECSPros.Api.Services.StorePlatformBilgisi)?.Id.ToString() ?? "";
}

@foreach (var blok in Model)
{
    switch (blok.Tip)
    {
        case "slider":
            @* Tasarım nihai (2026-07-16): tek <img> kaynağı; ilk slide eager/high, sonrakiler
               data-ms-lazy-src; intrinsic 1200x525; mobil oran class'ı config.gorunum'dan
               (mobil-dikey → ms-mobil-dikey, varsayılan ms-mobil-yatay — ana sayfa kalıbı). *@
            <div class="ms-ana-sayfa-elment">
            <section class="ms-slider @(blok.Gorunum == "mobil-dikey" ? "ms-mobil-dikey" : "ms-mobil-yatay")" data-ms-slider data-ms-page-module="slider" aria-label="@(blok.Baslik.Length > 0 ? blok.Baslik : "Kampanya slider")">
                <div class="ms-slider-gorsel-alani" data-ms-slider-gorsel-alani>
                    @for (var i = 0; i < blok.Ogeler.Count; i++)
                    {
                        var slide = blok.Ogeler[i];
                        <a class="ms-slider-slide @(i == 0 ? "ms-slider-slide-gorunur ms-slider-slide-aktif" : "")" href="@(slide.LinkUrl ?? "#")" target="@(slide.YeniSekme ? "_blank" : null)" aria-label="@slide.Baslik kampanyasına git">
                            @{
                                // A fazı (2026-07-30): varyantı olan görsele srcset — cihaz gereken genişliği indirir.
                                // width/height GERÇEK boyutlardan: ayrılan alan yükleme sonrası değişmez (CLS düzeltmesi).
                                var slideUrl = slide.GorselUrl ?? slide.MobilGorselUrl;
                                var slideSrcset = MsSrcset.Srcset(slideUrl);
                                var slideBoyut = MsSrcset.Boyut(slideUrl);
                            }
                            @if (i == 0)
                            {
                            <img class="no-lazy" src="@slideUrl" srcset="@slideSrcset" sizes="@(slideSrcset is null ? null : "100vw")" alt="@slide.Baslik" width="@(slideBoyut?.Genislik ?? 1200)" height="@(slideBoyut?.Yukseklik ?? 525)" loading="eager" fetchpriority="high" decoding="async" data-ms-lazy="false">
                            }
                            else
                            {
                            <img data-ms-lazy-src="@slideUrl" data-ms-lazy-srcset="@slideSrcset" data-ms-lazy-sizes="@(slideSrcset is null ? null : "100vw")" alt="@slide.Baslik" width="@(slideBoyut?.Genislik ?? 1200)" height="@(slideBoyut?.Yukseklik ?? 525)" loading="lazy">
                            }
                        </a>
                    }
                </div>

                <button class="ms-slider-kontrol ms-slider-kontrol-sol" type="button" aria-label="Önceki görsel" data-ms-slider-yon="onceki">
                    <i class="fa-solid fa-chevron-left ms-fa-ikon" aria-hidden="true"></i>
                </button>
                <button class="ms-slider-kontrol ms-slider-kontrol-sag" type="button" aria-label="Sonraki görsel" data-ms-slider-yon="sonraki">
                    <i class="fa-solid fa-chevron-right ms-fa-ikon" aria-hidden="true"></i>
                </button>

                <div class="ms-slider-noktalar" data-ms-slider-noktalar aria-label="Slider görsel seçimi">
                    @for (var i = 0; i < blok.Ogeler.Count; i++)
                    {
                        <button class="ms-slider-nokta @(i == 0 ? "ms-slider-nokta-aktif" : "")" type="button" aria-label="@(i + 1). görsel" data-ms-slider-index="@i" aria-pressed="@(i == 0 ? "true" : "false")"></button>
                    }
                </div>
            </section>
            </div>
            break;

        case "story":
        {
            var storyAnahtarlari = StoryAnahtarlari(blok);
            <div class="ms-ana-sayfa-elment">
            <section class="ms-story" data-ms-story aria-label="Story alanı">
                <div class="ms-story-listesi no-lazy">
                    @foreach (var story in blok.Ogeler)
                    {
                        <button class="ms-story-karti" type="button" data-ms-story-grup="@storyAnahtarlari[story.Id]" data-ms-story-ac="@blok.Ogeler.ToList().IndexOf(story)">
                            <span class="ms-story-gorsel">
                                <img class="no-lazy" src="@story.GorselUrl" alt="@story.Baslik story görseli" width="64" height="64">
                            </span>
                            <span class="ms-story-etiket">@story.Baslik</span>
                        </button>
                    }
                </div>

                @* Story frame verisi: öğe config.frames'ten; yoksa öğenin görsel/videosundan tek kare *@
                <script type="application/json" data-ms-story-veri>@Html.Raw(StoryVerisi(blok, storyAnahtarlari))</script>

                <div class="ms-story-modal ms-gizli" data-ms-story-modal aria-hidden="true">
                    <div class="ms-story-modal-arkaplan" data-ms-story-kapat></div>
                    <div class="ms-story-cerceve" role="dialog" aria-modal="true" aria-label="Story görüntüleyici">
                        <div class="ms-story-progress-listesi" data-ms-story-progress-listesi></div>

                        @* 2026-07-17: data-ms-modal-surukleme-alani kaldırıldı — story modalı
                           çek-kapat akışının dışında (kullanıcı kararı; site.js seçicileri de daraltıldı). *@
                        <div class="ms-story-modal-ust">
                            <span class="ms-story-modal-avatar">
                                <img data-ms-story-avatar alt="" width="40" height="40" loading="lazy" decoding="async">
                            </span>
                            <strong data-ms-story-modal-baslik>Story</strong>
                            <span class="ms-story-modal-bosluk"></span>
                            <button class="ms-story-ikon-buton" type="button" data-ms-story-kapat aria-label="Kapat">
                                <i class="fa-solid fa-xmark ms-fa-ikon" aria-hidden="true"></i>
                            </button>
                        </div>

                        <img class="ms-story-modal-gorsel" data-ms-story-modal-gorsel alt="" width="800" height="1200" loading="lazy" decoding="async">
                        <video class="ms-story-modal-gorsel ms-gizli" data-ms-story-modal-video muted playsinline preload="metadata"></video>

                        <button class="ms-story-yon ms-story-yon-sol" type="button" data-ms-story-yon="onceki" aria-label="Önceki story">
                            <i class="fa-solid fa-chevron-left ms-fa-ikon" aria-hidden="true"></i>
                        </button>
                        <button class="ms-story-yon ms-story-yon-sag" type="button" data-ms-story-yon="sonraki" aria-label="Sonraki story">
                            <i class="fa-solid fa-chevron-right ms-fa-ikon" aria-hidden="true"></i>
                        </button>

                        <button class="ms-story-orta-oynat" type="button" data-ms-story-orta-oynat aria-label="Oynat">
                            <i class="fa-solid fa-play ms-fa-ikon" data-ms-story-orta-ikon aria-hidden="true"></i>
                        </button>

                        <div class="ms-story-modal-alt">
                            <strong data-ms-story-alt-baslik>Story</strong>
                            <a class="ms-story-aksiyon" href="#" data-ms-story-aksiyon>İncele</a>
                        </div>
                    </div>
                </div>
            </section>
            </div>
            break;
        }

        case "banner" when blok.Sablon == "reklam":
            <div class="ms-ana-sayfa-elment">
            <div class="ms-gorunum-reklam-vitrin lazy-infinite-on" data-ms-gorunum-reklam-vitrin>
                @if (blok.Ogeler.FirstOrDefault() is { } reklamBanner)
                {
                    var reklamSrcset = MsSrcset.Srcset(reklamBanner.GorselUrl);
                    var reklamBoyut = MsSrcset.Boyut(reklamBanner.GorselUrl);
                    <a class="ms-gorunum-reklam-vitrin-banner" href="@(reklamBanner.LinkUrl ?? "#")" aria-label="@reklamBanner.Baslik">
                        <img data-ms-lazy-src="@reklamBanner.GorselUrl" data-ms-lazy-srcset="@reklamSrcset" data-ms-lazy-sizes="@(reklamSrcset is null ? null : "(max-width: 768px) 100vw, 50vw")" alt="@reklamBanner.Baslik" width="@(reklamBoyut?.Genislik ?? 1200)" height="@(reklamBoyut?.Yukseklik ?? 525)" loading="lazy" decoding="async">
                    </a>
                }

                <div class="ms-gorunum-reklam-vitrin-icerik">
                    <div class="ms-gorunum-reklam-vitrin-ust">
                        <h3>@blok.Baslik</h3>
                        <a class="ms-gorunum-tumunu-gor" href="@(blok.TumunuGorUrl ?? "#")">@(blok.AltBaslik ?? "Kategoriye Git")</a>
                    </div>

                    <div class="ms-gorunum-reklam-vitrin-kaydirma">
                        <button class="ms-gorunum-reklam-vitrin-kontrol" type="button" data-ms-gorunum-reklam-vitrin-kontrol="sol" aria-label="Önceki ürünler">‹</button>
                        <div class="ms-gorunum-reklam-vitrin-liste" data-ms-gorunum-reklam-vitrin-liste>
                            @foreach (var urun in blok.Urunler)
                            {
                                <a class="ms-gorunum-reklam-vitrin-urun" href="@urun.Url">
                                    <img data-ms-lazy-src="@urun.GorselUrl" alt="@urun.Ad">
                                    <span>
                                        @urun.Ad
                                        <em>@Fiyat(urun.Fiyat)</em>
                                    </span>
                                </a>
                            }
                        </div>
                        <button class="ms-gorunum-reklam-vitrin-kontrol" type="button" data-ms-gorunum-reklam-vitrin-kontrol="sag" aria-label="Sonraki ürünler">›</button>
                    </div>
                </div>
            </div>
            </div>
            break;

        case "banner":
            <div class="ms-ana-sayfa-elment">
                <div class="ms-gorunum-banner-grid ms-gorunum-banner-grid-@(blok.Sablon ?? "tekli") @(blok.MobilCarousel ? "ms-gorunum-banner-mobil-carousel" : "")">
                    @foreach (var banner in blok.Ogeler)
                    {
                        var bannerSrcset = MsSrcset.Srcset(banner.GorselUrl);
                        var bannerBoyut = MsSrcset.Boyut(banner.GorselUrl);
                        <a class="ms-gorunum-banner-karti" href="@(banner.LinkUrl ?? "#")" target="@(banner.YeniSekme ? "_blank" : null)">
                            <img data-ms-lazy-src="@banner.GorselUrl" data-ms-lazy-srcset="@bannerSrcset" data-ms-lazy-sizes="@(bannerSrcset is null ? null : "(max-width: 768px) 100vw, 403px")" alt="@banner.Baslik" width="@(bannerBoyut?.Genislik ?? 400)" height="@(bannerBoyut?.Yukseklik ?? 164)" loading="lazy" decoding="async">
                        </a>
                    }
                </div>
            </div>
            break;

        case "carousel":
        {
            var sablon = blok.Sablon ?? "standart";
            var demoSinifi = sablon switch
            {
                "ozel-fiyat" => "ms-gorunum-carousel-demo-ozel-fiyat",
                "flash" => "ms-gorunum-carousel-demo-flash",
                _ => "ms-gorunum-carousel-demo-standart ms-gorunum-carousel-tema-" + (blok.Tema ?? "varsayilan"),
            };
            var listeSinifi = sablon switch
            {
                "ozel-fiyat" => " ms-gorunum-carousel-urun-sik",
                "flash" => " ms-gorunum-carousel-urun-genis",
                _ => "",
            };
            <div class="ms-ana-sayfa-elment">
            <div class="ms-gorunum-demo ms-gorunum-carousel-demo @demoSinifi ms-gorunum-carousel-demo-market lazy-infinite-on" data-ms-gorunum-carousel>
                <div class="ms-gorunum-baslik-satiri">
                    <div>
                        @if (sablon == "flash")
                        {
                            @* Tasarım nihai: Tümünü Gör flash'ta kaldırıldı; başlık liste linkidir. *@
                            <h2 class="ms-gorunum-flash-baslik">
                                <a class="ms-gorunum-flash-baslik-link" href="@(blok.TumunuGorUrl ?? "/urun-listesi")">
                                    <i class="fa-solid fa-bolt-lightning ms-fa-ikon ms-ikon-orijinal" aria-hidden="true"></i>
                                    @blok.Baslik
                                </a>
                            </h2>
                        }
                        else
                        {
                            <h2>@blok.Baslik</h2>
                        }
                        @if (blok.AltBaslik is not null)
                        {
                            <p>@blok.AltBaslik</p>
                        }
                    </div>
                    <div class="ms-gorunum-carousel-sag">
                        @if (blok.TumunuGorUrl is not null && sablon != "flash")
                        {
                            <a class="ms-gorunum-tumunu-gor" href="@blok.TumunuGorUrl">Tümünü Gör</a>
                        }
                        @if (sablon == "flash" && blok.FlashBitis is { } bitis)
                        {
                            <span class="ms-gorunum-flash-sayac" data-ms-vitrin-flash-sayac data-ms-vitrin-flash-bitis="@bitis.ToString("O")" aria-label="Flash ürünler bitiş sayacı">
                                <input type="number" min="0" max="30" value="0" inputmode="numeric" aria-label="Gün" data-ms-gorunum-flash-input="gun" readonly>
                                :
                                <input type="number" min="0" max="23" value="0" inputmode="numeric" aria-label="Saat" data-ms-gorunum-flash-input="saat" readonly>
                                :
                                <input type="number" min="0" max="59" value="0" inputmode="numeric" aria-label="Dakika" data-ms-gorunum-flash-input="dakika" readonly>
                                :
                                <input type="number" min="0" max="59" value="0" inputmode="numeric" aria-label="Saniye" data-ms-gorunum-flash-input="saniye" readonly>
                            </span>
                        }
                        <span class="ms-gorunum-etiket" data-ms-gorunum-carousel-sayac>1 / @blok.Urunler.Count</span>
                    </div>
                </div>

                <div class="ms-gorunum-carousel-kapsayici">
                    <button class="ms-gorunum-carousel-kontrol ms-slider-kontrol ms-slider-kontrol-sol" type="button" data-ms-gorunum-carousel-kontrol="sol" aria-label="Önceki @blok.Baslik ürünlerini göster">
                        <i class="fa-solid fa-chevron-left ms-fa-ikon" aria-hidden="true"></i>
                    </button>
                    <div class="ms-gorunum-carousel ms-gorunum-carousel-urun@(listeSinifi)" data-ms-gorunum-carousel-liste aria-label="@blok.Baslik ürünleri">
                        @foreach (var urun in blok.Urunler)
                        {
                            @await Html.PartialAsync("~/Views/ProjeElementleri/Urun/_UrunKarti.cshtml", urun)
                        }
                    </div>
                    <button class="ms-gorunum-carousel-kontrol ms-slider-kontrol ms-slider-kontrol-sag" type="button" data-ms-gorunum-carousel-kontrol="sag" aria-label="Sonraki @blok.Baslik ürünlerini göster">
                        <i class="fa-solid fa-chevron-right ms-fa-ikon" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            </div>
            break;
        }

        case "infinity":
            <div class="ms-ana-sayfa-elment" data-ms-vitrin-infinity data-ms-vitrin-blok-id="@blok.Id" data-ms-vitrin-platform="@msVitrinPlatformId" data-ms-vitrin-sayfa="1">
                <div class="ms-gorunum-grid ms-gorunum-grid-anasayfa" data-ms-vitrin-infinity-liste>
                    @foreach (var urun in blok.Urunler)
                    {
                        <a class="ms-gorunum-kart" href="@urun.Url">
                            <img src="@(urun.GorselUrl ?? "/images/no-image.svg")" alt="@urun.Ad">
                            <div class="ms-gorunum-kart-icerik">
                                <strong>@urun.Ad</strong>
                                <span class="ms-gorunum-fiyat">@Fiyat(urun.Fiyat)</span>
                            </div>
                        </a>
                    }
                </div>

                <div class="ms-gorunum-daha-fazla-alani">
                    <button class="ms-buton ms-buton-sade" type="button" data-ms-vitrin-daha-fazla>Daha Fazla Göster</button>
                </div>
            </div>
            break;

        case "tabs":
            <div class="ms-ana-sayfa-elment" data-ms-gorunum-icerik-tabs>
                <div class="ms-gorunum-sekme-seridi" role="tablist" aria-label="Vitrin sekmeleri">
                    @for (var i = 0; i < blok.Ogeler.Count; i++)
                    {
                        <button class="ms-gorunum-mini-tab @(i == 0 ? "ms-gorunum-mini-tab-aktif" : "")" type="button" data-ms-gorunum-icerik-tab="@blok.Ogeler[i].Id.ToString("N")" aria-pressed="@(i == 0 ? "true" : "false")">@blok.Ogeler[i].Baslik</button>
                    }
                </div>

                @for (var i = 0; i < blok.Ogeler.Count; i++)
                {
                    var sekme = blok.Ogeler[i];
                    <div class="ms-gorunum-paneli @(i == 0 ? "" : "ms-gizli")" data-ms-gorunum-icerik-panel="@sekme.Id.ToString("N")">
                        <div class="ms-gorunum-grid ms-gorunum-grid-kompakt">
                            @foreach (var urun in sekme.Urunler)
                            {
                                <a class="ms-gorunum-kart" href="@urun.Url">
                                    <img src="@(urun.GorselUrl ?? "/images/no-image.svg")" alt="@urun.Ad">
                                    <div class="ms-gorunum-kart-icerik">
                                        <strong>@urun.Ad</strong>
                                        <span class="ms-gorunum-fiyat">@Fiyat(urun.Fiyat)</span>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
            break;

        case "collection":
            <div class="ms-ana-sayfa-elment">
                <div class="ms-hesabim-koleksiyon-grid @(blok.MobilCarousel ? "ms-gorunum-banner-mobil-carousel" : "")">
                    @foreach (var koleksiyon in blok.Koleksiyonlar)
                    {
                        <article class="ms-hesabim-koleksiyon-karti">
                            <div class="ms-hesabim-koleksiyon-ust">
                                <div class="ms-hesabim-koleksiyon-kullanici">
                                    <span class="ms-hesabim-koleksiyon-avatar" aria-hidden="true">@koleksiyon.UyeBasHarfleri</span>
                                    <div>
                                        <strong>@koleksiyon.UyeAdi</strong>
                                        <p>@koleksiyon.Ad</p>
                                    </div>
                                </div>
                            </div>

                            <div class="ms-hesabim-koleksiyon-kapak">
                                @foreach (var kapak in koleksiyon.Kapak)
                                {
                                    <a href="@kapak.UrunUrl" aria-label="@koleksiyon.Ad koleksiyonundaki @kapak.UrunAdi ürününü aç">
                                        <img src="@kapak.GorselUrl" alt="@kapak.UrunAdi" />
                                    </a>
                                }
                                @if (koleksiyon.KalanUrun > 0)
                                {
                                    <span class="ms-hesabim-koleksiyon-kapak-bos">+@koleksiyon.KalanUrun</span>
                                }
                            </div>

                            <div class="ms-hesabim-koleksiyon-icerik">
                                <h3>@koleksiyon.Ad</h3>
                                @if (koleksiyon.Aciklama is not null)
                                {
                                    <p>@koleksiyon.Aciklama</p>
                                }
                                <div class="ms-hesabim-koleksiyon-rozetler" aria-label="Koleksiyon bilgileri">
                                    <span>@koleksiyon.UrunSayisi Ürün</span>
                                    <span>Herkese açık</span>
                                    <span>@koleksiyon.Goruntulenme Görüntülenme</span>
                                </div>
                                @* H10: public koleksiyon sayfası açıldı — tasarım _Collection.cshtml aksiyonları *@
                                <div class="ms-hesabim-koleksiyon-aksiyonlar">
                                    <a class="ms-buton ms-buton-s ms-buton-sade" href="/koleksiyon/@koleksiyon.ShareCode">Koleksiyonu Aç</a>
                                    <button class="ms-buton ms-buton-s ms-buton-sade" type="button" data-ms-koleksiyon-paylas="@koleksiyon.ShareCode">Paylaş</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                <script>
                    (() => {
                        // H10: vitrin koleksiyon kartı Paylaş — hesabım davranışıyla aynı (panoya kopyala)
                        document.currentScript.previousElementSibling
                            .querySelectorAll("[data-ms-koleksiyon-paylas]").forEach((buton) => {
                                buton.addEventListener("click", async () => {
                                    const link = location.origin + "/koleksiyon/" + buton.dataset.msKoleksiyonPaylas;
                                    try {
                                        await navigator.clipboard.writeText(link);
                                        const eski = buton.textContent;
                                        buton.textContent = "Kopyalandı ✓";
                                        window.setTimeout(() => { buton.textContent = eski; }, 1600);
                                    } catch { window.prompt("Koleksiyon bağlantısı:", link); }
                                });
                            });
                    })();
                </script>
            </div>
            break;

        case "categories" when blok.Gorunum == "vitrin":
            <div class="ms-ana-sayfa-elment">
                <div class="ms-gorunum-kategori-vitrin-grid">
                    @foreach (var kategori in blok.Ogeler)
                    {
                        <a class="ms-gorunum-kategori-vitrin-karti" href="@(kategori.LinkUrl ?? "#")">
                            <img src="@kategori.GorselUrl" alt="@kategori.Baslik">
                            <span>
                                <strong>@kategori.Baslik</strong>
                                <small>@kategori.AltBaslik</small>
                            </span>
                        </a>
                    }
                </div>
            </div>
            break;

        case "categories":
            <div class="ms-ana-sayfa-elment">
                <div class="ms-gorunum-kategori-kapsul-listesi @(blok.MobilCarousel ? "ms-gorunum-banner-mobil-carousel" : "")" aria-label="@blok.Baslik">
                    @foreach (var kategori in blok.Ogeler)
                    {
                        <a class="ms-gorunum-kategori-kapsul" href="@(kategori.LinkUrl ?? "#")">
                            <img data-ms-lazy-src="@kategori.GorselUrl" alt="@kategori.Baslik" width="64" height="64" loading="lazy">
                            <strong>@kategori.Baslik</strong>
                        </a>
                    }
                </div>
            </div>
            break;

        case "brands":
            <div class="ms-ana-sayfa-elment">
                @* 2026-09-01 (kullanıcı bildirimi): blok BAŞLIKSIZ basılıyordu — panelde girilen
                   başlık ("Markalar") standart başlık satırıyla gösterilir ki blok sayfada
                   tanınabilsin (tasarım demo sayfasında başlık dokümantasyon h3'üydü). *@
                @if (blok.Baslik.Length > 0)
                {
                    <div class="ms-gorunum-baslik-satiri">
                        <div>
                            <h2>@blok.Baslik</h2>
                            @if (blok.AltBaslik is not null)
                            {
                                <p>@blok.AltBaslik</p>
                            }
                        </div>
                    </div>
                }
                <div class="ms-gorunum-marka-grid @(blok.MobilCarousel ? "ms-gorunum-banner-mobil-carousel" : "")">
                    @foreach (var marka in blok.Ogeler)
                    {
                        @* 2026-09-01 (kullanıcı kararı): panelden marka görseli (logo/banner)
                           yüklendiyse kartta YALNIZ o gösterilir — config.images kolajı (seed'in
                           demo görselleri) tamamen devre dışı kalır. Görsel yüklenmemişse eski
                           kolaj davranışı (config.images ≤4) korunur. *@
                        var mozaik = marka.GorselUrl is { Length: > 0 } markaGorsel
                            ? new List<string> { markaGorsel }
                            : marka.EkGorseller.Take(4).ToList();
                        <a class="ms-gorunum-marka-karti" href="@(marka.LinkUrl ?? "#")">
                            @if (marka.Rozet is not null)
