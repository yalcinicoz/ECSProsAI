ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5062
DOTNET_gcServer=1
DOTNET_NOLOGO=1

Node__Id=legacy-stock-worker-1
Node__Role=Worker
Node__WorkerProfile=LegacyStock
Node__MigrateOnStartup=false
# systemd unit ProtectSystem=strict kullanır; fallback key dizini izinli shared altında olmalı.
DataProtection__KeysPath=/opt/ECSProsAI/shared/dp-keys

LegacyReadImport__Enabled=false
# Gerçek değer yalnız /etc/ecspros/legacy-stock-worker.env içinde tutulur.
LegacyReadImport__ConnectionString=__SECRET__

LegacyStockSync__Enabled=true
LegacyStockSync__DryRun=true
LegacyStockSync__IntervalSeconds=300
LegacyStockSync__StartupDelaySeconds=15
LegacyStockSync__CommandTimeoutSeconds=300
LegacyStockSync__StockStorageType=1
LegacyStockSync__MinimumSourceRows=1000
LegacyStockSync__BlockOnUnmappedQuantity=true
LegacyStockSync__MaximumUnmappedRows=0
LegacyStockSync__MaximumUnmappedQuantity=0
# Yalnız kontrollü eşleme onarımı sırasında açılır; işlemden sonra tekrar false yapılır.
LegacyStockSync__RepairMissingMappings=false
LegacyStockSync__MappingRepairDryRun=true
