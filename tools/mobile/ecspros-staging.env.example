# /etc/ecspros-staging.env — kopyalayıp SECRET'ı doldurun (openssl rand -hex 24), chmod 600
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5055
MobileAttestation__DevBypassSecret=BURAYA_SECRET
# FAZ 10 / A2 (2026-08-30): staging arka plan worker'ları ÇALIŞTIRMAZ (canlı işleri
# çiftlememek için) ve açılışta migrate/seed yapmaz — prod instance'ın işidir.
Node__Id=staging-5055
Node__Role=Api
Node__MigrateOnStartup=false
